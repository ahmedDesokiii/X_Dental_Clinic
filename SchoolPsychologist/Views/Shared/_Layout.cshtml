@using Microsoft.AspNetCore.Identity
@using SchoolPsychologist.Models.User
@inject IAuthorizationService AuthorizationService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="autocomplete" content="off">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dental</title>

    <!-- Bootstrap-->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Main CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/executive-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolPsychologist.styles.css" asp-append-version="true" />


    <!-- Icons & Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Beiruti:wght@200..900&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="~/images/sklogo.ico">

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />

    <!-- SweetAlert -->
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <!-- ================= JS (Core First) ================= -->
    <!--  jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>

    <!-- Plugins -->
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.2/moment.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/columncontrol/1.1.1/css/columnControl.dataTables.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

</head>

<body dir="rtl" style=" background: linear-gradient(115deg,  #7AE2CF,#ABE0F0  );border: none;">
    <header>

        <!-- 🔷 Top Bar -->
        <div class="top-bar py-0 bg-transparent">
            <div class="container-fluid d-flex justify-content-between align-items-center">

                <!-- Logo -->
                <div class="d-flex align-items-center me-5">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <img src="~/images/dn.png" style="width:150px">
                    </a>
                </div>

                <!-- Contact Info -->
                <div class="d-flex gap-5 ms-5">

                    <div class="info-box">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <small class="fw-bold">اتصل بنا !</small>
                            <p> 01000025879 &nbsp; 20+</p>
                        </div>
                    </div>

                    <div class="info-box">
                        <i class="bi bi-geo-alt-fill"></i>
                        <div>
                            <small class="fw-bold">العنوان</small>
                            <p>  طنطا - سبرباي</p>
                        </div>
                    </div>
                    <div class="info-box">
                        <i class="bi bi-envelope-at-fill"></i>
                        <div>
                            <small class="fw-bold">البريد الالكتروني</small>
                            <p>adesokiii88@gmail.com</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>


        <!-- 🔷 Navbar -->
        <div class="main-navbar ">
            <div class="container-fluid d-flex justify-content-between align-items-center ">

                <!-- Menu -->
                <ul class="nav-menu mt-0">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole(Roles.Admin.ToString()))
                        {
                            <li><a style="font-size:20px !important" asp-controller="Users" asp-action="Index">المستخدمين</a></li>
                            <li><a style="font-size:20px !important" asp-controller="Roles" asp-action="Index">المجموعات</a></li>
                        }

                        
                        @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.View_Students).Result.Succeeded))
                        {
                            <li><a style="font-size:20px !important" asp-controller="Students" asp-action="ListStudents">قائمة الطلاب  </a></li>
                        }
                    }

                </ul>

                <!-- Right -->
                <div class="nav-right">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>

    </header>
    <div class="container-fluid   px-0 mx-0" dir="rtl">
        <main role="main" class="mb-2">
            @RenderBody()
        </main>
    </div>

    <!-- ================= Scripts ================= -->
    <!-- Bootstrap after jQuery -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert -->
    <script src="~/sweetalert2/sweetalert2.all.min.js"></script>

    <!-- SignalR -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>

    <!-- Firebase  -->
    <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-messaging-compat.js"></script>


    <!-- ================= Your Scripts ================= -->

    <script src="~/js/site.js"></script>
    <script src="~/js/login.js"></script>
    <script src="~/js/Users.js"></script>
    <script src="~/js/InvoiceQuery.js"></script>
    <script src="~/js/GL_Account.js"></script>
    <script src="~/js/AddEntry.js"></script>
    <script src="~/js/lookupModal.js"></script>
    <script src="~/js/notifications.js"></script>
    <script src="~/js/signature.js"></script>
    <script src="~/js/testSig.js"></script>
    <script src="~/js/global-toast.js"></script>
    <script src="~/js/alert-adapter.js"></script>
    <script src="~/js/global-actions.js"></script>
    <script src="~/js/Employee.js"></script>
    <!-- Init -->
    <script>
        $(document).ready(function () {
        $('.searchable').select2();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
