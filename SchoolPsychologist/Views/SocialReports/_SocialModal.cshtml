@model SocialReportVM

<div class="modal fade" id="socialModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px;background:linear-gradient(135deg,#f4f6f8,#e2ebee);">

            <div class="modal-header" style="background:#758A93;color:#fff;">
                <i class="bi bi-file-earmark-text-fill fs-3 mx-3"></i>

                <span class="fs-4 fw-bold">تقرير اجتماعي</span>
                <button class="btn-close btn-close-white position-absolute start-0 mx-3" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="Save" method="post">

                <div class="modal-body px-4">

                    <input type="hidden" asp-for="NewReport.Id" id="socialId" />
                    <input type="hidden" asp-for="NewReport.StudentId" value="@Model.StudentId" />

                    <div class="mb-3">
                        <label>الحالة الأسرية</label>
                        <select asp-for="NewReport.FamilyStatus"
                                id="family"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<FamilyStatus>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>المستوى الاقتصادي</label>
                        <select asp-for="NewReport.EconomicLevel"
                                id="eco"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<EconomicLevel>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>العلاقة الأسرية</label>
                        <select asp-for="NewReport.FamilyRelation"
                                id="rel"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<RelationshipLevel>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label>ملاحظات</label>
                        <textarea asp-for="NewReport.Notes"
                                  id="notes"
                                  class="form-control"></textarea>
                    </div>

                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn btn-success px-4 rounded-pill">حفظ</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                </div>

            </form>

        </div>
    </div>
</div>