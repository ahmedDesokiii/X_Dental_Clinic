@model UserRolesViewModel
@{
    ViewData["Title"] = "تعديل مجموعات المستخدم";
}
@* <div class="card border-0 mb-3" style="background-color:#032b42 !important; border-radius:0 0 0 80px ">
    <div class="d-flex text-center mx-auto pb-3">
        <a asp-controller="Users" asp-action="index" class="text-center fs-4 fw-bold text-decoration-none" style="color:#415E72 !important ">قائمة المستخدمين</a>
        <i class="bi bi-chevron-double-left fw-bold fs-4 mt-2 mx-3" style="color:#415E72 !important"></i>
        <a class="text-center fs-3 fw-bold text-decoration-none" style="color:#415E72 !important ">@ViewData["Title"]</a>
    </div>
</div> *@


<section class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-1"></div>
        <form method="post">
            <div class="card col-md-10 p-0 mx-auto justify-content-center">
                <div class="card-header d-flex align-items-center justify-content-start bg-info-subtle ">
                    
                    <span class="fs-3 fw-bold link-success px-5">
                        @ViewData["Title"] [@Model.UserName]
                    </span>
                    <button type="submit" title="حفظ تعديل المجموعات" class="btn send-btn position-absolute start-0 top-0 mt-2  ms-3 fs-5  rounded-3 ">
                        <span class="fw-bold"> حفظ التعديلات</span>
                        <i class="bi bi-floppy2 fs-5 fw-bold me-2"></i>
                    </button>
                </div>
                <div class="card-body row p-0 justify-content-center">
                    <div class="col-md-6">
                        <table class="table table-hover display nowrap  px-0 table-bordered border-primary-subtle" id="tableUser">
                            <thead>
                                <tr class="text-center">
                                    <th class=" text-white text-center fs-5" style="width:80%;background-color:#032b42 !important;">المجموعة</th>
                                    <th class=" text-white text-center fs-5" style="width:20%;background-color:#032b42 !important;">اجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Roles.Count; i++)
                                {
                                    <tr>
                                        <td class="fs-6 px-2 py-0 text-dark text-center fw-bold">
                                            <input type="hidden" asp-for="@Model.Roles[i].DisplayValue" />
                                            <label class="form-check-label" asp-for="@Model.Roles[i].IsSelected">
                                                @Model.Roles[i].DisplayValue
                                            </label>
                                        </td>
                                       
                                        <td class="fs-5 px-2 py-0 text-dark text-center bg-info-subtle">
                                            <input asp-for="@Model.Roles[i].IsSelected" class="form-check-input border-primary" />
                                        </td>
                                    </tr>
                                    <div asp-validation-summary="All" class="text-danger"></div>
                                }
                            </tbody>
                            <tfoot class="">
                                <tr class="text-center">
                                    <th style="background-color:#FCBF49 !important;">المجموعة</th>
                                    <th style="background-color:#FCBF49 !important;">اجراءات</th>
                                </tr>
                            </tfoot>
                        </table>

                    </div>
                </div>
                @* <div class="card-footer text-center">
                    <button type="submit" title="حفظ تعديل المجموعات" class="btn btn-success fs-5 px-5 rounded-3 ">
                        <i class="bi bi-floppy2 fs-5 fw-bold ps-2"></i>حفظ التعديلات
                    </button>
                </div> *@
            </div>
        </form>
    </div>
</section>
<style>
    .send-btn {
        background: linear-gradient(135deg, #25D366, #128C7E);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 8px 22px;
        transition: all .25s ease-in-out;
    }

        .send-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
            opacity: .95;
        }

        .send-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

</style>