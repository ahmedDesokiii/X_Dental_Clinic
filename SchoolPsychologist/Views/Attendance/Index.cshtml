@model AttendanceVM

@{
    ViewData["Title"] = "الحضور والانصراف";
}

<section class="container-fluid px-0 mx-auto">
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <div class="card mt-4">

                <!-- Header -->
                <div class="card-header bg-info-subtle text-center">
                    <span class="fs-2 fw-bold text-success">
                        تقرير حضور و غياب الطلاب
                    </span>
                     <div class="text-center mt-3 position-absolute start-0 ms-3 top-0">
                        </div>
                </div>

                <!-- Select Class -->
                <div class="p-3">

                    <form method="get">
                        <!-- Code -->
                        <div class="input-group mt-2 row mx-auto w-25">
                            <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0"
                                  style="color:#415E72;">
                               الفصل
                            </span>
                            <select name="classId"
                                    class="form-control text-center rounded-start-3"
                                    onchange="this.form.submit()">

                                <option value="">اختر الفصل</option>

                                @foreach (var c in Model.Classes)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.ClassId)">
                                        @c.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </form>
                </div>

                <!-- Table -->
                <div class="card-body">

                    @if (Model.Students.Any())
                    {
                        <form asp-action="Save" method="post">

                            <input type="hidden" name="ClassId" value="@Model.ClassId" />

                            <div id="Users" class="tabcontent">
                                <table class="table table-hover display nowrap  px-0 table-bordered border-primary-subtle" id="tableUser">
                                    <thead>
                                        <tr class="text-center">
                                            <th class=" text-white text-center fs-6" style="width:5%;background-color:#415E72 !important;">صورة</th>
                                            <th class=" text-white text-center fs-6" style="width:7%;background-color:#415E72 !important;">كود</th>
                                            <th class=" text-white text-center fs-6" style="width:20%;background-color:#415E72 !important;">اسـم</th>
                                            <th class=" text-white text-center fs-6" style="width:8%;background-color:#415E72 !important;">هوية</th>                                            
                                            <th class=" text-white text-center fs-6" style="width:10%;background-color:#415E72 !important;">تليفون</th>
                                            <th class=" text-white text-center fs-6" style="width:30%;background-color:#415E72 !important;">العنوان</th> 
                                            <th class=" text-white text-center fs-6" style="width:10%;background-color:#415E72 !important;">حضور الفصل</th>
                                            <th class=" text-white text-center fs-6" style="width:10%;background-color:#415E72 !important;">حضور المصنع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Students.Count; i++)
                                        {
                                            <tr class="text-center">
                                                <td class="fs-6 text-center  px-1  py-1">
                                                    <img src="@(!string.IsNullOrEmpty(Model.Students[i].ImagePath) ? Model.Students[i].ImagePath : "/images/default-user.png")"
                                                         width="40"
                                                         height="40"
                                                         style="border-radius:50%;object-fit:cover;" />
                                                </td>
                                                <td class="fs-6 text-center  px-1  py-1">@Model.Students[i].Code</td>
                                                <td class=" px-1 py-1 ">
                                                    <span class="link-dark fw-bold" style="font-size:14px">
                                                        @Model.Students[i].StudentName
                                                    </span>
                                                </td>
                                                <td class="text-center px-1" style="font-size:13px">@Model.Students[i].NationalId</td>
                                                <td class="text-center px-1" style="font-size:13px">@Model.Students[i].Phone</td>
                                                <td class="text-center px-1" style="font-size:13px">@Model.Students[i].Address</td>
                                                <!-- Class -->
                                                <td class="bg-light-subtle">
                                                    <input type="checkbox"
                                                           asp-for="Students[i].IsPresentClass"
                                                           class="form-check-input fs-4" />
                                                </td>

                                                <!-- Factory -->
                                                <td class="bg-light-subtle">
                                                    <input type="checkbox"
                                                           asp-for="Students[i].IsPresentFactory"
                                                           class="form-check-input fs-4" />
                                                </td>
                                                <input type="hidden" asp-for="Students[i].StudentId" />
                                                
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="bg-danger-subtle">
                                        <tr class="text-center">
                                            <th style="width:5%;background-color:#FCBF49 !important;">صورة</th>
                                            <th style="width:5%;background-color:#FCBF49 !important;">كود</th>
                                            <th style="width:15%;background-color:#FCBF49 !important;">اسـم</th>
                                            <th style="width:8%;background-color:#FCBF49 !important;">هوية</th>
                                            <th style="width:10%;background-color:#FCBF49 !important;">تليفون</th>
                                            <th style="width:5%;background-color:#FCBF49 !important;">عنوان</th>
                                            <th style="width:8%;background-color:#FCBF49 !important;">فصل</th>
                                            <th style="width:12%;background-color:#FCBF49 !important;">مصنع</th>
                                    
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <button  title="حفظ بيانات الحضور" class="btn send-btn position-absolute start-0 top-0 mt-2 px-4  ms-3 fs-5  rounded-3 ">
                                <span class="fw-bold mb-2"> حفظ الحضور</span>
                                <i class="bi bi-floppy2 fs-5 fw-bold me-2"></i>
                            </button>
                           
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center">
                            اختر فصل لعرض الطلاب
                        </div>
                    }

                </div>

            </div>
        </div>
        <div class="col-md-1"></div>
    </div>
    
</section>
<style>
    .send-btn {
        background: linear-gradient(135deg, #25D366, #128C7E);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 8px 22px;
        transition: all .25s ease-in-out;
    }

        .send-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
            opacity: .95;
        }

        .send-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

</style>