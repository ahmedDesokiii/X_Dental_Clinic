@using Microsoft.AspNetCore.Identity
@inject IAuthorizationService AuthorizationService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager

@model StudentViewModel

@{
    ViewData["Title"] = "قائمة الطلاب";
}

<!-- Main content -->

<section class="container-fluid mt-4">
    <div class="row">

        <div class="col-md-1"></div>
        <div class="col-md-10">
            <div class="card p-0">
                <div class="card-header d-flex align-items-center justify-content-start bg-info-subtle py-0">
                    <div class="col-md-1">
                        @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.Add_Student).Result.Succeeded))
                        {
                            <a title="إضافة طالب جديد" class="btn btn-outline-success border-0 bg-transparent ms-3 fs-1 rounded-3 "
                                    data-bs-toggle="modal"
                                    data-bs-target="#studentModal"
                                   onclick="clearStudentForm()">
                                <i class="bi bi-person-fill-add fs-1 fw-bold link-success" ></i>
                            </a>
                        }
                        
                    </div>
                    <div class="col-md-10 text-center">
                        <span class="fs-2 fw-bold" style="color:#415E72 !important;">
                            قائمة الطلاب
                            <i class="bi bi-people pe-2 fs-3" style="color:#415E72 !important;"></i>
                        </span>
                    </div>
                    @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.Add_Student).Result.Succeeded))
                    {
                        @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.RepAttendance_Student).Result.Succeeded))
                        {
                            <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تقرير شئون الطلاب"
                                   asp-controller="Attendance" asp-action="Index" asp-route-classId="0">
                                <i class="bi bi-file-earmark-break-fill fs-5 link-dark"></i>
                            </a>
                        }
                    }

                </div>
                <!-- /.card-header -->

                <div class="card-body p-0">
                    <!-- Tab links -->
                    @*  <div class="tab">
                        <button class="tablinks" onclick="openCity('event', 'Users')" id="defaultOpen">قائمة المستخدمين</button>
                    </div> *@
                    <!-- Tab content -->
                    @if (!Model.Students.Any())
                    {
                        <div class="alert  alert-warning mt-5">
                            <h4 class="alert-heading">لا يوجد طلاب !</h4>
                            <p class="mb-0">لم يتم اضافة طلاب للتطبيق حتي الآن</p>
                        </div>
                    }
                    else
                    {

                        <div id="Users" class="tabcontent">
                            <table class="table table-hover display nowrap  px-0 table-bordered border-primary-subtle" id="tableUser">
                                <thead>
                                    <tr class="text-center">
                                        <th class=" text-white text-center fs-6" style="width:5%;background-color:#415E72 !important;">صورة</th>
                                        <th class=" text-white text-center fs-6" style="width:5%;background-color:#415E72 !important;">كود</th>
                                        <th class=" text-white text-center fs-6" style="width:15%;background-color:#415E72 !important;">اسـم</th>
                                        <th class=" text-white text-center fs-6" style="width:8%;background-color:#415E72 !important;">هوية</th>
                                        <th class=" text-white text-center fs-6" style="width:7%;background-color:#415E72 !important;">ديانة</th>
                                        <th class=" text-white text-center fs-6" style="width:10%;background-color:#415E72 !important;">تليفون</th>
                                        <th class=" text-white text-center fs-6" style="width:5%;background-color:#415E72 !important;">نوع</th>
                                        <th class=" text-white text-center fs-6" style="width:8%;background-color:#415E72 !important;">فصل</th>
                                        <th class=" text-white text-center fs-6" style="width:12%;background-color:#415E72 !important;">ولي الامر</th>
                                        <th class=" text-white text-center fs-6" style="width:30%;background-color:#415E72 !important;">اجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var stu in Model.Students)
                                    {
                                        <tr class="text-center">
                                            <td class="fs-6 text-center  px-1  py-1"> 
                                                <img src="@(!string.IsNullOrEmpty(stu.ImagePath) ? stu.ImagePath : "/images/default-user.png")"
                                                     width="40"
                                                     height="40"
                                                     style="border-radius:50%;object-fit:cover;" />
                                            </td>
                                            <td class="fs-6 text-center  px-1  py-1">@stu.Code</td>
                                            <td class=" px-1 py-1 ">
                                                <span class="link-dark fw-bold" style="font-size:14px">
                                                    @stu.FullName
                                                </span>
                                            </td>
                                            <td class="text-center px-1"style="font-size:13px">@stu.NationalId</td>
                                            @if (stu.Region == Region.Muslim)
                                            {
                                                <td class="fw-bold fs-6 px-1 py-2 m-0 text-primary"><span class="bg-info-subtle py-1 px-3 rounded-5">مسلم</span></td>
                                            }
                                            else if (stu.Region == Region.Christian)
                                            {
                                                <td class="fw-bold fs-6 px-1 py-2 m-0 text-warning"><span class="bg-warning-subtle py-1 px-3 rounded-5">مسيحي</span></td>
                                            }
                                            else if (stu.Region == Region.Jewish)
                                            {
                                                <td class="fw-bold fs-6 px-1 py-2 m-0 text-dark"><span class="bg-dark-subtle py-1 px-3 rounded-5">يهودي</span></td>
                                            }

                                            <td class="text-center px-1" style="font-size:13px">@stu.Phone</td>
                                            
                                            @if (stu.Gender == Gender.Male){
                                                <td class="fw-bold fs-6 px-1 py-2 m-0 text-success"><span class="bg-success-subtle py-1 px-3 rounded-5">ذكر</span></td>
                                            }
                                            else 
                                            {
                                                <td class="fw-bold fs-6 px-1 py-2 m-0 text-warning"><span class="bg-warning-subtle py-1 px-3 rounded-5">انثي</span></td>
                                            }
                                           
                                            <td class="fs-6 text-center px-1">@stu.Class.Name</td>
                                            <td class="text-center px-1" style="font-size:14px">@stu.Parent.FullName</td>

                                            <td class="py-1">
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.Details_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="بيانات الطالب" href="#">
                                                        <i class="bi bi-person-lines-fill fs-5 link-warning"></i>
                                                    </a>
                                                }
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.Edit_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تعديل"
                                                           onclick="editStudent('@stu.Id','@stu.Code','@stu.FullName','@stu.NationalId','@stu.Gender','@stu.ClassId','@stu.ParentId','@stu.Phone','@stu.Address','@stu.ImagePath')"
                                                           data-bs-toggle="modal"
                                                           data-bs-target="#studentModal">
                                                        <i class="bi bi-pencil-square fs-5 link-info"></i>
                                                    </a>
                                                }
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.Delete_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="حذف"
                                                           asp-controller="Students" asp-action="Delete" asp-route-Id="@stu.Id">
                                                        <i class="bi bi-trash-fill fs-5 link-danger"></i>
                                                    </a>
                                                }
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.RepTeacher_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تقرير معلم"
                                                           asp-controller="TeacherReports" asp-action="Index" asp-route-studentId="@stu.Id">
                                                        <i class="bi bi-file-earmark-font-fill fs-5 link-dark"></i>
                                                    </a>
                                                }
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.RepPsychology_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تقرير نفسي"
                                                           asp-controller="PsychologyReports" asp-action="Index" asp-route-studentId="@stu.Id">
                                                        <i class="bi bi-file-earmark-ppt-fill fs-5 link-dark"></i>
                                                    </a>
                                                }
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.RepSocial_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تقرير اجتماعي"
                                                           asp-controller="SocialReports" asp-action="Index" asp-route-studentId="@stu.Id">

                                                        <i class="bi bi-file-earmark-text-fill fs-5 link-dark"></i>
                                                    </a>
                                                }
                                                @if ((AuthorizationService.AuthorizeAsync(User, Permissions.Students.RepAttendance_Student).Result.Succeeded))
                                                {
                                                    <a class="btn fw-bold btn-outline-dark bg-transparent border-0 p-0 mx-1 fs-5" title="تقرير شئون الطلاب"
                                                           asp-controller="Attendance" asp-action="Index" asp-route-classId="@stu.ClassId">
                                                        <i class="bi bi-file-earmark-break-fill fs-5 link-dark"></i>
                                                    </a>
                                                }
                                              
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-danger-subtle">
                                    <tr class="text-center">
                                        <th style="width:5%;background-color:#FCBF49 !important;">صورة</th>
                                        <th style="width:5%;background-color:#FCBF49 !important;">كود</th>
                                        <th style="width:15%;background-color:#FCBF49 !important;">اسـم</th>
                                        <th style="width:8%;background-color:#FCBF49 !important;">هوية</th>
                                        <th style="width:7%;background-color:#FCBF49 !important;">ديانة</th>
                                        <th style="width:10%;background-color:#FCBF49 !important;">تليفون</th>
                                        <th style="width:5%;background-color:#FCBF49 !important;">نوع</th>
                                        <th style="width:8%;background-color:#FCBF49 !important;">فصل</th>
                                        <th style="width:12%;background-color:#FCBF49 !important;">ولي الامر</th>
                                        <th style="width:30%;background-color:#FCBF49 !important;">اجراءات</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
                <!-- /.card-body -->
            </div>
            <!-- /.card -->
            <!-- /.card -->
        </div>
        <div class="col-md-1"></div>
        <!-- /.col -->
    </div>
    <!-- /.row -->
</section>
<!-- /.content -->



<div class="modal fade" id="studentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content" style="border-radius:12px;">

            <!-- Header -->
            <div class="modal-header"
                 style="background-color:#758A93; color:#fff;"
                 dir="rtl">

                <div>
                    <i class="bi bi-person-fill fs-3 mx-3"></i>
                    <span class="fs-4 fw-bold modal-title" id="modalTitle">
                        بيانات الطالب
                    </span>
                </div>

                <button type="button"
                        class="btn-close btn-close-white position-absolute start-0 mx-3"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <form asp-action="Save"
                      asp-controller="Students"
                      method="post"
                      enctype="multipart/form-data">

                    <!-- Hidden -->
                    <input type="hidden" asp-for="NewStudent.Id" id="studentId" />

                    <!-- Image -->
                    <div class="text-center my-0">
                        <img id="imgPreview"
                             src="~/images/default-user.png"
                             class="rounded-circle "
                             width="100"
                             height="100"
                             style="object-fit:cover;" />

                        <input type="file"
                               name="file"
                               class="form-control py-0 px-2 text-center w-75 mt-0 mb-3 mx-auto"
                               style="font-size:12px"
                               onchange="previewImage(event)" />
                    </div>

                    <!-- Code -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle"
                              style="color:#415E72;">
                            كود الطالب
                        </span>

                        <input asp-for="NewStudent.Code"
                               id="studentCode"
                               class="form-control text-center"
                               placeholder="ادخل كود الطالب"
                               style="border-top-left-radius:20px;" />
                    </div>

                    <!-- Name -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle"
                              style="color:#415E72;">
                            اسم الطالب
                        </span>

                        <input asp-for="NewStudent.FullName"
                               id="studentName"
                               class="form-control text-center"
                               placeholder="ادخل اسم الطالب"
                               style="border-top-left-radius:20px;" />
                    </div>

                    <!-- National ID -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            الرقم القومي
                        </span>

                        <input asp-for="NewStudent.NationalId"
                               id="nationalId"
                               class="form-control text-center"
                               placeholder="14 رقم"
                               style="border-top-left-radius:20px;" />
                    </div>

                    <!-- Gender -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            النوع
                        </span>
                        <select asp-for="NewStudent.Gender"
                                asp-items="Html.GetEnumSelectList<Gender>()"
                                class="form-control text-center">
                        </select>
                    </div>
                    <!-- Gender -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            الديانة
                        </span>
                        <select asp-for="NewStudent.Region"
                                asp-items="Html.GetEnumSelectList<Region>()"
                                class="form-control text-center">
                        </select>
                    </div>

                    <!-- Class -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            الفصل
                        </span>

                        <select asp-for="NewStudent.ClassId"
                                id="classId"
                                class="form-control text-center"
                                asp-items="@(new SelectList(Model.Classes,"Id","Name"))">
                        </select>
                    </div>

                    <!-- Parent -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            ولي الأمر
                        </span>

                        <select asp-for="NewStudent.ParentId"
                                id="parentId"
                                class="form-control text-center"
                                asp-items="@(new SelectList(Model.Parents,"Id","FullName"))">
                        </select>
                    </div>

                    <!-- Phone -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            رقم الهاتف
                        </span>

                        <input asp-for="NewStudent.Phone"
                               id="phone"
                               class="form-control text-center"
                               placeholder="اختياري" />
                    </div>

                    <!-- Address -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                            العنوان
                        </span>

                        <input asp-for="NewStudent.Address"
                               id="address"
                               class="form-control text-center" />
                    </div>

                    <!-- Buttons -->
                    <div class="modal-footer mt-2"
                         style="padding:0 15px 15px 0">

                        <button type="submit"
                                class="btn btn-success px-4 rounded-3">
                            حفظ البيانات
                            <i class="bi bi-check-circle me-1"></i>
                        </button>

                        <button type="button"
                                class="btn btn-secondary rounded-3"
                                data-bs-dismiss="modal">
                            إلغاء
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>




@section Scripts {

    <script>

        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById('imgPreview').src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        function editStudent(id, code, name, nationalId, gender, classId, parentId, phone, address, imagePath) {

            $('#studentId').val(id);
            $('#studentCode').val(code);
            $('#studentName').val(name);
            $('#nationalId').val(nationalId);
            $('#gender').val(gender);
            $('#classId').val(classId);
            $('#parentId').val(parentId);
            $('#phone').val(phone);
            $('#address').val(address);

            if (imagePath) {
                $('#imgPreview').attr('src', imagePath);
            } else {
                $('#imgPreview').attr('src', '/images/default-user.png');
            }
        }

        function clearStudentForm() {
            $('#studentId').val(0);
            $('#studentCode').val('');
            $('#studentName').val('');
            $('#nationalId').val('');
            $('#gender').val(1);
            $('#classId').val('');
            $('#parentId').val('');
            $('#phone').val('');
            $('#address').val('');
            $('#imgPreview').attr('src', '/images/default-user.png');
        }

    </script>

    
    @if (!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
    {
        if (Context.Session.GetString(Helper.MsgType) == Helper.Success)
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'success'
                });
            </script>

        }
        else
        {
            <script>

                Swal.fire({
                    title: '@Context.Session.GetString(Helper.Title)',
                    text: '@Html.Raw(@Context.Session.GetString(Helper.Msg))',
                    confirmButtonText: 'Ok',
                    icon: 'error'
                });
            </script>
        }
        Context.Session.SetString(Helper.MsgType, "");
    }

}

    

    








