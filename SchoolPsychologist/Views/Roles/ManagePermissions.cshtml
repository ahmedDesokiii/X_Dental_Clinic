<style>
    .send-btn {
        background: linear-gradient(135deg, #25D366, #128C7E);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 8px 22px;
        transition: all .25s ease-in-out;
    }

        .send-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
            opacity: .95;
        }

        .send-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

</style>