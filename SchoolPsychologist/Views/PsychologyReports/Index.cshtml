@model PsychologyReportVM

@{
    ViewData["Title"] = "التقارير النفسية";
    int cNo = 0;
}

<div class="container-fluid px-0 mt-4">
    <div class="row mx-auto">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header d-flex align-items-center bg-info-subtle py-2">
                    <span class="fs-2 fw-bold link-success">
                       بيانات الطالب
                    </span>
                
                </div>
                <div class="card-body">
                    <!-- Image -->
                    <div class="text-center my-0">
                        @* src="~/images/default-user.png" *@
                        <img id="imgPreview"
                             src="@Model.StudentData?.ImagePath"
                             class="rounded-circle "
                             width="100"
                             height="100"
                             style="object-fit:cover;" />
                         </div>

                    <!-- Code -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0"
                              style="color:#415E72;">
                            كود الطالب
                        </span>

                        <input asp-for="StudentData.Code"
                               id="studentCode"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="ادخل كود الطالب" />
                    </div>

                    <!-- Name -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0"
                              style="color:#415E72;">
                            اسم الطالب
                        </span>

                        <input asp-for="StudentData.FullName"
                               id="studentName"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="ادخل اسم الطالب" />
                    </div>

                    <!-- National ID -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0">
                            الرقم القومي
                        </span>

                        <input asp-for="StudentData.NationalId"
                               id="nationalId"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="14 رقم" />
                    </div>

                    <!-- Gender -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 py-0 bg-info-subtle">
                            النوع
                        </span>
                        <select asp-for="StudentData.Gender"
                                asp-items="Html.GetEnumSelectList<Gender>()"
                                class=" form-control text-center rounded-start-3 py-0">
                        </select>
                    </div>
                    <!-- Gender -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-start-3 col-md-4 py-0 bg-info-subtle">
                            الديانة
                        </span>
                        <select asp-for="StudentData.Region"
                                asp-items="Html.GetEnumSelectList<Region>()"
                                class="form-control text-center rounded-start-3 py-0">
                        </select>
                    </div>
                    @*
            <!-- Class -->
            <div class="input-group mt-2 row mx-auto">
                <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                    الفصل
                </span>

                 <select asp-for="StudentData.ClassId"
                        id="classId"
                        class="form-control text-center"
                        asp-items="@(new SelectList(Model.StudentData.Classes, "Id", "Name"))">
                </select> 
            </div>

             <!-- Parent -->
            <div class="input-group mt-2 row mx-auto">
                <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                    ولي الأمر
                </span>

                <select asp-for="NewStudent.ParentId"
                        id="parentId"
                        class="form-control text-center"
                        asp-items="@(new SelectList(Model.Parents, "Id", "FullName"))">
                </select>
            </div> *@

                    <!-- Phone -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-start-3 col-md-4 py-0 bg-info-subtle">
                            رقم الهاتف
                        </span>

                        <input asp-for="StudentData.Phone"
                               id="phone"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="اختياري" />
                    </div>

                    <!-- Address -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-start-3 col-md-4 py-0 bg-info-subtle">
                            العنوان
                        </span>

                        <input asp-for="StudentData.Address"
                               id="address"
                               class="form-control py-0 text-center rounded-start-3" />
                    </div>
                </div>
            </div>
            
        </div>
        <div class="col-md-9">
            <div class="card p-0">

                <!-- Header -->
                <div class="card-header d-flex align-items-center bg-info-subtle py-0">
                    <div class="col-md-1">
                        <button type="button"
                                onclick="clearPsyForm()"
                                class="btn btn-outline-dark border-0 bg-transparent fs-1"
                                data-bs-toggle="modal"
                                data-bs-target="#psyModal" accesskey=""
                                title="اضافة تقرير نفسي">

                            <i class="bi bi-heart-pulse-fill"></i>
                        </button>
                    </div>

                    <div class="col-md-10 text-center">
                        <span class="fs-2 fw-bold link-success">
                            التقارير النفسية
                        </span>
                    </div>

                </div>

                <!-- Alerts -->
                <div class="px-3 mt-2">

                    @if (Model.Reports.Any(x => x.Severity == SeverityLevel.حرجة))
                    {
                        <div class="alert alert-danger text-center">
                            ⚠ يوجد حالات حرجة
                        </div>
                    }

                    @if (Model.Reports.Any(x => x.Status == CaseStatus.مفتوحة))
                    {
                        <div class="alert alert-warning text-center">
                            ⚠ يوجد حالات مفتوحة تحتاج متابعة
                        </div>
                    }

                </div>

                <!-- Body -->
                <div class="card-body text-center">

                    @if (!Model.Reports.Any())
                    {
                        <div class="alert alert-warning mt-3">
                            <h5>لا يوجد تقارير نفسية</h5>
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered border-primary-subtle">

                            <thead>
                                <tr class="fw-bolder text-white bg-dark">
                                    <td>#</td>
                                    <td>نوع المشكلة</td>
                                    <td>الخطورة</td>
                                    <td>الحالة</td>
                                    <td>التاريخ</td>
                                    <td>إجراءات</td>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var r in Model.Reports)
                                {
                                    cNo++;

                                    string severityClass = r.Severity switch
                                    {
                                        SeverityLevel.حرجة => "bg-danger-subtle text-danger fw-bold",
                                        SeverityLevel.عظمي => "bg-warning-subtle text-dark",
                                        SeverityLevel.متوسطة => "bg-info-subtle",
                                        _ => "bg-light"
                                    };

                                    string statusClass = r.Status switch
                                    {
                                        CaseStatus.مفتوحة => "text-danger fw-bold",
                                        CaseStatus.انتظار => "text-warning",
                                        CaseStatus.مغلقة => "text-success",
                                        _ => ""
                                    };

                                    <tr>
                                        <td>@cNo</td>
                                        <td>@r.IssueType</td>

                                        <!-- Severity -->
                                        <td class="@severityClass">
                                            @r.Severity
                                        </td>

                                        <!-- Status -->
                                        <td class="@statusClass">
                                            @r.Status
                                        </td>

                                        <td>@r.ReportDate.ToShortDateString()</td>

                                        <!-- Actions -->
                                        <td>
                                            <button class="btn btn-outline-dark border-0"
                                                    onclick="editPsy('@r.Id','@r.IssueType','@r.Severity','@r.Status','@r.Description','@r.Recommendations')"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#psyModal">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }

                </div>
            </div>
        </div>
    </div>
   
</div>

<!-- Modal -->
<partial name="_PsyModal" model="Model" />

@section Scripts{
    <script>

        function editPsy(id, issue, severity, status, desc, rec) {

            $('#psyId').val(id);
            $('#issue').val(parseInt(issue));
            $('#severity').val(parseInt(severity));
            $('#status').val(parseInt(status));
            $('#desc').val(desc);
            $('#rec').val(rec);
        }

        function clearPsyForm() {

            $('#psyId').val(0);
            $('#issue').val(1);
            $('#severity').val(1);
            $('#status').val(1);
            $('#desc').val('');
            $('#rec').val('');
        }

    </script>
}