@model PsychologyReportVM

<div class="modal fade" id="psyModal" tabindex="-1" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px; background:linear-gradient(135deg,#f4f6f8,#e2ebee);">

            <!-- Header -->
            <div class="modal-header"
                 style="background-color:#758A93; color:#fff;">
                <i class="bi bi-heart-pulse-fill  fs-3 mx-3"></i>
                <span class="fs-4 fw-bold">تقرير نفسي</span>

                <button type="button"
                        class="btn-close btn-close-white position-absolute start-0 mx-3"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <!-- Body -->
            <form asp-action="Save" method="post">

                <div class="modal-body px-4">

                    <input type="hidden" asp-for="NewReport.Id" id="psyId" />
                    <input type="hidden" asp-for="NewReport.StudentId" value="@Model.StudentId" />

                    <!-- Issue -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">نوع المشكلة</label>
                        <select asp-for="NewReport.IssueType"
                                id="issue"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<IssueType>()">
                        </select>
                    </div>

                    <!-- Severity -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">درجة الخطورة</label>
                        <select asp-for="NewReport.Severity"
                                id="severity"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<SeverityLevel>()">
                        </select>
                    </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">الحالة</label>
                        <select asp-for="NewReport.Status"
                                id="status"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<CaseStatus>()">
                        </select>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">الوصف</label>
                        <textarea asp-for="NewReport.Description"
                                  id="desc"
                                  class="form-control text-center"
                                  rows="3"></textarea>
                    </div>

                    <!-- Recommendations -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">التوصيات</label>
                        <textarea asp-for="NewReport.Recommendations"
                                  id="rec"
                                  class="form-control text-center"
                                  rows="3"></textarea>
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer justify-content-center">

                    <button type="submit"
                            class="btn btn-success px-4 rounded-pill">
                        حفظ البيانات
                        <i class="bi bi-check-circle"></i>
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary px-4 rounded-pill"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

