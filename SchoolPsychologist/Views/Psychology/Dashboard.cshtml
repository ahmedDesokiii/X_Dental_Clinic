
@model PsychologyDashboardViewModel

<div class="container-fluid">

    <!-- KPIs -->
    <div class="row text-center">

        <div class="col-md-3">
            <div class="card bg-primary text-white p-3">
                <h3>@Model.TotalCases</h3>
                <p>إجمالي الحالات</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-white p-3">
                <h3>@Model.OpenCases</h3>
                <p>حالات مفتوحة</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white p-3">
                <h3>@Model.ClosedCases</h3>
                <p>حالات مغلقة</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-dark text-white p-3">
                <h3>@Model.TotalReports</h3>
                <p>التقارير</p>
            </div>
        </div>

    </div>

    <!-- Alerts -->
    <div class="row mt-3">

        @if (Model.HasCriticalCases)
        {
            <div class="alert alert-danger">⚠ يوجد حالات حرجة تحتاج تدخل سريع</div>
        }

        @if (Model.HasPendingReports)
        {
            <div class="alert alert-warning">📄 يوجد تقارير غير معتمدة</div>
        }

        @if (Model.HasMissingFollowUp)
        {
            <div class="alert alert-info">🕒 يوجد حالات بدون متابعة</div>
        }

    </div>

    <!-- Latest Cases -->
    <div class="card mt-3">
        <div class="card-header bg-info text-white">آخر الحالات</div>

        <div class="card-body">
            <table class="table text-center">
                <thead>
                    <tr>
                        <th>الطالب</th>
                        <th>النوع</th>
                        <th>الحالة</th>
                        <th>الأولوية</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in Model.LatestCases)
                    {
                        <tr>
                            <td>@c.StudentName</td>
                            <td>@c.Type</td>
                            <td>@c.Status</td>
                            <td>@c.Priority</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Latest Reports -->
    <div class="card mt-3">
        <div class="card-header bg-secondary text-white">آخر التقارير</div>

        <div class="card-body">
            <table class="table text-center">
                <thead>
                    <tr>
                        <th>العنوان</th>
                        <th>الحالة</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model.LatestReports)
                    {
                        <tr>
                            <td>@r.Title</td>
                            <td>
                                @(r.IsApproved ? "معتمد" : "قيد المراجعة")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>