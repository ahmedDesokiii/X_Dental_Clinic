@model TeacherReportVM

<div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog card card-success card-outline">
        <div class="modal-content" style="border-radius:12px;">

            <!-- Header -->
            <div class="modal-header"
                 style="background-color:#758A93; color:#fff;"
                 dir="rtl">

                <div>
                    <i class="bi bi-journal-text fs-3 mx-3"></i>
                    <span class="fs-4 fw-bold modal-title" id="reportModalTitle">
                        تقرير المعلم
                    </span>
                </div>

                <button type="button"
                        class="btn-close btn-close-white position-absolute start-0 mx-3"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <form asp-action="Save"
                      asp-controller="TeacherReports"
                      method="post">

                    <!-- Hidden -->
                    <input type="hidden" asp-for="NewReport.Id" id="reportId" />
                    <input type="hidden" asp-for="NewReport.StudentId" value="@Model.StudentId" />

                    <!-- Teacher Name -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold col-md-4 bg-info-subtle">
                            اسم المدرس
                        </span>

                        <input asp-for="NewReport.TeacherName"
                               id="teacherName"
                               class="form-control text-center"
                               placeholder="ادخل اسم المدرس" />
                    </div>

                    <!-- Subject -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold col-md-4 bg-info-subtle">
                            المادة
                        </span>

                        <input asp-for="NewReport.Subject"
                               id="subject"
                               class="form-control text-center"
                               placeholder="ادخل المادة" />
                    </div>

                    <!-- Rating -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold col-md-4 bg-info-subtle">
                            التقييم
                        </span>

                        <select asp-for="NewReport.Rating"
                                id="rating"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<RatingLevel>()">
                        </select>
                    </div>

                    <!-- Behavior -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold col-md-4 bg-info-subtle">
                            السلوك
                        </span>

                        <select asp-for="NewReport.Behavior"
                                id="behavior"
                                class="form-control text-center"
                                asp-items="Html.GetEnumSelectList<BehaviorLevel>()">
                        </select>
                    </div>

                    <!-- Notes -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold col-md-4 bg-info-subtle">
                            ملاحظات
                        </span>

                        <textarea asp-for="NewReport.Notes"
                                  id="notes"
                                  class="form-control text-center"
                                  rows="3"
                                  placeholder="اكتب الملاحظات..."></textarea>
                    </div>

                    <!-- Buttons -->
                    <div class="modal-footer mt-4"
                         style="padding:0 15px 15px 0">

                        <button type="submit"
                                class="btn btn-success px-4 rounded-3">
                            حفظ البيانات
                            <i class="bi bi-check-circle me-1"></i>
                        </button>

                        <button type="button"
                                class="btn btn-secondary rounded-3"
                                data-bs-dismiss="modal">
                            إلغاء
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>