@model TeacherReportVM

@{
    ViewData["Title"] = "تقارير المعلم";
    int cNo = 0;
}

<div class="container-fluid px-0 mt-4">

    <div class="row mx-auto">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header d-flex align-items-center bg-info-subtle py-2">
                    <span class="fs-2 fw-bold link-success">
                        بيانات الطالب
                    </span>
                
                </div>
                <div class="card-body">
                    <!-- Image -->
                    <div class="text-center my-0">
                        @* src="~/images/default-user.png" *@
                        <img id="imgPreview"
                             src="@Model.StudentData?.ImagePath"
                             class="rounded-circle "
                             width="100"
                             height="100"
                             style="object-fit:cover;" />
                    </div>

                    <!-- Code -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0"
                              style="color:#415E72;">
                            كود الطالب
                        </span>

                        <input asp-for="StudentData.Code"
                               id="studentCode"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="ادخل كود الطالب" />
                    </div>

                    <!-- Name -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0"
                              style="color:#415E72;">
                            اسم الطالب
                        </span>

                        <input asp-for="StudentData.FullName"
                               id="studentName"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="ادخل اسم الطالب" />
                    </div>

                    <!-- National ID -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle py-0">
                            الرقم القومي
                        </span>

                        <input asp-for="StudentData.NationalId"
                               id="nationalId"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="14 رقم" />
                    </div>

                    <!-- Gender -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-end-3 col-md-4 py-0 bg-info-subtle">
                            النوع
                        </span>
                        <select asp-for="StudentData.Gender"
                                asp-items="Html.GetEnumSelectList<Gender>()"
                                class=" form-control text-center rounded-start-3 py-0">
                        </select>
                    </div>
                    <!-- Gender -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-start-3 col-md-4 py-0 bg-info-subtle">
                            الديانة
                        </span>
                        <select asp-for="StudentData.Region"
                                asp-items="Html.GetEnumSelectList<Region>()"
                                class="form-control text-center rounded-start-3 py-0">
                        </select>
                    </div>
                    @*
            <!-- Class -->
            <div class="input-group mt-2 row mx-auto">
                <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                    الفصل
                </span>

                 <select asp-for="StudentData.ClassId"
                        id="classId"
                        class="form-control text-center"
                        asp-items="@(new SelectList(Model.StudentData.Classes, "Id", "Name"))">
                </select> 
            </div>

             <!-- Parent -->
            <div class="input-group mt-2 row mx-auto">
                <span class="input-group-text fw-bold rounded-end-3 col-md-4 bg-info-subtle">
                    ولي الأمر
                </span>

                <select asp-for="NewStudent.ParentId"
                        id="parentId"
                        class="form-control text-center"
                        asp-items="@(new SelectList(Model.Parents, "Id", "FullName"))">
                </select>
            </div> *@

                    <!-- Phone -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-start-3 col-md-4 py-0 bg-info-subtle">
                            رقم الهاتف
                        </span>

                        <input asp-for="StudentData.Phone"
                               id="phone"
                               class="form-control text-center rounded-start-3 py-0"
                               placeholder="اختياري" />
                    </div>

                    <!-- Address -->
                    <div class="input-group mt-2 row mx-auto">
                        <span class="input-group-text fw-bold rounded-start-3 col-md-4 py-0 bg-info-subtle">
                            العنوان
                        </span>

                        <input asp-for="StudentData.Address"
                               id="address"
                               class="form-control py-0 text-center rounded-start-3" />
                    </div>
                </div>
            </div>
            
        </div>
       <div class="col-md-9">
            <!-- Header -->
            <div class="card">
                <div class="card-header d-flex align-items-center bg-info-subtle py-2">

                    <!-- Add -->
                    <div class="col-md-2">
                        <button class="btn btn-outline-dark border-0 bg-transparent fs-1"
                                onclick="clearReportForm()"
                                data-bs-toggle="modal"
                                data-bs-target="#reportModal"
                        title="اضافة تقرير معلم">
                            <i class="bi bi-journal-plus"></i>
                        </button>
                    </div>

                    <div class="col-md-8 text-center">
                        <span class="fs-2 fw-bold text-success">
                            تقارير المعلم
                        </span>
                    </div>

                </div>

                <!-- Alerts -->
                <div class="px-3 mt-2">

                    @if (Model.Reports.Any(x => x.Rating == RatingLevel.ضعيف))
                    {
                        <div class="alert alert-danger text-center">
                            ⚠ يوجد طلاب بتقييم ضعيف
                        </div>
                    }

                    @if (Model.Reports.Any(x => x.Behavior == BehaviorLevel.سيئ))
                    {
                        <div class="alert alert-warning text-center">
                            ⚠ يوجد مشاكل سلوكية
                        </div>
                    }

                </div>

                <!-- Table -->
                <div class="card-body text-center">

                    @if (!Model.Reports.Any())
                    {
                        <div class="alert alert-warning">
                            لا يوجد تقارير حتى الآن
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover table-bordered border-primary-subtle">

                            <thead>
                                <tr class="bg-dark text-white">
                                    <th>#</th>
                                    <th>المدرس</th>
                                    <th>المادة</th>
                                    <th>التقييم</th>
                                    <th>السلوك</th>
                                    <th>التاريخ</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var r in Model.Reports)
                                {
                                    cNo++;

                                    string ratingClass = r.Rating switch
                                    {
                                        RatingLevel.ممتاز => "bg-success-subtle",
                                        RatingLevel.جيد => "bg-info-subtle",
                                        RatingLevel.مقبول => "bg-warning-subtle",
                                        RatingLevel.ضعيف => "bg-danger-subtle",
                                        _ => ""
                                    };

                                    string behaviorClass = r.Behavior switch
                                    {
                                        BehaviorLevel.جيد => "text-success",
                                        BehaviorLevel.عادي => "text-warning",
                                        BehaviorLevel.سيئ => "text-danger fw-bold",
                                        _ => ""
                                    };

                                    <tr>
                                        <td>@cNo</td>
                                        <td>@r.TeacherName</td>
                                        <td>@r.Subject</td>

                                        <!-- Rating -->
                                        <td class="@ratingClass fw-bold">
                                            @r.Rating
                                        </td>

                                        <!-- Behavior -->
                                        <td class="@behaviorClass">
                                            @r.Behavior
                                        </td>

                                        <td>@r.ReportDate.ToShortDateString()</td>

                                        <!-- Actions -->
                                        <td>
                                            <button class="btn btn-outline-dark border-0"
                                                    onclick="editReport('@r.Id','@r.TeacherName','@r.Subject','@r.Rating','@r.Behavior','@r.Notes')"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#reportModal">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }

                </div>
            </div>
       </div>
       
   </div>
   
</div>

<!-- Modal -->
<partial name="_TeacherReportModal" model="Model" />

@section Scripts{
    <script>

        function editReport(id, teacherName, subject, rating, behavior, notes) {

            $('#reportId').val(id);
            $('#teacherName').val(teacherName);
            $('#subject').val(subject);

            $('#rating').val(parseInt(rating));
            $('#behavior').val(parseInt(behavior));

            $('#notes').val(notes);
        }

        function clearReportForm() {

            $('#reportId').val(0);
            $('#teacherName').val('');
            $('#subject').val('');
            $('#rating').val(1);
            $('#behavior').val(1);
            $('#notes').val('');
        }

    </script>
}
