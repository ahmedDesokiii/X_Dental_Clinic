@page
@using Dental.Areas.Identity.Pages.Account
@model LoginModel

@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div  class="text-center mb-1">
    <div class="card border-0 bg-transparent" >
        <div class="card-body">
            <span class="text-center fw-bold fs-1  pb-3" style="color:#415E72 !important ">
               @ViewData["Title"]
                <i class="bi bi-box-arrow-in-right pe-2 fs-1"></i>
            </span>
        </div>
    </div>
</div>

<section class="mt-0" id="loginfrm">
    <div class="container-fluid ">
        <div class="row d-flex justify-content-center align-items-center mt-1">
            <div class="col-md-4"></div>
            <div class="col-md-4 ">
                <div class="card shadow px-4 pt-5 pb-3 " style="border-radius:15px 30px;background: linear-gradient(115deg, #EAEFEF,#fff)">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <!-- UserName -->
                        <div class="input-group mb-3">

                            <span class="input-group-text border-start-0 fw-bold text-center text-white rounded-end-3" style="background:#415E72" id="inputGroup-sizing-default">&nbsp;&nbsp;&nbsp;&nbsp;اسم المستخدم&nbsp;&nbsp;&nbsp;&nbsp;</span>
                            <input asp-for="Input.UserName" required class="form-control text-center me-1 p-0" aria-required="true" placeholder="ادخل اسم المستخدم ..." type="text" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" style="border-top-left-radius : 20px ;border-left-width:3px;border-right-width:3px;" autofocus>
                        </div>

                  
                        <!-- Password -->
                        <div class="input-group mb-3">
                            <span class="input-group-text border-start-0 fw-bold text-center text-white rounded-end-3 px-3" style="background:#415E72" id="inputGroup-sizing-default">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;كلمة المرور&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp</span>
                            <input asp-for="Input.Password" required id="pass" class="form-control text-center me-1 p-0" placeholder="ادخل كلمة المرور صحيحة..." type="password" style="border-top-left-radius : 20px ;border-left-width:3px;border-right-width:3px;">
                            <br>
                        </div>

                        <div class="d-flex justify-content-between  align-items-center ">
                            <a class=" text-decoration-none link-primary" id="forgot-password" href="#" @* asp-area="Identity" asp-page="./ForgotPassword" *@>نسيت كلمة المرور</a>

                            <!-- Checkbox -->
                            <div class="checkbox my-0 py-0">
                                <label asp-for="Input.RememberMe" class="form-label">
                                    <input class="form-check-input mx-2" asp-for="Input.RememberMe" />
                                    تذكرني
                                </label>
                            </div>
                        </div>

                        <div class="text-center text-lg-start mt-2 pt-2">
                            <button id="login-submit" type="submit" data-mdb-button-init data-mdb-ripple-init class="btn fw-bold btn-lg w-100 send-btn"
                                    style="padding-left: 3rem; padding-right: 3rem">
                                تسجيل الدخول
                            </button>

                            <p class="small fw-bold text-center mt-2 pt-1 mb-0">
                                هل لديك حساب ؟ <a href="#" class="link-danger">تسجيل حساب جديد</a>
                            </p>
                            @*  <p class="small fw-bold text-center mt-2 pt-1 mb-0">
                            هل لديك حساب ؟ <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
                                              class="link-danger">تسجيل حساب جديد</a>
                        </p> *@
                        </div>
                    </form>
                    <div class="d-flex flex-row align-items-center justify-content-center mt-5 mb-0">
                        <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn border-0 btn-floating mx-1">
                            <i class="bi bi-google fs-4"></i>
                        </button>
                        <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn border-0 btn-floating mx-1">
                            <i class="bi bi-twitter fs-4"></i>
                        </button>
                        <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn border-0 btn-floating mx-1">
                            <i class="bi bi-youtube fs-4"></i>
                        </button>
                        <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn border-0 btn-floating mx-1">
                            <i class="bi bi-facebook fs-4"></i>
                        </button>
                        <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn border-0 btn-floating mx-1">
                            <i class="bi bi-whatsapp fs-4"></i>
                        </button>
                        <button type="button" data-mdb-button-init data-mdb-ripple-init class="btn border-0 btn-floating mx-1">
                            <i class="bi bi-twitter-x fs-4"></i>
                        </button>
                    </div>
            
                </div>
                </div>
            <div class="col-md-1"></div>
            <div class="col-md-3 justify-content-center mx-auto">
                @* <img src="~/images/dots/hero-image.png" /> *@
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Login.js"></script>
}

<style>
    .send-btn {
        background: linear-gradient(135deg, #25D366, #128C7E);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 8px 22px;
        transition: all .25s ease-in-out;
    }

        .send-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(0,0,0,.15);
            opacity: .95;
        }

        .send-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

</style>

