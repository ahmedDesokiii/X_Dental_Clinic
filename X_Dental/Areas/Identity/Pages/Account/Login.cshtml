@page
@using Dental.Areas.Identity.Pages.Account
@model LoginModel
@inject Dental.Core.Settings.IClinicSettingsService ClinicSettingsService
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "/Views/Shared/_AuthLayout.cshtml";   // 🔐 H1: من غير الـ sidebar
    var clinic = ClinicSettingsService.Get();
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "صباح الخير" : hour < 17 ? "نهارك سعيد" : "مساء الخير";
    // خطأ عام (اسم/كلمة سر غلط، حساب معلّق) — مش أخطاء الحقول الفاضية
    var hasError = ViewData.ModelState.TryGetValue(string.Empty, out var generalErrors) && generalErrors.Errors.Count > 0;
}

<div class="auth-shell">

    <!-- ═══════ لوحة الهوية ═══════ -->
    <aside class="auth-brand">
        <div class="auth-orbs" aria-hidden="true"><i></i><i></i><i></i></div>

        <div class="auth-brand-top">
            <div class="auth-logo">
                @if (!string.IsNullOrEmpty(clinic.LogoPath))
                {
                    <img src="@Url.Content("~" + clinic.LogoPath)" alt="" />
                }
                else
                {
                    <img src="~/icons/icon-192.png" alt="" />
                }
            </div>
            <div>
                <b>@clinic.DoctorName</b>
                <span>@clinic.ClinicName</span>
            </div>
        </div>

        <div class="auth-hero">
            <svg class="auth-tooth" viewBox="0 0 120 120" aria-hidden="true">
                <defs>
                    <linearGradient id="tg" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#ffffff" />
                        <stop offset="1" stop-color="#c7f2ea" />
                    </linearGradient>
                </defs>
                <path d="M60 26c-7-5-19-7-27 0s-8 21-4 31c3 8 7 13 8 24 1 9 3 17 9 17 5 0 6-10 9-18 2-5 3-7 5-7s3 2 5 7c3 8 4 18 9 18 6 0 8-8 9-17 1-11 5-16 8-24 4-10 4-24-4-31s-20-5-27 0z" fill="url(#tg)" />
                <circle cx="80" cy="40" r="5" fill="#5eead4" />
            </svg>
            <h1>إدارة عيادتك<br /><span>في مكان واحد</span></h1>
            <p>المرضى، الجلسات، الـ Dental Chart، المدفوعات، المواعيد وتذكيرات واتساب — من الكمبيوتر أو الموبايل.</p>
        </div>

        <ul class="auth-features">
            <li><i class="bi bi-shield-lock"></i><span>صلاحيات لكل موظف</span></li>
            <li><i class="bi bi-whatsapp"></i><span>تذكير المواعيد بضغطة</span></li>
            <li><i class="bi bi-phone"></i><span>يتثبّت كتطبيق على الموبايل</span></li>
        </ul>

        <div class="auth-brand-foot">
            @if (!string.IsNullOrWhiteSpace(clinic.Phone))
            {
                <span><i class="bi bi-telephone"></i> <bdi dir="ltr">@clinic.Phone</bdi></span>
            }
            @if (!string.IsNullOrWhiteSpace(clinic.Address))
            {
                <span><i class="bi bi-geo-alt"></i> @clinic.Address</span>
            }
        </div>
    </aside>

    <!-- ═══════ الفورم ═══════ -->
    <main class="auth-main">
        <div class="auth-card">
            <div class="auth-mobile-brand">
                <img src="@(string.IsNullOrEmpty(clinic.LogoPath) ? Url.Content("~/icons/icon-192.png") : Url.Content("~" + clinic.LogoPath))" alt="" />
                <b>@clinic.DoctorName</b>
            </div>

            <div class="auth-head">
                <span class="auth-greet">@greeting 👋</span>
                <h2>سجّل دخولك</h2>
                <p>ادخل بيانات حسابك عشان تكمّل</p>
            </div>

            <form id="account" method="post" novalidate class="@(hasError ? "has-error" : "")">
                @if (hasError)
                {
                    <div class="auth-alert" role="alert">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <label class="auth-field">
                    <span class="auth-label">اسم المستخدم</span>
                    <span class="auth-input">
                        <i class="bi bi-person"></i>
                        <input asp-for="Input.UserName" dir="ltr" autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus placeholder="username" />
                    </span>
                    <span asp-validation-for="Input.UserName" class="auth-err"></span>
                </label>

                <label class="auth-field">
                    <span class="auth-label">كلمة السر</span>
                    <span class="auth-input">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Input.Password" id="pass" type="password" dir="ltr" autocomplete="current-password" required placeholder="••••••••" />
                        <button type="button" class="auth-eye" id="togglePass" tabindex="-1" aria-label="إظهار كلمة السر"><i class="bi bi-eye"></i></button>
                    </span>
                    <span class="auth-caps" id="capsWarn" hidden><i class="bi bi-capslock-fill"></i> زرار Caps Lock شغال</span>
                    <span asp-validation-for="Input.Password" class="auth-err"></span>
                </label>

                <div class="auth-row">
                    <label class="auth-check">
                        <input asp-for="Input.RememberMe" />
                        <span></span>
                        فاكرني على الجهاز ده
                    </label>
                    <button type="button" class="auth-link" id="forgotBtn">نسيت كلمة السر؟</button>
                </div>

                <button type="submit" class="auth-submit" id="loginBtn">
                    <span class="txt">دخول</span>
                    <i class="bi bi-arrow-left"></i>
                    <span class="spin" aria-hidden="true"></span>
                </button>
            </form>

            <button type="button" class="auth-install" id="pwaInstallBtn" hidden>
                <i class="bi bi-download"></i> ثبّت البرنامج كتطبيق على الجهاز ده
            </button>

            <p class="auth-foot">© @DateTime.Now.Year @clinic.ClinicName</p>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const pass = document.getElementById('pass');
            const eye = document.getElementById('togglePass');
            eye.addEventListener('click', () => {
                const show = pass.type === 'password';
                pass.type = show ? 'text' : 'password';
                eye.innerHTML = `<i class="bi ${show ? 'bi-eye-slash' : 'bi-eye'}"></i>`;
                pass.focus();
            });

            const caps = document.getElementById('capsWarn');
            ['keydown', 'keyup'].forEach(ev => pass.addEventListener(ev, e => {
                if (e.getModifierState) caps.hidden = !e.getModifierState('CapsLock');
            }));

            document.getElementById('forgotBtn').addEventListener('click', () => {
                const box = document.querySelector('.auth-forgot');
                if (box) { box.remove(); return; }
                const d = document.createElement('div');
                d.className = 'auth-forgot';
                d.innerHTML = '<i class="bi bi-info-circle"></i><span>كلمة السر بيغيّرها <b>مدير النظام</b> من شاشة المستخدمين ← كلمة السر. كلّمه وهيبعتلك واحدة جديدة.</span>';
                document.querySelector('.auth-row').after(d);
            });

            const form = document.getElementById('account');
            form.addEventListener('submit', e => {
                if (window.jQuery && $(form).valid && !$(form).valid()) return;
                const b = document.getElementById('loginBtn');
                b.classList.add('loading'); b.disabled = true;
            });

            // لو فيه خطأ: هزّة صغيرة + التركيز على كلمة السر
            if (form.classList.contains('has-error')) {
                document.querySelector('.auth-card').classList.add('shake');
                pass.focus();
            }
        })();
    </script>
}
