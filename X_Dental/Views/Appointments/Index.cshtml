@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --sc-teal-900: #0a4d4f;
        --sc-teal-700: #0d7377;
        --sc-teal-600: #0f9b8e;
        --sc-teal-500: #14b8a6;
        --sc-teal-100: #c7f2ea;
        --sc-sky-50: #eafbfc;
        --sc-sky-100: #dcf5f7;
        --sc-coral-300: #f6c6bc;
        --sc-ink-900: #0b2e30;
        --sc-ink-600: #4b6b6c;
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-light: #f0fdfa;
        --radius-lg: 18px;
        --radius-md: 12px;
        --shadow-soft: 0 1px 3px rgba(15, 23, 42, 0.06);
        --shadow-hover: 0 10px 26px rgba(10, 77, 79, 0.12);
        --shadow-card: 0 20px 50px rgba(10, 77, 79, .08);
    }

    body {
        background: radial-gradient(circle at 6% 4%, var(--sc-teal-100) 0%, transparent 38%), radial-gradient(circle at 97% 92%, var(--sc-coral-300) 0%, transparent 26%), var(--sc-sky-50);
    }

    /* ── Hero ── */
    .calendar-hero {
        background: linear-gradient(135deg, var(--sc-teal-700), var(--sc-teal-500));
        background-size: 200% 200%;
        animation: heroGradientShift 8s ease-in-out infinite;
        border-radius: var(--radius-lg);
        padding: 22px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 14px 34px rgba(13, 115, 119, .28);
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 16px;
        position: relative;
        overflow: hidden;
    }

    @@keyframes heroGradientShift {
        0%, 100% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }
    }

    .calendar-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 92% -20%, rgba(255,255,255,.32), transparent 55%);
        pointer-events: none;
    }

    .calendar-hero::before {
        content: '';
        position: absolute;
        top: -60%;
        left: -30%;
        width: 55%;
        height: 220%;
        background: linear-gradient(105deg, transparent, rgba(255,255,255,.14), transparent);
        transform: rotate(12deg);
        animation: heroShineCal 6s ease-in-out infinite;
        pointer-events: none;
    }

    @@keyframes heroShineCal {
        0%, 100% {
            left: -40%;
        }

        50% {
            left: 110%;
        }
    }

    .calendar-hero .hero-content {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 1;
    }

    .calendar-hero .hero-icon {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,.18);
        color: #fff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.15);
        animation: heroIconFloat 4s ease-in-out infinite;
    }

    @@keyframes heroIconFloat {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }

        50% {
            transform: translateY(-4px) rotate(-4deg);
        }
    }

    .calendar-hero h1 {
        font-size: 1.25rem;
        font-weight: 800;
        margin: 0;
        color: #fff;
    }

    .calendar-hero p {
        font-size: 0.85rem;
        margin: 4px 0 0;
        color: rgba(255,255,255,.9);
        font-weight: 600;
    }

    .btn-hero-new {
        background: #fff;
        color: var(--sc-teal-700);
        border: none;
        padding: 11px 22px;
        border-radius: 12px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(10, 40, 42, .18);
        transition: all .2s ease;
        font-size: 0.9rem;
        position: relative;
        z-index: 1;
        cursor: pointer;
        overflow: hidden;
        animation: heroBtnPulse 3s ease-in-out infinite;
    }

    @@keyframes heroBtnPulse {
        0%, 100% {
            box-shadow: 0 8px 20px rgba(10, 40, 42, .18);
        }

        50% {
            box-shadow: 0 8px 26px rgba(10, 40, 42, .3), 0 0 0 4px rgba(255,255,255,.15);
        }
    }

    .btn-hero-new:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 26px rgba(10, 40, 42, .24);
        color: var(--sc-teal-700);
    }

    .btn-hero-new i {
        transition: transform .3s ease;
    }

    .btn-hero-new:hover i {
        transform: rotate(90deg);
    }

    /* ── Stats Bar ── */
    .stats-bar {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-card-glass {
        background: rgba(255,255,255,.78);
        backdrop-filter: blur(14px);
        border-radius: 16px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: var(--shadow-soft);
        transition: all .25s ease;
        animation: statCardIn .5s cubic-bezier(.2,.8,.3,1) backwards;
    }

        .stat-card-glass:nth-child(1) {
            animation-delay: .03s;
        }

        .stat-card-glass:nth-child(2) {
            animation-delay: .06s;
        }

        .stat-card-glass:nth-child(3) {
            animation-delay: .09s;
        }

        .stat-card-glass:nth-child(4) {
            animation-delay: .12s;
        }

        .stat-card-glass:nth-child(5) {
            animation-delay: .15s;
        }

        .stat-card-glass:nth-child(6) {
            animation-delay: .18s;
        }

        .stat-card-glass:nth-child(7) {
            animation-delay: .21s;
        }

        .stat-card-glass:nth-child(8) {
            animation-delay: .24s;
        }

    @@keyframes statCardIn {
        from {
            opacity: 0;
            transform: translateY(14px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .stat-card-glass:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
    }

        .stat-card-glass:hover .stat-icon-box {
            transform: scale(1.12) rotate(-6deg);
        }

    .stat-icon-box {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
        transition: transform .3s cubic-bezier(.2,1.4,.4,1);
    }

        .stat-icon-box.teal {
            background: #f0fdfa;
            color: #0f766e;
        }

        .stat-icon-box.blue {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .stat-icon-box.green {
            background: #f0fdf4;
            color: #166534;
        }

        .stat-icon-box.orange {
            background: #fffbeb;
            color: #b45309;
        }

        .stat-icon-box.cyan {
            background: #ecfeff;
            color: #0e7490;
        }

        .stat-icon-box.purple {
            background: #f5f3ff;
            color: #6d28d9;
        }

        .stat-icon-box.slate {
            background: #f1f5f9;
            color: #334155;
        }

        .stat-icon-box.red {
            background: #fef2f2;
            color: #b91c1c;
        }

    .stat-value-lg {
        display: block;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--sc-ink-900);
        line-height: 1.1;
    }

    .stat-label-lg {
        font-size: 0.78rem;
        color: var(--sc-ink-600);
        font-weight: 600;
    }

    /* ── Calendar Shell ── */
    .calendar-shell {
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(16px);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.6);
        padding: 24px;
        animation: fadeInUpCal .6s ease forwards;
        opacity: 0;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInUpCal {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .cal-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--sc-ink-900);
        margin: 0;
        transition: opacity .2s ease;
    }

    .cal-nav-group {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cal-nav {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1.5px solid var(--sc-sky-100);
        background: #fff;
        color: var(--sc-ink-600);
        cursor: pointer;
        transition: all .2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

        .cal-nav:hover {
            background: var(--brand);
            color: #fff;
            border-color: var(--brand);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13,148,136,0.25);
        }

        .cal-nav:active {
            transform: translateY(0) scale(.94);
        }

    .cal-today-btn {
        padding: 8px 16px;
        border-radius: 10px;
        border: 1.5px solid var(--sc-sky-100);
        background: #fff;
        color: var(--sc-ink-600);
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .2s ease;
    }

        .cal-today-btn:hover {
            background: var(--brand-light);
            border-color: var(--sc-teal-500);
            color: var(--brand-dark);
        }

    /* ── Week Grid ── */
    .week-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 12px;
    }

    .day-column {
        background: rgba(255,255,255,.6);
        border-radius: 16px;
        border: 1px solid rgba(226,232,240,0.5);
        min-height: 200px;
        overflow: hidden;
        transition: all 0.3s ease;
        animation: dayFadeIn 0.5s ease forwards;
        opacity: 0;
    }

        .day-column:hover {
            box-shadow: 0 8px 24px rgba(10, 77, 79, 0.08);
            border-color: var(--sc-teal-500);
            transform: translateY(-2px);
        }

        .day-column.is-today {
            border-color: var(--sc-teal-500);
            box-shadow: 0 0 0 3px rgba(13,148,136,0.15), 0 8px 24px rgba(13,148,136,0.1);
            background: rgba(255,255,255,.9);
        }

    @@keyframes dayFadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .day-column:nth-child(1) {
        animation-delay: .02s;
    }

    .day-column:nth-child(2) {
        animation-delay: .04s;
    }

    .day-column:nth-child(3) {
        animation-delay: .06s;
    }

    .day-column:nth-child(4) {
        animation-delay: .08s;
    }

    .day-column:nth-child(5) {
        animation-delay: .10s;
    }

    .day-column:nth-child(6) {
        animation-delay: .12s;
    }

    .day-column:nth-child(7) {
        animation-delay: .14s;
    }

    .day-header {
        padding: 14px 10px;
        text-align: center;
        border-bottom: 1px solid var(--sc-sky-100);
        background: linear-gradient(135deg, #fff 0%, #A6F1E0 100%);
        position: relative;
    }

    .day-name {
        font-size: .75rem;
        font-weight: 800;
        color: var(--sc-ink-600);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .day-number {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--sc-ink-900);
        margin-top: 4px;
        transition: color .2s ease;
    }

    .day-column.is-today .day-number {
        color: var(--sc-teal-600);
    }

    .today-indicator {
        position: absolute;
        top: 8px;
        left: 8px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--sc-teal-500);
        box-shadow: 0 0 0 3px rgba(13,148,136,0.2);
        animation: pulseToday 2s infinite;
    }

    @@keyframes pulseToday {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.3);
            opacity: 0.7;
        }
    }

    .day-slots {
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 60px;
    }

    /* ── Patient Slots ── */
    .patient-slot {
        background: #fff;
        border-radius: 12px;
        padding: 12px;
        border: 1px solid rgba(226,232,240,0.8);
        cursor: pointer;
        transition: all .25s ease;
        border-inline-start: 4px solid var(--sc-teal-500);
        animation: slotSlideIn 0.4s ease forwards;
        opacity: 0;
        transform: translateX(10px);
    }

        .patient-slot:hover {
            transform: translateX(-4px) translateY(-2px);
            box-shadow: 0 8px 20px rgba(10, 77, 79, 0.12);
            border-color: var(--sc-teal-500);
        }

        .patient-slot:active {
            transform: translateX(-2px) translateY(0) scale(.98);
        }

    @@keyframes slotSlideIn {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .slot-time {
        font-size: .75rem;
        font-weight: 800;
        color: var(--sc-teal-600);
        background: var(--brand-light);
        padding: 3px 10px;
        border-radius: 8px;
        display: inline-block;
        margin-bottom: 6px;
    }

    .slot-name {
        font-weight: 800;
        color: var(--sc-ink-900);
        font-size: .9rem;
        margin-bottom: 4px;
    }

    .slot-phone {
        font-size: .8rem;
        color: var(--sc-ink-600);
        display: flex;
        gap: 4px;
        font-family: 'Segoe UI', monospace;
        direction: ltr;
        justify-content: flex-end;
        align-items: center;
    }

    .slot-status {
        margin-top: 6px;
        font-size: .72rem;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 8px;
        display: inline-block;
    }

    .status-scheduled {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-confirmed {
        background: #cffafe;
        color: #0e7490;
    }

    .status-checkedin {
        background: #d1fae5;
        color: #047857;
    }

    .status-inprogress {
        background: #fef3c7;
        color: #92400e;
    }

    .status-completed {
        background: #e2e8f0;
        color: #334155;
    }

    .status-cancelled {
        background: #fee2e2;
        color: #b91c1c;
        text-decoration: line-through;
        opacity: 0.7;
    }

    .status-noshow {
        background: #fef2f2;
        color: #991b1b;
    }

    .empty-day {
        text-align: center;
        color: #94a3b8;
        padding: 24px 0;
        font-size: .85rem;
        font-weight: 600;
    }

        .empty-day i {
            display: block;
            font-size: 1.5rem;
            margin-bottom: 8px;
            color: var(--sc-sky-100);
        }

    /* ── Loading Skeleton ── */
    .skeleton-day {
        background: rgba(255,255,255,.6);
        border-radius: 16px;
        border: 1px solid rgba(226,232,240,0.5);
        min-height: 320px;
        overflow: hidden;
        animation: skeletonPulse 1.5s infinite;
    }

    @@keyframes skeletonPulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.6;
        }
    }

    .skeleton-header {
        height: 60px;
        background: linear-gradient(135deg, var(--sc-sky-50), transparent);
        border-bottom: 1px solid var(--sc-sky-100);
    }

    .skeleton-slots {
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .skeleton-slot {
        height: 80px;
        background: var(--sc-sky-50);
        border-radius: 12px;
    }

    /* ── Modals ── */
    .custom-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .custom-modal.show {
            display: flex;
        }

    .modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15,23,42,0.45);
        backdrop-filter: blur(4px);
    }

    .modal-box {
        position: relative;
        z-index: 1;
        width: 90%;
        max-width: 480px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.2);
        animation: modalSlide 0.25s ease;
        overflow: hidden;
    }

    @@keyframes modalSlide {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px;
        background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
        color: #fff;
    }

        .modal-head h5 {
            margin: 0;
            font-weight: 800;
            font-size: 1.1rem;
        }

    .modal-body {
        padding: 24px;
    }

    .modal-foot {
        padding: 0 24px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-modal {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-modal:hover {
            transform: translateY(-1px);
        }

        .btn-modal:active {
            transform: translateY(0) scale(.97);
        }

    .btn-modal-cancel {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-modal-cancel:hover {
            background: #e2e8f0;
        }

    .btn-modal-save {
        background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
        color: #fff;
    }

        .btn-modal-save:hover {
            box-shadow: 0 6px 16px rgba(13,148,136,0.3);
        }

    .btn-modal-danger {
        background: #fee2e2;
        color: #b91c1c;
    }

        .btn-modal-danger:hover {
            background: #fecaca;
        }

    .btn-modal-info {
        background: #dbeafe;
        color: #1e40af;
    }

        .btn-modal-info:hover {
            background: #bfdbfe;
        }

    /* ── Responsive ── */
    @@media (max-width: 1200px) {
        .week-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .stats-bar {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .week-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stats-bar {
            grid-template-columns: repeat(2, 1fr);
        }

        .calendar-hero {
            flex-direction: column;
            text-align: center;
        }

            .calendar-hero .hero-content {
                flex-direction: column;
            }

        .calendar-header {
            justify-content: center;
        }
    }

    @@media (max-width: 480px) {
        .week-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- 🔷 Hero -->
<div class="calendar-hero" dir="ltr">
    <div class="hero-content">
        <div class="hero-icon"><i class="bi bi-calendar2-week-fill"></i></div>
        <div>
            <h1>Appointment Schedule</h1>
            <p>View, book, and manage patient appointments on a weekly basis.</p>
        </div>
    </div>
    @* ⭐ بيفتح المودال المشترك من غير patientId → يظهر البحث بالاسم/الكود/الموبايل *@
    <button class="btn-hero-new" onclick="AppointmentModal.open()">
        <i class="bi bi-plus-lg"></i> New Appointment
    </button>
</div>

<!-- 🔷 Stats -->
<div class="stats-bar" id="statsBar" dir="ltr">
    <div class="stat-card">
        <div class="stat-icon-box teal"><i class="bi bi-calendar-check"></i></div>
        <div>
            <span class="stat-value-lg" id="statTotalWeek">0</span>
            <span class="stat-label-lg d-block">This Week</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box blue"><i class="bi bi-calendar-day"></i></div>
        <div>
            <span class="stat-value-lg" id="statToday">0</span>
            <span class="stat-label-lg d-block">Today</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box orange"><i class="bi bi-clock"></i></div>
        <div>
            <span class="stat-value-lg" id="statPending">0</span>
            <span class="stat-label-lg d-block">Pending</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box green"><i class="bi bi-check-circle"></i></div>
        <div>
            <span class="stat-value-lg" id="statConfirmed">0</span>
            <span class="stat-label-lg d-block">Confirmed</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box cyan"><i class="bi bi-person-check"></i></div>
        <div>
            <span class="stat-value-lg" id="statCheckedIn">0</span>
            <span class="stat-label-lg d-block">Checked In</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box purple"><i class="bi bi-activity"></i></div>
        <div>
            <span class="stat-value-lg" id="statInProgress">0</span>
            <span class="stat-label-lg d-block">In Progress</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box slate"><i class="bi bi-check2-all"></i></div>
        <div>
            <span class="stat-value-lg" id="statCompleted">0</span>
            <span class="stat-label-lg d-block">Completed</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-box red"><i class="bi bi-x-circle"></i></div>
        <div>
            <span class="stat-value-lg" id="statCancelled">0</span>
            <span class="stat-label-lg d-block">Cancelled / No-Show</span>
        </div>
    </div>
</div>

<!-- 🔷 Calendar -->
<div class="calendar-shell" dir="ltr">
    <div class="calendar-header">
        <div class="cal-nav-group">
            <button class="cal-nav" onclick="shiftWeek(-1)" title="Previous Week"><i class="bi bi-chevron-left"></i></button>
            <button class="cal-today-btn" onclick="goToToday()">Today</button>
            <button class="cal-nav" onclick="shiftWeek(1)" title="Next Week"><i class="bi bi-chevron-right"></i></button>
        </div>
        <h3 class="cal-title" id="weekRange">Loading...</h3>
    </div>
    <div class="week-grid" id="weekGrid">
        <!-- Loading Skeleton -->
        @for (int i = 1; i <= 7; i++)
        {
            <div class="skeleton-day">
                <div class="skeleton-header"></div>
                <div class="skeleton-slots">
                    <div class="skeleton-slot"></div>
                    <div class="skeleton-slot"></div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 🔷 Details Modal -->
<div class="custom-modal" id="detailsModal">
    <div class="modal-overlay" onclick="closeDetailsModal()"></div>
    <div class="modal-box">
        <div class="modal-head">
            <h5><i class="bi bi-calendar-check me-2"></i> Appointment Details</h5>
            <button type="button" class="btn-close btn-close-white" onclick="closeDetailsModal()"></button>
        </div>
        <div class="modal-body" id="detailsBody"></div>
        <div class="modal-foot" id="detailsActions"></div>
    </div>
</div>

@* ⭐ المودال المشترك: بحث عن المريض + مواعيد نفس اليوم *@
@await Html.PartialAsync("_AppointmentModal")

@section Scripts {
    <script>
        let currentWeekStart = getStartOfWeek(new Date());
        let selectedAppointmentId = null;

        function getStartOfWeek(date) {
            const d = new Date(date);
            const day = d.getDay();
            d.setDate(d.getDate() - day);
            d.setHours(0, 0, 0, 0);
            return d;
        }

        function formatDateOnly(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');

            return `${y}-${m}-${d}`;
        }

        function goToToday() {
            currentWeekStart = getStartOfWeek(new Date());
            loadWeek();
        }

        function shiftWeek(dir) {
            currentWeekStart.setDate(currentWeekStart.getDate() + (dir * 7));
            loadWeek();
        }

        const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

        async function loadWeek() {
            const start = new Date(currentWeekStart);
            const end = new Date(currentWeekStart);
            end.setDate(end.getDate() + 7);

            const rangeEl = document.getElementById('weekRange');
            rangeEl.style.opacity = '0';
            setTimeout(() => {
                rangeEl.textContent =
                    `${start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })} — ${new Date(end - 1).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}`;
                rangeEl.style.opacity = '1';
            }, 120);

            let events = [];
            try {
                const res = await fetch(`/Appointments/GetEvents?start=${start.toISOString()}&end=${end.toISOString()}`);
                const result = await res.json();
                if (result.success) events = result.data;
            } catch (err) {
                console.error('Failed to load appointments', err);
            }

            renderWeek(start, events);
            updateStats(events);
        }

        function updateStats(events) {
            const today = formatDateOnly(new Date());
            const totalWeek = events.length;
            const confirmed = events.filter(e => e.status === 2).length;
            const pending = events.filter(e => e.status === 1).length;
            const todayCount = events.filter(e => formatDateOnly(new Date(e.start)) === today).length;

            // ⭐ More KPIs — derived from the status badge class already returned by the server
            const checkedIn = events.filter(e => e.statusColorClass === 'status-checkedin').length;
            const inProgress = events.filter(e => e.statusColorClass === 'status-inprogress').length;
            const completed = events.filter(e => e.statusColorClass === 'status-completed').length;
            const cancelled = events.filter(e => e.statusColorClass === 'status-cancelled' || e.statusColorClass === 'status-noshow').length;

            animateCount(document.getElementById('statTotalWeek'), totalWeek);
            animateCount(document.getElementById('statConfirmed'), confirmed);
            animateCount(document.getElementById('statPending'), pending);
            animateCount(document.getElementById('statToday'), todayCount);
            animateCount(document.getElementById('statCheckedIn'), checkedIn);
            animateCount(document.getElementById('statInProgress'), inProgress);
            animateCount(document.getElementById('statCompleted'), completed);
            animateCount(document.getElementById('statCancelled'), cancelled);
        }

        function animateCount(el, target) {
            if (!el) return;
            const start = parseInt(el.textContent) || 0;
            const diff = target - start;
            if (diff === 0) return;
            const duration = 600;
            const startTime = performance.now();

            function step(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeProgress = 1 - Math.pow(1 - progress, 3); // ease-out cubic
                el.textContent = Math.floor(start + (diff * easeProgress));
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        function renderWeek(weekStart, events) {
            const grid = document.getElementById('weekGrid');
            const today = formatDateOnly(new Date());
            grid.innerHTML = '';

            for (let i = 0; i < 7; i++) {
                const day = new Date(weekStart);
                day.setDate(day.getDate() + i);
                const dayKey = formatDateOnly(day);
                const dayEvents = events.filter(e => formatDateOnly(new Date(e.start)) === dayKey)
                    .sort((a, b) => new Date(a.start) - new Date(b.start));

                const col = document.createElement('div');
                col.className = 'day-column' + (dayKey === today ? ' is-today' : '');

                const isToday = dayKey === today;

                col.innerHTML = `
                            <div class="day-header">
                                ${isToday ? '<div class="today-indicator"></div>' : ''}
                                <div class="day-name">${dayNames[day.getDay()]}</div>
                                <div class="day-number">${day.getDate()}</div>
                            </div>
                            <div class="day-slots">
                                ${dayEvents.length === 0 ? '<div class="empty-day"><i class="bi bi-calendar-x"></i>No appointments</div>' : ''}
                                        ${dayEvents.map((e, idx) => `
                                            <div class="patient-slot" style="animation-delay: ${idx * 0.05}s" onclick="openDetailsModal(${e.id})">
                                                <div class="slot-name">${e.patientName}</div>
                                                <div class="slot-phone"><i class="bi bi-telephone-fill"></i> ${e.patientMobile}</div>
                                                <span class="slot-status ${e.statusColorClass}">${e.statusText}</span>
                                            </div>
                                        `).join('')}
                            </div>`;
                grid.appendChild(col);
            }
        }

        // ── Details Modal ──
        async function openDetailsModal(id) {
            selectedAppointmentId = id;
            const res = await fetch(`/Appointments/GetById?id=${id}`);
            const result = await res.json();
            if (!result.success) {
                Swal.fire({ title: 'Error', text: result.message, icon: 'error' });
                return;
            }
            const a = result.data;

            document.getElementById('detailsBody').innerHTML = `
                    <div class="mb-2"><strong style="font-size:1.1rem; color:var(--sc-ink-900);">${a.patientName}</strong> <span class="slot-status ${a.statusColorClass}">${a.statusText}</span></div>
                    <div class="mb-2" style="color:var(--sc-ink-600); font-size:.85rem;"><i class="bi bi-telephone"></i> ${a.patientMobile}</div>
                    <div class="mb-2" style="color:var(--sc-ink-600); font-size:.85rem;"><i class="bi bi-calendar3"></i> ${new Date(a.start).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
                    ${a.reason ? `<div class="mb-2" style="color:var(--sc-ink-900);"><strong>Reason:</strong> ${a.reason}</div>` : ''}
                    ${a.notes ? `<div class="mb-2" style="color:var(--sc-ink-600);"><strong>Additional Notes:</strong> ${a.notes}</div>` : ''}
                `;

            const actions = [];
            if (a.status === 1) {
                actions.push(`<button class="btn-modal btn-modal-info" onclick="doAction('Confirm')">Confirm</button>`);
            }
            if (a.status === 1 || a.status === 2) {
                actions.push(`<button class="btn-modal btn-modal-save" onclick="doAction('CheckIn')">Check In</button>`);
                actions.push(`<button class="btn-modal btn-modal-danger" onclick="doAction('Cancel')">Cancel</button>`);
            }
            if (a.status === 3 || a.status === 4) {
                actions.push(`<button class="btn-modal btn-modal-save" onclick="convertToVisit()">Start Visit</button>`);
            }
            actions.push(`<button class="btn-modal btn-modal-cancel" onclick="closeDetailsModal()">Close</button>`);

            document.getElementById('detailsActions').innerHTML = actions.join('');
            document.getElementById('detailsModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeDetailsModal() {
            document.getElementById('detailsModal').classList.remove('show');
            document.body.style.overflow = '';
        }

        async function doAction(action) {
            try {
                const res = await fetch(`/Appointments/${action}?id=${selectedAppointmentId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    closeDetailsModal();
                    Swal.fire({ title: 'Done!', text: result.message, icon: 'success', confirmButtonColor: '#14b8a6', timer: 1500, showConfirmButton: false });
                    loadWeek();
                } else {
                    Swal.fire({ title: 'Action Failed', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'Error', text: 'Server connection failed', icon: 'error' });
            }
        }

        async function convertToVisit() {
            try {
                const res = await fetch(`/Appointments/ConvertToVisit?id=${selectedAppointmentId}&category=1`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    window.location.href = `/Clinical/Session?patientId=${result.patientId}&visitId=${result.visitId}`;
                } else {
                    Swal.fire({ title: 'Action Failed', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'Error', text: 'Server connection failed', icon: 'error' });
            }
        }

        // ⭐ المودال المشترك بينادي دي بعد نجاح الحجز → نعيد تحميل الأسبوع والـ KPIs
        window.onAppointmentCreated = function() {
            loadWeek();
        };

        // ── Keyboard Shortcuts ──
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                closeDetailsModal();
            }
        });

        document.addEventListener('DOMContentLoaded', loadWeek);
    </script>
}
