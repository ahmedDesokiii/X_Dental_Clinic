@using Dental.Modules.Diagnosis.DTOs
@using static Dental.Constants.EnumHelper
@model List<DiagnosisListDto>
@{
    ViewData["Title"] = "Diagnosis Catalog";
}
@section Styles {
    <style>
        :root {
            --sc-teal-700: #0d7377;
            --sc-teal-600: #0f9b8e;
            --sc-teal-500: #14b8a6;
            --sc-sky-50: #eafbfc;
            --sc-sky-100: #dcf5f7;
            --sc-ink-900: #0b2e30;
            --sc-ink-600: #4b6b6c;
            --sc-ink-400: #94a3b8;
        }

        body {
            background: radial-gradient(circle at 6% 4%, var(--sc-sky-100) 0%, transparent 38%), var(--sc-sky-50);
        }

        @@keyframes diagFadeUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes diagRowIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes diagShine {
            0%, 100% {
                right: -30%;
            }

            50% {
                right: 105%;
            }
        }

        @@keyframes diagChipPop {
            0% {
                transform: scale(.88);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes diagPulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(255,255,255,.25);
            }

            50% {
                box-shadow: 0 0 0 6px rgba(255,255,255,0);
            }
        }

        .diag-hero {
            background: linear-gradient(135deg, var(--sc-teal-700), var(--sc-teal-500));
            border-radius: 18px;
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 14px 34px rgba(13,115,119,.28);
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 16px;
            position: relative;
            overflow: hidden;
            animation: diagFadeUp .5s ease;
        }

            .diag-hero::before {
                content: '';
                position: absolute;
                top: -60%;
                right: -30%;
                width: 45%;
                height: 220%;
                background: linear-gradient(105deg, transparent, rgba(255,255,255,.16), transparent);
                transform: rotate(12deg);
                animation: diagShine 6s ease-in-out infinite;
                pointer-events: none;
            }

            .diag-hero .hero-title {
                display: flex;
                align-items: center;
                gap: 16px;
                position: relative;
                z-index: 1;
            }

            .diag-hero .hero-icon {
                width: 52px;
                height: 52px;
                background: rgba(255,255,255,.18);
                color: #fff;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
                flex-shrink: 0;
            }

            .diag-hero h1 {
                font-size: 1.25rem;
                font-weight: 800;
                margin: 0;
                color: #fff;
            }

            .diag-hero p {
                font-size: .85rem;
                margin: 2px 0 0;
                color: rgba(255,255,255,.9);
                font-weight: 600;
            }

        .btn-hero-light {
            background: #fff;
            color: var(--sc-teal-700);
            border: none;
            padding: 11px 22px;
            border-radius: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all .2s ease;
            position: relative;
            z-index: 1;
            animation: diagPulse 3s ease-in-out infinite;
        }

            .btn-hero-light:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 18px rgba(10,40,42,.24);
            }

        .diag-card {
            background: rgba(255,255,255,.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(10,77,79,.08);
            padding: 22px;
            animation: diagFadeUp .55s .05s ease backwards;
        }

        .diag-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            gap: 12px;
            flex-wrap: wrap;
        }

        .diag-search {
            flex: 1;
            max-width: 320px;
            position: relative;
        }

            .diag-search input {
                width: 100%;
                padding: 10px 40px 10px 14px;
                border-radius: 10px;
                border: 1.5px solid var(--sc-sky-100);
                font-size: .9rem;
                transition: all .2s;
            }

                .diag-search input:focus {
                    outline: none;
                    border-color: var(--sc-teal-500);
                    box-shadow: 0 0 0 3px rgba(20,184,166,.12);
                }

            .diag-search i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--sc-ink-600);
            }

        .diag-filter-chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .diag-chip {
            padding: 7px 14px;
            border-radius: 999px;
            border: 1px solid var(--sc-sky-100);
            background: #fff;
            font-weight: 700;
            font-size: .78rem;
            color: var(--sc-ink-600);
            cursor: pointer;
            transition: all .2s;
        }

            .diag-chip:hover {
                border-color: var(--sc-teal-500);
                color: var(--sc-teal-700);
            }

            .diag-chip.active {
                background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
                color: #fff;
                border-color: transparent;
                box-shadow: 0 4px 12px rgba(13,148,136,.3);
                animation: diagChipPop .2s ease;
            }

        .diag-count {
            font-size: .8rem;
            color: var(--sc-ink-600);
            font-weight: 700;
            margin-bottom: 12px;
        }

        table.diag-table {
            width: 100%;
            border-collapse: collapse;
        }

            table.diag-table th {
                text-align: left;
                font-size: .74rem;
                text-transform: uppercase;
                letter-spacing: .3px;
                color: var(--sc-ink-600);
                font-weight: 800;
                padding: 10px 12px;
                border-bottom: 2px solid var(--sc-sky-100);
                cursor: pointer;
                user-select: none;
                white-space: nowrap;
            }

                table.diag-table th:hover {
                    color: var(--sc-teal-700);
                }

                table.diag-table th .sort-arrow {
                    font-size: .68rem;
                    opacity: .4;
                    margin-left: 4px;
                }

                table.diag-table th.sorted .sort-arrow {
                    opacity: 1;
                    color: var(--sc-teal-600);
                }

            table.diag-table td {
                padding: 12px;
                font-size: .87rem;
                color: var(--sc-ink-900);
                border-bottom: 1px solid var(--sc-sky-100);
                vertical-align: middle;
            }

            table.diag-table tbody tr {
                animation: diagRowIn .3s ease backwards;
                transition: background .15s;
            }

                table.diag-table tbody tr:hover td {
                    background: var(--sc-sky-50);
                }

        .code-badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: .75rem;
            background: var(--sc-sky-100);
            color: var(--sc-teal-700);
            padding: 3px 10px;
            border-radius: 999px;
            font-weight: 700;
        }

        .diag-name-main {
            font-weight: 700;
        }

        .diag-name-sub {
            font-size: .76rem;
            color: var(--sc-ink-600);
            margin-top: 1px;
        }

        .price-cell {
            font-weight: 800;
            color: var(--sc-teal-700);
        }

        .lab-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .72rem;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: .78rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 999px;
        }

            .status-pill.active {
                background: #dcfce7;
                color: #15803d;
            }

            .status-pill.inactive {
                background: #fee2e2;
                color: #b91c1c;
            }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
            display: inline-block;
        }

        .row-actions {
            display: flex;
            gap: 4px;
            justify-content: flex-end;
        }

        .icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            border: none;
            background: transparent;
            color: var(--sc-ink-600);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s;
        }

            .icon-btn:hover {
                background: var(--sc-sky-100);
                color: var(--sc-teal-700);
                transform: scale(1.08);
            }

            .icon-btn.danger:hover {
                background: #fee2e2;
                color: #dc2626;
            }

        .diag-pagination {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .diag-page-info {
            font-size: .8rem;
            color: var(--sc-ink-600);
            font-weight: 700;
        }

        .diag-page-controls {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .page-btn {
            min-width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--sc-sky-100);
            background: #fff;
            color: var(--sc-ink-600);
            font-weight: 700;
            font-size: .82rem;
            cursor: pointer;
            transition: all .2s;
        }

            .page-btn:hover:not(:disabled) {
                border-color: var(--sc-teal-500);
                color: var(--sc-teal-700);
            }

            .page-btn.active {
                background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
                color: #fff;
                border-color: transparent;
            }

            .page-btn:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--sc-ink-600);
            animation: diagFadeUp .4s ease;
        }

        /* Modal */
        .diag-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.4);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
        }

            .diag-modal-overlay.show {
                display: flex;
                animation: diagFadeUp .25s ease;
            }

        .diag-modal-box {
            background: #fff;
            border-radius: 22px;
            padding: 28px;
            width: 92%;
            max-width: 560px;
            box-shadow: 0 25px 50px rgba(0,0,0,.18);
        }

            .diag-modal-box h5 {
                margin: 0 0 20px;
                font-weight: 800;
                color: var(--sc-ink-900);
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .diag-form-group {
            margin-bottom: 16px;
        }

            .diag-form-group label {
                display: block;
                font-size: .78rem;
                font-weight: 700;
                color: var(--sc-ink-600);
                margin-bottom: 6px;
            }

            .diag-form-group .form-control {
                width: 100%;
                padding: 10px 12px;
                border-radius: 10px;
                border: 1.5px solid var(--sc-sky-100);
                font-size: .9rem;
                transition: all .2s;
            }

                .diag-form-group .form-control:focus {
                    outline: none;
                    border-color: var(--sc-teal-500);
                    box-shadow: 0 0 0 3px rgba(20,184,166,.12);
                }

        .diag-form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        /* Price / Status / Lab row */
        .diag-meta-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin-bottom: 16px;
        }

        .diag-meta-card {
            border: 1.5px solid var(--sc-sky-100);
            border-radius: 14px;
            padding: 12px;
            background: linear-gradient(180deg, #fff, var(--sc-sky-50));
        }

            .diag-meta-card label {
                display: block;
                font-size: .72rem;
                font-weight: 800;
                color: var(--sc-ink-600);
                margin-bottom: 8px;
                text-transform: uppercase;
                letter-spacing: .3px;
            }

        .price-input-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .price-input-wrap input {
                width: 100%;
                border: none;
                background: transparent;
                font-size: 1.1rem;
                font-weight: 800;
                color: var(--sc-ink-900);
                outline: none;
            }

            .price-input-wrap span {
                font-size: .74rem;
                color: var(--sc-ink-400);
                font-weight: 700;
            }

        .meta-toggle-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .meta-toggle-text {
            font-size: .84rem;
            font-weight: 700;
            color: var(--sc-ink-900);
        }

        .switch-toggle {
            width: 42px;
            height: 24px;
            border-radius: 999px;
            border: none;
            background: #e2e8f0;
            position: relative;
            cursor: pointer;
            transition: background .2s;
            flex-shrink: 0;
        }

            .switch-toggle.on {
                background: var(--sc-teal-500);
            }

                .switch-toggle.on.lab-on {
                    background: #2563eb;
                }

            .switch-toggle::after {
                content: '';
                position: absolute;
                top: 3px;
                left: 3px;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: #fff;
                transition: transform .2s;
                box-shadow: 0 1px 3px rgba(0,0,0,.2);
            }

            .switch-toggle.on::after {
                transform: translateX(18px);
            }

        .diag-modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
        }

        .btn-cancel {
            background: var(--sc-sky-100);
            color: var(--sc-ink-600);
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-cancel:hover {
                background: #cbeef0;
            }

        .btn-save {
            background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-save:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(13,148,136,.3);
            }

        @@media (max-width: 640px) {
            .diag-form-row, .diag-meta-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section dir="ltr">
    @Html.AntiForgeryToken()
    <div class="diag-hero">
        <div class="hero-title">
            <div class="hero-icon"><i class="bi bi-activity"></i></div>
            <div>
                <h1>Diagnosis Catalog</h1>
                <p>Diagnoses, pricing, and lab linkage used during clinical sessions</p>
            </div>
        </div>
        <button class="btn-hero-light" onclick="openDiagFormModal()">
            <i class="bi bi-plus-lg"></i> New Diagnosis
        </button>
    </div>

    <div class="diag-card">
        <div class="diag-toolbar">
            <div class="diag-search">
                <input type="text" id="diagSearchInput" class="text-center" placeholder="Search by name or code..." oninput="onDiagSearch()" />
                <i class="bi bi-search"></i>
            </div>
            <div class="diag-filter-chips" id="diagFilterChips">
                <button class="diag-chip active" data-filter="all">All</button>
                <button class="diag-chip" data-filter="active">Active</button>
                <button class="diag-chip" data-filter="inactive">Inactive</button>
                <button class="diag-chip" data-filter="lab">Lab-linked</button>
            </div>
        </div>

        <div class="diag-count" id="diagCount"></div>

        <div class="table-responsive">
            <table class="diag-table" id="diagTable">
                <thead>
                    <tr>
                        <th data-sort="code">Code <i class="bi bi-arrow-down-up sort-arrow"></i></th>
                        <th data-sort="nameEn">Name <i class="bi bi-arrow-down-up sort-arrow"></i></th>
                        <th data-sort="price">Price <i class="bi bi-arrow-down-up sort-arrow"></i></th>
                        <th>Lab</th>
                        <th data-sort="isActive">Status <i class="bi bi-arrow-down-up sort-arrow"></i></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="diagTableBody"></tbody>
            </table>
        </div>

        <div class="empty-state" id="diagEmptyState" style="display:none;">
            <i class="bi bi-inboxes" style="font-size:2rem;"></i>
            <p class="mt-2">No diagnoses match your search.</p>
        </div>

        <div class="diag-pagination" id="diagPagination"></div>
    </div>
</section>

<!-- Add / Edit Modal -->
<div class="diag-modal-overlay" id="diagFormModalOverlay">
    <div class="diag-modal-box" dir="ltr">
        <h5><i class="bi bi-activity"></i> <span id="diagModalTitle">New Diagnosis</span></h5>
        <form id="diagForm">
            <input type="hidden" id="diagId" value="0" />

            <div class="diag-form-row">
                <div class="diag-form-group">
                    <label>Code <span style="color:#dc2626;">*</span></label>
                    <input type="text" class="form-control" id="diagCode" placeholder="e.g. D01" />
                </div>
                <div class="diag-form-group">
                    <label>Name (English) <span style="color:#dc2626;">*</span></label>
                    <input type="text" class="form-control" id="diagNameEn" placeholder="e.g. Surface Caries" />
                </div>
            </div>

            <div class="diag-form-group">
                <label>Name (Arabic) <span style="color:#94a3b8;">(optional)</span></label>
                <input type="text" class="form-control" id="diagNameAr" placeholder="اختياري" dir="rtl" />
            </div>

            <div class="diag-meta-row">
                <div class="diag-meta-card">
                    <label>Price</label>
                    <div class="price-input-wrap">
                        <input type="number" min="0" step="0.01" id="diagPrice" value="0" />
                        <span>EGP</span>
                    </div>
                </div>
                <div class="diag-meta-card">
                    <label>Status</label>
                    <div class="meta-toggle-row">
                        <span class="meta-toggle-text" id="diagActiveText">Active</span>
                        <button type="button" class="switch-toggle on" id="diagActiveToggle" onclick="toggleSwitch(this, 'diagActiveText', 'Active', 'Inactive')"></button>
                    </div>
                </div>
                <div class="diag-meta-card">
                    <label>Lab Linked</label>
                    <div class="meta-toggle-row">
                        <span class="meta-toggle-text" id="diagLabText">No</span>
                        <button type="button" class="switch-toggle" id="diagLabToggle" onclick="toggleSwitch(this, 'diagLabText', 'Yes', 'No', true)"></button>
                    </div>
                </div>
            </div>

            <div class="diag-form-group">
                <label>Notes</label>
                <textarea class="form-control" id="diagNotes" rows="2" placeholder="Optional"></textarea>
            </div>
        </form>
        <div class="diag-modal-actions">
            <button type="button" class="btn-cancel" onclick="closeDiagFormModal()">Cancel</button>
            <button type="button" class="btn-save" onclick="submitDiagForm()"><i class="bi bi-check-lg"></i> Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const DEFAULT_CATEGORY = 1; // Category field is hidden from the UI — sent as a fixed default (Caries)

        // ── Data (loaded once from the server-rendered model) ──
        let diagAll = [
                    @foreach (var d in Model)
            {
                @:{ id: @d.Id, code: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.Code)), nameEn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.NameEn)), nameAr: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.NameAr)), price: @d.Price.ToString(System.Globalization.CultureInfo.InvariantCulture), isActive: @d.IsActive.ToString().ToLower(), isLab: @d.IsLaboratoryRelated.ToString().ToLower() },
            }
                ];

        let diagFiltered = [...diagAll];
        let diagSort = { key: 'code', dir: 'asc' };
        let diagStatusFilter = 'all';
        let diagSearchTerm = '';
        let diagPage = 1;
        const PAGE_SIZE = 10;

        function applyDiagFilters() {
            let list = [...diagAll];

            if (diagStatusFilter === 'active') list = list.filter(d => d.isActive);
            else if (diagStatusFilter === 'inactive') list = list.filter(d => !d.isActive);
            else if (diagStatusFilter === 'lab') list = list.filter(d => d.isLab);

            if (diagSearchTerm) {
                const q = diagSearchTerm.toLowerCase();
                list = list.filter(d =>
                    d.code.toLowerCase().includes(q) ||
                    d.nameEn.toLowerCase().includes(q) ||
                    (d.nameAr || '').toLowerCase().includes(q)
                );
            }

            list.sort((a, b) => {
                let av = a[diagSort.key], bv = b[diagSort.key];
                if (typeof av === 'string') { av = av.toLowerCase(); bv = bv.toLowerCase(); }
                if (av < bv) return diagSort.dir === 'asc' ? -1 : 1;
                if (av > bv) return diagSort.dir === 'asc' ? 1 : -1;
                return 0;
            });

            diagFiltered = list;
            diagPage = 1;
            renderDiagTable();
        }

        function onDiagSearch() {
            diagSearchTerm = document.getElementById('diagSearchInput').value.trim();
            applyDiagFilters();
        }

        function statusPillHtml(isActive) {
            return isActive
                ? '<span class="status-pill active"><span class="status-dot"></span>Active</span>'
                : '<span class="status-pill inactive"><span class="status-dot"></span>Inactive</span>';
        }

        function renderDiagTable() {
            const totalPages = Math.max(1, Math.ceil(diagFiltered.length / PAGE_SIZE));
            if (diagPage > totalPages) diagPage = totalPages;
            const start = (diagPage - 1) * PAGE_SIZE;
            const pageItems = diagFiltered.slice(start, start + PAGE_SIZE);

            const tbody = document.getElementById('diagTableBody');
            const empty = document.getElementById('diagEmptyState');

            document.getElementById('diagCount').textContent = `${diagFiltered.length} diagnosis${diagFiltered.length === 1 ? '' : 'es'} found`;

            if (!pageItems.length) {
                tbody.innerHTML = '';
                empty.style.display = 'block';
                document.getElementById('diagPagination').innerHTML = '';
                return;
            }
            empty.style.display = 'none';

            tbody.innerHTML = pageItems.map((d, i) => `
                        <tr style="animation-delay:${Math.min(i * 0.03, 0.3)}s">
                            <td><span class="code-badge">${d.code}</span></td>
                            <td>
                                <div class="diag-name-main">${d.nameEn}</div>
                                ${d.nameAr ? `<div class="diag-name-sub">${d.nameAr}</div>` : ''}
                            </td>
                            <td class="price-cell">${Number(d.price).toLocaleString()} EGP</td>
                            <td>${d.isLab ? '<span class="lab-badge"><i class="bi bi-flask"></i> Lab</span>' : '<span style="color:#cbd5e1;">—</span>'}</td>
                            <td>${statusPillHtml(d.isActive)}</td>
                            <td>
                                <div class="row-actions">
                                    <button class="icon-btn" title="Edit" onclick="editDiag(${d.id})"><i class="bi bi-pencil"></i></button>
                                    <button class="icon-btn" title="${d.isActive ? 'Deactivate' : 'Activate'}" onclick="toggleDiag(${d.id})"><i class="bi ${d.isActive ? 'bi-toggle-on' : 'bi-toggle-off'}"></i></button>
                                    <button class="icon-btn danger" title="Delete" onclick="deleteDiag(${d.id})"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    `).join('');

            renderDiagPagination(totalPages);
        }

        function renderDiagPagination(totalPages) {
            const wrap = document.getElementById('diagPagination');
            if (totalPages <= 1) { wrap.innerHTML = ''; return; }

            let buttons = `<button class="page-btn" ${diagPage === 1 ? 'disabled' : ''} onclick="goToDiagPage(${diagPage - 1})"><i class="bi bi-chevron-left"></i></button>`;
            for (let p = 1; p <= totalPages; p++) {
                buttons += `<button class="page-btn ${p === diagPage ? 'active' : ''}" onclick="goToDiagPage(${p})">${p}</button>`;
            }
            buttons += `<button class="page-btn" ${diagPage === totalPages ? 'disabled' : ''} onclick="goToDiagPage(${diagPage + 1})"><i class="bi bi-chevron-right"></i></button>`;

            wrap.innerHTML = `
                        <span class="diag-page-info">Page ${diagPage} of ${totalPages}</span>
                        <div class="diag-page-controls">${buttons}</div>
                    `;
        }

        window.goToDiagPage = function(p) {
            diagPage = p;
            renderDiagTable();
        };

        // ── Sorting ──
        document.querySelectorAll('#diagTable th[data-sort]').forEach(th => {
            th.addEventListener('click', () => {
                const key = th.dataset.sort;
                if (diagSort.key === key) {
                    diagSort.dir = diagSort.dir === 'asc' ? 'desc' : 'asc';
                } else {
                    diagSort = { key, dir: 'asc' };
                }
                document.querySelectorAll('#diagTable th[data-sort]').forEach(h => h.classList.remove('sorted'));
                th.classList.add('sorted');
                th.querySelector('.sort-arrow').className = `bi ${diagSort.dir === 'asc' ? 'bi-arrow-up' : 'bi-arrow-down'} sort-arrow`;
                applyDiagFilters();
            });
        });

        // ── Filter chips ──
        document.getElementById('diagFilterChips').addEventListener('click', e => {
            const chip = e.target.closest('.diag-chip');
            if (!chip) return;
            document.querySelectorAll('.diag-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            diagStatusFilter = chip.dataset.filter;
            applyDiagFilters();
        });

        // ── Modal toggles ──
        window.toggleSwitch = function(btn, textId, onLabel, offLabel, isLab) {
            const isOn = btn.classList.toggle('on');
            if (isLab) btn.classList.toggle('lab-on', isOn);
            document.getElementById(textId).textContent = isOn ? onLabel : offLabel;
        };

        function setSwitch(btn, textId, onLabel, offLabel, value, isLab) {
            btn.classList.toggle('on', value);
            if (isLab) btn.classList.toggle('lab-on', value);
            document.getElementById(textId).textContent = value ? onLabel : offLabel;
        }

        function openDiagFormModal() {
            document.getElementById('diagModalTitle').textContent = 'New Diagnosis';
            document.getElementById('diagForm').reset();
            document.getElementById('diagId').value = 0;
            document.getElementById('diagPrice').value = 0;
            setSwitch(document.getElementById('diagActiveToggle'), 'diagActiveText', 'Active', 'Inactive', true);
            setSwitch(document.getElementById('diagLabToggle'), 'diagLabText', 'Yes', 'No', false, true);
            document.getElementById('diagFormModalOverlay').classList.add('show');
        }

        function closeDiagFormModal() {
            document.getElementById('diagFormModalOverlay').classList.remove('show');
        }

        async function editDiag(id) {
            const res = await fetch(`/Diagnosis/GetById?id=${id}`);
            const result = await res.json();
            if (!result.success) {
                Swal.fire({ title: 'Error', text: result.message, icon: 'error', confirmButtonColor: '#dc2626' });
                return;
            }
            const d = result.data;
            document.getElementById('diagModalTitle').textContent = 'Edit Diagnosis';
            document.getElementById('diagId').value = d.id;
            document.getElementById('diagCode').value = d.code;
            document.getElementById('diagNameEn').value = d.nameEn || '';
            document.getElementById('diagNameAr').value = d.nameAr || '';
            document.getElementById('diagPrice').value = d.price;
            document.getElementById('diagNotes').value = d.notes || '';
            setSwitch(document.getElementById('diagActiveToggle'), 'diagActiveText', 'Active', 'Inactive', !!d.isActive);
            setSwitch(document.getElementById('diagLabToggle'), 'diagLabText', 'Yes', 'No', !!d.isLaboratoryRelated, true);
            document.getElementById('diagFormModalOverlay').classList.add('show');
        }

        async function submitDiagForm() {
            const payload = {
                Id: parseInt(document.getElementById('diagId').value) || 0,
                Code: document.getElementById('diagCode').value.trim(),
                NameEn: document.getElementById('diagNameEn').value.trim(),
                NameAr: document.getElementById('diagNameAr').value.trim(),
                Category: DEFAULT_CATEGORY,
                Price: parseFloat(document.getElementById('diagPrice').value) || 0,
                IsActive: document.getElementById('diagActiveToggle').classList.contains('on'),
                IsLaboratoryRelated: document.getElementById('diagLabToggle').classList.contains('on'),
                Notes: document.getElementById('diagNotes').value.trim()
            };

            if (!payload.Code || !payload.NameEn) {
                Swal.fire({ title: 'Required', text: 'Code and English name are required', icon: 'warning', confirmButtonColor: '#0d9488' });
                return;
            }

            const form = new URLSearchParams();
            Object.keys(payload).forEach(k => form.append(k, payload[k]));
            if (antiForgeryToken) form.append('__RequestVerificationToken', antiForgeryToken);

            const res = await fetch('/Diagnosis/Save', { method: 'POST', body: form });
            const result = await res.json();

            if (result.success) {
                Swal.fire({ title: 'Saved', text: result.message, icon: 'success', timer: 1400, showConfirmButton: false })
                    .then(() => location.reload());
            } else {
                Swal.fire({ title: 'Error', text: result.message || 'Something went wrong while saving', icon: 'error', confirmButtonColor: '#dc2626' });
            }
        }

        async function toggleDiag(id) {
            const form = new URLSearchParams();
            form.append('id', id);
            if (antiForgeryToken) form.append('__RequestVerificationToken', antiForgeryToken);
            const res = await fetch('/Diagnosis/ToggleActive', { method: 'POST', body: form });
            const result = await res.json();
            if (result.success) location.reload();
            else Swal.fire({ title: 'Error', text: result.message, icon: 'error', confirmButtonColor: '#dc2626' });
        }

        async function deleteDiag(id) {
            const confirmResult = await Swal.fire({
                title: 'Delete this diagnosis?', text: 'This action may not be reversible.', icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#dc2626', cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, delete', cancelButtonText: 'Cancel'
            });
            if (!confirmResult.isConfirmed) return;

            const form = new URLSearchParams();
            form.append('id', id);
            if (antiForgeryToken) form.append('__RequestVerificationToken', antiForgeryToken);
            const res = await fetch('/Diagnosis/Delete', { method: 'POST', body: form });
            const result = await res.json();
            if (result.success) {
                Swal.fire({ title: 'Deleted', text: result.message, icon: 'success', timer: 1400, showConfirmButton: false })
                    .then(() => location.reload());
            } else {
                Swal.fire({ title: 'Error', text: result.message, icon: 'error', confirmButtonColor: '#dc2626' });
            }
        }

        applyDiagFilters();
    </script>
}
