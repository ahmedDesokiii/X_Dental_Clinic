@{
    ViewData["Title"] = "صلاحيات الدور";
    var roleId = (int)ViewBag.RoleId;
}

<div class="ft-page um-page pm-page" dir="rtl">

    <div class="ft-hero um-hero">
        <a asp-action="Index" class="ft-hero-icon pm-back" title="رجوع للأدوار"><i class="bi bi-arrow-right"></i></a>
        <div>
            <h1 id="pmTitle">صلاحيات الدور</h1>
            <p id="pmSub">اختار الموديولات والصلاحيات المسموحة</p>
        </div>
        <div class="ft-hero-stat">
            <b id="pmCount">0</b><span>/ <span id="pmTotal">0</span> صلاحية</span>
            <div class="ft-progress"><i id="pmBar" style="width:0%"></i></div>
        </div>
    </div>

    <div class="pm-admin" id="pmAdmin" hidden>
        <i class="bi bi-shield-fill-check"></i>
        <div><b>مدير النظام له كل الصلاحيات تلقائيًا</b><span>ما محتاجش تختار حاجة — ودي الحماية اللي بتمنع إن البرنامج يتقفل على الكل.</span></div>
    </div>

    <div class="ft-toolbar pm-toolbar" id="pmToolbar">
        <span class="pm-label"><i class="bi bi-magic"></i> قوالب جاهزة:</span>
        <button type="button" class="um-chip" data-preset="all">كل الصلاحيات</button>
        <button type="button" class="um-chip" data-preset="reception">استقبال</button>
        <button type="button" class="um-chip" data-preset="readOnly">عرض فقط</button>
        <button type="button" class="um-chip" data-preset="none">مسح الكل</button>
        <div class="um-search pm-search">
            <i class="bi bi-search"></i>
            <input type="search" id="pmSearch" placeholder="ابحث عن صلاحية…" />
        </div>
    </div>

    <div class="pm-layout">
        <div class="pm-modules" id="pmModules">
            <div class="ft-skeleton um-sk"></div><div class="ft-skeleton um-sk"></div>
        </div>

        <aside class="pm-side">
            <div class="ft-card">
                <h2><i class="bi bi-people"></i> مستخدمين الدور ده</h2>
                <div id="pmUsers" class="pm-users"></div>
                <a asp-controller="Users" asp-action="Index" class="pm-link">إدارة المستخدمين <i class="bi bi-arrow-left"></i></a>
            </div>
            <div class="ft-card pm-tip">
                <h2><i class="bi bi-lightbulb"></i> إزاي بتشتغل؟</h2>
                <ul>
                    <li><b>عرض</b> = يفتح الشاشة ويشوف البيانات.</li>
                    <li><b>إضافة / تعديل</b> = يحفظ ويغيّر.</li>
                    <li>المستخدم اللي عليه أكتر من دور بياخد مجموع صلاحياتهم.</li>
                    <li>الأزرار والقوائم اللي مالوش صلاحية عليها بتستخبى، ولو حاول يوصلها بيترفض.</li>
                </ul>
            </div>
        </aside>
    </div>

    <div class="pm-savebar" id="pmSavebar" hidden>
        <span><i class="bi bi-exclamation-circle"></i> فيه تغييرات لسه ما اتحفظتش</span>
        <button type="button" class="ft-btn ft-btn-soft" id="pmUndo">تراجع</button>
        <button type="button" class="ft-btn ft-btn-primary" id="pmSave"><i class="bi bi-check2-circle"></i> حفظ الصلاحيات</button>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const ROLE_ID = @roleId;
            const URLS = {
                get: '@Url.Action("GetPermissions", "Roles")',
                save: '@Url.Action("SavePermissions", "Roles")'
            };
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const norm = s => String(s || '').toLowerCase().replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي');
            const isView = label => /^(عرض|قائمة|تفاصيل|كشف|تقارير)/.test(label);

            let D = null, saved = new Set(), current = new Set(), q = '';

            async function load() {
                const res = await fetch(`${URLS.get}?roleId=${ROLE_ID}`, { headers: { 'Accept': 'application/json' } });
                D = await res.json();
                if (!D.success) { Swal.fire({ icon: 'error', title: D.message }); return; }
                saved = new Set(D.modules.flatMap(m => m.permissions.filter(p => p.granted).map(p => p.value)));
                current = new Set(saved);
                document.getElementById('pmTitle').textContent = `صلاحيات «${D.role.displayName}»`;
                document.getElementById('pmSub').textContent = D.role.details || 'اختار الموديولات والصلاحيات المسموحة';
                document.getElementById('pmTotal').textContent = D.modules.reduce((n, m) => n + m.permissions.length, 0);
                document.getElementById('pmAdmin').hidden = !D.role.isAdmin;
                document.getElementById('pmToolbar').hidden = D.role.isAdmin;
                renderUsers(); render();
            }

            function renderUsers() {
                const states = { 2: '', 1: ' (معلّق)', 0: ' (معطّل)' };
                document.getElementById('pmUsers').innerHTML = D.users.length
                    ? D.users.map(u => `<div class="pm-user"><span class="um-avatar um-avatar-sm">${esc((u.fullName_Ar || u.userName || '?').trim().charAt(0))}</span><span>${esc(u.fullName_Ar)}<small>${states[u.currentState] ?? ''}</small></span></div>`).join('')
                    : '<div class="um-hint">مفيش مستخدمين على الدور ده لسه</div>';
            }

            function moduleCard(m) {
                const perms = m.permissions.filter(p => !q || norm(p.label + ' ' + m.title).includes(q));
                if (!perms.length) return '';
                const on = m.permissions.filter(p => current.has(p.value)).length;
                const state = on === 0 ? 'none' : on === m.permissions.length ? 'full' : 'part';
                const lock = D.role.isAdmin ? 'disabled' : '';
                return `
                <section class="pm-module pm-${state}" data-module="${esc(m.key)}">
                    <header>
                        <span class="pm-module-icon"><i class="bi ${esc(m.icon)}"></i></span>
                        <div class="pm-module-title"><b>${esc(m.title)}</b><small>${esc(m.description)}</small></div>
                        <span class="pm-module-count">${on}/${m.permissions.length}</span>
                        <label class="pm-switch" title="الموديول كله">
                            <input type="checkbox" data-all="${esc(m.key)}" ${state === 'full' ? 'checked' : ''} ${lock} />
                            <i></i>
                        </label>
                    </header>
                    <div class="pm-perms">
                        ${perms.map(p => `
                        <label class="pm-perm ${current.has(p.value) ? 'on' : ''}">
                            <input type="checkbox" value="${esc(p.value)}" ${current.has(p.value) ? 'checked' : ''} ${lock} />
                            <span class="pm-perm-kind ${isView(p.label) ? 'view' : 'edit'}">${isView(p.label) ? 'عرض' : 'تعديل'}</span>
                            <span class="pm-perm-label">${esc(p.label)}</span>
                            <span class="pm-switch pm-switch-sm"><i></i></span>
                        </label>`).join('')}
                    </div>
                </section>`;
            }

            function render() {
                document.getElementById('pmModules').innerHTML = D.modules.map(moduleCard).join('') || '<div class="ft-empty"><i class="bi bi-search"></i><b>مفيش صلاحية بالاسم ده</b></div>';
                const n = current.size, total = +document.getElementById('pmTotal').textContent || 1;
                document.getElementById('pmCount').textContent = n;
                document.getElementById('pmBar').style.width = (n * 100 / total) + '%';
                const dirty = !D.role.isAdmin && (n !== saved.size || [...current].some(p => !saved.has(p)));
                document.getElementById('pmSavebar').hidden = !dirty;
            }

            document.getElementById('pmModules').addEventListener('change', e => {
                const t = e.target;
                if (t.dataset.all) {
                    const m = D.modules.find(x => x.key === t.dataset.all);
                    m.permissions.forEach(p => t.checked ? current.add(p.value) : current.delete(p.value));
                } else if (t.value) {
                    t.checked ? current.add(t.value) : current.delete(t.value);
                    // التعديل من غير العرض ملوش معنى → نفعّل عرض نفس الموديول تلقائيًا
                    if (t.checked) {
                        const m = D.modules.find(x => x.permissions.some(p => p.value === t.value));
                        const viewPerm = m?.permissions.find(p => isView(p.label));
                        if (viewPerm) current.add(viewPerm.value);
                    }
                }
                render();
            });

            document.getElementById('pmToolbar').addEventListener('click', e => {
                const b = e.target.closest('[data-preset]'); if (!b) return;
                current = new Set(D.presets[b.dataset.preset] || []);
                render();
            });
            document.getElementById('pmSearch').addEventListener('input', e => { q = norm(e.target.value.trim()); render(); });
            document.getElementById('pmUndo').addEventListener('click', () => { current = new Set(saved); render(); });

            document.getElementById('pmSave').addEventListener('click', async () => {
                const btn = document.getElementById('pmSave'); btn.disabled = true;
                try {
                    const res = await fetch(URLS.save, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ roleId: ROLE_ID, permissions: [...current] })
                    });
                    const r = await res.json();
                    Swal.fire({ toast: true, position: 'top', icon: r.success ? 'success' : 'error', title: r.message, timer: 2800, showConfirmButton: false });
                    if (r.success) { saved = new Set(current); render(); }
                } finally { btn.disabled = false; }
            });

            window.addEventListener('beforeunload', e => {
                if (!document.getElementById('pmSavebar').hidden) { e.preventDefault(); e.returnValue = ''; }
            });

            load();
        })();
    </script>
}
