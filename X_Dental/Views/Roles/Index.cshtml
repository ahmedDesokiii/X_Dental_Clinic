@{
    ViewData["Title"] = "الأدوار والصلاحيات";
}

<div class="ft-page um-page" dir="rtl">

    <div class="ft-hero um-hero">
        <div class="ft-hero-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <div>
            <h1>الأدوار والصلاحيات</h1>
            <p>كل دور = مجموعة صلاحيات. المستخدم بياخد صلاحيات كل الأدوار اللي عليه.</p>
        </div>
        <div class="um-hero-actions">
            <a asp-controller="Users" asp-action="Index" class="ft-btn um-btn-glass"><i class="bi bi-people"></i> المستخدمين</a>
            <button type="button" class="ft-btn um-btn-white" id="btnNewRole"><i class="bi bi-plus-circle-fill"></i> دور جديد</button>
        </div>
    </div>

    <div class="rl-grid" id="rlGrid">
        <div class="ft-skeleton um-sk"></div><div class="ft-skeleton um-sk"></div><div class="ft-skeleton um-sk"></div>
    </div>

    <div class="rl-note">
        <i class="bi bi-info-circle"></i>
        <span>
            <b>مدير النظام</b> له كل الصلاحيات تلقائيًا، وهو الوحيد اللي يقدر يدخل على المستخدمين والأدوار والإعدادات.
            أي تعديل في الصلاحيات بيوصل للمستخدمين فورًا من غير ما يعملوا خروج.
        </span>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const URLS = {
                all: '@Url.Action("GetAll", "Roles")',
                save: '@Url.Action("SaveRole", "Roles")',
                del: '@Url.Action("DeleteRole", "Roles")',
                perms: '@Url.Action("ManagePermissions", "Roles")'
            };
            const TONES = { Admin: 'admin', Doctor: 'doctor', Reception: 'reception', User: 'user' };
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const toast = (icon, title) => Swal.fire({ toast: true, position: 'top', icon, title, timer: 2600, showConfirmButton: false });
            let D = null;

            async function load() {
                const res = await fetch(URLS.all, { headers: { 'Accept': 'application/json' } });
                D = await res.json();
                render();
            }

            function card(r) {
                const pct = Math.round(r.permissionsCount * 100 / D.totalPermissions);
                const tone = TONES[r.name] || 'custom';
                return `
                <article class="rl-card um-tone-${tone}" data-id="${r.id}">
                    <div class="rl-card-head">
                        <span class="rl-icon"><i class="bi ${r.isAdmin ? 'bi-shield-fill-check' : 'bi-person-badge-fill'}"></i></span>
                        <div class="rl-title">
                            <b>${esc(r.displayName)}</b>
                            <small dir="ltr">${r.displayName !== r.name ? esc(r.name) : ''}</small>
                        </div>
                        ${r.isSystem ? '<span class="rl-sys" title="دور أساسي"><i class="bi bi-lock-fill"></i></span>' : ''}
                    </div>
                    <p class="rl-desc">${esc(r.details) || (r.isAdmin ? 'تحكم كامل في البرنامج' : '<span class="um-hint">من غير وصف</span>')}</p>

                    <div class="rl-meter">
                        <div class="rl-meter-top"><span>الصلاحيات</span><b>${r.isAdmin ? 'الكل' : `${r.permissionsCount} / ${D.totalPermissions}`}</b></div>
                        <div class="rl-bar"><i style="width:${pct}%"></i></div>
                    </div>

                    <div class="rl-modules">
                        ${r.modules.length ? r.modules.map(m => `<span title="${esc(m.title)}"><i class="bi ${esc(m.icon)}"></i></span>`).join('') : '<span class="um-hint">مفيش صلاحيات</span>'}
                    </div>

                    <div class="rl-foot">
                        <span class="rl-users"><i class="bi bi-people"></i> ${r.usersCount} مستخدم</span>
                        <div class="rl-actions">
                            ${r.isAdmin ? '' : `<a class="ft-btn ft-btn-primary" href="${URLS.perms}?roleId=${r.id}"><i class="bi bi-sliders"></i> الصلاحيات</a>`}
                            <button type="button" class="ft-btn ft-btn-soft ft-btn-icon" data-act="edit" title="تعديل الاسم والوصف"><i class="bi bi-pencil"></i></button>
                            ${r.isSystem ? '' : `<button type="button" class="ft-btn ft-btn-soft ft-btn-icon um-danger" data-act="delete" title="مسح"><i class="bi bi-trash3"></i></button>`}
                        </div>
                    </div>
                </article>`;
            }

            function render() {
                document.getElementById('rlGrid').innerHTML = D.roles.map(card).join('');
            }

            async function editRole(r) {
                const isNew = !r;
                const copyOpts = D.roles.map(x => `<option value="${x.id}">${esc(x.displayName)}</option>`).join('');
                const { value } = await Swal.fire({
                    title: isNew ? 'دور جديد' : `تعديل «${r.displayName}»`,
                    html: `
                        <div class="rl-form" dir="rtl">
                            <label>اسم الدور</label>
                            <input id="rlName" class="form-control" value="${esc(r?.name || '')}" ${r?.isAdmin ? 'disabled' : ''} placeholder="مثلاً: مساعد طبيب" />
                            <label>الوصف</label>
                            <input id="rlDetails" class="form-control" value="${esc(r?.details || '')}" placeholder="مين ياخد الدور ده؟" />
                            ${isNew ? `<label>ابدأ بصلاحيات</label>
                                <select id="rlCopy" class="form-select"><option value="">من غير صلاحيات</option>${copyOpts}</select>` : ''}
                        </div>`,
                    showCancelButton: true, confirmButtonText: isNew ? 'إنشاء' : 'حفظ', cancelButtonText: 'إلغاء',
                    focusConfirm: false,
                    preConfirm: () => {
                        const name = document.getElementById('rlName').value.trim();
                        if (name.length < 2) { Swal.showValidationMessage('اكتب اسم الدور'); return false; }
                        return {
                            roleId: r?.id || null, name,
                            details: document.getElementById('rlDetails').value,
                            copyFromRoleId: isNew ? (+document.getElementById('rlCopy').value || null) : null
                        };
                    }
                });
                if (!value) return;
                const res = await fetch(URLS.save, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(value) });
                const out = await res.json();
                if (!out.success) return Swal.fire({ icon: 'error', title: out.message });
                if (isNew && out.roleId) return location.href = `${URLS.perms}?roleId=${out.roleId}`;
                toast('success', out.message); load();
            }

            document.getElementById('rlGrid').addEventListener('click', async e => {
                const b = e.target.closest('[data-act]'); if (!b) return;
                const r = D.roles.find(x => x.id == b.closest('[data-id]').dataset.id); if (!r) return;
                if (b.dataset.act === 'edit') return editRole(r);
                if (b.dataset.act === 'delete') {
                    const ok = await Swal.fire({
                        icon: 'warning', title: `مسح دور «${r.displayName}»؟`,
                        text: r.usersCount ? `عليه ${r.usersCount} مستخدم — لازم تنقلهم الأول.` : 'العملية دي مش هترجع.',
                        showCancelButton: true, confirmButtonText: 'مسح', cancelButtonText: 'إلغاء', confirmButtonColor: '#dc2626'
                    });
                    if (!ok.isConfirmed) return;
                    const res = await fetch(`${URLS.del}?roleId=${r.id}`, { method: 'POST' });
                    const out = await res.json();
                    toast(out.success ? 'success' : 'error', out.message);
                    load();
                }
            });

            document.getElementById('btnNewRole').addEventListener('click', () => editRole(null));
            load();
        })();
    </script>
}
