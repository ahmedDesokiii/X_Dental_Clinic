@{
    ViewData["Title"] = "الفواتير والمدفوعات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --sc-teal-900: #0a4d4f;
        --sc-teal-700: #0d7377;
        --sc-teal-600: #0f9b8e;
        --sc-teal-500: #14b8a6;
        --sc-teal-100: #c7f2ea;
        --sc-sky-50: #eafbfc;
        --sc-sky-100: #dcf5f7;
        --sc-coral-300: #f6c6bc;
        --sc-ink-900: #0b2e30;
        --sc-ink-600: #4b6b6c;
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-light: #f0fdfa;
        --radius-lg: 18px;
        --radius-md: 12px;
        --shadow-soft: 0 1px 3px rgba(15, 23, 42, 0.06);
        --shadow-hover: 0 10px 26px rgba(10, 77, 79, 0.12);
        --shadow-card: 0 20px 50px rgba(10, 77, 79, .08);
    }

    body {
        background: radial-gradient(circle at 6% 4%, var(--sc-teal-100) 0%, transparent 38%), radial-gradient(circle at 97% 92%, var(--sc-coral-300) 0%, transparent 26%), var(--sc-sky-50);
    }

    /* ── Hero ── */
    .payments-hero {
        background: linear-gradient(135deg, var(--sc-teal-700), var(--sc-teal-500));
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 14px 34px rgba(13, 115, 119, .28);
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
        position: relative;
        overflow: hidden;
    }

        .payments-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 92% -20%, rgba(255,255,255,.32), transparent 55%);
            pointer-events: none;
        }

        .payments-hero .hero-content {
            display: flex;
            align-items: center;
            gap: 18px;
            position: relative;
            z-index: 1;
        }

        .payments-hero .hero-icon {
            width: 56px;
            height: 56px;
            background: rgba(255,255,255,.18);
            color: #fff;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255,255,255,.15);
        }

        .payments-hero h1 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            color: #fff;
        }

        .payments-hero p {
            font-size: 0.85rem;
            margin: 4px 0 0;
            color: rgba(255,255,255,.9);
            font-weight: 600;
        }

    /* ── Search Shell ── */
    .search-shell-glass {
        max-width: 600px;
        margin: 0 auto;
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(16px);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255,255,255,.6);
        padding: 40px;
        box-shadow: var(--shadow-card);
        text-align: center;
        animation: shellFadeIn 0.6s ease forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    @@keyframes shellFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .search-shell-glass .shell-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 20px;
        box-shadow: 0 8px 20px rgba(13,148,136,0.25);
    }

    .search-shell-glass h3 {
        font-weight: 800;
        color: var(--sc-ink-900);
        margin-bottom: 8px;
        font-size: 1.3rem;
    }

    .search-shell-glass p {
        color: var(--sc-ink-600);
        font-size: .9rem;
        margin-bottom: 28px;
        line-height: 1.6;
    }

    /* ── Search Input ── */
    .search-input-wrapper {
        position: relative;
        margin-bottom: 16px;
    }

    .search-input-glass {
        width: 100%;
        border: 1.5px solid var(--sc-sky-100);
        border-radius: 14px;
        padding: 14px 18px 14px 50px;
        font-size: 1rem;
        color: var(--sc-ink-900);
        background: #fff;
        transition: all 0.25s ease;
        outline: none;
        font-weight: 600;
    }

        .search-input-glass:focus {
            border-color: var(--sc-teal-500);
            box-shadow: 0 0 0 4px rgba(20,184,166,0.1);
        }

        .search-input-glass::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }

    .search-input-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--sc-teal-600);
        font-size: 1.2rem;
        pointer-events: none;
    }

    /* ── Results Box ── */
    .results-box-glass {
        text-align: right;
        margin-top: 12px;
        border-radius: 14px;
        overflow: hidden;
        border: 1.5px solid var(--sc-sky-100);
        display: none;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        animation: resultsSlideDown 0.25s ease;
    }

    @@keyframes resultsSlideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .result-item-glass {
        padding: 14px 18px;
        cursor: pointer;
        border-bottom: 1px solid var(--sc-sky-100);
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        color: var(--sc-ink-900);
        font-size: 0.95rem;
    }

        .result-item-glass:hover {
            background: var(--brand-light);
            color: var(--brand-dark);
            padding-right: 24px;
        }

        .result-item-glass:last-child {
            border-bottom: none;
        }

        .result-item-glass .result-meta {
            font-size: 0.8rem;
            color: var(--sc-ink-600);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .result-item-glass:hover .result-meta {
            color: var(--sc-teal-600);
        }

    .result-empty {
        padding: 20px;
        text-align: center;
        color: #94a3b8;
        font-weight: 600;
    }

        .result-empty i {
            display: block;
            font-size: 2rem;
            margin-bottom: 8px;
            color: var(--sc-sky-100);
        }

    /* ── Loading State ── */
    .search-loading {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px;
        color: var(--sc-teal-600);
        font-weight: 700;
        font-size: 0.9rem;
    }

        .search-loading.show {
            display: flex;
        }

        .search-loading i {
            animation: spin 0.9s linear infinite;
            font-size: 1.2rem;
        }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* ── Quick Stats (Optional decorative) ── */
    .quick-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        max-width: 600px;
        margin: 0 auto 24px;
    }

    .quick-stat-card {
        background: rgba(255,255,255,.78);
        backdrop-filter: blur(14px);
        border-radius: 14px;
        padding: 16px;
        text-align: center;
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: var(--shadow-soft);
        transition: all .25s ease;
    }

        .quick-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
        }

    .quick-stat-value {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--sc-ink-900);
    }

    .quick-stat-label {
        font-size: 0.75rem;
        color: var(--sc-ink-600);
        font-weight: 600;
        margin-top: 4px;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .payments-hero {
            flex-direction: column;
            text-align: center;
            padding: 22px;
        }

            .payments-hero .hero-content {
                flex-direction: column;
            }

        .search-shell-glass {
            padding: 28px 20px;
            margin: 0 12px;
        }

        .quick-stats-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- 🔷 Hero -->
<div class="payments-hero">
    <div class="hero-content">
        <div class="hero-icon"><i class="bi bi-receipt-cutoff"></i></div>
        <div>
            <h1>الفواتير والمدفوعات</h1>
            <p>ابحث عن المريض واستعرض كشف الحساب الكامل والدفعات</p>
        </div>
    </div>
</div>

<!-- 🔷 Quick Stats (Placeholder / Static for visual balance) -->
<div class="quick-stats-row">
    <div class="quick-stat-card">
        <div class="quick-stat-value"><i class="bi bi-receipt" style="color: var(--sc-teal-600);"></i></div>
        <div class="quick-stat-label">كشف حساب مفصل</div>
    </div>
    <div class="quick-stat-card">
        <div class="quick-stat-value"><i class="bi bi-cash-stack" style="color: #166534;"></i></div>
        <div class="quick-stat-label">تتبع المدفوعات</div>
    </div>
    <div class="quick-stat-card">
        <div class="quick-stat-value"><i class="bi bi-graph-up" style="color: #1d4ed8;"></i></div>
        <div class="quick-stat-label">الأرصدة والمتبقي</div>
    </div>
</div>

<!-- 🔷 Search Shell -->
<div class="search-shell-glass">
    <div class="shell-icon"><i class="bi bi-search-heart"></i></div>
    <h3>كشف حساب مريض</h3>
    <p>ابحث باسم المريض أو رقم التليفون عشان تشوف كشف الحساب الكامل بتاعه</p>

    <div class="search-input-wrapper">
        <i class="bi bi-search search-input-icon"></i>
        <input type="text" id="patientSearch" class="search-input-glass" placeholder="اكتب اسم المريض أو رقم التليفون..." autocomplete="off" />
    </div>

    <div class="search-loading" id="searchLoading">
        <i class="bi bi-arrow-repeat"></i> جاري البحث...
    </div>

    <div class="results-box-glass" id="resultsBox"></div>
</div>

@section Scripts {
    <script>
        let searchTimeout;
        const searchInput = document.getElementById('patientSearch');
        const resultsBox = document.getElementById('resultsBox');
        const searchLoading = document.getElementById('searchLoading');

        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimeout);
            const term = this.value.trim();

            resultsBox.style.display = 'none';
            searchLoading.classList.remove('show');

            if (term.length < 2) {
                return;
            }

            searchLoading.classList.add('show');
            searchTimeout = setTimeout(() => doSearch(term), 400);
        });

        // إخفاء النتائج لما يدوس بره
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-shell-glass')) {
                resultsBox.style.display = 'none';
            }
        });

        async function doSearch(term) {
            try {
                const res = await fetch(`/Patients/Search?term=${encodeURIComponent(term)}`);
                const list = await res.json();

                searchLoading.classList.remove('show');

                if (!list.length) {
                    resultsBox.innerHTML = `
                        <div class="result-empty">
                            <i class="bi bi-inbox"></i>
                            لا توجد نتائج مطابقة
                        </div>`;
                    resultsBox.style.display = 'block';
                    return;
                }

                resultsBox.innerHTML = '';
                list.forEach(function (p, index) {
                    const item = document.createElement('div');
                    item.className = 'result-item-glass';
                    item.style.animationDelay = `${index * 0.03}s`;
                    item.innerHTML = `
                        <span>${p.fullNameAr}</span>
                        <span class="result-meta"><i class="bi bi-telephone-fill"></i> ${p.phone || '—'}</span>
                    `;
                    item.addEventListener('click', function () {
                        window.location.href = `/Payments/Statement?patientId=${p.id}`;
                    });
                    resultsBox.appendChild(item);
                });

                resultsBox.style.display = 'block';
            } catch (err) {
                searchLoading.classList.remove('show');
                console.error('Search failed', err);
                resultsBox.innerHTML = `
                    <div class="result-empty">
                        <i class="bi bi-wifi-off"></i>
                        حدث خطأ في الاتصال
                    </div>`;
                resultsBox.style.display = 'block';
            }
        }
    </script>
}