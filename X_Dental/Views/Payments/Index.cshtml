@{
    ViewData["Title"] = "الفواتير والمدفوعات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --sc-teal-900: #0a4d4f;
        --sc-teal-800: #0b5f62;
        --sc-teal-700: #0d7377;
        --sc-teal-600: #0f9b8e;
        --sc-teal-500: #14b8a6;
        --sc-teal-100: #c7f2ea;
        --sc-sky-50: #eafbfc;
        --sc-sky-100: #dcf5f7;
        --sc-coral-300: #f6c6bc;
        --sc-ink-900: #0b2e30;
        --sc-ink-600: #4b6b6c;
        --sc-ink-400: #8aa5a6;
        --brand-light: #f0fdfa;
        --radius-lg: 20px;
        --radius-md: 14px;
        --shadow-soft: 0 1px 2px rgba(15,23,42,.04), 0 4px 14px rgba(10,77,79,.06);
        --shadow-hover: 0 14px 34px rgba(10,77,79,.14);
        --shadow-card: 0 1px 2px rgba(15,23,42,.04), 0 18px 44px rgba(10,77,79,.08);
        --dp-general: #0f9b8e;
        --dp-general-2: #2dd4bf;
        --dp-ortho: #7c3aed;
        --dp-ortho-2: #a78bfa;
        --dp-paid: #047857;
        --dp-due: #b91c1c;
        --dp-disc: #b45309;
    }

    body {
        background: radial-gradient(circle at 6% 4%, var(--sc-teal-100) 0%, transparent 38%), radial-gradient(circle at 97% 92%, var(--sc-coral-300) 0%, transparent 26%), var(--sc-sky-50);
    }

    .dp-shell {
        position: relative;
        animation: dpRise .6s cubic-bezier(.2,1,.3,1) backwards;
    }

    .dp-num, .dp-kpi-value, .dp-date {
        font-variant-numeric: tabular-nums;
    }

    .dp-date {
        direction: ltr;
        unicode-bidi: isolate;
        display: inline-block;
    }

    @@keyframes dpRise {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes dpPop {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* ══════════ Hero + toolbar ══════════ */
    .dp-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 26px 30px 86px;
        background: radial-gradient(circle at 88% -10%, rgba(255,255,255,.22), transparent 42%), radial-gradient(circle at 8% 120%, rgba(167,139,250,.35), transparent 45%), linear-gradient(135deg, var(--sc-teal-900) 0%, var(--sc-teal-700) 55%, var(--sc-teal-600) 100%);
        box-shadow: 0 22px 50px rgba(10,77,79,.28);
        color: #fff;
    }

        .dp-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.09) 1px, transparent 1px);
            background-size: 18px 18px;
            mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
            -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
            pointer-events: none;
        }

    .dp-hero-row {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .dp-hero-brand {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .dp-hero-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.2);
        backdrop-filter: blur(6px);
        flex-shrink: 0;
    }

    .dp-hero h1 {
        margin: 0;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: .2px;
        text-transform: capitalize;
    }

    .dp-hero-brand p {
        margin: 3px 0 0;
        font-size: .84rem;
        font-weight: 600;
        color: rgba(255,255,255,.82);
    }

    .btn-hero-search {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: var(--sc-teal-800);
        padding: 11px 20px;
        border-radius: 12px;
        font-weight: 800;
        font-size: .88rem;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(0,0,0,.16);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-hero-search:hover {
            color: var(--sc-teal-800);
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(0,0,0,.22);
        }

    .dp-toolbar {
        position: relative;
        z-index: 1;
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.14);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .dp-title h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dp-title p {
        margin: 4px 0 0;
        font-size: .82rem;
        font-weight: 700;
        color: rgba(255,255,255,.8);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .dp-live {
        display: none;
        align-items: center;
        gap: 6px;
        font-size: .68rem;
        font-weight: 800;
        color: #bbf7d0;
        background: rgba(34,197,94,.18);
        border: 1px solid rgba(34,197,94,.35);
        padding: 2px 10px;
        border-radius: 999px;
    }

        .dp-live.on {
            display: inline-flex;
        }

    .dp-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        position: relative;
    }

        .dp-live-dot::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: #4ade80;
            animation: dpPing 1.6s cubic-bezier(0,0,.2,1) infinite;
        }

    @@keyframes dpPing {
        75%, 100% {
            transform: scale(2.6);
            opacity: 0;
        }
    }

    .dp-controls {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .dp-seg {
        position: relative;
        display: inline-flex;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 14px;
        padding: 4px;
        backdrop-filter: blur(8px);
    }

        .dp-seg button {
            position: relative;
            z-index: 1;
            border: none;
            background: none;
            padding: 8px 16px;
            font-weight: 800;
            font-size: .82rem;
            color: rgba(255,255,255,.85);
            border-radius: 10px;
            cursor: pointer;
            transition: color .25s ease;
            white-space: nowrap;
        }

            .dp-seg button.active {
                color: var(--sc-teal-800);
            }

    .dp-seg-glider {
        position: absolute;
        top: 4px;
        bottom: 4px;
        left: 4px;
        width: 0;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 6px 16px rgba(0,0,0,.18);
        transition: left .4s cubic-bezier(.3,1.35,.5,1), width .4s cubic-bezier(.3,1.35,.5,1);
        z-index: 0;
    }

    .dp-custom {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        padding: 5px 8px;
        animation: dpPop .25s ease;
    }

        .dp-custom[hidden] {
            display: none;
        }

        .dp-custom input {
            border: none;
            border-radius: 8px;
            padding: 6px 8px;
            font-size: .8rem;
            color: var(--sc-ink-900);
            background: #fff;
            outline: none;
        }

        .dp-custom span {
            font-size: .78rem;
            font-weight: 700;
            color: rgba(255,255,255,.85);
        }

    .dp-icon-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,.22);
        background: rgba(255,255,255,.1);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        transition: transform .2s ease, background .2s ease, color .2s ease;
    }

        .dp-icon-btn:hover {
            background: #fff;
            color: var(--sc-teal-800);
            transform: translateY(-2px);
        }

        .dp-icon-btn.small {
            width: auto;
            height: 34px;
            padding: 0 12px;
            gap: 6px;
            font-size: .8rem;
            font-weight: 800;
        }

        .dp-icon-btn.light {
            border-color: var(--sc-sky-100);
            background: #fff;
            color: var(--sc-teal-700);
        }

            .dp-icon-btn.light:hover {
                background: var(--sc-teal-600);
                color: #fff;
            }

    .dp-shell.loading #dpRefresh i {
        animation: dpSpin .8s linear infinite;
    }

    @@keyframes dpSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .dp-progress {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3px;
        overflow: hidden;
        opacity: 0;
        transition: opacity .2s;
        z-index: 2;
    }

        .dp-progress::before {
            content: '';
            position: absolute;
            inset: 0;
            width: 40%;
            background: linear-gradient(90deg, transparent, #5eead4, #c4b5fd, transparent);
            animation: dpIndeterminate 1.1s ease-in-out infinite;
        }

    .dp-shell.loading .dp-progress {
        opacity: 1;
    }

    @@keyframes dpIndeterminate {
        from {
            transform: translateX(-120%);
        }

        to {
            transform: translateX(320%);
        }
    }

    .dp-shell.loading .dp-kpi-value,
    .dp-shell.loading .dp-bars,
    .dp-shell.loading .dp-donut-wrap,
    .dp-shell.loading .dp-table {
        opacity: .45;
        transition: opacity .2s;
    }

    /* ══════════ KPI cards (overlap hero) ══════════ */
    .dp-body {
        position: relative;
        z-index: 2;
        margin-top: -62px;
        padding: 0 14px;
    }

    .dp-kpis {
        display: grid;
        grid-template-columns: 1.55fr 1fr 1fr 1fr;
        gap: 14px;
        margin-bottom: 18px;
    }

    .dp-kpi {
        position: relative;
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(255,255,255,.8);
        border-radius: var(--radius-lg);
        padding: 18px;
        box-shadow: var(--shadow-card);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
        animation: dpRise .5s cubic-bezier(.2,1,.3,1) backwards;
        min-width: 0;
    }

        .dp-kpi:nth-child(1) {
            animation-delay: .1s;
        }

        .dp-kpi:nth-child(2) {
            animation-delay: .17s;
        }

        .dp-kpi:nth-child(3) {
            animation-delay: .24s;
        }

        .dp-kpi:nth-child(4) {
            animation-delay: .31s;
        }

        .dp-kpi:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .dp-kpi::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--sc-teal-500), var(--sc-teal-700));
            opacity: .9;
        }

        .dp-kpi.general::after {
            background: linear-gradient(90deg, var(--dp-general-2), var(--dp-general));
        }

        .dp-kpi.ortho::after {
            background: linear-gradient(90deg, var(--dp-ortho-2), var(--dp-ortho));
        }

        .dp-kpi.count::after {
            background: linear-gradient(90deg, #fbbf24, #d97706);
        }

    .dp-kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .dp-kpi-label {
        font-size: .78rem;
        font-weight: 800;
        color: var(--sc-ink-600);
    }

    .dp-kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .95rem;
        background: var(--sc-sky-50);
        color: var(--sc-teal-600);
    }

    .dp-kpi.general .dp-kpi-icon {
        background: #ccfbf1;
        color: var(--dp-general);
    }

    .dp-kpi.ortho .dp-kpi-icon {
        background: #ede9fe;
        color: var(--dp-ortho);
    }

    .dp-kpi.count .dp-kpi-icon {
        background: #fef3c7;
        color: #d97706;
    }

    .dp-kpi-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--sc-ink-900);
        line-height: 1.2;
        white-space: nowrap;
    }

        .dp-kpi-value small {
            font-size: .72rem;
            font-weight: 700;
            color: var(--sc-ink-600);
        }

    .dp-kpi-sub {
        margin-top: 8px;
        font-size: .74rem;
        font-weight: 700;
        color: var(--sc-ink-600);
    }

    .dp-kpi-chip {
        font-size: .7rem;
        font-weight: 800;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--sc-sky-50);
        color: var(--sc-teal-700);
        white-space: nowrap;
    }

    .dp-kpi-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 10px;
    }

        .dp-kpi-split > div {
            background: var(--sc-sky-50);
            border-radius: 10px;
            padding: 6px 10px;
            min-width: 0;
        }

        .dp-kpi-split span {
            display: block;
            font-size: .66rem;
            font-weight: 800;
            color: var(--sc-ink-600);
        }

        .dp-kpi-split b {
            font-size: .95rem;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

            .dp-kpi-split b.paid {
                color: var(--dp-paid);
            }

            .dp-kpi-split b.remain {
                color: var(--dp-due);
            }

    .dp-kpi-track {
        margin-top: 10px;
        height: 6px;
        border-radius: 6px;
        background: var(--sc-sky-100);
        overflow: hidden;
    }

    .dp-kpi-fill {
        height: 100%;
        width: 0;
        border-radius: 6px;
        transition: width 1s cubic-bezier(.3,1,.4,1);
    }

    .dp-kpi.general .dp-kpi-fill {
        background: linear-gradient(90deg, var(--dp-general-2), var(--dp-general));
    }

    .dp-kpi.ortho .dp-kpi-fill {
        background: linear-gradient(90deg, var(--dp-ortho-2), var(--dp-ortho));
    }

    /* الكارت الرئيسي + حلقة نسبة السداد */
    .dp-kpi-main {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 14px;
        align-items: center;
    }

        .dp-kpi-main .dp-kpi-value {
            font-size: 1.85rem;
        }

    .dp-ring {
        position: relative;
        width: 92px;
        height: 92px;
        flex-shrink: 0;
    }

        .dp-ring svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .dp-ring circle {
            fill: none;
            stroke-width: 9;
        }

    .dp-ring-track {
        stroke: var(--sc-sky-100);
    }

    .dp-ring-arc {
        stroke: url(#dpRingGrad);
        stroke-linecap: round;
        stroke-dasharray: 0 214;
        transition: stroke-dasharray 1.1s cubic-bezier(.3,1,.4,1);
    }

    .dp-ring-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1.1;
    }

        .dp-ring-center b {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--sc-ink-900);
        }

        .dp-ring-center span {
            font-size: .62rem;
            font-weight: 800;
            color: var(--sc-ink-600);
        }

    .dp-kpi-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px dashed var(--sc-sky-100);
        font-size: .76rem;
        font-weight: 700;
        color: var(--sc-ink-600);
    }

        .dp-kpi-foot b {
            color: var(--sc-ink-900);
        }

    .dp-trend {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .7rem;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 999px;
        white-space: nowrap;
        animation: dpPop .35s ease;
    }

        .dp-trend.up {
            background: #dcfce7;
            color: #15803d;
        }

        .dp-trend.down {
            background: #fee2e2;
            color: #b91c1c;
        }

        .dp-trend.flat {
            background: var(--sc-sky-50);
            color: var(--sc-ink-600);
        }

    /* ══════════ Cards ══════════ */
    .dp-card {
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
        padding: 18px 20px;
        animation: dpRise .55s .25s cubic-bezier(.2,1,.3,1) backwards;
        min-width: 0;
        margin-bottom: 16px;
    }

    .dp-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

        .dp-card-head h5 {
            margin: 0;
            font-weight: 800;
            font-size: .98rem;
            color: var(--sc-ink-900);
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .dp-card-head h5 .hicon {
                width: 30px;
                height: 30px;
                border-radius: 9px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--sc-sky-50);
                color: var(--sc-teal-600);
                font-size: .9rem;
            }

        .dp-card-head small {
            display: block;
            margin-top: 2px;
            margin-right: 39px;
            font-size: .74rem;
            color: var(--sc-ink-600);
            font-weight: 700;
        }

    .dp-grid-2 {
        display: grid;
        grid-template-columns: 1.9fr 1fr;
        gap: 16px;
    }

    .dp-side {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .dp-legend {
        display: flex;
        gap: 12px;
        font-size: .74rem;
        font-weight: 800;
        color: var(--sc-ink-600);
    }

        .dp-legend span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .dp-legend i {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            display: inline-block;
        }

    .dp-dot-general {
        background: var(--dp-general);
    }

    .dp-dot-ortho {
        background: var(--dp-ortho);
    }

    /* ══════════ Table ══════════ */
    .dp-table-tools {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .dp-chips {
        display: inline-flex;
        gap: 4px;
        padding: 4px;
        background: var(--sc-sky-50);
        border-radius: 12px;
    }

    .dp-chip {
        border: none;
        background: transparent;
        color: var(--sc-ink-600);
        font-weight: 800;
        font-size: .78rem;
        padding: 6px 12px;
        border-radius: 9px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .2s ease;
    }

        .dp-chip b {
            background: #fff;
            color: var(--sc-teal-700);
            border-radius: 999px;
            padding: 0 7px;
            font-size: .68rem;
            min-width: 20px;
            text-align: center;
        }

        .dp-chip:hover {
            color: var(--sc-teal-700);
        }

        .dp-chip.active {
            background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
            color: #fff;
            box-shadow: 0 4px 12px rgba(13,148,136,.28);
        }

            .dp-chip.active b {
                background: rgba(255,255,255,.22);
                color: #fff;
            }

        .dp-chip.ortho.active {
            background: linear-gradient(135deg, var(--dp-ortho-2), var(--dp-ortho));
            box-shadow: 0 4px 12px rgba(124,58,237,.28);
        }

    .dp-search {
        position: relative;
    }

        .dp-search input {
            border: 1.5px solid var(--sc-sky-100);
            border-radius: 10px;
            padding: 7px 34px 7px 12px;
            font-size: .82rem;
            width: 230px;
            outline: none;
            background: #fff;
            transition: border-color .2s, box-shadow .2s;
        }

            .dp-search input:focus {
                border-color: var(--sc-teal-500);
                box-shadow: 0 0 0 3px rgba(20,184,166,.12);
            }

        .dp-search i {
            position: absolute;
            right: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--sc-ink-600);
            font-size: .82rem;
        }

    .dp-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--sc-sky-100);
        border-radius: 14px;
    }

    .dp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .86rem;
        min-width: 1040px;
    }

        .dp-table thead th {
            text-align: right;
