@{
    ViewData["Title"] = "الفواتير والمدفوعات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --sc-teal-900: #0a4d4f;
        --sc-teal-700: #0d7377;
        --sc-teal-600: #0f9b8e;
        --sc-teal-500: #14b8a6;
        --sc-teal-100: #c7f2ea;
        --sc-sky-50: #eafbfc;
        --sc-sky-100: #dcf5f7;
        --sc-coral-300: #f6c6bc;
        --sc-ink-900: #0b2e30;
        --sc-ink-600: #4b6b6c;
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-light: #f0fdfa;
        --radius-lg: 18px;
        --radius-md: 12px;
        --shadow-soft: 0 1px 3px rgba(15, 23, 42, 0.06);
        --shadow-hover: 0 10px 26px rgba(10, 77, 79, 0.12);
        --shadow-card: 0 20px 50px rgba(10, 77, 79, .08);
        /* ⭐ ألوان لوحة المدفوعات اليومية */
        --dp-general: #0f9b8e;
        --dp-general-2: #14b8a6;
        --dp-ortho: #7c3aed;
        --dp-ortho-2: #a78bfa;
    }

    body {
        background: radial-gradient(circle at 6% 4%, var(--sc-teal-100) 0%, transparent 38%), radial-gradient(circle at 97% 92%, var(--sc-coral-300) 0%, transparent 26%), var(--sc-sky-50);
    }

    /* ── Hero ── */
    .payments-hero {
        background: linear-gradient(135deg, var(--sc-teal-700), var(--sc-teal-500));
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 14px 34px rgba(13, 115, 119, .28);
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
        position: relative;
        overflow: hidden;
        contain: content;
    }

        .payments-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 92% -20%, rgba(255,255,255,.32), transparent 55%);
            pointer-events: none;
        }

        .payments-hero .hero-content {
            display: flex;
            align-items: center;
            gap: 18px;
            position: relative;
            z-index: 1;
        }

        .payments-hero .hero-icon {
            width: 56px;
            height: 56px;
            background: rgba(255,255,255,.18);
            color: #fff;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255,255,255,.15);
        }

        .payments-hero h1 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            color: #fff;
        }

        .payments-hero p {
            font-size: 0.85rem;
            margin: 4px 0 0;
            color: rgba(255,255,255,.9);
            font-weight: 600;
        }

    .btn-hero-search {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.92);
        color: var(--sc-teal-700);
        padding: 11px 20px;
        border-radius: 12px;
        font-weight: 800;
        font-size: .88rem;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(10,40,42,.15);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-hero-search:hover {
            color: var(--sc-teal-700);
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(10,40,42,.22);
        }

   
    /* ══════════════════════════════════════════════
           ⭐ Daily Payments Dashboard
           ══════════════════════════════════════════════ */
    .dp-shell {
        margin-top: 36px;
        position: relative;
        animation: dpRise .6s .15s cubic-bezier(.2,1,.3,1) backwards;
    }

    @@keyframes dpRise {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* شريط تحميل علوي */
    .dp-progress {
        position: absolute;
        top: -10px;
        left: 0;
        right: 0;
        height: 3px;
        border-radius: 3px;
        overflow: hidden;
        opacity: 0;
        transition: opacity .2s;
    }

        .dp-progress::before {
            content: '';
            position: absolute;
            inset: 0;
            width: 40%;
            background: linear-gradient(90deg, transparent, var(--sc-teal-500), var(--dp-ortho-2), transparent);
            animation: dpIndeterminate 1.1s ease-in-out infinite;
        }

    .dp-shell.loading .dp-progress {
        opacity: 1;
    }

    @@keyframes dpIndeterminate {
        from {
            transform: translateX(-120%);
        }

        to {
            transform: translateX(320%);
        }
    }

    .dp-shell.loading .dp-kpi-value,
    .dp-shell.loading .dp-bars,
    .dp-shell.loading .dp-donut-wrap {
        opacity: .45;
        transition: opacity .2s;
    }

    /* Head */
    .dp-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 18px;
    }

    .dp-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .dp-title-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 8px 20px rgba(13,148,136,.28);
        flex-shrink: 0;
    }

    .dp-title h3 {
        margin: 0;
        font-weight: 800;
        font-size: 1.2rem;
        color: var(--sc-ink-900);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dp-title p {
        margin: 3px 0 0;
        font-size: .8rem;
        color: var(--sc-ink-600);
        font-weight: 700;
    }

    .dp-live {
        display: none;
        align-items: center;
        gap: 6px;
        font-size: .7rem;
        font-weight: 800;
        color: #15803d;
        background: #dcfce7;
        padding: 3px 10px;
        border-radius: 999px;
    }

        .dp-live.on {
            display: inline-flex;
        }

    .dp-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        position: relative;
    }

        .dp-live-dot::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: #22c55e;
            animation: dpPing 1.6s cubic-bezier(0,0,.2,1) infinite;
        }

    @@keyframes dpPing {
        75%, 100% {
            transform: scale(2.6);
            opacity: 0;
        }
    }

    .dp-controls {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    /* Segmented control بـ glider متحرك */
    .dp-seg {
        position: relative;
        display: inline-flex;
        background: rgba(255,255,255,.88);
        border: 1px solid var(--sc-sky-100);
        border-radius: 14px;
        padding: 4px;
        box-shadow: var(--shadow-soft);
    }

        .dp-seg button {
            position: relative;
            z-index: 1;
            border: none;
            background: none;
            padding: 8px 16px;
            font-weight: 800;
            font-size: .82rem;
            color: var(--sc-ink-600);
            border-radius: 10px;
            cursor: pointer;
            transition: color .25s ease;
            white-space: nowrap;
        }

            .dp-seg button.active {
                color: #fff;
            }

    .dp-seg-glider {
        position: absolute;
        top: 4px;
        bottom: 4px;
        left: 4px;
        width: 0;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
        box-shadow: 0 6px 14px rgba(13,148,136,.32);
        transition: left .4s cubic-bezier(.3,1.35,.5,1), width .4s cubic-bezier(.3,1.35,.5,1);
        z-index: 0;
    }

    .dp-custom {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.88);
        border: 1px solid var(--sc-sky-100);
        border-radius: 12px;
        padding: 5px 8px;
        animation: dpPop .25s ease;
    }

        .dp-custom[hidden] {
            display: none;
        }

        .dp-custom input {
            border: 1px solid var(--sc-sky-100);
            border-radius: 8px;
            padding: 5px 8px;
            font-size: .8rem;
            color: var(--sc-ink-900);
            outline: none;
        }

            .dp-custom input:focus {
                border-color: var(--sc-teal-500);
            }

        .dp-custom span {
            font-size: .78rem;
            font-weight: 700;
            color: var(--sc-ink-600);
        }

    @@keyframes dpPop {
        from {
            opacity: 0;
            transform: scale(.92);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .dp-icon-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid var(--sc-sky-100);
        background: rgba(255,255,255,.88);
        color: var(--sc-teal-700);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease;
    }

        .dp-icon-btn:hover {
            background: var(--sc-teal-600);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(13,148,136,.28);
        }

        .dp-icon-btn.small {
            width: auto;
            padding: 0 12px;
            gap: 6px;
            font-size: .8rem;
            font-weight: 800;
            height: 36px;
        }

    .dp-shell.loading #dpRefresh i {
        animation: dpSpin .8s linear infinite;
    }

    @@keyframes dpSpin {
        to {
            transform: rotate(360deg);
        }
    }

    /* KPI cards */
    .dp-kpis {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr 1fr;
        gap: 14px;
        margin-bottom: 16px;
    }

    .dp-kpi {
        position: relative;
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 18px;
        padding: 18px;
        box-shadow: var(--shadow-soft);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
        animation: dpRise .5s cubic-bezier(.2,1,.3,1) backwards;
    }

        .dp-kpi:nth-child(1) {
            animation-delay: .2s;
        }

        .dp-kpi:nth-child(2) {
            animation-delay: .27s;
        }

        .dp-kpi:nth-child(3) {
            animation-delay: .34s;
        }

        .dp-kpi:nth-child(4) {
            animation-delay: .41s;
        }

        .dp-kpi:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

    .dp-kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .dp-kpi-label {
        font-size: .78rem;
        font-weight: 800;
        color: var(--sc-ink-600);
    }

    .dp-kpi-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        background: var(--sc-sky-50);
        color: var(--sc-teal-600);
    }

    .dp-kpi.general .dp-kpi-icon {
        background: #ccfbf1;
        color: var(--dp-general);
    }

    .dp-kpi.ortho .dp-kpi-icon {
        background: #ede9fe;
        color: var(--dp-ortho);
    }

    .dp-kpi-value {
        font-size: 1.55rem;
        font-weight: 800;
        color: var(--sc-ink-900);
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

        .dp-kpi-value small {
            font-size: .72rem;
            font-weight: 700;
            color: var(--sc-ink-600);
        }

    .dp-kpi-sub {
        margin-top: 6px;
        font-size: .74rem;
        font-weight: 700;
        color: var(--sc-ink-600);
    }

    .dp-kpi-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 10px;
    }

        .dp-kpi-split > div {
            background: var(--sc-sky-50);
            border-radius: 10px;
            padding: 6px 10px;
        }

        .dp-kpi-split span {
            display: block;
            font-size: .68rem;
            font-weight: 800;
            color: var(--sc-ink-600);
        }

        .dp-kpi-split b {
            font-size: .92rem;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
        }

            .dp-kpi-split b.paid {
                color: #047857;
            }

            .dp-kpi-split b.remain {
                color: #b91c1c;
            }

    .dp-kpi-chip {
        font-size: .7rem;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 999px;
        background: var(--sc-sky-50);
        color: var(--sc-teal-700);
    }

    /* نسخة الكارت الرئيسي (خلفية غامقة) */
    .dp-kpi-hero .dp-kpi-split > div {
        background: rgba(255,255,255,.12);
    }

    .dp-kpi-hero .dp-kpi-split span {
        color: rgba(255,255,255,.8);
    }

    .dp-kpi-hero .dp-kpi-split b.paid {
        color: #bbf7d0;
    }

    .dp-kpi-hero .dp-kpi-split b.remain {
        color: #fecaca;
    }

    .dp-kpi-hero .dp-kpi-chip {
        background: rgba(255,255,255,.16);
        color: #fff;
    }

    .dp-kpi-hero .dp-kpi-sub {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
    }

        .dp-kpi-hero .dp-kpi-sub b {
            color: #fff;
        }

    .dp-kpi-track {
        margin-top: 10px;
        height: 6px;
        border-radius: 6px;
        background: var(--sc-sky-100);
        overflow: hidden;
    }

    .dp-kpi-fill {
        height: 100%;
        width: 0;
        border-radius: 6px;
        transition: width 1s cubic-bezier(.3,1,.4,1);
    }

    .dp-kpi.general .dp-kpi-fill {
        background: linear-gradient(90deg, var(--dp-general-2), var(--dp-general));
    }

    .dp-kpi.ortho .dp-kpi-fill {
        background: linear-gradient(90deg, var(--dp-ortho-2), var(--dp-ortho));
    }

    /* الكارت الرئيسي */
    .dp-kpi-hero {
        background: linear-gradient(135deg, var(--sc-teal-900), var(--sc-teal-600));
        border: none;
        color: #fff;
        box-shadow: 0 16px 36px rgba(10,77,79,.3);
    }

        .dp-kpi-hero .dp-kpi-label,
        .dp-kpi-hero .dp-kpi-sub,
        .dp-kpi-hero .dp-kpi-value small {
            color: rgba(255,255,255,.85);
        }

        .dp-kpi-hero .dp-kpi-value {
            color: #fff;
            font-size: 1.9rem;
        }

        .dp-kpi-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -40%;
            width: 45%;
            height: 200%;
            background: linear-gradient(105deg, transparent, rgba(255,255,255,.18), transparent);
            transform: rotate(14deg);
            animation: dpShine 5s ease-in-out infinite;
            pointer-events: none;
        }

    @@keyframes dpShine {
        0%, 100% {
            right: -40%;
        }

        50% {
            right: 110%;
        }
    }

    .dp-kpi-bg {
        position: absolute;
        left: -6px;
        bottom: -14px;
        font-size: 5.2rem;
        color: rgba(255,255,255,.08);
        pointer-events: none;
        animation: dpFloat 5s ease-in-out infinite;
    }

    @@keyframes dpFloat {
        0%, 100% {
            transform: translateY(0) rotate(-8deg);
        }

        50% {
            transform: translateY(-8px) rotate(-3deg);
        }
    }

    .dp-trend {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .72rem;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 999px;
        animation: dpPop .35s ease;
    }

        .dp-trend.up {
            background: rgba(34,197,94,.22);
            color: #bbf7d0;
        }

        .dp-trend.down {
            background: rgba(239,68,68,.25);
            color: #fecaca;
        }

        .dp-trend.flat {
            background: rgba(255,255,255,.16);
            color: rgba(255,255,255,.85);
        }

    /* Cards */
    .dp-grid-2 {
        display: grid;
        grid-template-columns: 1.9fr 1fr;
        gap: 14px;
        margin-bottom: 16px;
    }

    .dp-card {
        background: rgba(255,255,255,.85);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 18px;
        box-shadow: var(--shadow-card);
        padding: 18px 20px;
        animation: dpRise .55s .3s cubic-bezier(.2,1,.3,1) backwards;
        min-width: 0;
    }

    .dp-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

        .dp-card-head h5 {
            margin: 0;
            font-weight: 800;
            font-size: .95rem;
            color: var(--sc-ink-900);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dp-card-head h5 i {
                color: var(--sc-teal-600);
            }

        .dp-card-head small {
            font-size: .74rem;
            color: var(--sc-ink-600);
            font-weight: 700;
        }

    .dp-legend {
        display: flex;
        gap: 12px;
        font-size: .74rem;
        font-weight: 800;
        color: var(--sc-ink-600);
    }

        .dp-legend span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .dp-legend i {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            display: inline-block;
        }

    .dp-dot-general {
        background: var(--dp-general);
    }

    .dp-dot-ortho {
        background: var(--dp-ortho);
    }

    /* Bar chart */
    .dp-bars-wrap {
        position: relative;
        background-image: repeating-linear-gradient(to top, var(--sc-sky-100) 0 1px, transparent 1px 25%);
        background-size: 100% calc(100% - 22px);
        background-repeat: no-repeat;
        border-radius: 8px;
    }

    .dp-bars {
        display: flex;
        align-items: stretch;
        gap: 6px;
        height: 230px;
        padding: 4px 2px 0;
    }

    .dp-bar-col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
    }

    .dp-bar-stack {
        flex: 1;
        width: 100%;
        max-width: 38px;
        display: flex;
        flex-direction: column-reverse;
        border-radius: 8px 8px 3px 3px;
        transition: background .2s ease, transform .2s ease;
    }

    .dp-bar-col:hover .dp-bar-stack {
        background: rgba(13,148,136,.07);
        transform: translateY(-2px);
    }

    .dp-bar-seg {
        height: 0;
        flex-shrink: 0;
        transition: height .85s cubic-bezier(.2,1.25,.35,1);
        transition-delay: calc(var(--i, 0) * 28ms);
    }

    .dp-bars.ready .dp-bar-seg {
        height: var(--h);
    }

    .dp-bar-seg.general {
        background: linear-gradient(180deg, var(--dp-general-2), var(--dp-general));
        border-radius: 0 0 3px 3px;
    }

        .dp-bar-seg.general.solo {
            border-radius: 7px 7px 3px 3px;
        }

    .dp-bar-seg.ortho {
        background: linear-gradient(180deg, var(--dp-ortho-2), var(--dp-ortho));
        border-radius: 7px 7px 0 0;
    }

    .dp-bar-label {
        font-size: .64rem;
        color: var(--sc-ink-600);
        font-weight: 800;
        margin-top: 6px;
        height: 16px;
        white-space: nowrap;
    }

    .dp-bar-col.is-today .dp-bar-label {
        color: var(--sc-teal-700);
    }

    /* Tooltip (متضاف للـ body عشان backdrop-filter مايحبسوش) */
    .dp-tip {
        position: fixed;
        z-index: 3000;
        background: #0b2e30;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: .78rem;
        line-height: 1.7;
        min-width: 170px;
        box-shadow: 0 14px 34px rgba(0,0,0,.28);
        pointer-events: none;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity .15s ease, transform .15s ease;
        direction: rtl;
    }

        .dp-tip.show {
            opacity: 1;
            transform: translateY(0);
        }

        .dp-tip .tt-h {
            font-weight: 800;
            color: #5eead4;
            border-bottom: 1px solid rgba(255,255,255,.12);
            padding-bottom: 5px;
            margin-bottom: 5px;
        }

        .dp-tip .tt-r {
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

            .dp-tip .tt-r span {
                color: #94a3b8;
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .dp-tip .tt-r i {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                display: inline-block;
            }

    /* Donut */
    .dp-donut-wrap {
        position: relative;
        width: 180px;
        height: 180px;
        margin: 4px auto 16px;
    }

    .dp-donut {
        width: 100%;
