                    <span class="dp-kpi-label">عام — المطلوب</span>
                    <span class="dp-kpi-icon"><i class="bi bi-heart-pulse"></i></span>
                </div>
                <div class="dp-kpi-value"><span id="dpKpiGeneral">0</span> <small>ج.م</small></div>
                <div class="dp-kpi-split">
                    <div><span>المدفوع</span><b class="paid" id="dpKpiGeneralPaid">0</b></div>
                    <div><span>الباقي</span><b class="remain" id="dpKpiGeneralRemain">0</b></div>
                </div>
                <div class="dp-kpi-track"><div class="dp-kpi-fill" id="dpKpiGeneralBar"></div></div>
                <div class="dp-kpi-sub" id="dpKpiGeneralSub">—</div>
            </div>

            <div class="dp-kpi ortho">
                <div class="dp-kpi-top">
                    <span class="dp-kpi-label">تقويم — المحصّل</span>
                    <span class="dp-kpi-icon"><i class="bi bi-emoji-smile"></i></span>
                </div>
                <div class="dp-kpi-value"><span id="dpKpiOrtho">0</span> <small>ج.م</small></div>
                <div class="dp-kpi-sub" id="dpKpiOrthoSub">—</div>
            </div>
        </div>

        <!-- Insights -->
        <div class="dp-insights">
            <div class="dp-ins">
                <div class="dp-ins-icon amber"><i class="bi bi-lightning-charge"></i></div>
                <div class="dp-ins-body">
                    <div class="dp-ins-title">ساعة الذروة</div>
                    <div class="dp-ins-value" id="dpInsPeak">—</div>
                    <div class="dp-ins-sub" id="dpInsPeakSub">—</div>
                </div>
            </div>
            <div class="dp-ins">
                <div class="dp-ins-icon rose"><i class="bi bi-trophy"></i></div>
                <div class="dp-ins-body">
                    <div class="dp-ins-title" id="dpInsBestTitle">أكبر دفعة</div>
                    <div class="dp-ins-value" id="dpInsBest">—</div>
                    <div class="dp-ins-sub" id="dpInsBestSub">—</div>
                </div>
            </div>
            <div class="dp-ins">
                <div class="dp-ins-icon blue"><i class="bi bi-credit-card-2-back"></i></div>
                <div class="dp-ins-body">
                    <div class="dp-ins-title">الطريقة الأكثر استخدامًا</div>
                    <div class="dp-ins-value" id="dpInsMethod">—</div>
                    <div class="dp-ins-sub" id="dpInsMethodSub">—</div>
                </div>
            </div>
            <div class="dp-ins">
                <div class="dp-ins-icon green"><i class="bi bi-calculator"></i></div>
                <div class="dp-ins-body">
                    <div class="dp-ins-title">متوسط الدفعة</div>
                    <div class="dp-ins-value" id="dpInsAvg">—</div>
                    <div class="dp-ins-sub" id="dpInsAvgSub">—</div>
                </div>
            </div>
        </div>

        <!-- Table (full width) -->
        <div class="dp-card">
            <div class="dp-card-head">
                <h5><span class="hicon"><i class="bi bi-list-ul"></i></span> تفاصيل الدفعات</h5>
                <div class="dp-table-tools">
                    <div class="dp-chips" id="dpCatChips">
                        <button type="button" class="dp-chip active" data-cat="all">الكل <b id="dpCntAll">0</b></button>
                        <button type="button" class="dp-chip" data-cat="general">عام <b id="dpCntGeneral">0</b></button>
                        <button type="button" class="dp-chip ortho" data-cat="ortho">تقويم <b id="dpCntOrtho">0</b></button>
                    </div>
                    <div class="dp-search">
                        <input type="text" id="dpSearch" placeholder="مريض / موبايل / إيصال..." autocomplete="off" />
                        <i class="bi bi-search"></i>
                    </div>
                    <button type="button" class="dp-icon-btn small light" id="dpExport" title="تصدير Excel"><i class="bi bi-file-earmark-spreadsheet"></i> تصدير</button>
                </div>
            </div>
            <div class="dp-table-wrap">
                <table class="dp-table">
                    <thead>
                        <tr>
                            <th>التاريخ / الوقت</th>
                            <th>المريض</th>
                            <th>النوع</th>
                            <th>الدفعة</th>
                            <th class="grp">مطلوب الزيارة</th>
                            <th>مدفوع الزيارة</th>
                            <th>الخصم</th>
                            <th>باقي الزيارة</th>
                            <th class="grp">رصيد المريض</th>
                            <th class="grp">الطريقة</th>
                        </tr>
                    </thead>
                    <tbody id="dpTbody"></tbody>
                </table>
                <div class="dp-empty" id="dpEmpty" style="display:none;">
                    <i class="bi bi-inbox"></i>
                    لا توجد دفعات في الفترة دي
                </div>
            </div>
            <div class="dp-table-foot">
                <span class="dp-table-sum" id="dpTableSum">—</span>
                <button type="button" class="dp-load-more" id="dpLoadMore" style="display:none;">عرض المزيد <i class="bi bi-chevron-down"></i></button>
            </div>
        </div>

        <!-- Chart + side (split + methods) -->
        <div class="dp-grid-2">
            <div class="dp-card">
                <div class="dp-card-head">
                    <div>
                        <h5><span class="hicon"><i class="bi bi-bar-chart-line"></i></span> حركة التحصيل</h5>
                        <small id="dpChartSub">—</small>
                    </div>
                    <div class="dp-legend">
                        <span><i class="dp-dot-general"></i> عام</span>
                        <span><i class="dp-dot-ortho"></i> تقويم</span>
                    </div>
                </div>
                <div class="dp-chart">
                    <div class="dp-yaxis" id="dpYAxis"></div>
                    <div class="dp-bars-wrap">
                        <div class="dp-bars" id="dpBars"></div>
                    </div>
                </div>
            </div>

            <div class="dp-side">
                <div class="dp-card">
                    <div class="dp-card-head">
                        <h5><span class="hicon"><i class="bi bi-pie-chart"></i></span> عام / تقويم</h5>
                    </div>
                    <div class="dp-donut-wrap">
                        <svg class="dp-donut" viewBox="0 0 140 140">
                            <circle class="dp-donut-track" cx="70" cy="70" r="54" />
                            <circle class="dp-donut-arc general" id="dpArcGeneral" cx="70" cy="70" r="54" />
                            <circle class="dp-donut-arc ortho" id="dpArcOrtho" cx="70" cy="70" r="54" />
                        </svg>
                        <div class="dp-donut-center">
                            <b id="dpDonutCount">0</b>
                            <span>دفعة</span>
                        </div>
                    </div>
                    <div class="dp-split-row">
                        <span class="lbl"><i class="dp-dot-general"></i> عام</span>
                        <span class="val"><span id="dpSplitGeneral">0</span><small id="dpSplitGeneralSub">—</small></span>
                    </div>
                    <div class="dp-split-row">
                        <span class="lbl"><i class="dp-dot-ortho"></i> تقويم</span>
                        <span class="val"><span id="dpSplitOrtho">0</span><small id="dpSplitOrthoSub">—</small></span>
                    </div>
                </div>

                <div class="dp-card">
                    <div class="dp-card-head">
                        <h5><span class="hicon"><i class="bi bi-wallet2"></i></span> طرق الدفع</h5>
                    </div>
                    <div class="dp-methods" id="dpMethods"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="dp-tip" id="dpTip"></div>
</section>

@section Scripts {
    <script>
        // ══════════════════════════════════════════════
        // ⭐ Daily Payments Dashboard
        // ══════════════════════════════════════════════
        (function () {
            const PAGE = 12;
            const REFRESH_MS = 60000;
            const DONUT_C = 2 * Math.PI * 54;
            const RING_C = 2 * Math.PI * 34;
            const METHOD_ICONS = { 0: 'bi-cash-coin', 1: 'bi-credit-card', 2: 'bi-credit-card-2-front', 3: 'bi-bank', 4: 'bi-shield-check', 5: 'bi-calendar3' };

            const $ = id => document.getElementById(id);
            const shell = $('dpShell');
            const state = {
                range: 'today', data: null, cat: 'all', term: '',
                filtered: [], shown: 0, knownIds: null, newIds: new Set(),
                buckets: [], timer: null, seq: 0, from: '', to: ''
            };

            // ── Helpers ──
            const fmt = n => Number(n || 0).toLocaleString('ar-EG', { maximumFractionDigits: 2 });
            const fmtInt = n => Math.round(Number(n || 0)).toLocaleString('ar-EG');
            const compactFmt = new Intl.NumberFormat('ar-EG', { notation: 'compact', maximumFractionDigits: 1 });
            const fmtCompact = n => compactFmt.format(n);
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const pct = (part, total) => total > 0 ? (part / total * 100) : 0;
            const pad = n => String(n).padStart(2, '0');

            // تاريخ محلي من غير UTC shift (للـ API: yyyy-MM-dd)
            function isoLocal(d) {
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
            }
            function todayIso() { return isoLocal(new Date()); }

            // ⭐ عرض التاريخ بصيغة dd/MM/yyyy
            function fmtDate(d) {
                const x = d instanceof Date ? d : new Date(d);
                return `${pad(x.getDate())}/${pad(x.getMonth() + 1)}/${x.getFullYear()}`;
            }
            function fmtDayMonth(d) {
                const x = d instanceof Date ? d : new Date(d);
                return `${pad(x.getDate())}/${pad(x.getMonth() + 1)}`;
            }
            const dateHtml = d => `<span class="dp-date">${fmtDate(d)}</span>`;
            const dayName = d => new Date(d).toLocaleDateString('ar-EG', { weekday: 'long' });
            const fmtTime = d => new Date(d).toLocaleTimeString('ar-EG', { hour: 'numeric', minute: '2-digit' });

            function hourLabel(h) {
                const x = h % 12 === 0 ? 12 : h % 12;
                return `${x.toLocaleString('ar-EG')} ${h < 12 ? 'ص' : 'م'}`;
            }

            function niceMax(v) {
                if (v <= 0) return 1;
                const p = Math.pow(10, Math.floor(Math.log10(v)));
                const n = v / p;
                const m = n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10;
                return m * p;
            }

            function countUp(el, target, asInt) {
                const from = parseFloat(el.dataset.val || '0');
                el.dataset.val = target;
                const f = asInt ? fmtInt : fmt;
                const start = performance.now(), dur = 950;
                cancelAnimationFrame(el._raf);
                const step = now => {
                    const p = Math.min((now - start) / dur, 1);
                    const e = 1 - Math.pow(1 - p, 4);
                    el.textContent = f(from + (target - from) * e);
                    if (p < 1) el._raf = requestAnimationFrame(step);
                };
                el._raf = requestAnimationFrame(step);
            }

            function setWidthAnimated(el, w) {
                requestAnimationFrame(() => requestAnimationFrame(() => { el.style.width = w + '%'; }));
            }

            // ── Range control ──
            function rangeDates(range) {
                const t = new Date(); t.setHours(0, 0, 0, 0);
                if (range === 'today') return [isoLocal(t), isoLocal(t)];
                if (range === 'week') { const s = new Date(t); s.setDate(t.getDate() - 6); return [isoLocal(s), isoLocal(t)]; }
                if (range === 'month') { const s = new Date(t); s.setDate(t.getDate() - 29); return [isoLocal(s), isoLocal(t)]; }
                return [$('dpFrom').value, $('dpTo').value];
            }

            function moveGlider() {
                const active = shell.querySelector('.dp-seg button.active');
                const g = shell.querySelector('.dp-seg-glider');
                if (!active || !g) return;
                g.style.width = active.offsetWidth + 'px';
                g.style.left = active.offsetLeft + 'px';
            }

            $('dpRangeSeg').addEventListener('click', e => {
                const btn = e.target.closest('button[data-range]');
                if (!btn) return;
                shell.querySelectorAll('.dp-seg button').forEach(b => b.classList.toggle('active', b === btn));
                moveGlider();
                state.range = btn.dataset.range;

                const custom = $('dpCustom');
                if (state.range === 'custom') {
                    custom.hidden = false;
                    if (!$('dpFrom').value || !$('dpTo').value) {
                        const [f, t] = rangeDates('week');
                        $('dpFrom').value = f; $('dpTo').value = t;
                    }
                } else {
                    custom.hidden = true;
                }
                load();
            });
            $('dpApply').addEventListener('click', () => load());
            $('dpRefresh').addEventListener('click', () => load());

            // ── Load ──
            async function load(opts = {}) {
                const silent = !!opts.silent;
                const [from, to] = rangeDates(state.range);
                if (!from || !to) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'warning', title: 'اختار تاريخ البداية والنهاية', showConfirmButton: false, timer: 1600 });
                    return;
                }
                const seq = ++state.seq;
                if (!silent) shell.classList.add('loading');

                try {
                    const res = await fetch(`/Payments/GetDailyReport?dateFrom=${from}&dateTo=${to}`);
                    const result = await res.json();
                    if (seq !== state.seq) return;
                    if (!result.success) {
                        Swal.fire({ icon: 'error', title: 'خطأ', text: result.message });
                        return;
                    }
                    const changedRange = state.from !== from || state.to !== to;
                    state.from = from; state.to = to;
                    render(result.data, silent && !changedRange);
                    setupAutoRefresh(to);
                } catch (err) {
                    console.error('Daily report failed', err);
                    if (seq === state.seq && !silent)
                        Swal.fire({ icon: 'error', title: 'خطأ', text: 'فشل تحميل المدفوعات اليومية' });
                } finally {
                    if (seq === state.seq) shell.classList.remove('loading');
                }
            }

            function setupAutoRefresh(to) {
                clearInterval(state.timer);
                const live = to === todayIso();
                $('dpLive').classList.toggle('on', live);
                if (live) {
                    state.timer = setInterval(() => { if (!document.hidden) load({ silent: true }); }, REFRESH_MS);
                }
            }

            document.addEventListener('visibilitychange', () => {
                if (!document.hidden && state.to === todayIso()) load({ silent: true });
            });

            // ── Render ──
            function render(d, silent) {
                const prevIds = state.knownIds;
                state.data = d;
                state.knownIds = new Set(d.payments.map(p => p.id));
                state.newIds = silent && prevIds
                    ? new Set(d.payments.filter(p => !prevIds.has(p.id)).map(p => p.id))
                    : new Set();

                renderRangeLabel(d);
                renderKpis(d);
                renderChart(d, silent);
                renderDonut(d);
                renderInsights(d);
                renderMethods(d);
                renderChips(d);
                applyTableFilter();

                if (state.newIds.size) {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'success',
                        title: `${fmtInt(state.newIds.size)} دفعة جديدة وصلت`,
                        showConfirmButton: false, timer: 2200
                    });
                }
            }

            function renderRangeLabel(d) {
                $('dpRangeLabel').innerHTML = d.days === 1
                    ? `${esc(dayName(d.dateFrom))} · ${dateHtml(d.dateFrom)}`
                    : `من ${dateHtml(d.dateFrom)} إلى ${dateHtml(d.dateTo)} · ${fmtInt(d.days)} يوم`;
            }

            function renderKpis(d) {
                countUp($('dpKpiTotal'), d.visitsTotal);
                countUp($('dpKpiPaid'), d.visitsPaid);
                countUp($('dpKpiRemain'), d.visitsRemaining);
                countUp($('dpKpiCollected'), d.totalAmount);
                $('dpKpiVisits').textContent = `${fmtInt(d.visitsCount)} زيارة`;

                // حلقة نسبة السداد = المدفوع / (المدفوع + الباقي) — الخصم مستبعد
                const rate = pct(d.visitsPaid, d.visitsPaid + d.visitsRemaining);
                $('dpKpiRate').textContent = `${Math.round(rate).toLocaleString('ar-EG')}%`;
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    $('dpKpiRing').style.strokeDasharray = `${rate / 100 * RING_C} ${RING_C}`;
                }));

                const tr = $('dpKpiTrend');
                tr.title = `الفترة السابقة: ${fmt(d.previousTotalAmount)} ج.م (${fmtInt(d.previousTotalCount)} دفعة)`;
                if (d.changePercent === null || d.changePercent === undefined) {
                    tr.className = 'dp-trend flat';
                    tr.innerHTML = '<i class="bi bi-dash"></i> لا توجد مقارنة';
                } else {
                    const up = d.changePercent >= 0;
                    tr.className = 'dp-trend ' + (up ? 'up' : 'down');
                    tr.innerHTML = `<i class="bi bi-graph-${up ? 'up' : 'down'}-arrow"></i> ${Math.abs(d.changePercent).toLocaleString('ar-EG')}% عن الفترة السابقة`;
                }

                countUp($('dpKpiCount'), d.totalCount, true);
                $('dpKpiAvg').textContent = `متوسط الدفعة ${fmt(d.averagePayment)} ج.م`;

                const settled = (paid, remain) => pct(paid, paid + remain);

                countUp($('dpKpiGeneral'), d.generalVisitsTotal);
                countUp($('dpKpiGeneralPaid'), d.generalVisitsPaid);
                countUp($('dpKpiGeneralRemain'), d.generalVisitsRemaining);
                const gS = settled(d.generalVisitsPaid, d.generalVisitsRemaining);
                $('dpKpiGeneralSub').textContent = `${fmtInt(d.generalVisitsCount)} زيارة · نسبة السداد ${Math.round(gS).toLocaleString('ar-EG')}%`;
                setWidthAnimated($('dpKpiGeneralBar'), gS);

                // التقويم: المحصّل في الفترة فقط (المطلوب إجمالي للحالة مش بالزيارة)
                countUp($('dpKpiOrtho'), d.orthoVisitsPaid);
                $('dpKpiOrthoSub').textContent = `${fmtInt(d.orthoVisitsCount)} زيارة · ${fmtInt(d.orthoCount)} دفعة`;
            }

            function buildBuckets(d) {
                if (d.days === 1) {
                    const hours = d.byHour;
                    const withData = hours.filter(h => h.count > 0).map(h => h.hour);
                    const s = Math.min(9, withData.length ? Math.min(...withData) : 9);
                    const e = Math.max(21, withData.length ? Math.max(...withData) : 21);
                    const nowH = new Date().getHours();
                    return hours.slice(s, e + 1).map(h => ({
                        label: hourLabel(h.hour),
                        title: `${hourLabel(h.hour)} – ${hourLabel((h.hour + 1) % 24)}`,
                        general: h.generalAmount, ortho: h.orthoAmount, count: h.count,
                        isToday: d.dateTo.slice(0, 10) === todayIso() && h.hour === nowH
                    }));
                }
                const tIso = todayIso();
                return d.byDay.map(x => {
                    const dt = new Date(x.date);
                    return {
                        label: d.days <= 7 ? dt.toLocaleDateString('ar-EG', { weekday: 'short' }) : fmtDayMonth(dt),
                        title: `${dayName(dt)} · ${fmtDate(dt)}`,
                        general: x.generalAmount, ortho: x.orthoAmount, count: x.count,
                        isToday: isoLocal(dt) === tIso
                    };
                });
            }

            function renderChart(d, silent) {
                const wrap = $('dpBars');
                const buckets = buildBuckets(d);
                state.buckets = buckets;
                $('dpChartSub').textContent = d.days === 1 ? 'التحصيل على مدار اليوم (بالساعة)' : 'التحصيل اليومي خلال الفترة';

                const rawMax = Math.max(0, ...buckets.map(b => b.general + b.ortho));
                const max = niceMax(rawMax);
                $('dpYAxis').innerHTML = [1, .75, .5, .25, 0]
                    .map(f => `<span>${rawMax ? fmtCompact(max * f) : (f === 0 ? fmtInt(0) : '')}</span>`).join('');

                const step = buckets.length > 14 ? Math.ceil(buckets.length / 10) : 1;

                // تحديث صامت: نغيّر الارتفاعات بس
                if (silent && wrap.childElementCount === buckets.length) {
                    wrap.querySelectorAll('.dp-bar-col').forEach((col, i) => {
                        const b = buckets[i];
                        const g = col.querySelector('.general'), o = col.querySelector('.ortho');
                        g.style.setProperty('--h', (b.general / max * 100) + '%');
                        o.style.setProperty('--h', (b.ortho / max * 100) + '%');
                        g.classList.toggle('solo', b.ortho === 0);
                    });
                    return;
                }

                wrap.classList.remove('ready');
                wrap.style.gap = buckets.length > 20 ? '2px' : '6px';
                wrap.innerHTML = buckets.map((b, i) => `
                                    <div class="dp-bar-col ${b.isToday ? 'is-today' : ''}" data-i="${i}" style="--i:${i}">
                                        <div class="dp-bar-stack">
                                            <div class="dp-bar-seg general ${b.ortho === 0 ? 'solo' : ''}" style="--h:${b.general / max * 100}%"></div>
                                            <div class="dp-bar-seg ortho" style="--h:${b.ortho / max * 100}%"></div>
                                        </div>
                                        <span class="dp-bar-label">${i % step === 0 ? b.label : ''}</span>
                                    </div>`).join('');
                void wrap.offsetWidth;
                requestAnimationFrame(() => wrap.classList.add('ready'));
            }

            // Tooltip الشارت
            const tip = $('dpTip');
            document.body.appendChild(tip);
            $('dpBars').addEventListener('mousemove', e => {
                const col = e.target.closest('.dp-bar-col');
                if (!col) { tip.classList.remove('show'); return; }
                const b = state.buckets[+col.dataset.i];
                if (!b) return;
                tip.innerHTML = `
                                    <div class="tt-h">${esc(b.title)}</div>
                                    <div class="tt-r"><span><i style="background:var(--dp-general)"></i> عام</span><b>${fmt(b.general)}</b></div>
                                    <div class="tt-r"><span><i style="background:var(--dp-ortho)"></i> تقويم</span><b>${fmt(b.ortho)}</b></div>
                                    <div class="tt-r"><span>الإجمالي</span><b>${fmt(b.general + b.ortho)} ج.م</b></div>
                                    <div class="tt-r"><span>عدد الدفعات</span><b>${fmtInt(b.count)}</b></div>`;
                tip.classList.add('show');
                const off = 14, r = tip.getBoundingClientRect();
                let x = e.clientX + off, y = e.clientY + off;
                if (x + r.width > window.innerWidth - 10) x = e.clientX - r.width - off;
                if (y + r.height > window.innerHeight - 10) y = e.clientY - r.height - off;
                tip.style.left = x + 'px';
                tip.style.top = y + 'px';
            });
            $('dpBars').addEventListener('mouseleave', () => tip.classList.remove('show'));

            function renderDonut(d) {
                const total = d.generalAmount + d.orthoAmount;
                const g = total ? d.generalAmount / total : 0;
                const o = total ? d.orthoAmount / total : 0;
                const gap = (g > 0 && o > 0) ? 3 : 0;
                const ga = $('dpArcGeneral'), oa = $('dpArcOrtho');
                ga.style.strokeDasharray = `${Math.max(0, g * DONUT_C - gap)} ${DONUT_C}`;
                ga.style.strokeDashoffset = '0';
                oa.style.strokeDasharray = `${Math.max(0, o * DONUT_C - gap)} ${DONUT_C}`;
                oa.style.strokeDashoffset = `${-(g * DONUT_C)}`;

                countUp($('dpDonutCount'), d.totalCount, true);
                countUp($('dpSplitGeneral'), d.generalAmount);
                countUp($('dpSplitOrtho'), d.orthoAmount);
                $('dpSplitGeneralSub').textContent = `${fmtInt(d.generalCount)} دفعة · ${(g * 100).toFixed(1)}%`;
                $('dpSplitOrthoSub').textContent = `${fmtInt(d.orthoCount)} دفعة · ${(o * 100).toFixed(1)}%`;
            }

            function renderInsights(d) {
                const has = d.totalCount > 0;

                const peak = has ? d.byHour.reduce((a, b) => b.amount > a.amount ? b : a) : null;
                $('dpInsPeak').textContent = peak ? `${hourLabel(peak.hour)} – ${hourLabel((peak.hour + 1) % 24)}` : '—';
                $('dpInsPeakSub').textContent = peak ? `${fmt(peak.amount)} ج.م · ${fmtInt(peak.count)} دفعة` : 'لا توجد بيانات';

                if (d.days > 1) {
                    const best = has ? d.byDay.reduce((a, b) => b.amount > a.amount ? b : a) : null;
                    $('dpInsBestTitle').textContent = 'أفضل يوم';
                    $('dpInsBest').innerHTML = best ? `${esc(dayName(best.date))} · ${dateHtml(best.date)}` : '—';
                    $('dpInsBestSub').textContent = best ? `${fmt(best.amount)} ج.م · ${fmtInt(best.count)} دفعة` : 'لا توجد بيانات';
                } else {
                    const big = has ? d.payments.reduce((a, b) => b.amount > a.amount ? b : a) : null;
                    $('dpInsBestTitle').textContent = 'أكبر دفعة';
                    $('dpInsBest').textContent = big ? `${fmt(big.amount)} ج.م` : '—';
                    $('dpInsBestSub').textContent = big ? `${big.patientName} · ${big.categoryText}` : 'لا توجد بيانات';
                }

                const tm = d.byMethod[0];
                $('dpInsMethod').textContent = tm ? tm.methodText : '—';
                $('dpInsMethodSub').textContent = tm ? `${pct(tm.amount, d.totalAmount).toFixed(0)}% من التحصيل` : 'لا توجد بيانات';

                $('dpInsAvg').textContent = has ? `${fmt(d.averagePayment)} ج.م` : '—';
                $('dpInsAvgSub').textContent = has && d.days > 1
                    ? `متوسط اليوم ${fmt(d.totalAmount / d.days)} ج.م`
                    : (has ? `على ${fmtInt(d.totalCount)} دفعة` : 'لا توجد بيانات');
            }

            function renderMethods(d) {
                const wrap = $('dpMethods');
                if (!d.byMethod.length) {
                    wrap.innerHTML = '<div class="dp-empty"><i class="bi bi-wallet2"></i>لا توجد بيانات</div>';
                    return;
                }
                wrap.innerHTML = d.byMethod.map((m, i) => {
                    const p = pct(m.amount, d.totalAmount);
                    return `
                                        <div class="dp-method" style="--i:${i}">
                                            <div class="dp-method-icon"><i class="bi ${METHOD_ICONS[m.method] || 'bi-wallet2'}"></i></div>
                                            <div class="dp-method-body">
                                                <div class="dp-method-top"><span>${esc(m.methodText)}</span><b>${fmt(m.amount)}</b></div>
                                                <div class="dp-method-track"><div class="dp-method-fill" data-w="${p}"></div></div>
                                                <div class="dp-method-meta">${fmtInt(m.count)} دفعة · ${p.toFixed(1)}%</div>
                                            </div>
                                        </div>`;
                }).join('');
                wrap.querySelectorAll('.dp-method-fill').forEach(f => setWidthAnimated(f, f.dataset.w));
            }

            function renderChips(d) {
                $('dpCntAll').textContent = fmtInt(d.totalCount);
                $('dpCntGeneral').textContent = fmtInt(d.generalCount);
                $('dpCntOrtho').textContent = fmtInt(d.orthoCount);
            }

            // ── Table ──
            $('dpCatChips').addEventListener('click', e => {
                const chip = e.target.closest('.dp-chip');
                if (!chip) return;
                shell.querySelectorAll('.dp-chip').forEach(c => c.classList.toggle('active', c === chip));
                state.cat = chip.dataset.cat;
                state.newIds = new Set();
                applyTableFilter();
            });

            let dpSearchTimer;
            $('dpSearch').addEventListener('input', function () {
                clearTimeout(dpSearchTimer);
                dpSearchTimer = setTimeout(() => {
                    state.term = this.value.trim().toLowerCase();
                    state.newIds = new Set();
                    applyTableFilter();
                }, 200);
            });

            $('dpLoadMore').addEventListener('click', () => renderMore());

            function applyTableFilter() {
                if (!state.data) return;
                const q = state.term;
                state.filtered = state.data.payments.filter(p =>
                    (state.cat === 'all' || (state.cat === 'ortho') === p.isOrtho) &&
                    (!q ||
                        (p.patientName || '').toLowerCase().includes(q) ||
                        (p.receiptNo || '').toLowerCase().includes(q) ||
                        (p.patientMobile || '').includes(q))
                );
                state.shown = 0;
                $('dpTbody').innerHTML = '';
                const sum = state.filtered.reduce((s, p) => s + p.amount, 0);
                $('dpTableSum').textContent = `${fmtInt(state.filtered.length)} دفعة · إجمالي ${fmt(sum)} ج.م`;
                $('dpEmpty').style.display = state.filtered.length ? 'none' : 'block';
                renderMore();
            }

            function rowHtml(p, i) {
                const time = fmtTime(p.paymentDate);
                const when = `${dateHtml(p.paymentDate)}<small>${time}</small>`;
                const cls = p.isOrtho ? 'ortho' : 'general';
                const settle = pct(p.visitPaid, p.visitPaid + p.visitRemaining);
                const remain = p.isOrtho
                    ? '<span class="dp-num">—</span>'
                    : (p.visitRemaining > 0
                        ? `<span class="dp-remain due">${fmt(p.visitRemaining)}</span>`
                        : `<span class="dp-remain done"><i class="bi bi-check2-circle"></i> مسدد</span>`);
                return `
                                <tr class="${state.newIds.has(p.id) ? 'dp-row-new' : ''}" style="animation-delay:${Math.min(i * 0.03, 0.3)}s" title="${esc(p.receiptNo ? 'إيصال: ' + p.receiptNo : '')}">
                                    <td class="dp-when">${when}</td>
                                    <td>
                                        <a class="dp-patient" href="/Payments/Statement?patientId=${p.patientId}">
                                            <span class="dp-avatar ${cls}">${esc((p.patientName || '?').trim().charAt(0))}</span>
                                            <span><b>${esc(p.patientName)}</b><small>${esc(p.patientMobile || '')}</small></span>
                                        </a>
                                    </td>
                                    <td><span class="dp-cat ${cls}">${esc(p.categoryText)}</span></td>
                                    <td class="dp-amount">${fmt(p.amount)}${splitBadgeHtml(p)}</td>
                                    <td class="dp-num grp">${p.isOrtho ? '—' : fmt(p.visitTotal)}</td>
                                    <td class="dp-num dp-paid">${fmt(p.visitPaid)}</td>
                                    <td class="dp-num dp-disc">${p.visitDiscount > 0 ? fmt(p.visitDiscount) : '—'}</td>
                                    <td>${remain}${p.isOrtho ? '' : `<div class="dp-settle" title="نسبة السداد ${Math.round(settle)}%"><i style="width:${settle}%"></i></div>`}</td>
                                    <td class="grp">${patientBalanceHtml(p)}</td>
                                    <td class="grp"><span class="dp-method-pill"><i class="bi ${METHOD_ICONS[p.method] || 'bi-wallet2'}"></i> ${esc(p.methodText)}</span></td>
                                </tr>`;
            }

            // ⭐ المرحلة 5 — الإيصال الواحد سطر واحد: badge لو اتوزع على أكتر من زيارة، وخصم لو اتسجل معاه
            function splitBadgeHtml(p) {
                let html = '';
                if ((p.partsCount || 1) > 1) {
                    const tip = (p.parts || []).map(x => `${fmtDate(new Date(x.visitDate))}: ${fmt(x.amount)}`).join(' · ');
                    html += `<span class="dp-split" title="${esc('موزعة على: ' + tip)}"><i class="bi bi-diagram-3"></i> ${fmtInt(p.partsCount)} زيارات</span>`;
                }
                if (Number(p.discount || 0) > 0)
                    html += `<span class="dp-split disc" title="خصم مسجّل مع الدفعة"><i class="bi bi-percent"></i> ${fmt(p.discount)}</span>`;
                return html;
            }

            // ⭐ رصيد المريض الكلي (كل زياراته النشطة) — بيوضح لو فيه باقي على زيارات تانية غير اللي اتدفع عليها
            function patientBalanceHtml(p) {
                const pRem = Number(p.patientRemaining || 0);
                const visitRem = Math.max(0, Number(p.visitRemaining || 0));
                const otherDue = pRem - visitRem;
                const tip = `إجمالي مطلوب المريض ${fmt(p.patientTotal)} ج.م · ${fmtInt(p.patientOpenVisits)} زيارة عليها باقي`;

                if (pRem <= 0.009)
                    return `<span class="dp-remain done" title="${esc(tip)}"><i class="bi bi-check2-all"></i> مسدد بالكامل</span>`;

                const note = otherDue > 0.009
                    ? `<small class="dp-pbal-note"><i class="bi bi-exclamation-circle"></i> منها ${fmt(otherDue)} على زيارات اخري</small>`
                    : '';
                return `<span class="dp-pbal ${otherDue > 0.009 ? 'more' : ''}" title="${esc(tip)}">${fmt(pRem)}</span>${note}`;
            }

            function renderMore() {
                const chunk = state.filtered.slice(state.shown, state.shown + PAGE);
                $('dpTbody').insertAdjacentHTML('beforeend', chunk.map((p, i) => rowHtml(p, i)).join(''));
                state.shown += chunk.length;
                $('dpLoadMore').style.display = state.shown < state.filtered.length ? 'inline-block' : 'none';
            }

            // ── CSV export (Excel بيقرأ العربي صح بسبب الـ BOM) ──
            const csvCell = v => `"${String(v ?? '').replace(/"/g, '""')}"`;
            $('dpExport').addEventListener('click', () => {
                if (!state.filtered.length) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'info', title: 'مفيش دفعات للتصدير', showConfirmButton: false, timer: 1500 });
                    return;
                }
                const head = ['التاريخ', 'الوقت', 'المريض', 'الموبايل', 'النوع', 'الدفعة', 'المطلوب', 'المدفوع', 'الخصم', 'باقي الزيارة', 'إجمالي مطلوب المريض', 'رصيد المريض', 'طريقة الدفع', 'رقم الإيصال', 'ملاحظات', 'عدد الزيارات', 'خصم الدفعة'];
                const lines = state.filtered.map(p => {
                    const dt = new Date(p.paymentDate);
                    return [fmtDate(dt), dt.toTimeString().slice(0, 5), p.patientName, p.patientMobile || '', p.categoryText,
                    p.amount, p.visitTotal, p.visitPaid, p.visitDiscount, p.visitRemaining, p.patientTotal, p.patientRemaining,
                    p.methodText, p.receiptNo || '', p.description || '', p.partsCount || 1, p.discount || 0].map(csvCell).join(',');
                });
                const blob = new Blob(['\uFEFF' + [head.map(csvCell).join(','), ...lines].join('\r\n')], { type: 'text/csv;charset=utf-8' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `payments_${fmtDate(state.from).replace(/\//g, '-')}_${fmtDate(state.to).replace(/\//g, '-')}.csv`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(a.href), 1000);
            });

            // ── Init ──
            window.addEventListener('resize', moveGlider);
            window.addEventListener('load', moveGlider);
            moveGlider();
            load();
        })();
    </script>
}
