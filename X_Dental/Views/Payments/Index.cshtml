@{
    ViewData["Title"] = "الفواتير والمدفوعات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --sc-teal-900: #0a4d4f;
        --sc-teal-700: #0d7377;
        --sc-teal-600: #0f9b8e;
        --sc-teal-500: #14b8a6;
        --sc-teal-100: #c7f2ea;
        --sc-sky-50: #eafbfc;
        --sc-sky-100: #dcf5f7;
        --sc-coral-300: #f6c6bc;
        --sc-ink-900: #0b2e30;
        --sc-ink-600: #4b6b6c;
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-light: #f0fdfa;
        --radius-lg: 18px;
        --radius-md: 12px;
        --shadow-soft: 0 1px 3px rgba(15, 23, 42, 0.06);
        --shadow-hover: 0 10px 26px rgba(10, 77, 79, 0.12);
        --shadow-card: 0 20px 50px rgba(10, 77, 79, .08);
    }

    body {
        background: radial-gradient(circle at 6% 4%, var(--sc-teal-100) 0%, transparent 38%), radial-gradient(circle at 97% 92%, var(--sc-coral-300) 0%, transparent 26%), var(--sc-sky-50);
    }

    /* ── Hero ── */
    .payments-hero {
        background: linear-gradient(135deg, var(--sc-teal-700), var(--sc-teal-500));
        border-radius: var(--radius-lg);
        padding: 28px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 14px 34px rgba(13, 115, 119, .28);
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 16px;
        position: relative;
        overflow: hidden;
        contain: content;
    }

        .payments-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 92% -20%, rgba(255,255,255,.32), transparent 55%);
            pointer-events: none;
        }

        .payments-hero .hero-content {
            display: flex;
            align-items: center;
            gap: 18px;
            position: relative;
            z-index: 1;
        }

        .payments-hero .hero-icon {
            width: 56px;
            height: 56px;
            background: rgba(255,255,255,.18);
            color: #fff;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            flex-shrink: 0;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255,255,255,.15);
        }

        .payments-hero h1 {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            color: #fff;
        }

        .payments-hero p {
            font-size: 0.85rem;
            margin: 4px 0 0;
            color: rgba(255,255,255,.9);
            font-weight: 600;
        }

    /* ── Search Shell ── */
    .search-shell-glass {
        max-width: 600px;
        margin: 0 auto;
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(16px);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255,255,255,.6);
        padding: 40px;
        box-shadow: var(--shadow-card);
        text-align: center;
        animation: shellFadeIn 0.5s ease forwards;
        opacity: 0;
        transform: translateY(16px);
        will-change: transform, opacity;
    }

    @@keyframes shellFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .search-shell-glass .shell-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 20px;
        box-shadow: 0 8px 20px rgba(13,148,136,0.25);
        transition: transform .3s ease;
    }

    .search-shell-glass:hover .shell-icon {
        transform: scale(1.06) rotate(-4deg);
    }

    .search-shell-glass h3 {
        font-weight: 800;
        color: var(--sc-ink-900);
        margin-bottom: 8px;
        font-size: 1.3rem;
    }

    .search-shell-glass p {
        color: var(--sc-ink-600);
        font-size: .9rem;
        margin-bottom: 28px;
        line-height: 1.6;
    }

    /* ── Search Input ── */
    .search-input-wrapper {
        position: relative;
        margin-bottom: 16px;
    }

    .search-input-glass {
        width: 100%;
        border: 1.5px solid var(--sc-sky-100);
        border-radius: 14px;
        padding: 14px 18px 14px 50px;
        font-size: 1rem;
        color: var(--sc-ink-900);
        background: #fff;
        transition: border-color .2s ease, box-shadow .2s ease;
        outline: none;
        font-weight: 600;
    }

        .search-input-glass:focus {
            border-color: var(--sc-teal-500);
            box-shadow: 0 0 0 4px rgba(20,184,166,0.1);
        }

        .search-input-glass::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }

    .search-input-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--sc-teal-600);
        font-size: 1.2rem;
        pointer-events: none;
    }

    /* ── Results Box ── */
    .results-box-glass {
        text-align: right;
        margin-top: 12px;
        border-radius: 14px;
        overflow: hidden;
        border: 1.5px solid var(--sc-sky-100);
        display: none;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        animation: resultsSlideDown 0.2s ease;
        max-height: 320px;
        overflow-y: auto;
    }

    @@keyframes resultsSlideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .result-item-glass {
        padding: 14px 18px;
        cursor: pointer;
        border-bottom: 1px solid var(--sc-sky-100);
        transition: background-color .15s ease, padding .15s ease;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        color: var(--sc-ink-900);
        font-size: 0.95rem;
        animation: itemFadeIn .25s ease forwards;
        opacity: 0;
    }

    @@keyframes itemFadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .result-item-glass:hover {
        background: var(--brand-light);
        color: var(--brand-dark);
        padding-right: 24px;
    }

    .result-item-glass:last-child {
        border-bottom: none;
    }

    .result-item-glass .result-meta {
        font-size: 0.8rem;
        color: var(--sc-ink-600);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .result-item-glass:hover .result-meta {
        color: var(--sc-teal-600);
    }

    .result-empty {
        padding: 20px;
        text-align: center;
        color: #94a3b8;
        font-weight: 600;
    }

        .result-empty i {
            display: block;
            font-size: 2rem;
            margin-bottom: 8px;
            color: var(--sc-sky-100);
        }

    /* ── Skeleton Loading (بدل نص "جاري البحث") ── */
    .skeleton-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        border-bottom: 1px solid var(--sc-sky-100);
    }

        .skeleton-row:last-child {
            border-bottom: none;
        }

    .skeleton-bar {
        height: 14px;
        border-radius: 6px;
        background: linear-gradient(90deg, var(--sc-sky-100) 25%, #f1fbfb 37%, var(--sc-sky-100) 63%);
        background-size: 400% 100%;
        animation: skeletonShine 1.4s ease infinite;
    }

    @@keyframes skeletonShine {
        0% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0 50%;
        }
    }

    /* ── Quick Stats ── */
    .quick-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        max-width: 600px;
        margin: 0 auto 24px;
    }

    .quick-stat-card {
        background: rgba(255,255,255,.78);
        backdrop-filter: blur(14px);
        border-radius: 14px;
        padding: 16px;
        text-align: center;
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: var(--shadow-soft);
        transition: transform .2s ease, box-shadow .2s ease;
        animation: statPop .45s ease forwards;
        opacity: 0;
        transform: translateY(10px);
    }

        .quick-stat-card:nth-child(1) {
            animation-delay: .05s;
        }

        .quick-stat-card:nth-child(2) {
            animation-delay: .12s;
        }

        .quick-stat-card:nth-child(3) {
            animation-delay: .19s;
        }

    @@keyframes statPop {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .quick-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
    }

    .quick-stat-value {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--sc-ink-900);
    }

    .quick-stat-label {
        font-size: 0.75rem;
        color: var(--sc-ink-600);
        font-weight: 600;
        margin-top: 4px;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .payments-hero {
            flex-direction: column;
            text-align: center;
            padding: 22px;
        }

            .payments-hero .hero-content {
                flex-direction: column;
            }

        .search-shell-glass {
            padding: 28px 20px;
            margin: 0 12px;
        }

        .quick-stats-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .search-shell-glass, .quick-stat-card, .result-item-glass {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>

<!-- 🔷 Hero -->
<div class="payments-hero" dir="ltr">
    <div class="hero-content">
        <div class="hero-icon"><i class="bi bi-receipt-cutoff"></i></div>
        <div>
            <h1 fs-1>payments</h1>
            <p>Look for the patient and review the full account statement and payments</p>
        </div>
    </div>
</div>

<!-- 🔷 Quick Stats -->
<div class="quick-stats-row">
    <div class="quick-stat-card">
        <div class="quick-stat-value"><i class="bi bi-receipt" style="color: var(--sc-teal-600);"></i></div>
        <div class="quick-stat-label">كشف حساب مفصل</div>
    </div>
    <div class="quick-stat-card">
        <div class="quick-stat-value"><i class="bi bi-cash-stack" style="color: #166534;"></i></div>
        <div class="quick-stat-label">تتبع المدفوعات</div>
    </div>
    <div class="quick-stat-card">
        <div class="quick-stat-value"><i class="bi bi-graph-up" style="color: #1d4ed8;"></i></div>
        <div class="quick-stat-label">الأرصدة والمتبقي</div>
    </div>
</div>

<!-- 🔷 Search Shell -->
<div class="search-shell-glass">
    <div class="shell-icon"><i class="bi bi-search-heart"></i></div>
    <h3>كشف حساب مريض</h3>
    <p>ابحث باسم المريض أو رقم التليفون عشان تشوف كشف الحساب الكامل بتاعه</p>

    <div class="search-input-wrapper">
        <i class="bi bi-search search-input-icon"></i>
        <input type="text" id="patientSearch" class="search-input-glass" placeholder="اكتب اسم المريض أو رقم التليفون..." autocomplete="off" />
    </div>

    <div class="results-box-glass" id="resultsBox"></div>
</div>

@section Scripts {
    <script>
        let searchTimeout;
        let searchAbortController = null;
        let searchSeq = 0; // نحمي من إجابات قديمة توصل بعد الجديدة (race condition)

        const searchInput = document.getElementById('patientSearch');
        const resultsBox = document.getElementById('resultsBox');

        function renderSkeleton() {
            resultsBox.innerHTML = Array.from({ length: 3 }).map(() => `
                        <div class="skeleton-row">
                            <div class="skeleton-bar" style="width: 40%;"></div>
                            <div class="skeleton-bar" style="width: 25%;"></div>
                        </div>`).join('');
            resultsBox.style.display = 'block';
        }

        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const term = this.value.trim();

            if (term.length < 2) {
                resultsBox.style.display = 'none';
                if (searchAbortController) searchAbortController.abort();
                return;
            }

            renderSkeleton();
            searchTimeout = setTimeout(() => doSearch(term), 350);
        });

        // إخفاء النتائج لما يدوس بره
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-shell-glass')) {
                resultsBox.style.display = 'none';
            }
        });

        async function doSearch(term) {
            // إلغاء أي طلب سابق لسه شغال عشان منستناش نتيجة قديمة
            if (searchAbortController) searchAbortController.abort();
            searchAbortController = new AbortController();

            const mySeq = ++searchSeq;

            try {
                const res = await fetch(`/Patients/Search?term=${encodeURIComponent(term)}`, {
                    signal: searchAbortController.signal
                });
                const list = await res.json();

                // لو وصلت نتيجة قديمة بعد ما المستخدم كتب حاجة جديدة، اتجاهلها
                if (mySeq !== searchSeq) return;

                if (!list.length) {
                    resultsBox.innerHTML = `
                                <div class="result-empty">
                                    <i class="bi bi-inbox"></i>
                                    لا توجد نتائج مطابقة
                                </div>`;
                    resultsBox.style.display = 'block';
                    return;
                }

                const frag = document.createDocumentFragment();
                list.forEach(function(p, index) {
                    const item = document.createElement('div');
                    item.className = 'result-item-glass';
                    item.style.animationDelay = `${Math.min(index * 0.03, 0.3)}s`;
                    item.innerHTML = `
                                <span>${p.fullNameAr}</span>
                                <span class="result-meta"><i class="bi bi-telephone-fill"></i> ${p.phone || '—'}</span>
                            `;
                    item.addEventListener('click', function() {
                        window.location.href = `/Payments/Statement?patientId=${p.id}`;
                    });
                    frag.appendChild(item);
                });

                resultsBox.innerHTML = '';
                resultsBox.appendChild(frag);
                resultsBox.style.display = 'block';
            } catch (err) {
                if (err.name === 'AbortError') return; // طلب اتلغى عمدًا، مش خطأ فعلي
                console.error('Search failed', err);
                if (mySeq !== searchSeq) return;
                resultsBox.innerHTML = `
                            <div class="result-empty">
                                <i class="bi bi-wifi-off"></i>
                                حدث خطأ في الاتصال
                            </div>`;
                resultsBox.style.display = 'block';
            }
        }
    </script>
}