@{
    ViewData["Title"] = "الفواتير والمدفوعات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .search-shell {
        max-width: 560px;
        margin: 60px auto;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(16px);
        border-radius: 20px;
        border: 1px solid rgba(226,232,240,0.6);
        padding: 32px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.06);
        text-align: center;
    }

        .search-shell h3 {
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .search-shell p {
            color: #64748b;
            font-size: .9rem;
            margin-bottom: 20px;
        }

    .search-input {
        width: 100%;
        border: 1px solid #d8dee3;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: .95rem;
    }

    #resultsBox {
        text-align: right;
        margin-top: 10px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        display: none;
    }

    .result-item {
        padding: 10px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
    }

        .result-item:hover {
            background: #f0fdfa;
        }

        .result-item:last-child {
            border-bottom: none;
        }
</style>

<div class="search-shell">
    <h3><i class="bi bi-receipt-cutoff"></i> كشف حساب مريض</h3>
    <p>ابحث باسم المريض أو رقم التليفون عشان تشوف كشف الحساب الكامل بتاعه</p>
    <input type="text" id="patientSearch" class="search-input" placeholder="اكتب اسم المريض أو رقم التليفون..." autocomplete="off" />
    <div id="resultsBox"></div>
</div>

@section Scripts {
    <script>
        let searchTimeout;
        document.getElementById('patientSearch').addEventListener('input', function () {
            clearTimeout(searchTimeout);
            const term = this.value.trim();
            if (term.length < 2) {
                document.getElementById('resultsBox').style.display = 'none';
                return;
            }
            searchTimeout = setTimeout(() => doSearch(term), 300);
        });

        async function doSearch(term) {
            try {
                const res = await fetch(`/Patients/Search?term=${encodeURIComponent(term)}`);
                const list = await res.json();
                const box = document.getElementById('resultsBox');
                if (!list.length) {
                    box.innerHTML = '<div class="result-item" style="color:#94a3b8;">لا توجد نتائج</div>';
                    box.style.display = 'block';
                    return;
                }
                box.innerHTML = '';
                list.forEach(function (p) {
                    const item = document.createElement('div');
                    item.className = 'result-item';
                    item.textContent = `${p.fullNameAr} — ${p.phone || ''}`;
                    item.addEventListener('click', function () {
                        window.location.href = `/Payments/Statement?patientId=${p.id}`;
                    });
                    box.appendChild(item);
                });
                box.style.display = 'block';
            } catch (err) {
                console.error('Search failed', err);
            }
        }
    </script>
}
