@{
    ViewData["Title"] = "كشف حساب المريض";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var patientId = ViewBag.PatientId;
}

<style>
    :root {
        --sc-teal-900: #0a4d4f;
        --sc-teal-700: #0d7377;
        --sc-teal-600: #0f9b8e;
        --sc-teal-500: #14b8a6;
        --sc-teal-100: #c7f2ea;
        --sc-sky-50: #eafbfc;
        --sc-sky-100: #dcf5f7;
        --sc-coral-300: #f6c6bc;
        --sc-ink-900: #0b2e30;
        --sc-ink-600: #4b6b6c;
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-light: #f0fdfa;
        --radius-lg: 18px;
        --radius-md: 12px;
        --shadow-soft: 0 1px 3px rgba(15, 23, 42, 0.06);
        --shadow-hover: 0 10px 26px rgba(10, 77, 79, 0.12);
        --shadow-card: 0 20px 50px rgba(10, 77, 79, .08);
    }

    body {
        background: radial-gradient(circle at 6% 4%, var(--sc-teal-100) 0%, transparent 38%), radial-gradient(circle at 97% 92%, var(--sc-coral-300) 0%, transparent 26%), var(--sc-sky-50);
    }

    /* ── Hero (ناحية الشمال، بنفس نمط صفحة الفواتير الرئيسية) ── */
    .statement-hero {
        direction: ltr;
        background: linear-gradient(135deg, var(--sc-teal-700), var(--sc-teal-500));
        border-radius: var(--radius-lg);
        padding: 24px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 14px 34px rgba(13, 115, 119, .28);
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 16px;
        position: relative;
        overflow: hidden;
        contain: content;
    }

        .statement-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 8% -20%, rgba(255,255,255,.32), transparent 55%);
            pointer-events: none;
        }

        .statement-hero .hero-content {
            display: flex;
            align-items: center;
            gap: 18px;
            position: relative;
            z-index: 1;
            direction: rtl; /* النص العربي جوه البلوك يفضل بيتقرأ صح */
        }

        .statement-hero .hero-avatar {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: rgba(255,255,255,.18);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 800;
            flex-shrink: 0;
            backdrop-filter: blur(6px);
            border: 2px solid rgba(255,255,255,.2);
        }

        .statement-hero h1 {
            font-size: 1.25rem;
            font-weight: 800;
            margin: 0;
            color: #fff;
        }

        .statement-hero .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 6px;
        }

    .hero-meta-tag {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.15);
        color: #fff;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255,255,255,.1);
    }

    .hero-actions {
        display: flex;
        gap: 10px;
        position: relative;
        z-index: 1;
        flex-wrap: wrap;
        direction: rtl;
    }

    .btn-hero {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.88rem;
        border: none;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-hero-back {
        background: rgba(255,255,255,.9);
        color: var(--sc-teal-700);
        box-shadow: 0 4px 12px rgba(10, 40, 42, .15);
    }

        .btn-hero-back:hover {
            background: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(10, 40, 42, .22);
            color: var(--sc-teal-700);
        }

    .btn-hero-print {
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.25);
        backdrop-filter: blur(4px);
    }

        .btn-hero-print:hover {
            background: rgba(255,255,255,.25);
            transform: translateY(-2px);
        }

    /* ── Stats ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-card-glass {
        background: rgba(255,255,255,.78);
        backdrop-filter: blur(14px);
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: var(--shadow-soft);
        transition: transform .2s ease, box-shadow .2s ease;
        animation: cardPopIn 0.45s ease forwards;
        opacity: 0;
        transform: translateY(15px);
        will-change: transform, opacity;
    }

        .stat-card-glass:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
        }

        .stat-card-glass:nth-child(1) {
            animation-delay: .05s;
        }

        .stat-card-glass:nth-child(2) {
            animation-delay: .1s;
        }

        .stat-card-glass:nth-child(3) {
            animation-delay: .15s;
        }

        .stat-card-glass:nth-child(4) {
            animation-delay: .2s;
        }

    @@keyframes cardPopIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stat-card-glass .stat-label {
        font-size: .78rem;
        color: var(--sc-ink-600);
        font-weight: 700;
        margin-bottom: 8px;
    }

    .stat-card-glass .stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--sc-ink-900);
    }

    .stat-card-glass.paid .stat-value {
        color: #047857;
    }

    .stat-card-glass.due .stat-value {
        color: #b91c1c;
    }

    /* ── Section Shells ── */
    .section-shell {
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(16px);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        margin-bottom: 20px;
        animation: sectionFadeIn 0.45s ease forwards;
        opacity: 0;
        transform: translateY(12px);
        will-change: transform, opacity;
    }

        .section-shell:nth-of-type(1) {
            animation-delay: .2s;
        }

        .section-shell:nth-of-type(2) {
            animation-delay: .28s;
        }

    @@keyframes sectionFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: var(--sc-sky-50);
        border-bottom: 1px solid var(--sc-sky-100);
    }

        .section-head h5 {
            font-weight: 800;
            font-size: 0.95rem;
            color: var(--sc-ink-900);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-head h5 i {
                color: var(--sc-teal-600);
                font-size: 1.1rem;
            }

    .section-body {
        padding: 0;
    }

    /* ── Tables ── */
    .stmt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .88rem;
        margin: 0;
    }

        .stmt-table thead th {
            background: var(--sc-sky-50);
            color: var(--sc-ink-600);
            font-weight: 800;
            padding: 14px 16px;
            border: none;
            border-bottom: 2px solid var(--sc-sky-100);
            text-align: right;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .stmt-table tbody tr {
            transition: background-color .15s ease;
            animation: rowFadeIn 0.3s ease forwards;
            opacity: 0;
        }

            .stmt-table tbody tr:hover {
                background-color: var(--brand-light) !important;
            }

    @@keyframes rowFadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stmt-table tbody td {
        padding: 12px 16px;
        border-bottom: 1px solid var(--sc-sky-100);
        color: var(--sc-ink-900);
        font-weight: 600;
    }

    .stmt-table tbody tr:last-child td {
        border-bottom: none;
    }

    .badge-paid {
        background: #d1fae5;
        color: #047857;
        padding: 3px 12px;
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 800;
    }

    .badge-due {
        background: #fee2e2;
        color: #b91c1c;
        padding: 3px 12px;
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 800;
    }

    .btn-void {
        background: none;
        border: none;
        color: #b91c1c;
        cursor: pointer;
        font-size: .8rem;
        font-weight: 700;
        transition: background-color .2s ease, transform .2s ease;
        padding: 4px 8px;
        border-radius: 6px;
    }

        .btn-void:hover {
            background: #fee2e2;
            transform: scale(1.05);
        }

    .btn-add-payment {
        display: flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.85rem;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(13,148,136,0.25);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-add-payment:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(13,148,136,0.35);
        }

    .btn-load-more {
        display: block;
        margin: 14px auto;
        background: var(--sc-sky-50);
        color: var(--sc-teal-700);
        border: 1.5px dashed var(--sc-teal-500);
        padding: 8px 22px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        transition: background-color .2s ease, transform .2s ease;
    }

        .btn-load-more:hover {
            background: var(--brand-light);
            transform: translateY(-1px);
        }

    /* ── Empty / Skeleton State ── */
    .empty-state {
        text-align: center;
        padding: 40px;
        color: #94a3b8;
        font-weight: 600;
    }

        .empty-state i {
            display: block;
            font-size: 2.5rem;
            margin-bottom: 12px;
            color: var(--sc-sky-100);
        }

    .skeleton-cell {
        height: 14px;
        border-radius: 6px;
        background: linear-gradient(90deg, var(--sc-sky-100) 25%, #f1fbfb 37%, var(--sc-sky-100) 63%);
        background-size: 400% 100%;
        animation: skeletonShine 1.4s ease infinite;
    }

    @@keyframes skeletonShine {
        0% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0 50%;
        }
    }

    /* ── Modal ── */
    .custom-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .custom-modal.show {
            display: flex;
        }

    .modal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(15,23,42,0.45);
        backdrop-filter: blur(4px);
    }

    .modal-box {
        position: relative;
        z-index: 1;
        width: 90%;
        max-width: 480px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.2);
        overflow: hidden;
        animation: modalSlide 0.22s ease;
    }

    @@keyframes modalSlide {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px;
        background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
        color: #fff;
    }

        .modal-head h5 {
            margin: 0;
            font-weight: 800;
            font-size: 1.1rem;
        }

    .modal-body {
        padding: 24px;
    }

    .modal-foot {
        padding: 0 24px 24px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .form-label-custom {
        display: block;
        font-size: 0.82rem;
        font-weight: 700;
        color: #475569;
        margin-bottom: 6px;
    }

    .form-control-custom {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--sc-sky-100);
        border-radius: 10px;
        font-size: 0.95rem;
        color: var(--sc-ink-900);
        background: #fff;
        transition: border-color .2s ease, box-shadow .2s ease;
        outline: none;
    }

        .form-control-custom:focus {
            border-color: var(--sc-teal-500);
            box-shadow: 0 0 0 3px rgba(20,184,166,0.1);
        }

    .btn-modal {
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

    .btn-modal-cancel {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-modal-cancel:hover {
            background: #e2e8f0;
        }

    .btn-modal-save {
        background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
        color: #fff;
    }

        .btn-modal-save:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(13,148,136,0.3);
        }

    /* ── Page fade-in ── */
    #stmtRoot {
        animation: rootFadeIn .3s ease;
    }

    @@keyframes rootFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* ── Responsive ── */
    @@media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .statement-hero {
            direction: rtl;
            flex-direction: column;
            text-align: center;
            padding: 20px;
        }

            .statement-hero .hero-content {
                flex-direction: column;
            }

        .hero-actions {
            width: 100%;
            justify-content: center;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .section-head {
            flex-direction: column;
            gap: 12px;
            align-items: flex-start;
        }

        .stmt-table {
            font-size: 0.8rem;
        }

            .stmt-table thead th, .stmt-table tbody td {
                padding: 10px 8px;
            }
    }

    @@media (max-width: 480px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .stat-card-glass, .section-shell, .stmt-table tbody tr, #stmtRoot {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }

    @@media print {
        .statement-hero, .btn-hero, .btn-add-payment, .btn-void, .custom-modal, .btn-load-more {
            display: none !important;
        }

        body {
            background: #fff;
        }

        .section-shell {
            box-shadow: none;
            border: 1px solid #ddd;
        }
    }
</style>

<div class="container-fluid" id="stmtRoot" dir="rtl" style="padding: 12px;">

    <!-- 🔷 Hero -->
    <div class="statement-hero">
        <div class="hero-content">
            <div>
                <h1 id="stmtPatientName" dir="ltr">جاري التحميل...</h1>
                <div class="hero-meta">
                    <span class="hero-meta-tag" id="stmtPatientCode"><i class="bi bi-hash"></i> —</span>
                    <span class="hero-meta-tag" id="stmtPatientMobile"><i class="bi bi-telephone"></i> —</span>
                </div>
            </div>
            <div class="hero-avatar"><i class="bi bi-receipt-cutoff"></i></div>
        </div>
        <div class="hero-actions">
            <a href="/Payments" class="btn-hero btn-hero-back">
                <i class="bi bi-arrow-right"></i> رجوع
            </a>
            <button type="button" class="btn-hero btn-hero-print" onclick="window.print()">
                <i class="bi bi-printer"></i> طباعة
            </button>
        </div>
    </div>

    <!-- 🔷 Stats -->
    <div class="stats-grid">
        <div class="stat-card-glass">
            <div class="stat-label">إجمالي المطلوب</div>
            <div class="stat-value" id="sumTotal">—</div>
        </div>
        <div class="stat-card-glass">
            <div class="stat-label">إجمالي الخصم</div>
            <div class="stat-value" id="sumDiscount">—</div>
        </div>
        <div class="stat-card-glass paid">
            <div class="stat-label">إجمالي المدفوع</div>
            <div class="stat-value" id="sumPaid">—</div>
        </div>
        <div class="stat-card-glass due">
            <div class="stat-label">المتبقي</div>
            <div class="stat-value" id="sumRemaining">—</div>
        </div>
    </div>

    <!-- 🔷 Payments Section -->
    <div class="section-shell">
        <div class="section-head">
            <h5><i class="bi bi-cash-stack"></i> سجل الدفعات</h5>
            <button class="btn-add-payment" onclick="openAddPaymentModal()">
                <i class="bi bi-plus-lg"></i> دفعة جديدة
            </button>
        </div>
        <div class="section-body">
            <table class="stmt-table">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الزيارة</th>
                        <th>المبلغ</th>
                        <th>الطريقة</th>
                        <th>رقم الإيصال</th>
                        <th>ملاحظات</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="paymentsBody"></tbody>
            </table>
            <button class="btn-load-more" id="paymentsLoadMore" style="display:none;" onclick="loadMorePayments()">
                عرض المزيد <i class="bi bi-chevron-down"></i>
            </button>
        </div>
    </div>

    <!-- 🔷 Visits Section -->
    <div class="section-shell">
        <div class="section-head">
            <h5><i class="bi bi-clipboard2-data"></i> الزيارات</h5>
        </div>
        <div class="section-body">
            <table class="stmt-table">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>النوع</th>
                        <th>الإجمالي</th>
                        <th>الخصم</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody id="visitsBody"></tbody>
            </table>
            <button class="btn-load-more" id="visitsLoadMore" style="display:none;" onclick="loadMoreVisits()">
                عرض المزيد <i class="bi bi-chevron-down"></i>
            </button>
        </div>
    </div>

    <!-- 🔷 Add Payment Modal -->
    <div class="custom-modal" id="payModal">
        <div class="modal-overlay" onclick="closeAddPaymentModal()"></div>
        <div class="modal-box">
            <div class="modal-head">
                <h5><i class="bi bi-cash-coin me-2"></i> تسجيل دفعة جديدة</h5>
                <button type="button" class="btn-close btn-close-white" onclick="closeAddPaymentModal()"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label-custom">الزيارة <span class="text-danger">*</span></label>
                    <select class="form-control-custom" id="payVisitId"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label-custom">المبلغ <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" class="form-control-custom" id="payAmount" placeholder="0.00" />
                </div>
                <div class="mb-3">
                    <label class="form-label-custom">طريقة الدفع</label>
                    <select class="form-control-custom" id="payMethod">
                        <option value="0">نقدي</option>
                        <option value="1">بطاقة ائتمان</option>
                        <option value="2">بطاقة خصم</option>
                        <option value="3">تحويل بنكي</option>
                        <option value="4">تأمين</option>
                        <option value="5">تقسيط</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label-custom">ملاحظات</label>
                    <textarea class="form-control-custom" id="payDesc" rows="2" placeholder="ملاحظات إضافية..."></textarea>
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn-modal btn-modal-cancel" onclick="closeAddPaymentModal()">إلغاء</button>
                <button type="button" class="btn-modal btn-modal-save" onclick="submitPayment()">حفظ الدفعة</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const patientId = @patientId;

        const PAGE_SIZE = 10;
        let allPayments = [];
        let allVisits = [];
        let paymentsShown = 0;
        let visitsShown = 0;

        document.addEventListener('DOMContentLoaded', () => {
            renderSkeletonTables();
            loadStatement();
        });

        function renderSkeletonTables() {
            const skeletonRow = (cols) => `<tr>${Array.from({ length: cols }).map(() => `<td><div class="skeleton-cell"></div></td>`).join('')}</tr>`;
            document.getElementById('paymentsBody').innerHTML = Array.from({ length: 4 }).map(() => skeletonRow(7)).join('');
            document.getElementById('visitsBody').innerHTML = Array.from({ length: 4 }).map(() => skeletonRow(7)).join('');
        }

        async function loadStatement() {
            try {
                const res = await fetch(`/Payments/GetStatement?patientId=${patientId}`);
                const result = await res.json();

                if (!result.success) {
                    Swal.fire({ title: 'خطأ', text: result.message, icon: 'error' });
                    return;
                }
                renderStatement(result.data);
            } catch (err) {
                console.error('Failed to load statement', err);
                Swal.fire({ title: 'خطأ', text: 'فشل تحميل البيانات من الخادم', icon: 'error' });
            }
        }

        function money(v) {
            return Number(v).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function animateCount(el, target) {
            const duration = 700;
            const startTime = performance.now();

            function step(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeProgress = 1 - Math.pow(1 - progress, 3);
                el.textContent = money(target * easeProgress);
                if (progress < 1) requestAnimationFrame(step);
                else el.textContent = money(target);
            }
            requestAnimationFrame(step);
        }

        function renderStatement(data) {
            allVisits = data.visits || [];
            allPayments = data.payments || [];
            paymentsShown = 0;
            visitsShown = 0;

            document.getElementById('stmtPatientName').textContent = data.patientName;
            document.getElementById('stmtPatientCode').innerHTML = `<i class="bi bi-hash"></i> ${data.patientCode}`;
            document.getElementById('stmtPatientMobile').innerHTML = `<i class="bi bi-telephone"></i> ${data.patientMobile || '—'}`;

            animateCount(document.getElementById('sumTotal'), data.totalAmount);
            animateCount(document.getElementById('sumDiscount'), data.totalDiscount);
            animateCount(document.getElementById('sumPaid'), data.totalPaid);
            animateCount(document.getElementById('sumRemaining'), data.totalRemaining);

            renderVisitsChunk(true);
            renderPaymentsChunk(true);

            const dueVisits = allVisits.filter(v => v.remaining > 0);
            document.getElementById('payVisitId').innerHTML = dueVisits.length
                ? dueVisits.map(v => `<option value="${v.visitId}">${new Date(v.visitDate).toLocaleDateString('ar-EG')} — متبقي ${money(v.remaining)}</option>`).join('')
                : '<option value="">لا توجد زيارات عليها مبلغ متبقي</option>';
        }

        function visitRowHtml(v, i) {
            return `
                        <tr style="animation-delay: ${Math.min(i * 0.04, 0.3)}s">
                            <td>${new Date(v.visitDate).toLocaleDateString('ar-EG')}</td>
                            <td>${v.category === 2 ? 'تقويم' : 'عام'}</td>
                            <td>${money(v.totalAmount)}</td>
                            <td>${money(v.discount)}</td>
                            <td>${money(v.paidAmount)}</td>
                            <td>${money(v.remaining)}</td>
                            <td>${v.isFullyPaid ? '<span class="badge-paid">مسدد</span>' : '<span class="badge-due">متبقي</span>'}</td>
                        </tr>`;
        }

        function paymentRowHtml(p, i) {
            return `
                        <tr style="animation-delay: ${Math.min(i * 0.04, 0.3)}s">
                            <td>${new Date(p.paymentDate).toLocaleDateString('ar-EG')}</td>
                            <td>${new Date(p.visitDate).toLocaleDateString('ar-EG')}</td>
                            <td style="font-weight:800; color:#047857;">${money(p.amount)}</td>
                            <td>${p.methodText}</td>
                            <td style="direction:ltr; text-align:right;">${p.receiptNo || '—'}</td>
                            <td>${p.description || ''}</td>
                            <td><button class="btn-void" onclick="voidPayment(${p.id})"><i class="bi bi-x-circle"></i> إلغاء</button></td>
                        </tr>`;
        }

        function renderVisitsChunk(reset) {
            const body = document.getElementById('visitsBody');
            if (!allVisits.length) {
                body.innerHTML = '<tr><td colspan="7" class="empty-state"><i class="bi bi-inbox"></i>لا توجد زيارات مسجلة</td></tr>';
                document.getElementById('visitsLoadMore').style.display = 'none';
                return;
            }

            if (reset) { body.innerHTML = ''; visitsShown = 0; }

            const nextChunk = allVisits.slice(visitsShown, visitsShown + PAGE_SIZE);
            const frag = document.createElement('tbody');
            frag.innerHTML = nextChunk.map((v, i) => visitRowHtml(v, i)).join('');
            while (frag.firstChild) body.appendChild(frag.firstChild);

            visitsShown += nextChunk.length;
            document.getElementById('visitsLoadMore').style.display = visitsShown < allVisits.length ? 'block' : 'none';
        }

        function renderPaymentsChunk(reset) {
            const body = document.getElementById('paymentsBody');
            if (!allPayments.length) {
                body.innerHTML = '<tr><td colspan="7" class="empty-state"><i class="bi bi-inbox"></i>لا توجد دفعات مسجلة</td></tr>';
                document.getElementById('paymentsLoadMore').style.display = 'none';
                return;
            }

            if (reset) { body.innerHTML = ''; paymentsShown = 0; }

            const nextChunk = allPayments.slice(paymentsShown, paymentsShown + PAGE_SIZE);
            const frag = document.createElement('tbody');
            frag.innerHTML = nextChunk.map((p, i) => paymentRowHtml(p, i)).join('');
            while (frag.firstChild) body.appendChild(frag.firstChild);

            paymentsShown += nextChunk.length;
            document.getElementById('paymentsLoadMore').style.display = paymentsShown < allPayments.length ? 'block' : 'none';
        }

        function loadMoreVisits() { renderVisitsChunk(false); }
        function loadMorePayments() { renderPaymentsChunk(false); }

        function openAddPaymentModal() {
            document.getElementById('payAmount').value = '';
            document.getElementById('payDesc').value = '';
            document.getElementById('payModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeAddPaymentModal() {
            document.getElementById('payModal').classList.remove('show');
            document.body.style.overflow = '';
        }

        async function submitPayment() {
            const visitId = parseInt(document.getElementById('payVisitId').value);
            const amount = parseFloat(document.getElementById('payAmount').value);
            const method = parseInt(document.getElementById('payMethod').value);
            const description = document.getElementById('payDesc').value;

            if (!visitId || !amount || amount <= 0) {
                Swal.fire({ title: 'مطلوب', text: 'اختر الزيارة وادخل مبلغ صحيح', icon: 'warning', confirmButtonColor: '#14b8a6' });
                return;
            }

            try {
                const res = await fetch('/Payments/AddPayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ VisitId: visitId, Amount: amount, Method: method, Description: description })
                });
                const result = await res.json();
                if (result.success) {
                    closeAddPaymentModal();
                    Swal.fire({ title: 'تم!', text: result.message, icon: 'success', confirmButtonColor: '#14b8a6', timer: 1500, showConfirmButton: false });
                    loadStatement();
                } else {
                    Swal.fire({ title: 'تعذر الحفظ', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'خطأ', text: 'مشكلة في الاتصال بالسيرفر', icon: 'error' });
            }
        }

        async function voidPayment(paymentId) {
            const confirm = await Swal.fire({
                title: 'تأكيد الإلغاء',
                text: 'هيتم إلغاء الدفعة دي وتصحيح رصيد الزيارة تلقائيًا. متأكد؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'أيوه، إلغاء',
                cancelButtonText: 'رجوع',
                confirmButtonColor: '#b91c1c',
                reverseButtons: true
            });
            if (!confirm.isConfirmed) return;

            try {
                const res = await fetch(`/Payments/VoidPayment?paymentId=${paymentId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    Swal.fire({ title: 'تم', text: result.message, icon: 'success', timer: 1500, showConfirmButton: false });
                    loadStatement();
                } else {
                    Swal.fire({ title: 'تعذر التنفيذ', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'خطأ', text: 'مشكلة في الاتصال بالسيرفر', icon: 'error' });
            }
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeAddPaymentModal();
        });
    </script>
}