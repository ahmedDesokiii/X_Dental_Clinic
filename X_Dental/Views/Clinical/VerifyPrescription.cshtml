@model Dental.Models.Clinic.Prescription
@{
    Layout = null;
    var patient = Model?.Visit?.Patient;
    var clinicName = ViewBag.ClinicName as string ?? "عيادة الأسنان";
    var invalid = ViewBag.InvalidToken as bool? ?? false;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>التحقق من الروشتة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --teal: #0d9488;
                --teal-dark: #0f766e;
                --ink: #0f172a;
                --muted: #64748b;
                --border: #e2e8f0;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', 'IBM Plex Sans Arabic', Tahoma, Arial, sans-serif;
                background: linear-gradient(160deg, #f0fdfa 0%, #e0f2fe 100%);
                min-height: 100vh;
                color: var(--ink);
                padding: 24px 16px;
            }

            .card {
                max-width: 520px;
                margin: 0 auto;
                background: #fff;
                border-radius: 20px;
                box-shadow: 0 12px 40px rgba(13,148,136,.12);
                overflow: hidden;
            }

            .card-head {
                background: linear-gradient(135deg, #0d9488, #0f766e);
                color: #fff;
                padding: 22px 24px;
                text-align: center;
            }

                .card-head i {
                    font-size: 2.2rem;
                    display: block;
                    margin-bottom: 8px;
                }

                .card-head h1 {
                    font-size: 1.25rem;
                    font-weight: 800;
                    margin: 0;
                }

                .card-head p {
                    font-size: 0.85rem;
                    opacity: .9;
                    margin-top: 4px;
                }

            .card-body {
                padding: 24px;
            }

            .status-ok {
                background: #d1fae5;
                color: #047857;
                border-radius: 12px;
                padding: 12px 16px;
                font-weight: 700;
                text-align: center;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .status-bad {
                background: #fee2e2;
                color: #b91c1c;
                border-radius: 12px;
                padding: 16px;
                font-weight: 700;
                text-align: center;
                margin-bottom: 12px;
            }

            .info-row {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border-bottom: 1px solid var(--border);
                font-size: 0.92rem;
            }

                .info-row:last-child {
                    border-bottom: none;
                }

            .info-label {
                color: var(--muted);
                font-weight: 600;
            }

            .info-value {
                font-weight: 700;
            }

            .meds {
                margin-top: 18px;
            }

                .meds h3 {
                    font-size: 0.9rem;
                    color: var(--teal-dark);
                    margin-bottom: 10px;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

            .med-item {
                background: #f8fafc;
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 12px 14px;
                margin-bottom: 8px;
            }

            .med-name {
                font-weight: 800;
                margin-bottom: 4px;
            }

            .med-meta {
                font-size: 0.8rem;
                color: var(--muted);
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .footer-note {
                text-align: center;
                font-size: 0.75rem;
                color: #94a3b8;
                padding: 16px 24px 20px;
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-head">
            <i class="bi bi-shield-check"></i>
            <h1>@clinicName</h1>
            <p>التحقق من صحة الروشتة</p>
        </div>
        <div class="card-body">
            @if (Model == null || invalid)
            {
                <div class="status-bad">
                    <i class="bi bi-x-circle"></i>
                    @(invalid ? "رمز التحقق غير صالح" : "الروشتة غير موجودة")
                </div>
                <p style="text-align:center; color:#64748b; font-size:0.9rem;">
                    يُرجى التأكد من مسح الرمز الصحيح من الروشتة الأصلية.
                </p>
            }
            else
            {
                <div class="status-ok">
                    <i class="bi bi-check-circle-fill"></i>
                    روشتة موثّقة وصحيحة
                </div>

                <div class="info-row">
                    <span class="info-label">رقم الروشتة</span>
                    <span class="info-value">#@Model.Id</span>
                </div>
                <div class="info-row">
                    <span class="info-label">المريض</span>
                    <span class="info-value">@(patient?.FullNameAr ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">كود المريض</span>
                    <span class="info-value">@(patient?.PatientCode ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">تاريخ الروشتة</span>
                    <span class="info-value">@Model.PrescriptionDate.ToString("dd/MM/yy")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">الطبيب</span>
                    <span class="info-value">د. @(Model.PrescribedBy ?? "—")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
                {
                    <div class="info-row">
                        <span class="info-label">التشخيص</span>
                        <span class="info-value">@Model.Diagnosis</span>
                    </div>
                }

                <div class="meds">
                    <h3><i class="bi bi-capsule"></i> الأدوية (@Model.Items.Count)</h3>
                    @foreach (var item in Model.Items)
                    {
                        <div class="med-item">
                            <div class="med-name">@item.MedicationName</div>
                            <div class="med-meta">
                                @if (!string.IsNullOrEmpty(item.Dosage))
                                {
                                    <span>الجرعة: @item.Dosage</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Frequency))
                                {
                                    <span>التكرار: @item.Frequency</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Duration))
                                {
                                    <span>المدة: @item.Duration</span>
                                }
                                @if (!string.IsNullOrEmpty(item.Instructions))
                                {
                                    <span>@item.Instructions</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="footer-note">
            هذه الصفحة للتحقق فقط — لا تُعدّ بديلاً عن الروشتة الأصلية
        </div>
    </div>
</body>
</html>