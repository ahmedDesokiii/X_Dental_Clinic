@model Dental.Models.Clinic.Prescription
@{
    Layout = null;   // صفحة مستقلة بدون Layout
    var patient = Model.Visit?.Patient;
    var clinicName = ViewBag.ClinicName as string ?? "عيادة الأسنان";
    var clinicAddress = ViewBag.ClinicAddress as string ?? "";
    var clinicPhone = ViewBag.ClinicPhone as string ?? "";
    var clinicLogo = ViewBag.ClinicLogo as string;
    var age = patient?.DateOfBirth.HasValue == true
        ? DateTime.Now.Year - patient.DateOfBirth.Value.Year
        : (int?)null;
    var verifyUrl = ViewBag.VerifyUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>روشتة — @(patient?.FullNameAr ?? "")</title>
    <!-- نفس عائلة الخط المستخدمة في التطبيق -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --teal: #0d9488;
                --teal-dark: #0f766e;
                --ink: #0f172a;
                --muted: #64748b;
                --border: #e2e8f0;
                --bg: #f8fafc;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, Arial, sans-serif;
                background: #e2e8f0;
                color: var(--ink);
                line-height: 1.5;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            /* شريط الأزرار (يختفي عند الطباعة) */
            .print-toolbar {
                position: sticky;
                top: 0;
                z-index: 100;
                background: #fff;
                border-bottom: 1px solid var(--border);
                padding: 12px 20px;
                display: flex;
                justify-content: center;
                gap: 12px;
                box-shadow: 0 2px 8px rgba(0,0,0,.06);
            }

            .btn-print {
                background: linear-gradient(135deg, #0d9488, #0f766e);
                color: #fff;
                border: none;
                padding: 10px 28px;
                border-radius: 10px;
                font-weight: 700;
                font-size: 0.95rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 14px rgba(13,148,136,.35);
                font-family: inherit;
            }

                .btn-print:hover {
                    transform: translateY(-1px);
                }

            .btn-close-page {
                background: #f1f5f9;
                color: #475569;
                border: none;
                padding: 10px 22px;
                border-radius: 10px;
                font-weight: 700;
                cursor: pointer;
                font-family: inherit;
            }

            /*
                     * مقاس الورقة: أكبر من A5 وأصغر من A4
                     * padding-top كبير عشان يسيب مساحة للهيدر المطبوع مسبقاً على الورق
                     */
            .rx-sheet {
                width: 170mm;
                min-height: 250mm;
                margin: 35px auto;
                background: #fff;
                padding: 28mm 14mm 12mm;
                box-shadow: 0 8px 30px rgba(0,0,0,.12);
                position: relative;
            }

            /* QR في المنتصف (تحت الهيدر المطبوع على الورق) */
            .qr-center {
                text-align: center;
                margin: 0 0 14px;
            }

                .qr-center .qr-img {
                    display: inline-block;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    padding: 3px;
                    background: #fff;
                }

                .qr-center .qr-caption {
                    font-size: 0.65rem;
                    color: var(--muted);
                    font-weight: 700;
                    margin-top: 3px;
                }

            /* ── بيانات المريض ── */
            .patient-box {
                background: var(--bg);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 12px 16px;
                margin-bottom: 14px;
            }

            .patient-row {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 16px;
            }

                .patient-row + .patient-row {
                    margin-top: 10px;
                    padding-top: 10px;
                    border-top: 1px dashed var(--border);
                }

                .patient-row .field {
                    min-width: 0;
                }

                    .patient-row .field.grow {
                        flex: 1;
                    }

                    .patient-row .field.shrink {
                        flex-shrink: 0;
                        text-align: left;
                        min-width: 70px;
                    }

                .patient-row .label {
                    color: var(--muted);
                    font-weight: 600;
                    font-size: 0.7rem;
                    display: block;
                    margin-bottom: 2px;
                }

                .patient-row .value {
                    font-weight: 700;
                    color: var(--ink);
                    font-size: 0.9rem;
                }

                    .patient-row .value.name {
                        font-weight: 800;
                        font-size: 1.12rem;
                        line-height: 1.3;
                    }

            /* التشخيص */
            .section {
                margin-bottom: 12px;
            }

            .section-label {
                font-size: 0.74rem;
                font-weight: 700;
                color: var(--teal-dark);
                margin-bottom: 4px;
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .diagnosis-text {
                background: #f0fdfa;
                border-right: 4px solid var(--teal);
                padding: 8px 12px;
                border-radius: 0 8px 8px 0;
                font-weight: 600;
                font-size: 0.88rem;
            }

            /* جدول الأدوية */
            .meds-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 0.82rem;
                margin-top: 4px;
            }

                .meds-table th {
                    background: var(--teal);
                    color: #fff;
                    font-weight: 700;
                    padding: 7px 7px;
                    text-align: right;
                    font-size: 0.74rem;
                }

                    .meds-table th:first-child {
                        border-radius: 0 8px 0 0;
                    }

                    .meds-table th:last-child {
                        border-radius: 8px 0 0 0;
                    }

                .meds-table td {
                    padding: 7px;
                    border-bottom: 1px solid var(--border);
                    vertical-align: top;
                }

                .meds-table tr:nth-child(even) td {
                    background: #f8fafc;
                }

            .med-name {
                font-weight: 800;
                color: var(--ink);
            }

            .med-num {
                display: inline-flex;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: #ccfbf1;
                color: var(--teal-dark);
                font-size: 0.7rem;
                font-weight: 800;
                align-items: center;
                justify-content: center;
                margin-left: 4px;
            }

            /* ملاحظات */
            .notes-box {
                background: #fffbeb;
                border: 1px dashed #fbbf24;
                border-radius: 8px;
                padding: 9px 12px;
                font-size: 0.84rem;
                color: #78350f;
                margin-top: 5px;
            }

            /* التوقيع */
            .signature-area {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-top: 24px;
                padding-top: 10px;
                border-top: 1px dashed var(--border);
            }

            .sig-block {
                text-align: center;
                min-width: 130px;
            }

            .sig-line {
                border-bottom: 1.5px solid #94a3b8;
                height: 38px;
                margin-bottom: 4px;
            }

            .sig-label {
                font-size: 0.72rem;
                color: var(--muted);
                font-weight: 600;
            }

            .doctor-name {
                font-weight: 800;
                color: var(--teal-dark);
                font-size: 0.86rem;
                margin-top: 2px;
            }

            /* فوتر */
            .rx-footer {
                margin-top: 16px;
                text-align: center;
                font-size: 0.65rem;
                color: #94a3b8;
                border-top: 1px solid var(--border);
                padding-top: 7px;
            }

            /* ── Print styles ── */
            @@media print {
                body {
                    background: #fff;
                }

                .print-toolbar {
                    display: none !important;
                }

                .rx-sheet {
                    width: 100%;
                    min-height: auto;
                    margin: 0;
                    padding: 22mm 10mm 8mm;
                    box-shadow: none;
                }

                @@page {
                    size: 170mm 250mm;
                    margin: 5mm;
                }
            }
    </style>
</head>
<body>

    <!-- شريط التحكم (يختفي عند الطباعة) -->
    <div class="print-toolbar no-print">
        <button class="btn-print" onclick="window.print()">
            <i class="bi bi-printer"></i> طباعة الروشتة
        </button>
        <button class="btn-close-page" onclick="window.close()">إغلاق</button>
    </div>

    <!-- ورقة الروشتة -->
    <div class="rx-sheet">

        @*
        ============================================================
        بيانات العيادة (معلّقة مؤقتاً — لو عايز ترجعها شيل التعليق)
        ============================================================
        <div class="clinic-header">
            <div style="display:flex; align-items:center; gap:16px; flex:1;">
                @if (!string.IsNullOrEmpty(clinicLogo))
                {
                    <img src="@clinicLogo" alt="Logo" class="clinic-logo" onerror="this.style.display='none'" />
                }
                else
                {
                    <div class="clinic-logo-placeholder"><i class="bi bi-hospital"></i></div>
                }
                <div class="clinic-info">
                    <h1>@clinicName</h1>
                    @if (!string.IsNullOrEmpty(clinicAddress))
                    {
                        <p><i class="bi bi-geo-alt"></i> @clinicAddress</p>
                    }
                    @if (!string.IsNullOrEmpty(clinicPhone))
                    {
                        <p><i class="bi bi-telephone"></i> @clinicPhone</p>
                    }
                </div>
            </div>
        </div>
        ============================================================
        *@

        <!-- الهيدر فاضي تماماً (مفيش عنوان "روشتة طبية")    عشان الورق المطبوع مسبقاً -->
        <!-- 1) QR في المنتصف تحت الهيدر المطبوع على الورق -->
        
        <br>
        <!-- 2) بيانات المريض -->
        <div class=" border-0">
            <!-- الصف 1: الاسم + العمر -->
            <div class="patient-row border-0 ">
                <div class="field grow">
                    @* <span class="label">اسم المريض</span> *@
                    <div class="value">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; @(patient?.FullNameAr ?? "—")</div>
                </div>
                <div class="field grow">
                    <div class="value">@(age.HasValue ? $"{age} سنة" : "—")</div>
                </div>
                <div class="field shrink">
                    @* <span class="label">العمر</span> *@

                    <div class="value">@Model.PrescriptionDate.ToString("yy/MM/dd")</div>

                </div>
            </div>
            <!-- الصف 2: التاريخ + النوع -->
            <div class="patient-row" >
                <div class="field grow" hidden>
                    @* <span class="label">تاريخ الروشتة</span> *@
                    <div class="value">@Model.PrescriptionDate.ToString("yy/MM/dd")</div>
                </div>
                <div class="field shrink" hidden>
                    <span class="label">النوع</span>
                    <div class="value">@(patient?.Gender?.NameAr ?? "—")</div>
                </div>
            </div>
        </div>
        
        <br><br>
        <!-- 3) باقي التفاصيل -->
        <!-- التشخيص -->
        @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
        {
            <div class="section text-start" dir="ltr" >
                <div class="section-label "><i class="bi bi-clipboard2-pulse"></i> التشخيص</div>
                <div class="diagnosis-text ">@Model.Diagnosis</div>
            </div>
        }
        <br>

        <!-- الأدوية -->
        <div class="section">
            <div class="section-label fs-4"><i class="bi bi-capsule fs-5"></i> الأدوية</div>
            
            <table class="meds-table">
                <thead>
                    <tr>
                        <th>التعليمات</th>
                        <th>المدة</th>
                        <th>التكرار</th>
                        <th>الجرعة</th>
                        <th>الدواء</th>
                        <th style="width:26px;">#</th>
        
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(item.Instructions ?? "—")</td>
                            <td>@(item.Duration ?? "—")</td>
                            <td>@(item.Frequency ?? "—")</td>
                            <td>@(item.Dosage ?? "—")</td>
                            <td class="med-name">@item.MedicationName</td>
                            <td><span class="med-num">@i</span></td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
        <br><br>
        <!-- ملاحظات -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="section">
                <div class="section-label"><i class="bi bi-chat-left-text"></i> ملاحظات</div>
                <div class="notes-box">@Model.Notes</div>
            </div>
        }

        <!-- التوقيع -->
        <div class="signature-area" hidden>
            <div class="sig-block" hidden>
                <div class="sig-line"></div>
                <div class="sig-label">توقيع المريض / ولي الأمر</div>
            </div>
            <div class="sig-block" hidden>
                <div class="sig-line"></div>
                <div class="sig-label">الطبيب المعالج</div>
                <div class="doctor-name">Dr. @(Model.PrescribedBy ?? "")</div>
            </div>
        </div>

        <!-- فوتر -->
        <div class="rx-footer" hidden>
            طُبعت بتاريخ @DateTime.Now.ToString("dd/MM/yyyy HH:mm") — روشتة رقم #@Model.Id
            <br />
            <span style="font-size:0.6rem;">امسح رمز QR للتحقق من صحة الروشتة</span>
        </div>

        <div class="rx-footer" hidden>
            @if (!string.IsNullOrEmpty(verifyUrl))
            {
                <div class="qr-center">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&margin=3&data=@Uri.EscapeDataString(verifyUrl)"
                         alt="QR Verify"
                         width="90" height="90"
                         class="qr-img" />
                    <div class="qr-caption">امسح لعرض الروشيته</div>
                </div>
            }
        </div>
    </div>


</body>
</html>