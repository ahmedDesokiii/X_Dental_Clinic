@using Dental.Modules.Patients.Enums
@using static Dental.Constants.EnumHelper

@model Dental.Modules.Clinical.ViewModels.SessionViewModel

@{
    ViewData["Title"] = $"سيشن — {Model.Patient.FullNameAr}";

    var initials = string.Join(
        "",
        (Model.Patient.FullNameAr ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0])
    );

    var sessionStatusClass = Model.Visit.Status switch
    {
        VisitStatus.Completed => "success",
        VisitStatus.Cancelled => "danger",
        _ => "warning"
    };

    var sessionStatusText = Model.Visit.Status switch
    {
        VisitStatus.Completed => "مكتمل",
        VisitStatus.Cancelled => "ملغي",
        _ => "قيد التنفيذ"
    };
}

@*
    ============================================================
    Clinical Session - Unified Layout
    ============================================================

    التصميم الجديد بدون Tabs:

    1. Patient Hero + KPIs
    2. Overview | Dental Chart | Payments
    3. Clinical Session Records
    4. Final Actions

    الـ HTML الخاص بكل جزء موجود داخل Partial مستقل:

    _SessionHeroAndKpi.cshtml
    _SessionOverviewCompact.cshtml
    _ClinicalChartColumn.cshtml
    _PaymentsCompact.cshtml
    _ClinicalRecordsTable.cshtml

    ============================================================
*@


<style>

    /* ============================================================
               IMPORTANT
               ============================================================

               احتفظ هنا بأي CSS قديم موجود في Session.cshtml
               إذا كانت الـ Partial Views الجديدة تعتمد عليه.

               خصوصًا:

               .session-hero
               .hero-content
               .hero-avatar
               .stats-grid
               .stat-card-glass

               الـ HTML الخاص بهذه العناصر تم نقله إلى:

               _SessionHeroAndKpi.cshtml

               لذلك لا تحذف الـ CSS إذا كان مستخدمًا هناك.
               ============================================================ */


    /* ============================================================
               PAGE CONTAINER
               ============================================================ */

    .clinical-session-page {
        width: 100%;
        min-height: 100vh;
        padding: 12px;
    }


    /* ============================================================
               MAIN GRID
               ============================================================ */

    .clinical-session-main-grid {
        margin-top: 0;
    }


    /* ============================================================
               FINAL ACTIONS
               ============================================================ */

    .session-final-actions {
        margin-top: 3px;
        padding: 14px 18px;
        border-radius: 16px;
        background: var(--bs-body-bg, #fff);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

    .session-final-actions-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .session-final-actions-left,
    .session-final-actions-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }


    /* ============================================================
               RESPONSIVE
               ============================================================ */

    @@media (max-width: 991.98px) {

        .clinical-session-page {
            padding: 8px;
        }

        .clinical-session-main-grid {
            row-gap: 12px;
        }

        .session-final-actions-inner {
            flex-direction: column;
            align-items: stretch;
        }

        .session-final-actions-left,
        .session-final-actions-right {
            width: 100%;
        }

        .session-final-actions .btn {
            flex: 1;
        }
    }


    @@media (max-width: 575.98px) {

        .clinical-session-page {
            padding: 6px;
        }

        .session-final-actions {
            padding: 12px;
        }

        .session-final-actions-left,
        .session-final-actions-right {
            flex-direction: column;
            width: 100%;
        }

        .session-final-actions .btn {
            width: 100%;
        }
    }

</style>


<div class="container-fluid clinical-session-page"
     dir="rtl"
     data-patient-id="@Model.Patient.Id"
     data-visit-id="@Model.Visit.Id"
     data-session-status="@sessionStatusText">


     
    @* ============================================================
       4. FINAL ACTIONS

       السيناريو:
       SaveClinicalRecord (لو فيه أسنان مُضافة) ثم CompleteVisit.
       الداتا بتيجي من window.clinicalToothRecords اللي بيظبطها
       _ClinicalChartColumn.cshtml أول ما أي سن يتضاف/يتعدل/يتشال.
       ============================================================ *@

    <div class="session-final-actions">

        <div class="session-final-actions-inner">

            <div class="session-final-actions-left">

                <button type="button"
                        id="btnFinishSession"
                        class="btn btn-success btn-lg btn-final-save">

                    <i class="bi bi-check2-circle me-1"></i>

                    إنهاء وحفظ السيشن

                </button>

            </div>

            <div class="session-final-actions-right">

                <button type="button"
                        id="btnBackToPatient"
                        class="btn btn-outline-secondary btn-hero btn-hero-back-sm">

                    <i class="bi bi-arrow-right me-1"></i>

                    رجوع لملف المريض

                </button>

                <button type="button"
                        id="btnPrintSession"
                        class="btn btn-outline-primary btn-hero btn-hero-print-sm">

                    <i class="bi bi-printer me-1"></i>

                    طباعة

                </button>

            </div>

        </div>

    </div>


    @* ============================================================
       1. PATIENT HERO + KPIs
       ============================================================ *@

@*     @await Html.PartialAsync(
        "_SessionHeroAndKpi",
        Model
    )
 *@
    @* ============================================================
       2. MAIN SESSION AREA

       col-3  : Overview
       col-6  : Dental Chart
       col-3  : Payments
       ============================================================ *@

    <div class="row g-3 align-items-stretch clinical-session-main-grid">


        @* ========================================================
           LEFT / OVERVIEW
           ======================================================== *@

        <div class="col-12 col-lg-3">

            @await Html.PartialAsync(
                "_SessionOverviewCompact",
                Model
            )

        </div>


        @* ========================================================
           CENTER / DENTAL CHART
           ======================================================== *@

        <div class="col-12 col-lg-6">

            @await Html.PartialAsync(
                "_ClinicalChartColumn",
                Model
            )

        </div>


        @* ========================================================
           RIGHT / PAYMENTS
           ======================================================== *@

        <div class="col-12 col-lg-3">

            @await Html.PartialAsync(
                "_PaymentsCompact",
                Model
            )

        </div>

    </div>


    @* ============================================================
       3. CLINICAL SESSION RECORDS

       كل سن يتم إضافته يظهر كسطر في الجدول.
       ============================================================ *@

    @await Html.PartialAsync(
        "_ClinicalRecordsTable",
        Model
    )


</div>


@section Scripts {

    <script>

        /*
        ============================================================
        Clinical Session - Main Page Script
        ============================================================
        */

        (() => {

            "use strict";


            /* ====================================================
               ELEMENTS
               ==================================================== */

            const btnFinishSession =
                document.getElementById("btnFinishSession");

            const btnBackToPatient =
                document.getElementById("btnBackToPatient");

            const btnPrintSession =
                document.getElementById("btnPrintSession");


            /* ====================================================
               PAGE DATA
               ==================================================== */

            const sessionPage =
                document.querySelector(".clinical-session-page");

            const patientId =
                sessionPage?.dataset.patientId;

            const visitId =
                sessionPage?.dataset.visitId;


            /* ====================================================
               URLS
               ==================================================== */

            const saveClinicalRecordUrl = '@Url.Action("SaveClinicalRecord", "Clinical")';

            const completeVisitUrl = '@Url.Action("CompleteVisit", "Clinical")';


            /* ====================================================
               HELPER
               ==================================================== */

            function showMessage(
                message,
                type = "error"
            ) {

                if (typeof Swal !== "undefined") {

                    Swal.fire({
                        icon: type,
                        text: message,
                        confirmButtonText: "حسنًا"
                    });

                    return;
                }

                alert(message);
            }


            /* ====================================================
               GET TOOTH RECORDS
               ====================================================

               الـ Dental Chart الجديد يفترض أن يحتفظ بالبيانات
               في window.clinicalToothRecords.

               ولو لم تكن موجودة، نستخدم Array فارغة.

               ==================================================== */

            function getToothRecords() {

                if (
                    window.clinicalToothRecords &&
                    Array.isArray(window.clinicalToothRecords)
                ) {

                    return window.clinicalToothRecords;

                }


                if (
                    window.toothRecords &&
                    Array.isArray(window.toothRecords)
                ) {

                    return window.toothRecords;

                }


                return [];

            }


            /* ====================================================
               SAVE CLINICAL RECORD
               ==================================================== */

            async function saveClinicalRecord() {

                const toothRecords =
                    getToothRecords();


                /*
                لا توجد أسنان:

                حسب السيناريو الجديد لا نرسل SaveClinicalRecord
                لأن الـ Controller الحالي يرجع:

                "لا توجد أي بيانات لحفظها."

                وفي هذه الحالة يمكن إغلاق السيشن مباشرة
                بعد تأكيد المستخدم.
                */

                if (!toothRecords.length) {

                    const result =
                        await confirmWithoutTeeth();

                    if (!result) {
                        return false;
                    }

                    return true;
                }


                const request = {

                    patientId: Number(patientId),

                    visitId: Number(visitId),

                    toothRecords: toothRecords

                };


                const response =
                    await fetch(
                        saveClinicalRecordUrl,
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(request)
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "حدث خطأ أثناء الاتصال بالسيرفر."
                    );
                }


                const result =
                    await response.json();


                if (!result.success) {

                    throw new Error(
                        result.message ||
                        "فشل حفظ بيانات السيشن."
                    );
                }


                return true;
            }


            /* ====================================================
               CONFIRM WITHOUT TEETH
               ==================================================== */

            async function confirmWithoutTeeth() {

                if (typeof Swal === "undefined") {

                    return confirm(
                        "لم يتم إضافة أي أسنان لهذه السيشن.\n\nهل تريد إنهاء السيشن بدون بيانات أسنان؟"
                    );
                }


                const result =
                    await Swal.fire({

                        icon: "question",

                        title: "لا توجد بيانات أسنان",

                        text:
                            "لم يتم إضافة أي سن لهذه السيشن. هل تريد إنهاء السيشن بدون بيانات أسنان؟",

                        showCancelButton: true,

                        confirmButtonText:
                            "نعم، إنهاء السيشن",

                        cancelButtonText:
                            "إلغاء",

                        reverseButtons: true

                    });


                return result.isConfirmed;
            }


            /* ====================================================
               COMPLETE VISIT
               ==================================================== */

            async function completeVisit() {

                const response =
                    await fetch(
                        completeVisitUrl,
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    visitId:
                                        Number(visitId)
                                })
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "حدث خطأ أثناء إنهاء الزيارة."
                    );
                }


                const result =
                    await response.json();


                if (!result.success) {

                    throw new Error(
                        result.message ||
                        "تعذر إنهاء الزيارة."
                    );
                }


                return result;
            }


            /* ====================================================
               FINISH SESSION
               ==================================================== */

            async function finishSession() {

                if (!patientId || !visitId) {

                    showMessage(
                        "بيانات المريض أو الزيارة غير صالحة."
                    );

                    return;
                }


                try {

                    if (btnFinishSession) {

                        btnFinishSession.disabled =
                            true;

                        btnFinishSession.dataset.originalText =
                            btnFinishSession.innerHTML;

                        btnFinishSession.innerHTML =

                            '<span class="spinner-border spinner-border-sm me-1"></span>' +
                            ' جاري الحفظ...';
                    }


                    /*
                    ==================================================
                    STEP 1
                    Save Clinical Record
                    ==================================================
                    */

                    const saved =
                        await saveClinicalRecord();


                    if (!saved) {

                        return;
                    }


                    /*
                    ==================================================
                    STEP 2
                    Complete Visit

                    لا يتم الوصول هنا إلا إذا نجح الحفظ.
                    ==================================================
                    */

                    await completeVisit();


                    /*
                    ==================================================
                    SUCCESS
                    ==================================================
                    */

                    if (typeof Swal !== "undefined") {

                        await Swal.fire({

                            icon: "success",

                            title: "تم بنجاح",

                            text:
                                "تم حفظ بيانات السيشن وإنهاء الزيارة.",

                            confirmButtonText:
                                "حسنًا"

                        });

                    } else {

                        alert(
                            "تم حفظ بيانات السيشن وإنهاء الزيارة."
                        );

                    }


                    /*
                    بعد نجاح إنهاء السيشن:
                    نرجع إلى ملف المريض.

                    استخدمنا PatientId حتى لا نعتمد على
                    URL ثابت.
                    */

                    window.location.href =
                        '@Url.Action("Details", "Patients")' +
                        '?id=' +
                        encodeURIComponent(patientId);

                }

                catch (error) {

                    console.error(
                        "Finish Session Error:",
                        error
                    );


                    showMessage(
                        error.message ||
                        "حدث خطأ أثناء حفظ وإنهاء السيشن.",
                        "error"
                    );

                }

                finally {

                    if (btnFinishSession) {

                        btnFinishSession.disabled =
                            false;

                        if (
                            btnFinishSession.dataset.originalText
                        ) {

                            btnFinishSession.innerHTML =
                                btnFinishSession.dataset.originalText;
                        }
                    }
                }
            }


            /* ====================================================
               BACK TO PATIENT
               ==================================================== */

            function backToPatient() {

                if (!patientId) {

                    showMessage(
                        "معرف المريض غير موجود."
                    );

                    return;
                }


                const url =
                    '@Url.Action("Details", "Patients")' +
                    '?id=' +
                    encodeURIComponent(patientId);


                window.location.href = url;
            }


            /* ====================================================
               PRINT
               ==================================================== */

            function printSession() {

                window.print();

            }


            /* ====================================================
               EVENTS
               ==================================================== */

            if (btnFinishSession) {

                btnFinishSession.addEventListener(
                    "click",
                    finishSession
                );
            }


            if (btnBackToPatient) {

                btnBackToPatient.addEventListener(
                    "click",
                    backToPatient
                );
            }


            if (btnPrintSession) {

                btnPrintSession.addEventListener(
                    "click",
                    printSession
                );
            }


        })();

    </script>


    <style>

        /* =========================================================
                           PRINT
                           ========================================================= */

        @@media print {

            .session-final-actions {
                display: none !important;
            }

            .clinical-session-page {
                padding: 0 !important;
            }

            body {
                background: #fff !important;
            }
        }

    </style>

}