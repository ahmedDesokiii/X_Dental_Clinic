@using Dental.Modules.Patients.Enums
@using static Dental.Constants.EnumHelper
@model Dental.Modules.Clinical.ViewModels.SessionViewModel

@{
    ViewData["Title"] = $"Session — {Model.Patient.FullNameAr}";

    var initials = string.Join("",
        (Model.Patient.FullNameAr ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0]));

    var sessionStatusClass = Model.Visit.Status switch
    {        VisitStatus.Completed => "success",
        VisitStatus.Cancelled => "danger",
        _ => "warning"
    };

    var sessionStatusText = Model.Visit.Status switch
    {
        VisitStatus.Completed => "Completed",
        VisitStatus.Cancelled => "Cancelled",
        _ => "In Progress"
    };

    var typeText = Model.Patient.PatientType switch
    {
        Dental.Models.Patient.PatientType.Orthodontics => "Orthodontics",
        Dental.Models.Patient.PatientType.Both => "General + Ortho",
        _ => "General"
    };

    var typeIcon = Model.Patient.PatientType switch
    {
        Dental.Models.Patient.PatientType.Orthodontics => "bi-braces",
        Dental.Models.Patient.PatientType.Both => "bi-heart-pulse",
        _ => "bi-app-indicator"
    };
    var paidPercent = Model.Visit.TotalAmount > 0
        ? Math.Min(100, (int)Math.Round((Model.Visit.PaidAmount / Model.Visit.TotalAmount) * 100))
        : 100;
}

<style>
    :root {
        --dc-bg: #f0f7f7;
        --dc-card: rgba(255,255,255,0.82);
        --dc-card-solid: #ffffff;
        --dc-border: rgba(255,255,255,0.6);
        --dc-teal-50: #eafbfc;
        --dc-teal-100: #c7f2ea;
        --dc-teal-500: #14b8a6;
        --dc-teal-600: #0d9488;
        --dc-teal-700: #0d7377;
        --dc-teal-900: #0a4d4f;
        --dc-coral-300: #f6c6bc;
        --dc-ink-900: #0b2e30;
        --dc-ink-600: #4b6b6c;
        --dc-ink-400: #94a3b8;
        --dc-shadow-sm: 0 2px 8px rgba(10,77,79,0.04);
        --dc-shadow: 0 8px 32px rgba(10,77,79,0.08);
        --dc-shadow-lg: 0 20px 60px rgba(10,77,79,0.12);
        --dc-glass: rgba(255,255,255,0.72);
    }


    .clinical-session-page {
        width: 100%;
        min-height: 100vh;
        background: radial-gradient(circle at 0% 0%, #e6fbf8 0%, transparent 45%), radial-gradient(circle at 100% 100%, #fef3ee 0%, transparent 35%), linear-gradient(180deg, #f0f7f7 0%, #f7fbfb 100%);
        padding: 16px 20px 100px;
        font-family: 'Segoe UI', 'IBM Plex Sans Arabic', system-ui, sans-serif;
        color: var(--dc-ink-900);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(24px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes fadeInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes fadeInRight {
        from {
            opacity: 0;
            transform: translateX(30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(13,148,136,0.25);
        }

        50% {
            box-shadow: 0 0 20px 4px rgba(13,148,136,0.15);
        }
    }

    @@keyframes progressFill {
        from {
            width: 0%;
        }
    }

    @@keyframes countUp {
        from {
            opacity: 0;
            transform: translateY(8px);
            filter: blur(4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    @@keyframes badgePop {
        0% {
            transform: scale(0);
        }

        70% {
            transform: scale(1.15);
        }

        100% {
            transform: scale(1);
        }
    }

    .anim-fade-up {
        animation: fadeInUp 0.6s cubic-bezier(0.2,0.8,0.3,1) forwards;
        opacity: 0;
    }

    .anim-fade-left {
        animation: fadeInLeft 0.6s cubic-bezier(0.2,0.8,0.3,1) forwards;
        opacity: 0;
    }

    .anim-fade-right {
        animation: fadeInRight 0.6s cubic-bezier(0.2,0.8,0.3,1) forwards;
        opacity: 0;
    }

    .anim-scale {
        animation: scaleIn 0.5s cubic-bezier(0.2,1.4,0.4,1) forwards;
        opacity: 0;
    }

    .anim-d1 {
        animation-delay: 0.08s;
    }

    .anim-d2 {
        animation-delay: 0.16s;
    }

    .anim-d3 {
        animation-delay: 0.24s;
    }

    .anim-d4 {
        animation-delay: 0.32s;
    }

    .anim-d5 {
        animation-delay: 0.40s;
    }

    .session-hero {
        background: linear-gradient(135deg, #0d7377 0%, #0f9b8e 50%, #14b8a6 100%);
        border-radius: 24px;
        padding: 20px 28px;
        color: #fff;
        box-shadow: var(--dc-shadow-lg), 0 0 0 1px rgba(255,255,255,0.15) inset;
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        animation: fadeInUp 0.7s ease forwards;
    }

        .session-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
            pointer-events: none;
        }

        .session-hero.status-success {
            background: linear-gradient(135deg, #0d7377 0%, #15803d 60%, #16a34a 100%);
        }

        .session-hero.status-danger {
            background: linear-gradient(135deg, #7f1d1d 0%, #b91c1c 60%, #dc2626 100%);
        }

    .hero-grid {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 20px;
        align-items: center;
        position: relative;
        z-index: 2;
    }

    .hero-avatar {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.3);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 800;
        flex-shrink: 0;
        animation: float 4s ease-in-out infinite;
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-4px);
        }
    }

    .hero-info h1 {
        font-size: 1.3rem;
        font-weight: 800;
        margin: 0 0 10px;
        letter-spacing: -0.3px;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.22);
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
        backdrop-filter: blur(4px);
        transition: all 0.2s ease;
    }

        .hero-tag:hover {
            background: rgba(255,255,255,0.25);
            transform: translateY(-1px);
        }

    .hero-actions {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: nowrap;
    }

    .btn-hero {
        border: none;
        padding: 10px 20px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .btn-hero:hover {
            transform: translateY(-2px);
        }

        .btn-hero.primary {
            background: #fff;
            color: var(--dc-teal-700);
            box-shadow: 0 10px 28px rgba(0,0,0,0.18);
            animation: pulseGlow 3s ease-in-out infinite;
        }

        .btn-hero.glass {
            background: rgba(255,255,255,0.12);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.28);
        }

            .btn-hero.glass:hover {
                background: rgba(255,255,255,0.22);
            }

    .hero-metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 18px;
        position: relative;
        z-index: 2;
    }

    .metric-glass {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.18);
        border-radius: 16px;
        padding: 14px;
        text-align: center;
        backdrop-filter: blur(4px);
        transition: all 0.3s ease;
    }

        .metric-glass:hover {
            background: rgba(255,255,255,0.18);
            transform: translateY(-3px);
        }

    .metric-value {
        font-size: 1.2rem;
        font-weight: 800;
        display: block;
        animation: countUp 0.8s ease forwards;
    }

    .metric-label {
        font-size: 0.7rem;
        opacity: 0.85;
        font-weight: 600;
        margin-top: 4px;
        display: block;
    }

    .payment-progress-hero {
        margin-top: 16px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 16px;
        padding: 14px 18px;
        position: relative;
        z-index: 2;
    }

    .progress-label-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .progress-track {
        height: 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.15);
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #fff, #c7f2ea);
        box-shadow: 0 0 12px rgba(255,255,255,0.3);
        animation: progressFill 1.2s cubic-bezier(0.2,0.8,0.3,1) forwards;
        width: @(paidPercent) %;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 620px 1fr;
        gap: 20px;
        align-items: start;
    }

    .chart-panel {
        position: sticky;
        top: 16px;
        background: var(--dc-card);
        border-radius: 24px;
        border: 1px solid var(--dc-border);
        box-shadow: var(--dc-shadow);
        padding: 5px;
        backdrop-filter: blur(12px);
        animation: fadeInLeft 0.7s 0.15s ease forwards;
        opacity: 0;
    }

    .chart-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

        .chart-panel-head h3 {
            font-size: 1rem;
            font-weight: 800;
            color: var(--dc-ink-900);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .chart-legend-compact {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(0,0,0,0.04);
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .legend-item-sm {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--dc-ink-600);
        padding: 3px 8px;
        border-radius: 8px;
        background: rgba(0,0,0,0.02);
    }

    .content-panel {
        display: flex;
        flex-direction: column;
        gap: 0;
        background: var(--dc-card);
        border-radius: 24px;
        border: 1px solid var(--dc-border);
        box-shadow: var(--dc-shadow);
        backdrop-filter: blur(12px);
        overflow: hidden;
        animation: fadeInRight 0.7s 0.2s ease forwards;
        opacity: 0;
        min-height: 600px;
    }

    .dc-tabs-bar {
        display: flex;
        gap: 4px;
        background: linear-gradient(180deg, rgba(240,253,250,0.8) 0%, rgba(240,253,250,0.4) 100%);
        padding: 8px;
        border-bottom: 1px solid rgba(0,0,0,0.04);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .dc-tab-btn {
        flex: 1;
        border: none;
        background: transparent;
        color: var(--dc-ink-600);
        font-weight: 700;
        font-size: 0.82rem;
        padding: 10px 12px;
        border-radius: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.25s cubic-bezier(0.2,0.8,0.3,1);
        position: relative;
    }

        .dc-tab-btn:hover {
            background: rgba(13,148,136,0.06);
            color: var(--dc-teal-700);
        }

        .dc-tab-btn.active {
            background: #fff;
            color: var(--dc-teal-700);
            box-shadow: 0 4px 16px rgba(13,115,119,0.12);
        }

        .dc-tab-btn .tab-badge {
            background: var(--dc-teal-100);
            color: var(--dc-teal-700);
            font-size: 0.65rem;
            font-weight: 800;
            padding: 1px 7px;
            border-radius: 999px;
            min-width: 20px;
            text-align: center;
        }

    .dc-tab-panel {
        display: none;
        padding: 20px;
        animation: fadeInUp 0.35s ease;
    }

        .dc-tab-panel.active {
            display: block;
        }

    .bottom-action-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(20px) saturate(1.8);
        border-top: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 -8px 32px rgba(10,77,79,0.08);
        padding: 14px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        transform: translateY(100%);
        transition: transform 0.4s cubic-bezier(0.2,0.8,0.3,1);
    }

        .bottom-action-bar.visible {
            transform: translateY(0);
        }

    .bottom-stats {
        display: flex;
        gap: 24px;
    }

    .bottom-stat {
        text-align: center;
    }

    .bottom-stat-value {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--dc-ink-900);
        display: block;
        line-height: 1;
    }

    .bottom-stat-label {
        font-size: 0.7rem;
        color: var(--dc-ink-400);
        font-weight: 600;
        margin-top: 4px;
    }

    .bottom-stat.remaining .bottom-stat-value {
        color: #dc2626;
    }

    .bottom-stat.paid .bottom-stat-value {
        color: #16a34a;
    }

    .btn-finish {
        background: linear-gradient(135deg, var(--dc-teal-600), var(--dc-teal-700));
        color: #fff;
        border: none;
        padding: 12px 28px;
        border-radius: 16px;
        font-weight: 800;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(13,115,119,0.3);
        transition: all 0.3s ease;
        animation: pulseGlow 3s ease-in-out infinite;
    }

        .btn-finish:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 12px 32px rgba(13,115,119,0.4);
        }

    .section-card {
        background: var(--dc-card-solid);
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.04);
        box-shadow: var(--dc-shadow-sm);
        padding: 20px;
        margin-bottom: 16px;
        transition: all 0.3s ease;
    }

        .section-card:hover {
            box-shadow: var(--dc-shadow);
            transform: translateY(-2px);
        }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

        .section-head h4 {
            margin: 0;
            font-weight: 800;
            font-size: 0.95rem;
            color: var(--dc-ink-900);
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .section-badge {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--dc-teal-700);
        background: var(--dc-teal-50);
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid var(--dc-teal-100);
    }

    .dc-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.82rem;
    }

        .dc-table th {
            text-align: right;
            padding: 12px 10px;
            color: var(--dc-ink-400);
            font-weight: 700;
            border-bottom: 2px solid #f1f5f9;
            white-space: nowrap;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .dc-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #f8fafc;
            color: #1e293b;
            vertical-align: middle;
            transition: background 0.15s ease;
        }

        .dc-table tbody tr:hover td {
            background: linear-gradient(90deg, transparent, rgba(13,148,136,0.03), transparent);
        }

        .dc-table tbody tr:last-child td {
            border-bottom: none;
        }

    .tooth-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #ede9fe, #ddd6fe);
        color: #5b21b6;
        font-weight: 800;
        font-size: 0.85rem;
        box-shadow: 0 2px 6px rgba(91,33,182,0.1);
    }

    .badge-pending {
        font-size: 0.68rem;
        font-weight: 700;
        color: #b45309;
        background: #fef3c7;
        padding: 3px 10px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .row-pending {
        background: linear-gradient(90deg, #fffbeb, #fff) !important;
    }

        .row-pending td:first-child {
            border-right: 3px solid #f59e0b;
        }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--dc-ink-400);
    }

        .empty-state i {
            font-size: 2.5rem;
            margin-bottom: 12px;
            display: block;
            opacity: 0.4;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.9rem;
            font-weight: 600;
        }

    .btn-sm {
        border: none;
        background: transparent;
        color: var(--dc-ink-400);
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
        transition: all 0.2s ease;
        font-size: 0.9rem;
    }

        .btn-sm:hover {
            background: #f1f5f9;
            color: var(--dc-teal-600);
        }

        .btn-sm.danger:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 999px;
    }

        .custom-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    @@media (max-width: 1199.98px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .chart-panel {
            position: relative;
            top: 0;
        }

        .hero-grid {
            grid-template-columns: auto 1fr;
        }

        .hero-actions {
            flex-direction: row;
            grid-column: 1 / -1;
        }

        .hero-metrics {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .clinical-session-page {
            padding: 12px 12px 100px;
        }

        .hero-metrics {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .bottom-stats {
            gap: 12px;
        }

        .bottom-stat-label {
            font-size: 0.6rem;
        }
    }

    @@media print {
        .session-hero .hero-actions, .payment-progress-hero,
        .dc-tabs-bar, .bottom-action-bar, .btn-sm {
            display: none !important;
        }

        .dc-tab-panel {
            display: block !important;
        }

        .clinical-session-page {
            padding: 0 !important;
            background: #fff !important;
        }

        .dashboard-grid {
            grid-template-columns: 1fr !important;
        }

        .chart-panel, .content-panel {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }
    }

    .modal-col-divider {
        width: 1px;
        background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
        flex-shrink: 0;
    }




</style>
<style>
    /* ⭐ Shine sweep across hero */
    .session-hero::before {
        content: '';
        position: absolute;
        top: -60%;
        right: -30%;
        width: 55%;
        height: 220%;
        background: linear-gradient(105deg, transparent, rgba(255,255,255,.14), transparent);
        transform: rotate(12deg);
        animation: heroShine 6s ease-in-out infinite;
        pointer-events: none;
    }
    @@keyframes heroShine {
        0%, 100% {
            right: -40%;
        }

        50% {
            right: 110%;
        }
    }

    /* ⭐ Floating particles */
    .session-hero .particle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,.35);
        animation: particleFloat linear infinite;
        pointer-events: none;
    }
    @@keyframes particleFloat {
        0% {
            transform: translateY(20px) scale(1);
            opacity: 0;
        }

        15% {
            opacity: .8;
        }

        90% {
            opacity: .5;
        }

        100% {
            transform: translateY(-160px) scale(.3);
            opacity: 0;
        }
    }

    /* ⭐ Tab badge pulse when active */
    .tab-badge {
        transition: transform .2s ease;
    }

    .dc-tab-btn.active .tab-badge {
        animation: badgePop .4s ease;
    }

    /* ⭐ Finish button shine */
    .btn-finish::after {
        content: '';
        position: absolute;
        top: 0;
        left: -80%;
        width: 50%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
        transform: skewX(-20deg);
        animation: btnShine 3.2s ease infinite;
    }

    .btn-finish {
        position: relative;
        overflow: hidden;
    }
    @@keyframes btnShine {
        0% {
            left: -80%;
        }

        55% {
            left: 130%;
        }

        100% {
            left: 130%;
        }
    }
</style>


<div dir="ltr"
     data-patient-id="@Model.Patient.Id"
     data-visit-id="@Model.Visit.Id"
     data-session-status="@sessionStatusText">

    @* ====== HERO ====== *@
    <div class="session-hero status-@sessionStatusClass anim-fade-up">
        <div class="hero-grid">
            <span class="particle" style="width:8px;height:8px;right:12%;bottom:20%;animation-duration:7s;"></span>
            <span class="particle" style="width:5px;height:5px;right:28%;bottom:10%;animation-duration:9s;animation-delay:1.2s;"></span>
            <span class="particle" style="width:6px;height:6px;right:55%;bottom:25%;animation-duration:8s;animation-delay:.6s;"></span>
            <span class="particle" style="width:4px;height:4px;right:75%;bottom:15%;animation-duration:10s;animation-delay:2s;"></span>
            <span class="particle" style="width:7px;height:7px;right:88%;bottom:30%;animation-duration:6.5s;animation-delay:.3s;"></span>
            <div class="hero-avatar">@initials</div>
            <div class="hero-info">
                <h1>@Model.Patient.FullNameAr</h1>
                <div class="hero-tags">
                    <span class="hero-tag"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i> @sessionStatusText</span>
                    <span class="hero-tag"><i class="bi bi-hash"></i> @Model.Patient.PatientCode</span>
                    <span class="hero-tag"><i class="bi bi-telephone"></i> @Model.Patient.Mobile</span>
                    <span class="hero-tag"><i class="bi @typeIcon"></i> @typeText</span>
                    <span class="hero-tag"><i class="bi bi-droplet"></i> @(Model.Patient.BloodGroup?.Name ?? "-")</span>
                    <span class="hero-tag"><i class="bi bi-calendar"></i> @Model.Visit.VisitDate.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
            <div class="hero-actions">
                <button type="button" id="btnAddRxSession" class="btn-hero glass" onclick="openRxModal()">
                    Prescription
                    <i class="bi bi-file-earmark-medical"></i>
                </button>
                <button type="button" id="btnPrintSession" class="btn-hero glass">
                    Print
                    <i class="bi bi-printer"></i>
                </button>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.Patient.Id" class="btn-hero glass">
                    Back
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            </div>
        </div>

        <div class="hero-metrics" hidden>
            <div class="metric-glass anim-fade-up anim-d1">
                <span class="metric-value">@Model.Visit.TotalAmount.ToString("N0")</span>
                <span class="metric-label">الإجمالي (م.ج)</span>
            </div>
            <div class="metric-glass anim-fade-up anim-d2">
                <span class="metric-value">@Model.Visit.Discount.ToString("N0")</span>
                <span class="metric-label">الخصم</span>
            </div>
            <div class="metric-glass anim-fade-up anim-d3">
                <span class="metric-value">@Model.Visit.PaidAmount.ToString("N0")</span>
                <span class="metric-label">المدفوع</span>
            </div>
            <div class="metric-glass anim-fade-up anim-d4">
                <span class="metric-value">@Model.Visit.Remaining.ToString("N0")</span>
                <span class="metric-label">المتبقي</span>
            </div>
        </div>

        <div class="payment-progress-hero" hidden>
            <div class="progress-label-row">
                <span>نسبة السداد</span>
                <b>@paidPercent%</b>
            </div>
            <div class="progress-track">
                <div class="progress-fill"></div>
            </div>
        </div>
    </div>

    @* ====== MAIN DASHBOARD GRID ====== *@
    <div class="dashboard-grid">

        @* --- LEFT: Chart --- *@
        <div class="chart-panel">
            @await Html.PartialAsync("_DentalChartInteractive", Model)
            <div class="chart-legend-compact">
            <span class="legend-item-sm"><span class="legend-dot" style="background:#fff;border:2px solid #0f9b8e;"></span> Healthy</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#ef4444;"></span> Decayed</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#3b82f6;"></span> Treated</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#cbd5e1;"></span> Missing</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#cbd5e1;"></span> Extracted</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#f59e0b;"></span> RootCanal</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#a855f7;"></span> Crown</span>
            <span class="legend-item-sm"><span class="legend-dot" style="background:#ec4899;"></span> Impants</span>
            </div>
        </div>

    

        @* --- RIGHT: Tabs Content --- *@
        <div class="content-panel">
            <div class="dc-tabs-bar">
                <button type="button" class="dc-tab-btn active" onclick="switchTab('tabCurrent', this)">
                    <i class="bi bi-table"></i> Current Session
                    <span class="tab-badge" id="tabBadgeCurrent">0</span>
                </button>
                <button type="button" class="dc-tab-btn" onclick="switchTab('tabPayments', this)">
                    <i class="bi bi-credit-card-2-front"></i> Payments
                </button>
                <button type="button" class="dc-tab-btn" onclick="switchTab('tabPrev', this)">
                    <i class="bi bi-clock-history"></i> Previous Sessions
                </button>
                <button type="button" class="dc-tab-btn" onclick="switchTab('tabXray', this)">
                    <i class="bi bi-image"></i> X-Rays
                </button>
                <button type="button" class="dc-tab-btn" onclick="switchTab('tabFollow', this)">
                    <i class="bi bi-calendar-plus"></i> Follow Up
                </button>
            </div>

            <div class="dc-tab-panel active custom-scroll" id="tabCurrent" style="max-height:680px; overflow-y:auto;">
                @await Html.PartialAsync("_ClinicalRecordsTable", Model)
            </div>
            <div class="dc-tab-panel custom-scroll" id="tabPrev" style="max-height:680px; overflow-y:auto;">
                @await Html.PartialAsync("_PreviousSessionsTable", Model)
            </div>
            <div class="dc-tab-panel custom-scroll" id="tabXray" style="max-height:680px; overflow-y:auto;">
                @await Html.PartialAsync("_XRaysTable", Model)
            </div>
            <div class="dc-tab-panel custom-scroll" id="tabPayments" style="max-height:680px; overflow-y:auto;">
                @await Html.PartialAsync("_PaymentsCompact", Model)
            </div>
            <div class="dc-tab-panel custom-scroll" id="tabFollow" style="max-height:680px; overflow-y:auto;">
                @await Html.PartialAsync("_FollowUpPanel", Model)
            </div>
        </div>
    @await Html.PartialAsync("_SessionPrescription", Model)
    </div>
  


@* ====== BOTTOM STICKY ACTION BAR ====== *@
<div class="bottom-action-bar" id="bottomBar">
    <div class="bottom-stats">
        <div class="bottom-stat">
            <span class="bottom-stat-value" id="barTotal">@Model.Visit.TotalAmount.ToString("N0")</span>
            <span class="bottom-stat-label">Total Amount</span>
        </div>
        <div class="bottom-stat paid">
            <span class="bottom-stat-value" id="barPaid">@Model.Visit.PaidAmount.ToString("N0")</span>
            <span class="bottom-stat-label">Paid Amount</span>
        </div>
        <div class="bottom-stat ">
            <span class="bottom-stat-value text-warning">@Model.Visit.Discount.ToString("N0")</span>
            <span class="bottom-stat-label"> Discount</span>
        </div>
        <div class="bottom-stat remaining">
            <span class="bottom-stat-value" id="barRemaining">@Model.Visit.Remaining.ToString("N0")</span>
            <span class="bottom-stat-label">Remaining</span>
        </div>
    </div>
    <button type="button" class="btn-finish" onclick="window.saveAndEndSession()">
        <i class="bi bi-check2-circle"></i> Save Session
    </button>
</div>

@section Scripts {
    <script>
        (() => {
            "use strict";

            window.switchTab = function(panelId, btn) {
                document.querySelectorAll('.dc-tab-panel').forEach(p => p.classList.remove('active'));
                document.querySelectorAll('.dc-tab-btn').forEach(b => b.classList.remove('active'));
                const panel = document.getElementById(panelId);
                panel.classList.add('active');
                panel.style.animation = 'none';
                void panel.offsetWidth;
                panel.style.animation = '';
                btn.classList.add('active');
            };

            const btnPrint = document.getElementById("btnPrintSession");
            if (btnPrint) btnPrint.addEventListener("click", () => window.print());

            const bottomBar = document.getElementById('bottomBar');
            
            function checkPendingChanges() {
                const hasTeeth = (window.pendingToothRecords || []).length > 0;
                const hasPayments = window.pendingPayments && window.pendingPayments.length > 0;
                bottomBar.classList.toggle('visible', hasTeeth || hasPayments);
            }

            const origRender = window.renderRecordsTable;
            window.renderRecordsTable = function() {
                if (origRender) origRender();
                checkPendingChanges();
                updateTabBadge();
            };
            const origRenderPay = window.renderPendingPaymentsSummary;
            window.renderPendingPaymentsSummary = function() {
                if (origRenderPay) origRenderPay();
                checkPendingChanges();
                updateBottomBar();
            };

            function updateTabBadge() {
                const count = (window.pendingToothRecords || []).length;
                const badge = document.getElementById('tabBadgeCurrent');
                if (badge) {
                    badge.textContent = count;
                    badge.style.display = count > 0 ? 'inline-block' : 'none';
                    if (count > 0) badge.style.animation = 'badgePop 0.4s ease';
                }
            }


            function updateBottomBar() {
                const baseTotal = @(Model.Visit.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
                const basePaid = @(Model.Visit.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
                const baseDiscount = @(Model.Visit.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture));
                const pendingDiagnosisTotal = (window.pendingToothRecords || [])
                    .reduce((sum, t) => sum + (t.DiagnosisPrice || 0), 0);
                const pendingPaidTotal = window.pendingPayments ? window.pendingPayments.reduce((sum, p) => sum + p.Amount, 0) : 0;
                const pendingDiscountTotal = window.pendingPayments ? window.pendingPayments.reduce((sum, p) => sum + (p.Discount || 0), 0) : 0;

                const newTotal = baseTotal + pendingDiagnosisTotal;
                const newDiscount = baseDiscount + pendingDiscountTotal;
                const newPaid = basePaid + pendingPaidTotal;
                const newRemaining = newTotal - newDiscount - newPaid;

                const fmt = n => n.toLocaleString('en-EG');
                const elTotal = document.getElementById('barTotal');
                const elPaid = document.getElementById('barPaid');
                const elRem = document.getElementById('barRemaining');
                if (elTotal) elTotal.textContent = fmt(newTotal);
                if (elPaid) elPaid.textContent = fmt(newPaid);
                if (elRem) elRem.textContent = fmt(newRemaining);
            }

            setTimeout(checkPendingChanges, 500);
        })();
    </script>
}
