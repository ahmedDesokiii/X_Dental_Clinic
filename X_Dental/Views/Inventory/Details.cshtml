@using Dental.Modules.Inventory.DTOs
@model MaterialDetailsDto
@{
    ViewData["Title"] = $"Material — {Model.Name}";
    var history = ViewBag.History as List<MaterialHistoryDto> ?? new List<MaterialHistoryDto>();
    string statusLabel, statusBg, statusIcon;
    if (Model.IsExpired) { statusLabel = "Expired"; statusBg = "#dc2626"; statusIcon = "bi-x-circle"; }
    else if (Model.IsOutOfStock) { statusLabel = "Out of stock"; statusBg = "#dc2626"; statusIcon = "bi-slash-circle"; }
    else if (Model.IsNearExpiry) { statusLabel = "Near expiry"; statusBg = "#f97316"; statusIcon = "bi-clock-history"; }
    else if (Model.IsLowStock) { statusLabel = "Low stock"; statusBg = "#f59e0b"; statusIcon = "bi-exclamation-triangle"; }
    else { statusLabel = "In stock"; statusBg = "#16a34a"; statusIcon = "bi-check-circle"; }
}

@section Styles {
    <style>
        :root {
            --dc-teal-600: #0d9488;
            --dc-shadow: 0 8px 32px rgba(10,77,79,.08);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes tlIn {
            from {
                opacity: 0;
                transform: translateX(-12px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes invShine {
            0%, 100% {
                right: -30%;
            }

            50% {
                right: 105%;
            }
        }

        .mdet-page {
            padding: 16px 20px 60px;
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: var(--dc-ink-900);
        }

        .mdet-hero {
            background: linear-gradient(135deg,#0d7377,#14b8a6);
            border-radius: 22px;
            padding: 20px 26px;
            color: #fff;
            margin-bottom: 18px;
            box-shadow: var(--dc-shadow);
            position: relative;
            overflow: hidden;
            animation: fadeInUp .45s ease both;
        }

            .mdet-hero::before {
                content: '';
                position: absolute;
                top: -60%;
                right: -30%;
                width: 45%;
                height: 220%;
                background: linear-gradient(105deg, transparent, rgba(255,255,255,.16), transparent);
                transform: rotate(12deg);
                animation: invShine 7s ease-in-out infinite;
                pointer-events: none;
            }

            .mdet-hero h1 {
                margin: 0 0 8px;
                font-size: 1.3rem;
                font-weight: 800;
                position: relative;
            }

        .mdet-tags {
            position: relative;
        }

            .mdet-tags span {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: rgba(255,255,255,.15);
                padding: 4px 12px;
                border-radius: 999px;
                font-size: .75rem;
                font-weight: 700;
                margin-right: 6px;
            }

        .mdet-grid {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 18px;
            align-items: start;
        }

        .mdet-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: var(--dc-shadow);
            padding: 18px;
            margin-bottom: 16px;
            animation: fadeInUp .5s ease both;
        }

            .mdet-card h6 {
                font-weight: 800;
                margin-bottom: 12px;
                color: var(--dc-teal-700);
                font-size: .82rem;
                text-transform: uppercase;
                letter-spacing: .3px;
            }

        .mdet-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid var(--dc-teal-50);
            font-size: .86rem;
        }

            .mdet-row:last-child {
                border-bottom: none;
            }

            .mdet-row span {
                color: var(--dc-ink-600);
                font-weight: 600;
            }

            .mdet-row b {
                color: var(--dc-ink-900);
                text-align: right;
            }

        .mdet-back {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 10px 14px;
            border-radius: 12px;
            border: 1.5px solid var(--dc-teal-100);
            background: #fff;
            color: var(--dc-teal-700);
            font-weight: 800;
            font-size: .85rem;
            text-decoration: none;
            transition: all .2s;
            animation: fadeInUp .55s .1s ease both;
        }

            .mdet-back:hover {
                background: var(--dc-teal-50);
                color: var(--dc-teal-700);
                transform: translateY(-1px);
            }

        .timeline {
            position: relative;
            padding-left: 36px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 13px;
                top: 6px;
                bottom: 6px;
                width: 2px;
                background: var(--dc-teal-100);
            }

        .tl-item {
            position: relative;
            padding-bottom: 18px;
            animation: tlIn .4s ease both;
        }

            .tl-item:last-child {
                padding-bottom: 0;
            }

        .tl-dot {
            position: absolute;
            left: -36px;
            top: 0;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .85rem;
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
        }

            .tl-dot.hist-created {
                background: #0d9488;
            }

            .tl-dot.hist-edited {
                background: #3b82f6;
            }

            .tl-dot.hist-in {
                background: #16a34a;
            }

            .tl-dot.hist-out {
                background: #f59e0b;
            }

            .tl-dot.hist-price {
                background: #a855f7;
            }

            .tl-dot.hist-expiry {
                background: #f97316;
            }

            .tl-dot.hist-deleted {
                background: #dc2626;
            }

        .tl-content {
            background: #f8fafc;
            border-radius: 12px;
            padding: 12px 16px;
            transition: transform .2s, box-shadow .2s;
        }

        .tl-item:hover .tl-content {
            transform: translateX(3px);
            box-shadow: 0 8px 18px rgba(10,77,79,.08);
        }

        .tl-title {
            font-weight: 800;
            font-size: .9rem;
            color: var(--dc-ink-900);
        }

        .tl-date {
            font-size: .72rem;
            color: #94a3b8;
            font-weight: 600;
        }

        .tl-detail {
            font-size: .8rem;
            color: #475569;
            margin-top: 4px;
        }

        .tl-empty {
            text-align: center;
            color: #94a3b8;
            padding: 36px 12px;
        }

        @@media (max-width: 900px) {
            .mdet-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="mdet-page" dir="ltr">
    <div class="mdet-hero">
        <h1><i class="bi bi-box-seam-fill mx-2"></i> @Model.Name</h1>
        <div class="mdet-tags">
            <span><i class="bi bi-hash"></i> @Model.Code</span>
            <span><i class="bi bi-tag"></i> @Model.CategoryName</span>
            <span style="background:@statusBg;"><i class="bi @statusIcon"></i> @statusLabel</span>
        </div>
    </div>

    <div class="mdet-grid">
        <div>
            <div class="mdet-card" style="animation-delay:.05s">
                <h6>Stock</h6>
                <div class="mdet-row"><span>Current qty</span><b>@Model.Quantity @Model.UnitName</b></div>
                <div class="mdet-row"><span>Minimum</span><b>@Model.MinimumStockLevel</b></div>
                <div class="mdet-row"><span>Location</span><b>@(Model.StorageLocation ?? "—")</b></div>
                <div class="mdet-row"><span>Expiry</span><b>@(Model.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</b></div>
                <div class="mdet-row"><span>Active</span><b>@(Model.IsActive ? "Yes" : "No")</b></div>
            </div>

            <div class="mdet-card" style="animation-delay:.12s">
                <h6>Commercial</h6>
                <div class="mdet-row"><span>Purchase price</span><b>@Model.PurchasePrice.ToString("N2") EGP</b></div>
                <div class="mdet-row"><span>Current price</span><b>@Model.CurrentPrice.ToString("N2") EGP</b></div>
                <div class="mdet-row"><span>Supplier</span><b>@(Model.SupplierName ?? "—")</b></div>
            </div>

            <div class="mdet-card" style="animation-delay:.18s">
                <h6>Notes</h6>
                <p style="font-size:.85rem; color:#475569; margin:0;">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes." : Model.Notes)</p>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p style="font-size:.82rem; color:#64748b; margin:8px 0 0;">@Model.Description</p>
                }
            </div>

            <a href="/Inventory" class="mdet-back"><i class="bi bi-arrow-left"></i> Back to inventory</a>
        </div>

        <div class="mdet-card" style="animation-delay:.1s">
            <h6><i class="bi bi-clock-history"></i> Activity timeline</h6>
            @if (!history.Any())
            {
                <div class="tl-empty">
                    <i class="bi bi-inbox fs-1 d-block mb-2" style="opacity:.4;"></i>
                    No movements recorded yet.
                </div>
            }
            else
            {
                <div class="timeline">
                    @{
                        var i = 0;
                    }
                    @foreach (var h in history)
                    {
                        <div class="tl-item" style="animation-delay:@((i * 0.05).ToString("0.00"))s">
                            <div class="tl-dot @h.ColorClass"><i class="bi @h.Icon"></i></div>
                            <div class="tl-content">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span class="tl-title">@h.ActionText</span>
                                    <span class="tl-date">@h.ActionDate.ToString("dd/MM/yyyy hh:mm tt")</span>
                                </div>
                                <div class="tl-detail">
                                    @if (h.QuantityBefore.HasValue || h.QuantityAfter.HasValue)
                                    {
                                        <span>Qty: @h.QuantityBefore → <b>@h.QuantityAfter</b></span>
                                    }
                                    @if (h.PriceBefore.HasValue || h.PriceAfter.HasValue)
                                    {
                                        <span class="ms-2">Price: @h.PriceBefore → <b>@h.PriceAfter</b></span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.Notes))
                                    {
                                        <div class="mt-1">@h.Notes</div>
                                    }
                                </div>
                                <div class="tl-date mt-1">
                                    <i class="bi bi-person"></i> @(h.UserName ?? "System")
                                </div>
                            </div>
                        </div>
                        i++;
                    }
                </div>
            }
        </div>
    </div>
</div>