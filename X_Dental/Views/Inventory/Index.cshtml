@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <style>
        :root {
            --dc-teal-50: #eafbfc;
            --dc-teal-100: #c7f2ea;
            --dc-teal-500: #14b8a6;
            --dc-teal-600: #0d9488;
            --dc-teal-700: #0d7377;
            --dc-teal-900: #0a4d4f;
            --dc-ink-900: #0b2e30;
            --dc-ink-600: #4b6b6c;
            --dc-ink-400: #94a3b8;
            --dc-shadow-sm: 0 2px 8px rgba(10,77,79,0.04);
            --dc-shadow: 0 8px 32px rgba(10,77,79,0.08);
            --dc-shadow-lg: 0 20px 60px rgba(10,77,79,0.12);
        }

        .inventory-page {
            padding: 16px 20px 60px;
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: var(--dc-ink-900);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes rowIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes invShine {
            0%, 100% {
                right: -30%;
            }

            50% {
                right: 105%;
            }
        }

        @@keyframes kpiPulse {
            0%, 100% {
                box-shadow: 0 4px 16px rgba(220,38,38,.08);
            }

            50% {
                box-shadow: 0 6px 22px rgba(220,38,38,.22);
            }
        }

        @@keyframes skShine {
            0% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @@keyframes modalIn {
            from {
                opacity: 0;
                transform: translateY(14px) scale(.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes overlayIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes chipPop {
            0% {
                transform: scale(.9);
            }

            100% {
                transform: scale(1);
            }
        }

        .anim-fade-up {
            animation: fadeInUp .5s cubic-bezier(.2,.8,.3,1) forwards;
            opacity: 0;
        }

        .anim-d1 {
            animation-delay: .05s;
        }

        .anim-d2 {
            animation-delay: .1s;
        }

        .anim-d3 {
            animation-delay: .15s;
        }

        .anim-d4 {
            animation-delay: .2s;
        }

        .anim-d5 {
            animation-delay: .25s;
        }

        .anim-d6 {
            animation-delay: .3s;
        }

        .inv-hero {
            background: linear-gradient(135deg,#0d7377 0%,#0f9b8e 50%,#14b8a6 100%);
            border-radius: 22px;
            padding: 22px 28px;
            color: #fff;
            box-shadow: var(--dc-shadow-lg);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            position: relative;
            overflow: hidden;
        }

            .inv-hero::before {
                content: '';
                position: absolute;
                top: -60%;
                right: -30%;
                width: 45%;
                height: 220%;
                background: linear-gradient(105deg, transparent, rgba(255,255,255,.16), transparent);
                transform: rotate(12deg);
                animation: invShine 7s ease-in-out infinite;
                pointer-events: none;
            }

            .inv-hero h1 {
                margin: 0;
                font-size: 1.35rem;
                font-weight: 800;
                position: relative;
            }

            .inv-hero p {
                margin: 4px 0 0;
                font-size: .85rem;
                opacity: .92;
                position: relative;
            }

        .inv-hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .btn-inv-primary {
            background: #fff;
            color: var(--dc-teal-700);
            border: none;
            padding: 11px 20px;
            border-radius: 14px;
            font-weight: 800;
            font-size: .85rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 10px 26px rgba(0,0,0,.15);
            transition: all .2s ease;
        }

            .btn-inv-primary:hover {
                transform: translateY(-2px);
            }

        .btn-inv-ghost {
            background: rgba(255,255,255,.16);
            color: #fff;
            border: 1px solid rgba(255,255,255,.28);
            padding: 11px 20px;
            border-radius: 14px;
            font-weight: 800;
            font-size: .85rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all .2s ease;
        }

            .btn-inv-ghost:hover {
                background: rgba(255,255,255,.24);
                transform: translateY(-2px);
            }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .kpi-card {
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: 16px;
            padding: 14px 14px 12px;
            box-shadow: var(--dc-shadow-sm);
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: all .22s ease;
            user-select: none;
        }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--dc-shadow);
            }

            .kpi-card.kpi-active {
                border-color: var(--dc-teal-500);
                box-shadow: 0 8px 22px rgba(13,148,136,.18);
                outline: 2px solid rgba(20,184,166,.25);
            }

            .kpi-card.alert-on {
                animation: kpiPulse 2.2s ease-in-out infinite;
            }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
        }

            .kpi-icon.teal {
                background: var(--dc-teal-50);
                color: var(--dc-teal-600);
            }

            .kpi-icon.green {
                background: #f0fdf4;
                color: #16a34a;
            }

            .kpi-icon.amber {
                background: #fffbeb;
                color: #d97706;
            }

            .kpi-icon.orange {
                background: #fff7ed;
                color: #ea580c;
            }

            .kpi-icon.red {
                background: #fef2f2;
                color: #dc2626;
            }

            .kpi-icon.slate {
                background: #f1f5f9;
                color: #475569;
            }

        .kpi-val {
            font-size: 1.22rem;
            font-weight: 800;
            color: var(--dc-ink-900);
            display: block;
            line-height: 1.15;
        }

        .kpi-card.warn .kpi-val {
            color: #d97706;
        }

        .kpi-card.danger .kpi-val {
            color: #dc2626;
        }

        .kpi-lbl {
            font-size: .7rem;
            color: var(--dc-ink-600);
            font-weight: 800;
            letter-spacing: .2px;
        }

        .kpi-hint {
            display: block;
            font-size: .65rem;
            color: var(--dc-ink-400);
            font-weight: 600;
            margin-top: 1px;
        }

        .inv-card {
            background: rgba(255,255,255,.92);
            border-radius: 22px;
            border: 1px solid rgba(255,255,255,.6);
            box-shadow: var(--dc-shadow);
            overflow: hidden;
        }

        .inv-filter-bar {
            display: flex;
            gap: 10px;
            padding: 16px 18px;
            border-bottom: 1px solid var(--dc-teal-50);
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
        }

        .inv-filter-pills {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .inv-pill {
            border: 1.5px solid var(--dc-teal-100);
            background: #fff;
            color: var(--dc-ink-600);
            font-weight: 700;
            font-size: .78rem;
            padding: 7px 14px;
            border-radius: 999px;
            cursor: pointer;
            transition: all .2s ease;
            white-space: nowrap;
        }

            .inv-pill:hover {
                border-color: var(--dc-teal-500);
                color: var(--dc-teal-700);
            }

            .inv-pill.active {
                background: linear-gradient(135deg, var(--dc-teal-600), var(--dc-teal-700));
                color: #fff;
                border-color: transparent;
                animation: chipPop .18s ease;
            }

        .inv-search-box {
            position: relative;
        }

            .inv-search-box input {
                padding: 9px 14px 9px 34px;
                border: 1.5px solid var(--dc-teal-100);
                border-radius: 999px;
                font-size: .85rem;
                width: 230px;
                outline: none;
            }

                .inv-search-box input:focus {
                    border-color: var(--dc-teal-500);
                    box-shadow: 0 0 0 3px rgba(20,184,166,.12);
                }

            .inv-search-box i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--dc-teal-600);
            }

        table.inv-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: .85rem;
        }

            table.inv-table th {
                text-align: left;
                padding: 12px 14px;
                color: var(--dc-ink-400);
                font-weight: 700;
                font-size: .72rem;
                text-transform: uppercase;
                letter-spacing: .3px;
                border-bottom: 2px solid #f1f5f9;
                white-space: nowrap;
            }

            table.inv-table td {
                padding: 12px 14px;
                border-bottom: 1px solid #f8fafc;
                vertical-align: middle;
            }

            table.inv-table tbody tr {
                animation: rowIn .32s ease backwards;
            }

                table.inv-table tbody tr:hover td {
                    background: rgba(13,148,136,.04);
                }

        .mat-code-badge {
            background: #f1f5f9;
            color: #475569;
            padding: 2px 10px;
            border-radius: 8px;
            font-size: .72rem;
            font-weight: 700;
            font-family: ui-monospace, monospace;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 800;
        }

        .status-ok {
            background: #dcfce7;
            color: #166534;
        }

        .status-low {
            background: #fef3c7;
            color: #b45309;
        }

        .status-out {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-expired {
            background: #fee2e2;
            color: #7f1d1d;
        }

        .status-near {
            background: #ffedd5;
            color: #c2410c;
        }

        .row-actions {
            display: flex;
            gap: 4px;
            justify-content: flex-start;
            flex-wrap: nowrap;
        }

        .act-btn {
            width: 32px;
            height: 32px;
            border: none;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: var(--dc-ink-600);
            transition: all .2s ease;
            cursor: pointer;
        }

            .act-btn:hover {
                background: #f0fdfa;
                color: var(--dc-teal-700);
                transform: translateY(-1px);
            }

            .act-btn.danger:hover {
                background: #fee2e2;
                color: #dc2626;
            }

            .act-btn.in:hover {
                background: #dcfce7;
                color: #166534;
            }

            .act-btn.out:hover {
                background: #fef3c7;
                color: #b45309;
            }

        .inv-empty {
            text-align: center;
            padding: 50px 20px;
            color: var(--dc-ink-400);
        }

            .inv-empty i {
                font-size: 2.4rem;
                opacity: .4;
                display: block;
                margin-bottom: 10px;
            }

        .inv-skel-row {
            height: 44px;
            border-radius: 8px;
            margin-bottom: 8px;
            background: linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 37%,#f1f5f9 63%);
            background-size: 400% 100%;
            animation: skShine 1.3s ease infinite;
        }

        .inv-modal {
            display: flex;
            position: fixed;
            inset: 0;
            z-index: 9999;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .22s ease, visibility .22s ease;
        }

            .inv-modal.show {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

        .inv-modal-overlay {
            position: absolute;
            inset: 0;
            background: rgba(15,23,42,.45);
            backdrop-filter: blur(8px);
        }

        .inv-modal.show .inv-modal-overlay {
            animation: overlayIn .22s ease;
        }

        .inv-modal-box {
            position: relative;
            z-index: 1;
            width: 92%;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,.2);
            overflow: hidden;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
        }

        .inv-modal.show .inv-modal-box {
            animation: modalIn .28s cubic-bezier(.2,.8,.3,1);
        }

        .inv-modal-box.sm {
            max-width: 480px;
        }

        .inv-modal-box.md {
            max-width: 640px;
        }

        .inv-modal-box.lg {
            max-width: 920px;
        }

        .inv-modal-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            background: linear-gradient(135deg, var(--dc-teal-600), var(--dc-teal-700));
            color: #fff;
            flex-shrink: 0;
        }

            .inv-modal-head h5 {
                margin: 0;
                font-weight: 800;
                font-size: 1.02rem;
            }

        .inv-modal-sub {
            margin: 3px 0 0;
            font-size: .75rem;
            font-weight: 600;
            color: rgba(255,255,255,.88);
        }

        .inv-modal-body {
            padding: 16px 20px;
            overflow: hidden;
        }

            .inv-modal-body.compact {
                padding: 14px 18px;
            }

        .inv-modal-foot {
            padding: 12px 20px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }

        .inv-form-section {
            margin-bottom: 12px;
        }

            .inv-form-section h6 {
                font-size: .72rem;
                font-weight: 800;
                color: var(--dc-teal-700);
                text-transform: uppercase;
                letter-spacing: .4px;
                margin-bottom: 8px;
                padding-bottom: 5px;
                border-bottom: 1px solid var(--dc-teal-50);
            }

        .inv-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

            .inv-form-grid.cols-3 {
                grid-template-columns: 1fr 1fr 1fr;
            }

            .inv-form-grid.cols-4 {
                grid-template-columns: 1fr 1.3fr 1fr 1.3fr;
            }

            .inv-form-grid .span-2 {
                grid-column: span 2;
            }

        .inv-label {
            display: block;
            font-size: .74rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: 4px;
        }

        .inv-hint {
            display: block;
            font-size: .65rem;
            color: var(--dc-ink-400);
            font-weight: 600;
            margin-top: 3px;
        }

        .inv-input, .inv-select, .inv-textarea {
            width: 100%;
            padding: 8px 11px;
            border: 1.5px solid var(--dc-teal-50);
            border-radius: 10px;
            font-size: .85rem;
            outline: none;
            transition: all .2s;
            background: #fff;
        }

            .inv-input:focus, .inv-select:focus, .inv-textarea:focus {
                border-color: var(--dc-teal-500);
                box-shadow: 0 0 0 3px rgba(20,184,166,.1);
            }

            .inv-input:disabled {
                background: #f8fafc;
                color: #64748b;
            }

        .inv-stock-chip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: var(--dc-teal-50);
            border-radius: 12px;
            padding: 10px 12px;
            margin-bottom: 12px;
        }

            .inv-stock-chip b {
                color: var(--dc-teal-700);
            }

        .inv-btn {
            padding: 9px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: .85rem;
            border: none;
            cursor: pointer;
            transition: all .2s;
        }

        .inv-btn-cancel {
            background: #f1f5f9;
            color: #475569;
        }

            .inv-btn-cancel:hover {
                background: #e2e8f0;
            }

        .inv-btn-save {
            background: linear-gradient(135deg, var(--dc-teal-600), var(--dc-teal-700));
            color: #fff;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .inv-btn-save:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 18px rgba(13,148,136,.28);
            }

            .inv-btn-save:disabled {
                opacity: .6;
                cursor: not-allowed;
                transform: none;
            }

        .inv-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            height: 38px;
            cursor: pointer;
            user-select: none;
        }

            .inv-toggle input {
                display: none;
            }

        .inv-toggle-track {
            width: 40px;
            height: 22px;
            border-radius: 999px;
            background: #cbd5e1;
            position: relative;
            transition: .2s;
        }

            .inv-toggle-track::after {
                content: '';
                position: absolute;
                top: 3px;
                left: 3px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #fff;
                transition: .2s;
            }

        .inv-toggle input:checked + .inv-toggle-track {
            background: var(--dc-teal-600);
        }

            .inv-toggle input:checked + .inv-toggle-track::after {
                left: 21px;
            }

        .inv-toggle-text {
            font-size: .82rem;
            font-weight: 700;
            color: var(--dc-ink-600);
        }

        @@media (max-width: 1200px) {
            .kpi-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .inv-form-grid.cols-4, .inv-form-grid.cols-3 {
                grid-template-columns: 1fr 1fr;
            }

            .inv-form-grid .span-2 {
                grid-column: span 2;
            }
        }

        @@media (max-width: 768px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .inv-filter-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .inv-search-box input {
                width: 100%;
            }

            .inv-form-grid, .inv-form-grid.cols-3, .inv-form-grid.cols-4 {
                grid-template-columns: 1fr;
            }

                .inv-form-grid .span-2 {
                    grid-column: span 1;
                }
        }
    </style>
}

<div class="inventory-page" dir="ltr">
    @Html.AntiForgeryToken()
    <div class="inv-hero anim-fade-up">
        <div>
            <h1><i class="bi bi-box-seam-fill mx-1"></i> Clinic Inventory</h1>
            <p>Materials, stock movements, and supplier management</p>
        </div>
        <div class="inv-hero-actions">
            <button type="button" class="btn-inv-ghost" onclick="openSupplierQuickModal()">
                <i class="bi bi-truck"></i> New supplier
            </button>
            <button type="button" class="btn-inv-primary" onclick="openMaterialModal()">
                <i class="bi bi-plus-circle"></i> Add material
            </button>
        </div>
    </div>

    <div class="kpi-grid" id="kpiGrid">
        <div class="kpi-card anim-fade-up anim-d1 kpi-active" data-status="" onclick="applyStatus('')">
            <div class="kpi-icon teal"><i class="bi bi-boxes"></i></div>
            <div>
                <span class="kpi-val" id="kpiTotal">—</span>
                <span class="kpi-lbl">Materials</span>
                <span class="kpi-hint">All SKUs</span>
            </div>
        </div>
        <div class="kpi-card anim-fade-up anim-d2" data-status="__value" onclick="applyStatus('')">
            <div class="kpi-icon green"><i class="bi bi-cash-stack"></i></div>
            <div>
                <span class="kpi-val" id="kpiValue">—</span>
                <span class="kpi-lbl">Stock value</span>
                <span class="kpi-hint">Qty × price (EGP)</span>
            </div>
        </div>
        <div class="kpi-card warn anim-fade-up anim-d3" data-status="LowStock" onclick="applyStatus('LowStock')">
            <div class="kpi-icon amber"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <span class="kpi-val" id="kpiLow">—</span>
                <span class="kpi-lbl">Low stock</span>
                <span class="kpi-hint">Below minimum</span>
            </div>
        </div>
        <div class="kpi-card warn anim-fade-up anim-d4" data-status="NearExpiry" onclick="applyStatus('NearExpiry')">
            <div class="kpi-icon orange"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <span class="kpi-val" id="kpiNear">—</span>
                <span class="kpi-lbl">Near expiry</span>
                <span class="kpi-hint">Use soon</span>
            </div>
        </div>
        <div class="kpi-card danger anim-fade-up anim-d5" data-status="Expired" onclick="applyStatus('Expired')">
            <div class="kpi-icon red"><i class="bi bi-calendar-x"></i></div>
            <div>
                <span class="kpi-val" id="kpiExpired">—</span>
                <span class="kpi-lbl">Expired</span>
                <span class="kpi-hint">Do not use</span>
            </div>
        </div>
        <div class="kpi-card danger anim-fade-up anim-d6" data-status="OutOfStock" onclick="applyStatus('OutOfStock')">
            <div class="kpi-icon slate"><i class="bi bi-slash-circle"></i></div>
            <div>
                <span class="kpi-val" id="kpiOut">—</span>
                <span class="kpi-lbl">Out of stock</span>
                <span class="kpi-hint">Zero quantity</span>
            </div>
        </div>
    </div>

    <div class="inv-card anim-fade-up anim-d2">
        <div class="inv-filter-bar">
            <div class="inv-filter-pills" id="statusPills">
                <button class="inv-pill active" data-status="">All</button>
                <button class="inv-pill" data-status="LowStock">Low stock</button>
                <button class="inv-pill" data-status="OutOfStock">Out of stock</button>
                <button class="inv-pill" data-status="NearExpiry">Near expiry</button>
                <button class="inv-pill" data-status="Expired">Expired</button>
                <button class="inv-pill" data-status="Available">In stock</button>
            </div>
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <select class="inv-select" id="filterCategory" style="width:170px;">
                    <option value="">All categories</option>
                </select>
                <div class="inv-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchBox" placeholder="Search name or code..." />
                </div>
            </div>
        </div>
        <div style="overflow-x:auto; padding: 0 8px 8px;">
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Material</th>
                        <th>Category</th>
                        <th>Qty</th>
                        <th>Min</th>
                        <th>Price</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="materialsBody">
                    <tr><td colspan="9"><div class="inv-skel-row"></div><div class="inv-skel-row"></div><div class="inv-skel-row"></div></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="materialModalContainer"></div>

<div class="inv-modal" id="stockInModal">
    <div class="inv-modal-overlay" onclick="closeStockModal('stockInModal')"></div>
    <div class="inv-modal-box sm">
        <div class="inv-modal-head">
            <div>
                <h5><i class="bi bi-box-arrow-in-down me-2"></i> Receive stock</h5>
                <p class="inv-modal-sub" id="siMaterialName">—</p>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="closeStockModal('stockInModal')"></button>
        </div>
        <div class="inv-modal-body compact">
            <input type="hidden" id="siMaterialId" />
            <div class="inv-form-grid">
                <div>
                    <label class="inv-label">Quantity *</label>
                    <input type="number" step="0.001" min="0" class="inv-input" id="siQuantity" />
                </div>
                <div>
                    <label class="inv-label">Unit price</label>
                    <input type="number" step="0.01" min="0" class="inv-input" id="siUnitPrice" />
                </div>
                <div>
                    <label class="inv-label">Expiry date</label>
                    <input type="date" class="inv-input" id="siExpiry" />
                </div>
                <div>
                    <label class="inv-label">Supplier</label>
                    <select class="inv-select" id="siSupplier"><option value="">— None —</option></select>
                </div>
                <div class="span-2">
                    <label class="inv-label">Notes</label>
                    <input type="text" class="inv-input" id="siNotes" placeholder="Optional" />
                </div>
            </div>
        </div>
        <div class="inv-modal-foot">
            <button type="button" class="inv-btn inv-btn-cancel" onclick="closeStockModal('stockInModal')">Cancel</button>
            <button type="button" class="inv-btn inv-btn-save" id="btnSaveStockIn" onclick="submitStockIn()"><i class="bi bi-check-lg"></i> Receive</button>
        </div>
    </div>
</div>

<div class="inv-modal" id="stockOutModal">
    <div class="inv-modal-overlay" onclick="closeStockModal('stockOutModal')"></div>
    <div class="inv-modal-box sm">
        <div class="inv-modal-head">
            <div>
                <h5><i class="bi bi-box-arrow-up me-2"></i> Issue stock</h5>
                <p class="inv-modal-sub" id="soMaterialName">—</p>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="closeStockModal('stockOutModal')"></button>
        </div>
        <div class="inv-modal-body compact">
            <input type="hidden" id="soMaterialId" />
            <div class="inv-stock-chip">
                <span>Available now</span>
                <b id="soAvailableHint">0</b>
            </div>
            <div class="inv-form-grid">
                <div>
                    <label class="inv-label">Quantity *</label>
                    <input type="number" step="0.001" min="0" class="inv-input" id="soQuantity" />
                </div>
                <div>
                    <label class="inv-label">Reason / destination</label>
                    <input type="text" class="inv-input" id="soReason" placeholder="e.g. Used in session" />
                </div>
                <div class="span-2">
                    <label class="inv-label">Notes</label>
                    <input type="text" class="inv-input" id="soNotes" placeholder="Optional" />
                </div>
            </div>
        </div>
        <div class="inv-modal-foot">
            <button type="button" class="inv-btn inv-btn-cancel" onclick="closeStockModal('stockOutModal')">Cancel</button>
            <button type="button" class="inv-btn inv-btn-save" id="btnSaveStockOut" onclick="submitStockOut()"><i class="bi bi-check-lg"></i> Issue</button>
        </div>
    </div>
</div>

<div class="inv-modal" id="supplierQuickModal">
    <div class="inv-modal-overlay" onclick="closeStockModal('supplierQuickModal')"></div>
    <div class="inv-modal-box sm">
        <div class="inv-modal-head">
            <div>
                <h5><i class="bi bi-truck me-2"></i> New supplier</h5>
                <p class="inv-modal-sub">Quick add — name and phone</p>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="closeStockModal('supplierQuickModal')"></button>
        </div>
        <div class="inv-modal-body compact">
            <div class="inv-form-grid">
                <div>
                    <label class="inv-label">Supplier name *</label>
                    <input type="text" class="inv-input" id="supName" placeholder="Company or person" />
                </div>
                <div>
                    <label class="inv-label">Phone</label>
                    <input type="text" class="inv-input" id="supPhone" placeholder="Optional" />
                </div>
            </div>
        </div>
        <div class="inv-modal-foot">
            <button type="button" class="inv-btn inv-btn-cancel" onclick="closeStockModal('supplierQuickModal')">Cancel</button>
            <button type="button" class="inv-btn inv-btn-save" onclick="submitSupplierQuick()"><i class="bi bi-check-lg"></i> Save supplier</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const CATEGORY_LABELS = {
            Consumables: 'Consumables', Restorative: 'Restorative', Anesthesia: 'Anesthesia', Impression: 'Impression',
            Orthodontic: 'Orthodontic', Endodontic: 'Endodontic', Surgical: 'Surgical', PPE: 'PPE', Sterilization: 'Sterilization', Other: 'Other'
        };
        let currentStatus = '';
        let currentCategory = '';
        let searchDebounce = null;
        let supplierOptionsCache = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadCategories();
            loadSuppliers();
            loadDashboard();
            loadMaterials();

            document.querySelectorAll('#statusPills .inv-pill').forEach(btn => {
                btn.addEventListener('click', () => applyStatus(btn.dataset.status || ''));
            });
            document.getElementById('filterCategory').addEventListener('change', function() {
                currentCategory = this.value;
                loadMaterials();
            });
            document.getElementById('searchBox').addEventListener('input', function() {
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(loadMaterials, 350);
            });
            document.addEventListener('keydown', e => {
                if (e.key !== 'Escape') return;
                closeMaterialModal();
                closeStockModal('stockInModal');
                closeStockModal('stockOutModal');
                closeStockModal('supplierQuickModal');
            });
        });

        function applyStatus(status) {
            currentStatus = status === '__value' ? '' : status;
            document.querySelectorAll('#statusPills .inv-pill').forEach(b => {
                b.classList.toggle('active', (b.dataset.status || '') === currentStatus);
            });
            document.querySelectorAll('.kpi-card[data-status]').forEach(c => {
                const s = c.dataset.status || '';
                c.classList.toggle('kpi-active', s === currentStatus || (currentStatus === '' && s === ''));
            });
            loadMaterials();
        }

        function loadCategories() {
            const sel = document.getElementById('filterCategory');
            Object.keys(CATEGORY_LABELS).forEach((key, idx) => {
                const opt = document.createElement('option');
                opt.value = idx + 1;
                opt.textContent = CATEGORY_LABELS[key];
                sel.appendChild(opt);
            });
        }

        async function loadSuppliers() {
            const res = await fetch('/Inventory/GetSuppliersLookup');
            const result = await res.json();
            supplierOptionsCache = result.data || [];
            const siSel = document.getElementById('siSupplier');
            siSel.innerHTML = '<option value="">— None —</option>' + supplierOptionsCache.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
        }

        function animateNumber(el, value, asMoney) {
            const end = Number(value || 0);
            const start = 0;
            const dur = 650;
            const t0 = performance.now();
            const tick = now => {
                const p = Math.min(1, (now - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                const n = start + (end - start) * eased;
                el.textContent = asMoney
                    ? Math.round(n).toLocaleString('en-US')
                    : Math.round(n).toLocaleString('en-US');
                if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        }

        async function loadDashboard() {
            const res = await fetch('/Inventory/GetDashboard');
            const result = await res.json();
            const d = result.data;
            animateNumber(document.getElementById('kpiTotal'), d.totalMaterials, false);
            animateNumber(document.getElementById('kpiValue'), d.totalStockValue, true);
            animateNumber(document.getElementById('kpiLow'), d.lowStockCount, false);
            animateNumber(document.getElementById('kpiNear'), d.expiringSoonCount, false);
            animateNumber(document.getElementById('kpiExpired'), d.expiredCount, false);
            animateNumber(document.getElementById('kpiOut'), d.outOfStockCount, false);

            toggleAlert('LowStock', d.lowStockCount);
            toggleAlert('NearExpiry', d.expiringSoonCount);
            toggleAlert('Expired', d.expiredCount);
            toggleAlert('OutOfStock', d.outOfStockCount);
        }

        function toggleAlert(status, count) {
            const card = document.querySelector(`.kpi-card[data-status="${status}"]`);
            if (!card) return;
            card.classList.toggle('alert-on', Number(count) > 0 && (status === 'Expired' || status === 'OutOfStock'));
        }

        function statusBadge(m) {
            if (m.isExpired) return '<span class="status-badge status-expired"><i class="bi bi-x-circle"></i> Expired</span>';
            if (m.isOutOfStock) return '<span class="status-badge status-out"><i class="bi bi-slash-circle"></i> Out of stock</span>';
            if (m.isNearExpiry) return '<span class="status-badge status-near"><i class="bi bi-clock-history"></i> Near expiry</span>';
            if (m.isLowStock) return '<span class="status-badge status-low"><i class="bi bi-exclamation-triangle"></i> Low stock</span>';
            return '<span class="status-badge status-ok"><i class="bi bi-check-circle"></i> In stock</span>';
        }

        function escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#39;' }[c]));
        }

        async function loadMaterials() {
            const tbody = document.getElementById('materialsBody');
            tbody.innerHTML = '<tr><td colspan="9"><div class="inv-skel-row"></div><div class="inv-skel-row"></div></td></tr>';
            const params = new URLSearchParams();
            const search = document.getElementById('searchBox').value.trim();
            if (search) params.append('Search', search);
            if (currentCategory) params.append('Category', currentCategory);
            if (currentStatus === 'LowStock') params.append('LowStock', 'true');
            if (currentStatus === 'OutOfStock') params.append('OutOfStock', 'true');
            if (currentStatus === 'Expired') params.append('Expired', 'true');
            if (currentStatus === 'NearExpiry') params.append('NearExpiry', 'true');
            if (currentStatus === 'Available') params.append('Available', 'true');
            try {
                const res = await fetch(`/Inventory/GetMaterials?${params.toString()}`);
                const result = await res.json();
                const data = result.data || [];
                if (!data.length) {
                    tbody.innerHTML = `<tr><td colspan="9"><div class="inv-empty"><i class="bi bi-inbox"></i><p>No matching materials</p></div></td></tr>`;
                    return;
                }
                tbody.innerHTML = data.map((m, i) => `
                                <tr style="animation-delay:${Math.min(i * 0.03, 0.35)}s">
                                    <td><span class="mat-code-badge">${escapeHtml(m.code)}</span></td>
                                    <td><b>${escapeHtml(m.name)}</b></td>
                                    <td>${escapeHtml(CATEGORY_LABELS[m.categoryName] || m.categoryName)}</td>
                                    <td>${Number(m.quantity)} <small class="text-muted">${escapeHtml(m.unitName)}</small></td>
                                    <td>${Number(m.minimumStockLevel)}</td>
                                    <td>${Number(m.currentPrice).toLocaleString('en-US')}</td>
                                    <td>${escapeHtml(m.supplierName || '—')}</td>
                                    <td>${statusBadge(m)}</td>
                                    <td>
                                        <div class="row-actions">
                                            <button class="act-btn in" title="Receive stock" onclick="openStockIn(${m.id}, decodeURIComponent('${encodeURIComponent(m.name || '')}'))"><i class="bi bi-box-arrow-in-down"></i></button>
                                            <button class="act-btn out" title="Issue stock" onclick="openStockOut(${m.id}, decodeURIComponent('${encodeURIComponent(m.name || '')}'), ${m.quantity})"><i class="bi bi-box-arrow-up"></i></button>
                                            <a class="act-btn" title="Details & timeline" href="/Inventory/Details/${m.id}"><i class="bi bi-clock-history"></i></a>
                                            <button class="act-btn" title="Edit" onclick="openMaterialModal(${m.id})"><i class="bi bi-pencil-square"></i></button>
                                            <button class="act-btn danger" title="Delete" onclick="deleteMaterial(${m.id})"><i class="bi bi-trash3"></i></button>
                                        </div>
                                    </td>
                                </tr>`).join('');
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="9"><div class="inv-empty"><i class="bi bi-wifi-off"></i><p>Could not load data</p></div></td></tr>`;
            }
        }

        let materialModalBackdrop = null;
        async function openMaterialModal(id) {
            const url = id ? `/Inventory/Modal?id=${id}` : '/Inventory/Modal';
            const box = document.getElementById('materialModalContainer');
            box.innerHTML = `<div class="inv-modal show" id="tempMatModal"><div class="inv-modal-overlay"></div>
                            <div class="inv-modal-box sm" style="min-height:160px; display:flex; align-items:center; justify-content:center;">
                                <div class="spinner-border" style="color:#0d9488"></div></div></div>`;
            try {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const html = await res.text();
                box.innerHTML = html;
                materialModalBackdrop = document.getElementById('materialFormModal');
                requestAnimationFrame(() => materialModalBackdrop.classList.add('show'));
                initMaterialForm();
            } catch (err) {
                box.innerHTML = '';
                Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load the form' });
            }
        }
        function closeMaterialModal() {
            if (!materialModalBackdrop) {
                const tmp = document.getElementById('materialModalContainer');
                if (tmp) tmp.innerHTML = '';
                return;
            }
            materialModalBackdrop.classList.remove('show');
            setTimeout(() => { document.getElementById('materialModalContainer').innerHTML = ''; materialModalBackdrop = null; }, 200);
        }
        function initMaterialForm() {
            const form = document.getElementById('materialForm');
            if (!form) return;
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btnSaveMaterial');
                const original = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
                const fd = new FormData(form);
                try {
                    const res = await fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const result = await res.json();
                    if (result.success) {
                        closeMaterialModal();
                        Swal.fire({ icon: 'success', title: result.message, timer: 1400, showConfirmButton: false });
                        loadMaterials(); loadDashboard();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: result.message });
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Could not reach the server' });
                } finally {
                    btn.disabled = false; btn.innerHTML = original;
                }
            });
        }

        async function deleteMaterial(id) {
            const confirmResult = await Swal.fire({
                title: 'Delete material?',
                text: 'It will be hidden from the list. The history trail is kept.',
                icon: 'warning', showCancelButton: true,
                confirmButtonText: 'Yes, delete', cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc2626', reverseButtons: true
            });
            if (!confirmResult.isConfirmed) return;
            const res = await fetch('/Inventory/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}`
            });
            const result = await res.json();
            if (result.success) {
                Swal.fire({ icon: 'success', title: result.message, timer: 1400, showConfirmButton: false });
                loadMaterials(); loadDashboard();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message });
            }
        }

        function closeStockModal(id) { document.getElementById(id).classList.remove('show'); }
        function openStockIn(materialId, name) {
            document.getElementById('siMaterialId').value = materialId;
            document.getElementById('siMaterialName').textContent = name;
            document.getElementById('siQuantity').value = '';
            document.getElementById('siUnitPrice').value = '';
            document.getElementById('siExpiry').value = '';
            document.getElementById('siNotes').value = '';
            document.getElementById('stockInModal').classList.add('show');
            setTimeout(() => document.getElementById('siQuantity').focus(), 80);
        }
        async function submitStockIn() {
            const req = {
                materialId: parseInt(document.getElementById('siMaterialId').value),
                quantity: parseFloat(document.getElementById('siQuantity').value),
                unitPrice: document.getElementById('siUnitPrice').value ? parseFloat(document.getElementById('siUnitPrice').value) : null,
                expiryDate: document.getElementById('siExpiry').value || null,
                supplierId: document.getElementById('siSupplier').value ? parseInt(document.getElementById('siSupplier').value) : null,
                notes: document.getElementById('siNotes').value
            };
            if (!req.quantity || req.quantity <= 0) {
                Swal.fire({ icon: 'warning', title: 'Quantity is required' }); return;
            }
            const res = await fetch('/Inventory/StockIn', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(req) });
            const result = await res.json();
            if (result.success) {
                closeStockModal('stockInModal');
                Swal.fire({ icon: 'success', title: result.message, timer: 1400, showConfirmButton: false });
                loadMaterials(); loadDashboard();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message });
            }
        }
        function openStockOut(materialId, name, available) {
            document.getElementById('soMaterialId').value = materialId;
            document.getElementById('soMaterialName').textContent = name;
            document.getElementById('soAvailableHint').textContent = `${available}`;
            document.getElementById('soQuantity').value = '';
            document.getElementById('soReason').value = '';
            document.getElementById('soNotes').value = '';
            document.getElementById('stockOutModal').classList.add('show');
            setTimeout(() => document.getElementById('soQuantity').focus(), 80);
        }
        async function submitStockOut() {
            const req = {
                materialId: parseInt(document.getElementById('soMaterialId').value),
                quantity: parseFloat(document.getElementById('soQuantity').value),
                destinationOrReason: document.getElementById('soReason').value,
                notes: document.getElementById('soNotes').value
            };
            if (!req.quantity || req.quantity <= 0) {
                Swal.fire({ icon: 'warning', title: 'Quantity is required' }); return;
            }
            const res = await fetch('/Inventory/StockOut', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(req) });
            const result = await res.json();
            if (result.success) {
                closeStockModal('stockOutModal');
                Swal.fire({ icon: 'success', title: result.message, timer: 1400, showConfirmButton: false });
                loadMaterials(); loadDashboard();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message });
            }
        }

        function openSupplierQuickModal() {
            document.getElementById('supName').value = '';
            document.getElementById('supPhone').value = '';
            document.getElementById('supplierQuickModal').classList.add('show');
            setTimeout(() => document.getElementById('supName').focus(), 80);
        }
        async function submitSupplierQuick() {
            const name = document.getElementById('supName').value.trim();
            if (!name) { Swal.fire({ icon: 'warning', title: 'Supplier name is required' }); return; }
            const token = document.querySelector('#materialForm input[name="__RequestVerificationToken"]')?.value
                || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const res = await fetch('/Inventory/CreateSupplier', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) },
                body: JSON.stringify({ name, phone: document.getElementById('supPhone').value })
            });
            const result = await res.json();
            if (result.success) {
                closeStockModal('supplierQuickModal');
                Swal.fire({ icon: 'success', title: 'Supplier added', timer: 1200, showConfirmButton: false });
                loadSuppliers();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message });
            }
        }
    </script>
}