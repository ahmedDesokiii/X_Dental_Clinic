@model Dental.Modules.Clinical.ViewModels.SessionViewModel
@{
    var previousSessions = ViewBag.PreviousSessions as List<Dental.Modules.Clinical.DTOs.PreviousSessionRecordDto> ?? new();
    // ⭐ المرحلة 2 — ملاحظات المتابعة (بتظهر جوه بلوك يومها، والأيام اللي فيها ملاحظات بس بتظهر برضه)
    var visitNotes = ViewBag.VisitNotes as List<Dental.Modules.Clinical.DTOs.VisitNoteDto> ?? new();
    var isSessionContext = Model?.Visit != null;   // في السيشن: زر "متابعة" على كل تشخيص

    // عرض رقم السن — 0 أو قيم غير قياسية تظهر كـ "—"
    string TLbl(int n)
    {
        if (n <= 0) return "—";
        return (n / 10) switch
        {
            1 => $"UL-{n % 10}",
            2 => $"UR-{n % 10}",
            3 => $"LL-{n % 10}",
            4 => $"LR-{n % 10}",
            _ => n.ToString()
        };
    }

    // ============================================================
    // تجميع حسب التاريخ فقط (مش VisitId)
    // → كل التشخيصات/الأسنان اللي حصلت في نفس اليوم تظهر في بلوك واحد
    // الماليات: مجموع مميز لكل VisitId في اليوم (من غير تكرار)
    // ============================================================
    var allDays = previousSessions.Select(r => r.Date.Date)
        .Concat(visitNotes.Select(n => n.VisitDate.Date))
        .Distinct()
        .OrderByDescending(d => d)
        .ToList();

    var groupedSessions = allDays
        .Select(day =>
        {
            var g = previousSessions.Where(r => r.Date.Date == day).ToList();
            var distinctVisits = g
                .GroupBy(x => x.VisitId)
                .Select(vg => vg.First())
                .ToList();
            var dayNotes = visitNotes.Where(n => n.VisitDate.Date == day).OrderBy(n => n.CreatedAt).ToList();

            return new
            {
                Date = day,
                // أول VisitId للـ panel id فقط (للـ accordion)
                PrimaryVisitId = distinctVisits.FirstOrDefault()?.VisitId ?? dayNotes.First().VisitId,
                Notes = dayNotes,
                VisitIds = distinctVisits.Select(v => v.VisitId).ToList(),
                Teeth = g.OrderBy(x => x.ToothNumber == 0 ? int.MaxValue : x.ToothNumber)
                         .ThenBy(x => x.DiagnosisName)
                         .ToList(),
                DiagnosisTotal = g.Sum(x => x.DiagnosisPrice),
                VisitTotalAmount = distinctVisits.Sum(v => v.VisitTotalAmount),
                VisitPaidAmount = distinctVisits.Sum(v => v.VisitPaidAmount),
                VisitDiscount = distinctVisits.Sum(v => v.VisitDiscount),
                VisitRemaining = distinctVisits.Sum(v => v.VisitRemaining)
            };
        })
        .ToList();

    var grandDiagnosisTotal = previousSessions.Sum(x => x.DiagnosisPrice);
    var grandVisitTotal = previousSessions.GroupBy(x => x.VisitId).Sum(g => g.First().VisitTotalAmount);
    var grandPaid = previousSessions.GroupBy(x => x.VisitId).Sum(g => g.First().VisitPaidAmount);
    var grandDiscount = previousSessions.GroupBy(x => x.VisitId).Sum(g => g.First().VisitDiscount);
    var grandRemaining = previousSessions.GroupBy(x => x.VisitId).Sum(g => g.First().VisitRemaining);
}

<div class="ps-grand-totals mb-2 mt-0">
    <div class="ps-grand-item">
        <span>إجمالي الزيارات</span>
        <b>@grandVisitTotal.ToString("N0")</b>
    </div>
    <div class="ps-grand-item paid">
        <span>المدفوع</span>
        <b>@grandPaid.ToString("N0")</b>
    </div>
    <div class="ps-grand-item discount">
        <span>الخصم</span>
        <b>@grandDiscount.ToString("N0")</b>
    </div>
    <div class="ps-grand-item remaining">
        <span>المتبقي</span>
        <b>@grandRemaining.ToString("N0")</b>
    </div>
</div>
<div class="prev-sessions-wrap">
    <div class="section-card" style="margin-bottom:16px;">
        <div class="section-head">
            <h4><i class="bi bi-clock-history"></i> السجل السابق للمريض</h4>
            <span class="section-badge">@groupedSessions.Count يوم علاج</span>
        </div>

        @if (groupedSessions.Any())
        {
            <div class="ps-groups">
                @foreach (var grp in groupedSessions)
                {
                    var panelId = $"psPanel_{grp.PrimaryVisitId}_{grp.Date:yyyyMMdd}";
                    var teethWithNumber = grp.Teeth.Count(t => t.ToothNumber > 0);
                    var teethLabel = teethWithNumber > 0
                        ? $"{teethWithNumber} سن"
                        : grp.Teeth.Any() ? $"{grp.Teeth.Count} سجل" : "متابعة";
                    <div class="ps-session-block">
                        <button type="button" class="ps-session-head" onclick="togglePsPanel(this)" data-target="@panelId">
                            <div class="ps-session-date">
                                <i class="bi bi-chevron-left ps-chevron"></i>
                                <i class="bi bi-calendar-event"></i>
                                <b>@grp.Date.ToString("dd/MM/yyyy")</b>
                                <span class="ps-teeth-count">@teethLabel</span>
                                @if (grp.Notes.Any())
                                {
                                    <span class="ps-notes-count" title="ملاحظات متابعة"><i class="bi bi-journal-text"></i> @grp.Notes.Count</span>
                                }
                            </div>
                            @if (grp.Teeth.Any())
                            {
                                <div class="ps-session-financials">
                                    <span class="ps-fin-chip total"><i class="bi bi-wallet2"></i> @grp.VisitTotalAmount.ToString("N0")</span>
                                    <span class="ps-fin-chip paid"><i class="bi bi-check-circle"></i> @grp.VisitPaidAmount.ToString("N0")</span>
                                    <span class="ps-fin-chip discount"><i class="bi bi-percent"></i> @grp.VisitDiscount.ToString("N0")</span>
                                    <span class="ps-fin-chip remaining"><i class="bi bi-exclamation-circle"></i> @grp.VisitRemaining.ToString("N0")</span>
                                </div>
                            }
                        </button>

                        <div class="ps-teeth-list" id="@panelId" style="display:none;">
                            @foreach (var r in grp.Teeth)
                            {
                                <div class="ps-tooth-row"
                                     data-vd="@r.VisitDiagnosisId"
                                     data-diag="@(r.DiagnosisCatalogId ?? 0)"
                                     data-notes="@(r.DiagnosisNotes ?? "")"
                                     data-tooth="@r.ToothNumber">
                                    <span class="tooth-chip @(r.ToothNumber <= 0 ? "tooth-chip-empty" : "")">@TLbl(r.ToothNumber)</span>
                                    <div class="ps-tooth-info">
                                        <span class="ps-diag-name">@(r.DiagnosisName ?? "بدون تشخيص")</span>
                                        @if (!string.IsNullOrWhiteSpace(r.DiagnosisNotes))
                                        {
                                            <span class="ps-diag-notes">@r.DiagnosisNotes</span>
                                        }
                                    </div>
                                    @{
                                        var followCount = r.VisitDiagnosisId > 0 ? visitNotes.Count(n => n.LinkedVisitDiagnosisId == r.VisitDiagnosisId) : 0;
                                    }
                                    @if (followCount > 0)
                                    {
                                        <span class="ps-follow-badge" title="عدد ملاحظات المتابعة على التشخيص ده"><i class="bi bi-chat-left-text"></i> @followCount</span>
                                    }
                                    <span class="ps-diag-price">@(r.DiagnosisPrice > 0 ? r.DiagnosisPrice.ToString("N0") + " م.ج" : "-")</span>
                                    @if (isSessionContext && r.VisitDiagnosisId > 0)
                                    {
                                        <button type="button" class="btn-sm ps-follow-btn" title="إضافة ملاحظة متابعة على التشخيص ده"
                                                onclick="event.stopPropagation(); window.SessionNotes && SessionNotes.startFor(@r.VisitDiagnosisId)">
                                            <i class="bi bi-journal-plus"></i>
                                        </button>
                                    }
                                    @if (r.VisitDiagnosisId > 0)
                                    {
                                        <button type="button" class="btn-sm" title="تعديل التشخيص والسعر"
                                                onclick="editPreviousRecord(this)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="width:28px;display:inline-block;"></span>
                                    }
                                </div>
                            }
                        </div>

                        @if (grp.Notes.Any())
                        {
                            <div class="ps-notes-block" data-panel="@panelId" style="display:none;">
                                <div class="ps-notes-title"><i class="bi bi-journal-medical"></i> ملاحظات المتابعة</div>
                                @foreach (var n in grp.Notes)
                                {
                                    <div class="ps-note">
                                        <div class="ps-note-text">@n.Text</div>
                                        <div class="ps-note-foot">
                                            @if (n.LinkedVisitDiagnosisId.HasValue)
                                            {
                                                <span class="ps-note-link">
                                                    <span class="tooth-chip @(n.LinkedToothNumber <= 0 ? "tooth-chip-empty" : "")">@TLbl(n.LinkedToothNumber)</span>
                                                    @n.LinkedDiagnosisName
                                                    @if (n.LinkedDiagnosisDate.HasValue)
                                                    {
                                                        <small>· @n.LinkedDiagnosisDate.Value.ToString("dd/MM/yyyy")</small>
                                                    }
                                                </span>
                                            }
                                            <span class="ps-note-time"><i class="bi bi-clock"></i> @n.CreatedAt.ToString("hh:mm tt")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (grp.Teeth.Any())
                        {
                            <div class="ps-session-subtotal">
                                <span>إجمالي تشخيصات هذا اليوم</span>
                                <b>@grp.DiagnosisTotal.ToString("N0") م.ج</b>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>لا توجد سجلات سابقة لهذا المريض.</p>
            </div>
        }
    </div>
</div>

<style>
    /* ⭐ المرحلة 2 — ملاحظات المتابعة */
    .ps-notes-count {
        font-size: .68rem;
        font-weight: 800;
        color: #4338ca;
        background: #eef2ff;
        padding: 2px 9px;
        border-radius: 999px;
        border: 1px solid #c7d2fe;
        display: inline-flex;
        gap: 4px;
        align-items: center;
    }

    .ps-follow-badge {
        font-size: .66rem;
        font-weight: 800;
        color: #4338ca;
        background: #eef2ff;
        padding: 2px 7px;
        border-radius: 8px;
        white-space: nowrap;
        display: inline-flex;
        gap: 3px;
        align-items: center;
    }

    .ps-follow-btn {
        color: #6366f1 !important;
    }

    .ps-notes-block {
        margin: 4px 14px 12px;
        padding: 10px 12px;
        border-radius: 14px;
        background: linear-gradient(135deg, #f8faff, #f5f3ff);
        border: 1px solid #e0e7ff;
    }

    .ps-notes-title {
        font-size: .76rem;
        font-weight: 800;
        color: #4338ca;
        margin-bottom: 8px;
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .ps-note {
        background: #fff;
        border: 1px solid #eef2ff;
        border-radius: 11px;
        padding: 8px 11px;
        margin-bottom: 6px;
    }

        .ps-note:last-child {
            margin-bottom: 0;
        }

    .ps-note-text {
        font-size: .84rem;
        color: #1e293b;
        line-height: 1.7;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ps-note-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
        flex-wrap: wrap;
    }

    .ps-note-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        font-weight: 700;
        color: #4338ca;
    }

        .ps-note-link small {
            color: #6366f1;
        }

    .ps-note-time {
        font-size: .68rem;
        color: #94a3b8;
        font-weight: 700;
        margin-inline-start: auto;
    }

    .ps-groups {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ps-session-block {
        background: #fafcfd;
        border: 1px solid #f1f5f9;
        border-radius: 16px;
        padding: 0;
        overflow: hidden;
        transition: all 0.25s ease;
    }

        .ps-session-block:hover {
            border-color: #ccf3ec;
            box-shadow: 0 8px 24px rgba(10,77,79,0.06);
        }

        .ps-session-block.open .ps-chevron {
            transform: rotate(-90deg);
        }

    .ps-session-head {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 12px 16px;
        background: transparent;
        border: none;
        cursor: pointer;
        text-align: right;
        font-family: inherit;
    }

        .ps-session-head:hover {
            background: rgba(13,148,136,0.04);
        }

    .ps-chevron {
        font-size: .75rem;
        color: #94a3b8;
        transition: transform 0.25s ease;
        margin-left: 4px;
    }

    .ps-session-date {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .85rem;
        color: #0b2e30;
    }

        .ps-session-date i.bi-calendar-event {
            color: #0d9488;
        }

    .ps-teeth-count {
        font-size: .68rem;
        font-weight: 700;
        color: #0d9488;
        background: #f0fdfa;
        padding: 2px 9px;
        border-radius: 999px;
        border: 1px solid #ccf3ec;
    }

    .ps-session-financials {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .ps-fin-chip {
        font-size: .7rem;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f1f5f9;
        color: #475569;
    }

        .ps-fin-chip.total {
            background: #f0fdfa;
            color: #0d7377;
        }

        .ps-fin-chip.paid {
            background: #f0fdf4;
            color: #16a34a;
        }

        .ps-fin-chip.discount {
            background: #fffbeb;
            color: #b45309;
        }

        .ps-fin-chip.remaining {
            background: #fef2f2;
            color: #dc2626;
        }

    .ps-teeth-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 4px 16px 10px;
        animation: fadeInUp 0.25s ease;
    }

    .ps-tooth-row {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1px solid #f8fafc;
        border-radius: 10px;
        padding: 8px 10px;
        transition: background .15s ease;
    }

        .ps-tooth-row:hover {
            background: #f0fdfa;
        }

    .ps-tooth-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .ps-diag-name {
        font-size: .8rem;
        font-weight: 700;
        color: #0d9488;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ps-diag-notes {
        font-size: .68rem;
        color: #94a3b8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ps-diag-price {
        font-size: .8rem;
        font-weight: 800;
        color: #0f172a;
        white-space: nowrap;
    }

    .ps-session-subtotal {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px 12px;
        border-top: 1px dashed #e2e8f0;
        font-size: .76rem;
        color: #64748b;
        font-weight: 700;
        margin-top: 2px;
    }

        .ps-session-subtotal b {
            color: #0d7377;
            font-size: .85rem;
        }

    .ps-grand-totals {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 2px solid #f0fdfa;
    }

    .ps-grand-item {
        background: linear-gradient(180deg, #f8fafc, #f1f5f9);
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.03);
    }

        .ps-grand-item span {
            display: block;
            font-size: .68rem;
            color: #94a3b8;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .ps-grand-item b {
            font-size: .95rem;
            color: #0f172a;
        }

        .ps-grand-item.paid b {
            color: #16a34a;
        }

        .ps-grand-item.discount b {
            color: #b45309;
        }

        .ps-grand-item.remaining {
            background: linear-gradient(180deg, #fef2f2, #fee2e2);
            border-color: #fecaca;
        }

            .ps-grand-item.remaining b {
                color: #dc2626;
            }

    /* سن فاضي / غير محدد */
    .tooth-chip-empty {
        background: linear-gradient(135deg, #f1f5f9, #e2e8f0) !important;
        color: #94a3b8 !important;
        box-shadow: none !important;
        font-size: 0.9rem !important;
    }

    @@media (max-width: 767.98px) {
        .ps-grand-totals {
            grid-template-columns: repeat(2, 1fr);
        }

        .ps-session-head {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    function togglePsPanel(headerBtn) {
        const targetId = headerBtn.dataset.target;
        const panel = document.getElementById(targetId);
        const block = headerBtn.closest('.ps-session-block');
        if (!panel) return;

        const isOpen = panel.style.display !== 'none';
        panel.style.display = isOpen ? 'none' : 'flex';
        block.classList.toggle('open', !isOpen);
        // ⭐ ملاحظات المتابعة بتفتح/تقفل مع نفس اليوم
        const notesBlock = block.querySelector(`.ps-notes-block[data-panel="${targetId}"]`);
        if (notesBlock) notesBlock.style.display = isOpen ? 'none' : 'block';
    }
    window.togglePsPanel = togglePsPanel;

    function editPreviousRecord(btn) {
        if (event) event.stopPropagation();

        const row = btn.closest('.ps-tooth-row');
        const vdId = parseInt(row.dataset.vd);
        const tooth = parseInt(row.dataset.tooth);
        const diagId = row.dataset.diag;
        const notes = row.dataset.notes;

        if (window.openToothModal) {
            openToothModal(tooth, null, null, { vdId: vdId, diagId: diagId, notes: notes });
        }
    }
    window.editPreviousRecord = editPreviousRecord;
</script>