@inject Dental.Core.Settings.IClinicSettingsService ClinicSettingsService
@{
    // 🔐 H1: Layout مستقل لشاشات الدخول — من غير القائمة الجانبية والشريط العلوي
    var clinic = ClinicSettingsService.Get();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a4d4f" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] — @clinic.ClinicName</title>

    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="~/icons/favicon-32.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />

    <style>
        @@font-face {
            font-family: 'Beiruti';
            src: url('@Url.Content("~/fonts/Beiruti-VariableFont_wght.ttf")') format('truetype');
            font-weight: 300 900;
            font-display: swap;
        }
    </style>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    @RenderBody()

    <script src="~/lib/jquery/jquery-3.7.1.min.js"></script>
    <script src="~/js/pwa.js" asp-append-version="true" data-base="@Url.Content("~/")"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
