@using Dental.Modules.Inventory.DTOs
@model MaterialDetailsDto
@{
    var isEdit = ViewBag.IsEdit == true;
}

<div class="inv-modal" id="materialFormModal">
    <div class="inv-modal-overlay" onclick="closeMaterialModal()"></div>
    <div class="inv-modal-box lg">
        <div class="inv-modal-head">
            <div>
                <h5>
                    <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                    @(isEdit ? "Edit Material" : "Add Material")
                </h5>
                <p class="inv-modal-sub">@(isEdit ? Model.Name : "Keep it to one compact screen — no extra scrolling")</p>
            </div>
            <button type="button" class="btn-close btn-close-white" onclick="closeMaterialModal()"></button>
        </div>
        <form id="materialForm" asp-action="Save" asp-controller="Inventory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Manufacturer" />
            <input type="hidden" asp-for="BatchNumber" />

            <div class="inv-modal-body compact">
                <div class="inv-form-section">
                    <h6>Basic info</h6>
                    <div class="inv-form-grid cols-4">
                        <div>
                            <label class="inv-label">Code *</label>
                            <input asp-for="Code" class="inv-input" maxlength="40" placeholder="e.g. MAT-014" required />
                        </div>
                        <div>
                            <label class="inv-label">Name *</label>
                            <input asp-for="Name" class="inv-input" maxlength="120" placeholder="Material name" required />
                        </div>
                        <div>
                            <label class="inv-label">Category *</label>
                            <select asp-for="Category" asp-items="ViewBag.Categories" class="inv-select" required>
                                <option value="">Select</option>
                            </select>
                        </div>
                        <div>
                            <label class="inv-label">Description</label>
                            <input asp-for="Description" class="inv-input" maxlength="200" placeholder="Short description" />
                        </div>
                    </div>
                </div>

                <div class="inv-form-section">
                    <h6>Stock</h6>
                    <div class="inv-form-grid cols-4">
                        <div>
                            <label class="inv-label">Quantity @(isEdit ? "" : "*")</label>
                            @if (isEdit)
                            {
                                <input class="inv-input" value="@Model.Quantity" disabled />
                                <small class="inv-hint">Change qty via Receive / Issue</small>
                            }
                            else
                            {
                                <input asp-for="Quantity" type="number" step="0.001" min="0" class="inv-input" value="@(Model.Quantity == 0 ? 0 : Model.Quantity)" />
                            }
                        </div>
                        <div>
                            <label class="inv-label">Unit *</label>
                            <select asp-for="Unit" asp-items="ViewBag.Units" class="inv-select" required>
                                <option value="">Select</option>
                            </select>
                        </div>
                        <div>
                            <label class="inv-label">Min. stock</label>
                            <input asp-for="MinimumStockLevel" type="number" step="0.001" min="0" class="inv-input" />
                        </div>
                        <div>
                            <label class="inv-label">Storage location</label>
                            <input asp-for="StorageLocation" class="inv-input" maxlength="80" placeholder="Shelf / cabinet" />
                        </div>
                    </div>
                </div>

                <div class="inv-form-section">
                    <h6>Commercial</h6>
                    <div class="inv-form-grid cols-3">
                        <div>
                            <label class="inv-label">Purchase price</label>
                            <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="inv-input" />
                        </div>
                        <div>
                            <label class="inv-label">Current price</label>
                            <input asp-for="CurrentPrice" type="number" step="0.01" min="0" class="inv-input" />
                        </div>
                        <div>
                            <label class="inv-label">Supplier</label>
                            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="inv-select">
                                <option value="">— None —</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="inv-form-section" style="margin-bottom:0;">
                    <h6>Expiry & status</h6>
                    <div class="inv-form-grid cols-4">
                        <div>
                            <label class="inv-label">Expiry date</label>
                            <input type="date" name="ExpiryDate" class="inv-input" value="@(Model.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="inv-label">Status</label>
                            <label class="inv-toggle">
                                <input type="hidden" name="IsActive" value="false" />
                                <input type="checkbox" name="IsActive" value="true" @(isEdit ? (Model.IsActive ? "checked" : null) : "checked") />
                                <span class="inv-toggle-track"></span>
                                <span class="inv-toggle-text">Active</span>
                            </label>
                        </div>
                        <div class="span-2">
                            <label class="inv-label">Notes</label>
                            <input asp-for="Notes" class="inv-input" maxlength="250" placeholder="Optional notes" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="inv-modal-foot">
                <button type="button" class="inv-btn inv-btn-cancel" onclick="closeMaterialModal()">Cancel</button>
                <button type="submit" class="inv-btn inv-btn-save" id="btnSaveMaterial">
                    <i class="bi bi-check-lg"></i> @(isEdit ? "Save changes" : "Add material")
                </button>
            </div>
        </form>
    </div>
</div>