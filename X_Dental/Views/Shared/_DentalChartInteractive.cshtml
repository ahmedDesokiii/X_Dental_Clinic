    }

        .surf-check-v4:has(input:checked) {
            background: linear-gradient(135deg, #0d9488, #0d7377);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 14px rgba(13,115,119,0.25);
        }

        .surf-check-v4 input {
            display: none;
        }

    .tooth-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 24px;
        border-top: 1px solid #f0fdfa;
        background: linear-gradient(180deg, #fafcfd, #fff);
        flex-shrink: 0;
    }

    .btn-glass-v4 {
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: .85rem;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

    .btn-cancel-v4 {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-cancel-v4:hover {
            background: #e2e8f0;
        }

    .btn-save-v4 {
        background: linear-gradient(135deg, #0d9488, #0d7377);
        color: #fff;
        box-shadow: 0 6px 18px rgba(13,115,119,0.25);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-save-v4:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(13,115,119,0.35);
        }

    /* ══════════════════════════════════════════════
           ⭐ Multi-Unit
           ══════════════════════════════════════════════ */
    .mu-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        padding: 4px 6px 8px;
    }

    .mu-toggle {
        border: 1.5px solid #ddd6fe;
        background: #fff;
        color: #6d28d9;
        font-weight: 800;
        font-size: .78rem;
        padding: 7px 14px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: all .25s ease;
    }

        .mu-toggle:hover {
            border-color: #7c3aed;
            transform: translateY(-1px);
        }

        .mu-toggle .mu-switch {
            width: 28px;
            height: 16px;
            border-radius: 999px;
            background: #e2e8f0;
            position: relative;
            transition: background .25s ease;
        }

            .mu-toggle .mu-switch::after {
                content: '';
                position: absolute;
                top: 2px;
                left: 2px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #fff;
                box-shadow: 0 1px 3px rgba(0,0,0,.2);
                transition: left .25s cubic-bezier(.3,1.4,.5,1);
            }

        .mu-toggle.on {
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 6px 16px rgba(124,58,237,.3);
        }

            .mu-toggle.on .mu-switch {
                background: rgba(255,255,255,.35);
            }

                .mu-toggle.on .mu-switch::after {
                    left: 14px;
                }

    .mu-hint {
        font-size: .72rem;
        font-weight: 700;
        color: #6d28d9;
        background: #f5f3ff;
        padding: 5px 10px;
        border-radius: 8px;
        display: none;
        animation: muPop .25s ease;
    }

    .chart-shell.mu-on .mu-hint {
        display: inline-block;
    }

    .chart-shell.mu-on .chart-canvas {
        box-shadow: 0 0 0 2px rgba(124,58,237,.35), 0 16px 40px rgba(124,58,237,.12);
        transition: box-shadow .3s ease;
    }

    .multi-check {
        position: absolute;
        top: -6px;
        right: -6px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: #fff;
        display: none;
        align-items: center;
        justify-content: center;
        font-size: .7rem;
        z-index: 31;
        box-shadow: 0 3px 8px rgba(124,58,237,.45);
        border: 2px solid #fff;
    }

    .tooth-box.multi-picked {
        z-index: 15;
    }

        .tooth-box.multi-picked .multi-check {
            display: flex;
            animation: muPop .3s cubic-bezier(.2,1.5,.4,1);
        }

        .tooth-box.multi-picked .realistic-tooth {
            transform: translateY(-3px) scale(1.1);
            filter: drop-shadow(0 0 3px rgba(124,58,237,.75)) drop-shadow(0 0 10px rgba(124,58,237,.4));
        }

        .tooth-box.multi-picked .tooth-num {
            background: #7c3aed;
        }

    @@keyframes muPop {
        from {
            transform: scale(.4);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .mu-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 8px;
        padding: 10px 14px;
        border-radius: 16px;
        background: linear-gradient(135deg, #7c3aed, #5b21b6);
        color: #fff;
        box-shadow: 0 12px 28px rgba(91,33,182,.3);
        animation: muSlide .35s cubic-bezier(.2,1.2,.3,1);
    }

        .mu-bar[hidden] {
            display: none;
        }

    @@keyframes muSlide {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .mu-bar-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .mu-bar-count {
        background: rgba(255,255,255,.18);
        border-radius: 12px;
        padding: 4px 12px;
        text-align: center;
        line-height: 1.1;
    }

        .mu-bar-count b {
            display: block;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .mu-bar-count span {
            font-size: .62rem;
            font-weight: 700;
            opacity: .85;
        }

    .mu-bar-range {
        font-weight: 800;
        font-size: .86rem;
    }

        .mu-bar-range small {
            display: block;
            font-size: .7rem;
            font-weight: 600;
            opacity: .8;
        }

    .mu-bar-actions {
        display: flex;
        gap: 6px;
    }

        .mu-bar-actions button {
            border: none;
            border-radius: 10px;
            padding: 8px 14px;
            font-weight: 800;
            font-size: .78rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: transform .2s ease, background .2s ease;
        }

            .mu-bar-actions button:hover {
                transform: translateY(-1px);
            }

    .mu-btn-clear {
        background: rgba(255,255,255,.16);
        color: #fff;
    }

        .mu-btn-clear:hover {
            background: rgba(255,255,255,.26);
        }

    .mu-btn-go {
        background: #fff;
        color: #6d28d9;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
    }

    /* شريط الوحدات جوه المودال */
    .mu-units-strip {
        background: linear-gradient(135deg, #f5f3ff, #faf5ff);
        border: 1px solid #ddd6fe;
        border-radius: 14px;
        padding: 10px 12px;
        margin-bottom: 14px;
        animation: muPop .3s ease;
    }

    .mu-units-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .76rem;
        font-weight: 800;
        color: #5b21b6;
        margin-bottom: 8px;
    }

        .mu-units-head b {
            background: #7c3aed;
            color: #fff;
            border-radius: 999px;
            padding: 1px 10px;
            font-size: .72rem;
        }

    .mu-units-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .mu-unit-chip {
        background: #fff;
        border: 1px solid #ddd6fe;
        color: #5b21b6;
        font-weight: 800;
        font-size: .74rem;
        padding: 4px 10px;
        border-radius: 8px;
        animation: muPop .3s ease backwards;
    }


    /* ⭐ Toolbar layout: 30% (زرار + hint) | 70% (شريط التحديد) */
    .mu-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: nowrap;
        gap: 10px;
        padding: 4px 6px 8px;
        min-height: 62px;
    }

    .mu-left {
        flex: 0 0 30%;
        max-width: 30%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        min-width: 0;
    }

    .mu-right {
        flex: 1 1 70%;
        min-width: 0;
    }

    .mu-hint {
        font-size: .66rem;
        padding: 3px 8px;
        line-height: 1.35;
        white-space: normal;
    }

    /* الشريط بقى في نفس السطر → أصغر وأخف */
    .mu-bar {
        margin-top: 0;
        padding: 6px 8px 6px 10px;
        border-radius: 14px;
        flex-wrap: nowrap;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(91,33,182,.25);
    }

    .mu-bar-info {
        flex: 1 1 auto;
        gap: 8px;
    }

    .mu-bar-count {
        padding: 3px 9px;
        border-radius: 10px;
        flex-shrink: 0;
    }

        .mu-bar-count b {
            font-size: 1rem;
        }

    .mu-bar-range {
        min-width: 0;
        font-size: .8rem;
    }

        .mu-bar-range span,
        .mu-bar-range small {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .mu-bar-actions {
        flex-shrink: 0;
        gap: 5px;
    }

        .mu-bar-actions button {
            padding: 7px 11px;
            font-size: .76rem;
        }

    /* على الموبايل: الصفين تحت بعض */
    @@media (max-width: 576px) {
        .mu-toolbar {
            flex-wrap: wrap;
        }

        .mu-left, .mu-right {
            flex: 1 1 100%;
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .modal-body-row {
            flex-direction: column;
            gap: 16px;
        }

        .modal-col-divider {
            display: none;
        }

        .modal-glass-xl {
            margin: 8px;
            max-height: 95vh;
            border-radius: 18px;
        }

        .tooth-modal-body {
            padding: 16px;
        }

        .tooth-modal-head {
            padding: 14px 16px;
        }

        .tooth-modal-foot {
