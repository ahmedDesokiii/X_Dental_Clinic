        }
    }
</style>

<div class="chart-shell" id="chartShell">
    <div class="tooth-tooltip" id="toothTooltip"></div>

    <!-- ⭐ Multi-Unit toolbar: الزرار + الـ hint (30%) | شريط التحديد (70%) -->
    <div class="mu-toolbar">
        <div class="mu-left">
            <button type="button" class="mu-toggle" id="muToggle" onclick="toggleMultiUnit()">
                <span class="mu-switch"></span>
                <i class="bi bi-diagram-3"></i> Multi-Unit
            </button>
            <span class="mu-hint"><i class="bi bi-hand-index"></i> Select adjacent teeth in the same arch</span>
        </div>

        <div class="mu-right">
            <div class="mu-bar" id="muBar" hidden>
                <div class="mu-bar-info">
                    <div class="mu-bar-count"><b id="muBarCount">0</b><span>units</span></div>
                    <div class="mu-bar-range">
                        <span id="muBarRange">—</span>
                        <small id="muBarTeeth">—</small>
                    </div>
                </div>
                <div class="mu-bar-actions">
                    <button type="button" class="mu-btn-clear" onclick="clearMultiSelection()" title="Clear"><i class="bi bi-x-lg"></i></button>
                    <button type="button" class="mu-btn-go" onclick="openMultiUnitModal()"><i class="bi bi-clipboard2-pulse"></i> Diagnose</button>
                </div>
            </div>
        </div>
    </div>

    <div class="chart-canvas" id="chartCanvas">
        <svg class="bg-arcs" viewBox="0 0 620 632" preserveAspectRatio="xMidYMid meet">
            <div class="quadrant-divider-v"></div>
            <div class="quadrant-divider-h"></div>
            <span class="quadrant-badge ur fs-5">UR</span>
            <span class="quadrant-badge ul fs-5">UL</span>
            <span class="quadrant-badge lr fs-5">LR</span>
            <span class="quadrant-badge ll fs-5">LL</span>
            <defs>
                <linearGradient id="gumUpperInt" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f8d3ca" /><stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
                <linearGradient id="gumLowerInt" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#f8d3ca" /><stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
            </defs>
            <path id="upperArchPath" fill="url(#gumUpperInt)"></path>
            <path id="lowerArchPath" fill="url(#gumLowerInt)"></path>
        </svg>

        <div class="arch-center-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2.4 0-3.6 1.3-4.8 1.3-1.6 0-2.7-1-3.5-.4-.9.7-.7 2.4-.4 3.9.4 2.2 1.1 6.6 2 9.3.5 1.5 1 2.9 2.1 2.9 1.4 0 1.4-3 2.6-3s1.2 3 2.6 3c1.1 0 1.6-1.4 2.1-2.9.9-2.7 1.6-7.1 2-9.3.3-1.5.5-3.2-.4-3.9-.8-.6-1.9.4-3.5.4C15.6 4.3 14.4 3 12 3Z" /></svg>
        </div>

        <!-- Upper Arch -->
        <div class="teeth-row upper">
            @for (int i = 18; i >= 11; i--)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-orig="@status.ToString().ToLower()" style="animation-delay:@((18 - i) * 45)ms" onclick="onToothClick(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@(i - 10)</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                    <span class="multi-check"><i class="bi bi-check-lg"></i></span>
                </div>
            }
            @for (int i = 21; i <= 28; i++)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-orig="@status.ToString().ToLower()" style="animation-delay:@((i % 10) * 45 + 360)ms" onclick="onToothClick(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@(i - 20)</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                    <span class="multi-check"><i class="bi bi-check-lg"></i></span>
                </div>
            }
        </div>

        <!-- Lower Arch -->
        <div class="teeth-row lower">
            @for (int i = 48; i >= 41; i--)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-orig="@status.ToString().ToLower()" style="animation-delay:@((48 - i) * 45 + 720)ms" onclick="onToothClick(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@(i - 40)</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                    <span class="multi-check"><i class="bi bi-check-lg"></i></span>
                </div>
            }
            @for (int i = 31; i <= 38; i++)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-orig="@status.ToString().ToLower()" style="animation-delay:@((i % 10) * 45 + 1080)ms" onclick="onToothClick(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@(i - 30)</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                    <span class="multi-check"><i class="bi bi-check-lg"></i></span>
                </div>
            }
        </div>
    </div>

    <!-- ⭐ Multi-Unit selection bar -->
    <div class="mu-bar" id="muBar" hidden>
        <div class="mu-bar-info">
            <div class="mu-bar-count"><b id="muBarCount">0</b><span>units</span></div>
            <div class="mu-bar-range">
                <span id="muBarRange">—</span>
                <small id="muBarTeeth">—</small>
            </div>
        </div>
        <div class="mu-bar-actions">
            <button type="button" class="mu-btn-clear" onclick="clearMultiSelection()"><i class="bi bi-x-lg"></i> Clear</button>
            <button type="button" class="mu-btn-go" onclick="openMultiUnitModal()"><i class="bi bi-clipboard2-pulse"></i> Diagnose</button>
        </div>
    </div>

    <!-- Tooth Detail Modal — XL 3-Column -->
    <div class="tooth-modal " id="toothModal">
        <div class="modal-overlay" onclick="closeToothModal()"></div>
        <div class="modal-glass-xl">
            <div class="tooth-modal-head">
                <h5 class="text-light"><i class="bi bi-grid-3x3-gap"></i><span id="toothModalTitle">Tooth Details</span><span id="selectedToothNum"></span>  </h5>
                <button type="button" class="btn-close-modal" onclick="closeToothModal()"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="tooth-modal-body pb-0 mb-0">
                <div class="modal-body-row">
                    @* Column 1: Status + Diagnosis + Notes *@
                    <div class="modal-col">
                        @* ⭐ Multi-Unit: الأسنان اللي التشخيص هيتطبق عليها *@
                        <div class="mu-units-strip" id="muUnitsStrip" style="display:none;">
                            <div class="mu-units-head">
                                <span><i class="bi bi-diagram-3"></i> Units</span>
                                <b id="muUnitsCount">0</b>
                            </div>
                            <div class="mu-units-chips" id="muUnitsChips"></div>
                        </div>

                        @* ⭐ Status ليه div مستقل عشان نقدر نخفيه لوحده في وضع تعديل الـ Previous Session
                           من غير ما نأثر على الـ Diagnosis / Price / Notes *@
                        <div class="form-group-v4 mb-3" id="statusFieldGroup">
                            <label>Tooth Status</label>
                            <select class="form-glass-v4 mb-2" id="toothStatus">
                                <option value="1">Healthy</option>
                                <option value="2" selected>Decayed</option>
                                <option value="3">Treated</option>
                                <option value="4">Missing</option>
                                <option value="5">Extracted</option>
                                <option value="6">Impacted</option>
                                <option value="7">Crown</option>
                                <option value="8">Bridge</option>
                                <option value="9">Implant</option>
                                <option value="10">Fractured</option>
                                <option value="11">Root Canal</option>
                                <option value="12">Filling</option>
                            </select>
                        </div>

                        @* ⭐ ده الجزء اللي المفروض يفضل ظاهر دايمًا (Diagnosis + Price + Notes) *@
                        <div class="form-group-v4 mb-3" id="diagnosisFieldGroup">
                            <label>Diagnosis</label>
                            <div class="diagnosis-row mb-2">
                                <select class="form-glass-v4" id="toothDiagnosis" onchange="onDiagnosisChange()">
                                    <option value="">-- Select diagnosis --</option>
                                    @if (ViewBag.DiagnosisList != null)
                                    {
                                        @foreach (var d in (List<Dental.Models.Clinic.DiagnosisCatalog>)ViewBag.DiagnosisList)
                                        {
                                            <option value="@d.Id" data-price="@d.Price">@d.NameEn</option>
                                        }
                                    }
                                </select>
                                <span class="diagnosis-price-badge" id="diagnosisPriceBadge">0 EGP</span>
                            </div>

                            <label>Condition Notes</label>
                            <textarea class="form-glass-v4" id="diagnosisNotes" rows="2" placeholder="Notes about the diagnosis / condition..."></textarea>
                        </div>

                        <div class="form-group-v4 mb-3" hidden>
                            <label>Affected Surfaces</label>
                            <div class="surface-picker-v4">
                                <label class="surf-check-v4"><input type="checkbox" value="M" /> M</label>
                                <label class="surf-check-v4"><input type="checkbox" value="D" /> D</label>
                                <label class="surf-check-v4"><input type="checkbox" value="B" /> B</label>
                                <label class="surf-check-v4"><input type="checkbox" value="L" /> L</label>
                                <label class="surf-check-v4"><input type="checkbox" value="O" /> O</label>
                            </div>
                        </div>
                        <div class="form-group-v4 mb-0" hidden>
                            <label>Procedure Code</label>
                            <input type="text" class="form-glass-v4" id="toothProcedure" placeholder="e.g. RCT, CRN, FLL" />
                        </div>
                    </div>

                    <div class="modal-col-divider"></div>

                    @* Column 3: X-Rays *@
                    <div class="modal-col" id="colXray">
                        <div class="form-group-v4 mb-0">
                            <label>Tooth X-Rays (optional)</label>
                            <div class="xray-upload-zone p-0" onclick="document.getElementById('toothXrayFiles').click()">
                                <input type="file" id="toothXrayFiles" accept="image/*" multiple hidden onchange="onToothXrayFilesChange(event)" />
                                <i class="bi bi-cloud-arrow-up" style="font-size:1.8rem;display:block;margin-bottom:8px;color:#0d9488;"></i>
                                <span class="mt-0" style="font-weight:700;color:#475569;">Click to upload one or more images</span>
                                <small style="display:block;margin-top:4px;color:#94a3b8;">JPG, PNG, DICOM</small>
                            </div>
                            <div id="xrayFilesList" class="xray-files-list"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tooth-modal-foot pt-0 mt-0">
                <button type="button" class="btn-glass-v4 btn-cancel-v4" onclick="closeToothModal()">Cancel</button>
                <button type="button" class="btn-glass-v4 btn-save-v4" id="btnApplyTooth" onclick="applyToothChanges()">
                    <i class="bi bi-check-lg"></i> <span id="btnApplyToothText">Add to Session</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        var canvas = document.getElementById('chartCanvas');
        if (window.initDentalArch) window.initDentalArch(canvas);
    })();

    /* ⭐ الآن Array — نفس السن ممكن ياخد أكتر من تشخيص (Insert) */
    window.pendingToothRecords = [];
    let currentToothNumber = null;
    let currentXrayFiles = [];
    let editingRecordUid = null;   // ⭐ تعديل ريكورد موجود في السيشن الحالي
    let historyEditCtx = null;     // ⭐ تعديل ريكورد من السجلات السابقة { vdId }

    // ⭐ Multi-Unit state
    let multiUnitOn = false;       // وضع تحديد أكتر من سن
    let multiSel = [];             // الأسنان المحددة بترتيبها على الفك
    let currentGroupTeeth = [];    // أسنان المجموعة المفتوحة في المودال
    let editingGroupId = null;     // تعديل مجموعة موجودة في السيشن الحالي

    const STATUS_ID_TO_CLASS = {
        1: 'healthy', 2: 'decayed', 3: 'treated', 4: 'missing', 5: 'extracted', 6: 'impacted',
        7: 'crown', 8: 'bridge', 9: 'implant', 10: 'fractured', 11: 'rootcanal', 12: 'filling'
    };
    const STATUS_ID_TO_LABEL_TT = {
        1: 'Healthy', 2: 'Decayed', 3: 'Treated', 4: 'Missing', 5: 'Extracted', 6: 'Impacted',
        7: 'Crown', 8: 'Bridge', 9: 'Implant', 10: 'Fractured', 11: 'Root Canal', 12: 'Filling'
    };

    // ⭐ ترتيب الأسنان الفعلي على امتداد كل فك — نفس ترتيب السيرفر (IsContiguousGroup)
    const ARCH_ORDERS = [
        [18, 17, 16, 15, 14, 13, 12, 11, 21, 22, 23, 24, 25, 26, 27, 28],
        [48, 47, 46, 45, 44, 43, 42, 41, 31, 32, 33, 34, 35, 36, 37, 38]
    ];

    window.toothInfoMap = @Html.Raw(ViewBag.ToothInfoMap ?? "{}");

    // ⭐ نفس منطق الترقيم في الـ Razor: 28→UR-8, 15→UL-5
    function toothLabelJs(num) {
        const q = Math.floor(num / 10), p = num % 10;
        return ({ 1: 'UL', 2: 'UR', 3: 'LL', 4: 'LR' })[q] + '-' + p;
    }

    let uidSeq = 0;
    function genUid() { return 'r' + Date.now() + '_' + (++uidSeq) + '_' + Math.floor(Math.random() * 10000); }
    function genGuid() {
        if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
            const r = Math.random() * 16 | 0;
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }

    function getPendingForTooth(num) {
        return window.pendingToothRecords.filter(r => r.ToothNumber === num);
    }

    // ── Arch helpers ──
    function archOf(num) { return ARCH_ORDERS.find(a => a.includes(num)) || null; }
    function rangeBetween(a, b) {
        const arch = archOf(a);
        const i = arch.indexOf(a), j = arch.indexOf(b);
        return arch.slice(Math.min(i, j), Math.max(i, j) + 1);
    }
    function sortByArch(teeth) {
        if (!teeth.length) return [];
        const arch = archOf(teeth[0]);
        return teeth.slice().sort((a, b) => arch.indexOf(a) - arch.indexOf(b));
    }
    function groupRangeLabel(teeth) {
        if (!teeth.length) return '—';
        if (teeth.length === 1) return toothLabelJs(teeth[0]);
        return `${toothLabelJs(teeth[0])} → ${toothLabelJs(teeth[teeth.length - 1])}`;
    }
    function getGroupTeeth(groupId) {
        return sortByArch(window.pendingToothRecords.filter(r => r.GroupId === groupId).map(r => r.ToothNumber));
    }

    function onDiagnosisChange() {
        const select = document.getElementById('toothDiagnosis');
        const badge = document.getElementById('diagnosisPriceBadge');
        const selectedOption = select.options[select.selectedIndex];
        const price = selectedOption ? parseFloat(selectedOption.dataset.price || 0) : 0;
        const units = currentGroupTeeth.length;

        if (units > 1) {
            // ⭐ السعر للسن الواحد × عدد الوحدات
            badge.classList.add('multi');
            badge.innerHTML = `${(price * units).toLocaleString('en-EG')} EGP<small>${price.toLocaleString('en-EG')} × ${units}</small>`;
        } else {
            badge.classList.remove('multi');
            badge.textContent = price.toLocaleString('en-EG') + ' EGP';
        }
        badge.classList.remove('updated');
        void badge.offsetWidth;
        badge.classList.add('updated');
    }

    // ════════════════════════════════════════════════
    // ⭐ Multi-Unit selection
    // ════════════════════════════════════════════════
    function toggleMultiUnit() {
        multiUnitOn = !multiUnitOn;
        document.getElementById('muToggle').classList.toggle('on', multiUnitOn);
        document.getElementById('chartShell').classList.toggle('mu-on', multiUnitOn);
        if (!multiUnitOn) clearMultiSelection();
    }

    function onToothClick(num, evt) {
        if (!multiUnitOn) { openToothModal(num, evt); return; }
        if (evt) { evt.preventDefault(); evt.stopPropagation(); }

        const arch = archOf(num);
        if (!multiSel.length) {
            multiSel = [num];
        } else if (archOf(multiSel[0]) !== arch) {
            // الوحدات لازم تكون في نفس الفك → نبدأ تحديد جديد
            multiSel = [num];
            muToast('Units must be in the same arch — selection restarted', 'info');
        } else if (multiSel.includes(num)) {
            const first = multiSel[0], last = multiSel[multiSel.length - 1];
            if (num === first) multiSel.shift();
            else if (num === last) multiSel.pop();
            else multiSel = rangeBetween(first, num); // ضغطة في النص = قص المدى لحد السن ده
        } else {
            // ⭐ أي سن في نفس الفك = مد المدى لحده تلقائيًا (بيضمن التجاور دايمًا)
            const first = multiSel[0], last = multiSel[multiSel.length - 1];
            multiSel = arch.indexOf(num) < arch.indexOf(first)
                ? rangeBetween(num, last)
                : rangeBetween(first, num);
        }
        renderMultiSelection();
    }

    function renderMultiSelection() {
        document.querySelectorAll('#chartCanvas .tooth-box').forEach(el => {
            el.classList.toggle('multi-picked', multiSel.includes(parseInt(el.dataset.tooth)));
        });

        const bar = document.getElementById('muBar');
        if (!multiSel.length) { bar.hidden = true; return; }

        const sorted = sortByArch(multiSel);
        multiSel = sorted;
        bar.hidden = false;
        document.getElementById('muBarCount').textContent = sorted.length;
        document.getElementById('muBarRange').textContent = groupRangeLabel(sorted);
        document.getElementById('muBarTeeth').textContent = sorted.map(toothLabelJs).join(' · ');
    }

    function clearMultiSelection() {
        multiSel = [];
        renderMultiSelection();
    }

    function openMultiUnitModal() {
        if (!multiSel.length) return;
        if (multiSel.length === 1) { openToothModal(multiSel[0], null); return; }
        openToothModal(multiSel[0], null, null, null, multiSel);
    }

    function muToast(title, icon) {
        Swal.fire({ toast: true, position: 'top-end', icon: icon || 'success', title, showConfirmButton: false, timer: 1600, customClass: { popup: 'rounded-4' } });
    }

    document.addEventListener('keydown', e => {
        const modalOpen = document.getElementById('toothModal').classList.contains('dc-show');
        if (e.key === 'Escape' && multiUnitOn && !modalOpen && multiSel.length) clearMultiSelection();
    });

    // ════════════════════════════════════════════════
    // Modal
    // ════════════════════════════════════════════════
    function openToothModal(num, evt, uid = null, hist = null, groupTeeth = null) {
        if (evt) { evt.preventDefault(); evt.stopPropagation(); }

        currentToothNumber = num;
        editingRecordUid = uid;
        historyEditCtx = hist;

        const existing = uid ? window.pendingToothRecords.find(r => r.uid === uid) : null;

        // ⭐ تحديد هل ده Multi-Unit (مجموعة جديدة أو تعديل مجموعة موجودة)
        editingGroupId = existing && existing.GroupId ? existing.GroupId : null;
        currentGroupTeeth = groupTeeth
            ? sortByArch(groupTeeth)
            : (editingGroupId ? getGroupTeeth(editingGroupId) : []);
        const isGroup = currentGroupTeeth.length > 1;

        // في المجموعة: الأشعة متخزنة على أول سجل بس
        const xraySource = editingGroupId
            ? (window.pendingToothRecords.find(r => r.GroupId === editingGroupId && r.XRays && r.XRays.length) || existing)
            : existing;

        document.getElementById('toothModalTitle').textContent = isGroup ? 'Multi-Unit Diagnosis' : 'Tooth Details';
        document.getElementById('selectedToothNum').textContent = isGroup
            ? ` (${groupRangeLabel(currentGroupTeeth)} · ${currentGroupTeeth.length} units)`
            : ' (' + toothLabelJs(num) + ')' + (hist ? ' — Edit History' : '');

        document.getElementById('toothStatus').value = existing ? existing.Status : 2;
        document.getElementById('toothProcedure').value = existing ? (existing.ProcedureCode || '') : '';
        document.getElementById('toothDiagnosis').value =
            hist ? (hist.diagId || '') : (existing ? (existing.DiagnosisCatalogId || '') : '');
        document.getElementById('diagnosisNotes').value =
            hist ? (hist.notes || '') : (existing ? (existing.DiagnosisNotes || '') : '');

        document.querySelectorAll('.surf-check-v4 input').forEach(cb => {
            cb.checked = existing ? (existing.Surfaces || []).some(s => s.Surface === cb.value) : false;
        });

        currentXrayFiles = xraySource && xraySource.XRays
            ? xraySource.XRays.map(x => ({ fileName: x.FileName || x.fileName, base64: x.Base64 || x.base64, notes: x.Notes || x.notes || '' }))
            : [];
        renderXrayFilesList();

        // ⭐ شريط الوحدات
        const strip = document.getElementById('muUnitsStrip');
        strip.style.display = isGroup ? '' : 'none';
        if (isGroup) {
            document.getElementById('muUnitsCount').textContent = currentGroupTeeth.length;
            document.getElementById('muUnitsChips').innerHTML = currentGroupTeeth
                .map((t, i) => `<span class="mu-unit-chip" style="animation-delay:${i * 40}ms">${toothLabelJs(t)}</span>`).join('');
        }
        document.getElementById('toothModal').classList.toggle('mu-mode', isGroup);

        onDiagnosisChange();

        // نص زرار الحفظ حسب الوضع
        const btnText = document.getElementById('btnApplyToothText');
        if (hist) btnText.textContent = 'Update Record';
        else if (uid) btnText.textContent = 'Save Changes';
        else btnText.textContent = isGroup ? `Add ${currentGroupTeeth.length} Units` : 'Add to Session';

        // ⭐ في وضع تعديل التاريخ (Previous Sessions): خبي بس الـ Status
        // والـ X-Rays — واسيب الـ Diagnosis/Price/Notes ظاهرين عشان دي أساس التعديل
        document.getElementById('statusFieldGroup').style.display = hist ? 'none' : '';
        document.getElementById('colXray').style.display = hist ? 'none' : '';

        document.querySelectorAll('#chartCanvas .tooth-box').forEach(t => t.classList.remove('selected'));
        (isGroup ? currentGroupTeeth : [num]).forEach(n => {
            const target = document.querySelector('#chartCanvas [data-tooth="' + n + '"]');
            if (target) target.classList.add('selected');
        });

        hideToothTooltip();

        const modal = document.getElementById('toothModal');
        modal.classList.add('dc-show');
        modal.style.setProperty('display', 'flex', 'important');
        modal.style.setProperty('visibility', 'visible', 'important');
        modal.style.setProperty('opacity', '1', 'important');
        modal.style.setProperty('pointer-events', 'auto', 'important');
    }

    function closeToothModal() {
        const modal = document.getElementById('toothModal');
        if (modal) {
            modal.classList.remove('dc-show');
            modal.style.setProperty('display', 'none', 'important');
            modal.style.setProperty('visibility', 'hidden', 'important');
            modal.style.setProperty('opacity', '0', 'important');
            modal.style.setProperty('pointer-events', 'none', 'important');
        }
        document.querySelectorAll('#chartCanvas .tooth-box').forEach(t => t.classList.remove('selected'));
        currentToothNumber = null;
        editingRecordUid = null;
        historyEditCtx = null;
        currentGroupTeeth = [];
        editingGroupId = null;
    }

    const toothModalEl = document.getElementById('toothModal');
    if (toothModalEl) {
        toothModalEl.addEventListener('click', function(e) {
            if (e.target === toothModalEl) closeToothModal();
        });
    }

    function onToothXrayFilesChange(e) {
        const files = Array.from(e.target.files || []);
        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = (ev) => {
                currentXrayFiles.push({ fileName: file.name, base64: ev.target.result, notes: '' });
                renderXrayFilesList();
            };
            reader.readAsDataURL(file);
        });
        e.target.value = '';
    }

    function renderXrayFilesList() {
        const wrap = document.getElementById('xrayFilesList');
        wrap.innerHTML = '';
        currentXrayFiles.forEach((xr, idx) => {
            const row = document.createElement('div');
            row.className = 'xray-file-row';
            row.innerHTML = `
                                <img src="${xr.base64}" class="xray-thumb" />
                                <input type="text" class="form-glass-v4 xray-note-input" placeholder="Note..." value="${xr.notes || ''}" />
                                <button type="button" class="xray-remove-btn"><i class="bi bi-x"></i></button>
                            `;
            row.querySelector('.xray-note-input').addEventListener('input', function() {
                currentXrayFiles[idx].notes = this.value;
            });
            row.querySelector('.xray-remove-btn').addEventListener('click', function() {
                currentXrayFiles.splice(idx, 1);
                renderXrayFilesList();
            });
            wrap.appendChild(row);
        });
    }

    // ⭐ شكل السن = آخر ريكورد pending عليه، ولو مفيش يرجع لحالته الأصلية
    function refreshToothVisual(num) {
        const toothEl = document.querySelector(`#chartCanvas [data-tooth="${num}"]`);
        if (!toothEl) return;
        const records = getPendingForTooth(num);
        const newClass = records.length
            ? (STATUS_ID_TO_CLASS[records[records.length - 1].Status] || 'healthy')
            : (toothEl.dataset.orig || 'healthy');
        toothEl.className = toothEl.className.split(' ')
            .filter(c => !Object.values(STATUS_ID_TO_CLASS).includes(c) && c !== 'selected')
            .join(' ');
        toothEl.classList.add(newClass);
        if (window.updateToothStatusOverlay) window.updateToothStatusOverlay(toothEl);
        updateToothFlag(num);
    }

    function readModalValues() {
        const diagSelect = document.getElementById('toothDiagnosis');
        const diagOption = diagSelect.options[diagSelect.selectedIndex];
        const diagId = diagSelect.value;
        const surfaces = Array.from(document.querySelectorAll('.surf-check-v4 input:checked'))
            .map(cb => ({ Surface: cb.value, Condition: 'Treated' }));
        return {
            statusId: parseInt(document.getElementById('toothStatus').value),
            surfaces,
            diagId: diagId ? parseInt(diagId) : null,
            diagPrice: diagOption && diagId ? parseFloat(diagOption.dataset.price || 0) : 0,
            diagName: diagOption && diagId ? diagOption.textContent : null,
            notes: document.getElementById('diagnosisNotes').value,
            procedure: document.getElementById('toothProcedure').value,
            xrays: currentXrayFiles.map(x => ({ FileName: x.fileName, Base64: x.base64, Notes: x.notes }))
        };
    }

    /* ⭐ الحفظ: Insert دايمًا للجديد — Update بس لو فيه editingRecordUid */
    function applyToothChanges() {
        if (historyEditCtx) { saveHistoryEdit(); return; }
        if (currentGroupTeeth.length > 1) { applyGroupChanges(); return; }
        if (!currentToothNumber) return;

        const v = readModalValues();
        const rec = {
            uid: editingRecordUid || genUid(),
            GroupId: null,
            ToothNumber: currentToothNumber,
            Status: v.statusId,
            Surfaces: v.surfaces,
            ProcedureCode: v.procedure,
            Notes: v.notes,
            DiagnosisCatalogId: v.diagId,
            DiagnosisName: v.diagName,
            DiagnosisPrice: v.diagPrice,
            DiagnosisSurface: v.surfaces.map(s => s.Surface).join(','),
            DiagnosisNotes: v.notes,
            XRays: v.xrays,
            PrescriptionItems: []
        };

        const toothNum = currentToothNumber;
        const wasEdit = !!editingRecordUid;
        if (wasEdit) {
            const idx = window.pendingToothRecords.findIndex(r => r.uid === editingRecordUid);
            if (idx > -1) window.pendingToothRecords[idx] = rec;
        } else {
            window.pendingToothRecords.push(rec); // ✅ Insert — حتى لو نفس السن
        }

        refreshToothVisual(toothNum);
        if (multiSel.length) clearMultiSelection();

        if (window.renderRecordsTable) window.renderRecordsTable();
        closeToothModal();

        muToast(wasEdit
            ? 'Record updated for ' + toothLabelJs(toothNum)
            : toothLabelJs(toothNum) + ' added to session');
    }

    /* ⭐ Multi-Unit: سجل لكل سن، كلهم بنفس الـ GroupId */
    function applyGroupChanges() {
        const v = readModalValues();
        if (!v.diagId) {
            Swal.fire({ title: 'Required', text: 'Please select a diagnosis for the units', icon: 'warning', confirmButtonColor: '#7c3aed' });
            return;
        }

        const teeth = currentGroupTeeth.slice();
        const wasEdit = !!editingGroupId;
        const groupId = editingGroupId || genGuid();

        // في التعديل: نشيل سجلات المجموعة القديمة ونكتبها من جديد بنفس الـ GroupId
        const oldTeeth = wasEdit ? getGroupTeeth(groupId) : [];
        if (wasEdit) window.pendingToothRecords = window.pendingToothRecords.filter(r => r.GroupId !== groupId);

        teeth.forEach((num, i) => {
            window.pendingToothRecords.push({
                uid: genUid(),
                GroupId: groupId,
                ToothNumber: num,
                Status: v.statusId,
                Surfaces: v.surfaces,
                ProcedureCode: v.procedure,
                Notes: v.notes,
                DiagnosisCatalogId: v.diagId,
                DiagnosisName: v.diagName,
                DiagnosisPrice: v.diagPrice,           // سعر السن الواحد → الإجمالي = السعر × الوحدات
                DiagnosisSurface: v.surfaces.map(s => s.Surface).join(','),
                DiagnosisNotes: v.notes,
                XRays: i === 0 ? v.xrays : [],         // الأشعة مرة واحدة للمجموعة
                PrescriptionItems: []
            });
        });

        [...new Set([...oldTeeth, ...teeth])].forEach(refreshToothVisual);
        clearMultiSelection();

        if (window.renderRecordsTable) window.renderRecordsTable();
        closeToothModal();

        muToast(wasEdit
            ? `Units updated (${groupRangeLabel(teeth)})`
            : `${teeth.length} units added (${groupRangeLabel(teeth)})`);
    }

    function updateToothFlag(num) {
        const toothEl = document.querySelector(`#chartCanvas [data-tooth="${num}"]`);
        if (!toothEl) return;
        const flag = toothEl.querySelector('.pending-flag');
        if (flag) flag.style.display = getPendingForTooth(num).length ? 'flex' : 'none';
    }

    function removePendingRecord(uid) {
        const rec = window.pendingToothRecords.find(r => r.uid === uid);
        if (rec && rec.GroupId) { removePendingGroup(rec.GroupId); return; }
        window.pendingToothRecords = window.pendingToothRecords.filter(r => r.uid !== uid);
        if (rec) refreshToothVisual(rec.ToothNumber);
        if (window.renderRecordsTable) window.renderRecordsTable();
    }

    function removePendingGroup(groupId) {
        const teeth = getGroupTeeth(groupId);
        window.pendingToothRecords = window.pendingToothRecords.filter(r => r.GroupId !== groupId);
        teeth.forEach(refreshToothVisual);
        if (window.renderRecordsTable) window.renderRecordsTable();
    }

    /* ⭐ تعديل ريكورد من السجلات السابقة (لو جزء من مجموعة السيرفر بيعدّل المجموعة كلها) */
    async function saveHistoryEdit() {
        const diagSelect = document.getElementById('toothDiagnosis');
        if (!diagSelect.value) {
            Swal.fire({ title: 'Required', text: 'Please select a diagnosis', icon: 'warning', confirmButtonColor: '#0d9488' });
            return;
        }
        const payload = {
            Id: historyEditCtx.vdId,
            DiagnosisCatalogId: parseInt(diagSelect.value),
            Notes: document.getElementById('diagnosisNotes').value
        };

        Swal.fire({ title: 'Updating...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        try {
            const res = await fetch('/Clinical/UpdateVisitDiagnosis', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                closeToothModal();
                Swal.fire({
                    title: 'Updated!',
                    text: data.units > 1
                        ? `Diagnosis & price updated for ${data.units} units`
                        : 'Diagnosis & price updated successfully',
                    icon: 'success', timer: 1400, showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire({ title: 'Error', text: data.message || 'Update failed', icon: 'error' });
            }
        } catch (e) {
            Swal.fire({ title: 'Error', text: 'Server connection failed', icon: 'error' });
        }
    }

    window.openToothModal = openToothModal;
    window.onToothClick = onToothClick;
    window.toggleMultiUnit = toggleMultiUnit;
    window.clearMultiSelection = clearMultiSelection;
    window.openMultiUnitModal = openMultiUnitModal;
    window.removePendingRecord = removePendingRecord;
    window.removePendingGroup = removePendingGroup;
    window.getGroupTeeth = getGroupTeeth;
    window.groupRangeLabel = groupRangeLabel;

    // ============================================================
    // ⭐ Tooth Hover Tooltip
    // ============================================================
    const toothTooltipEl = document.getElementById('toothTooltip');

    function buildTooltipContent(num) {
        const records = getPendingForTooth(num);
        const pending = records.length ? records[records.length - 1] : null;
        let statusText, diagnosisText, notesText, isPending = false, extraCount = 0;

        if (pending) {
            isPending = true;
            statusText = STATUS_ID_TO_LABEL_TT[pending.Status] || '-';
            diagnosisText = pending.DiagnosisName || null;
            notesText = pending.DiagnosisNotes || pending.Notes || null;
            extraCount = records.length - 1;
        } else {
            const info = window.toothInfoMap ? window.toothInfoMap[num] : null;
            if (!info) return null;
            statusText = info.status || '-';
            diagnosisText = info.diagnosis || null;
            notesText = info.notes || null;
        }

        let html = `<div class="tt-title"><i class="bi bi-grid-3x3-gap"></i> ${toothLabelJs(num)} <span class="tt-num">FDI ${num}</span>`;
        if (isPending) html += `<span class="tt-pending-tag">Pending</span>`;
        html += `</div>`;

        html += `<div class="tt-row"><span>Status</span><b>${statusText}</b></div>`;
        if (diagnosisText) html += `<div class="tt-row"><span>Diagnosis</span><b>${diagnosisText}</b></div>`;
        if (pending && pending.GroupId) {
            const g = getGroupTeeth(pending.GroupId);
            html += `<div class="tt-row"><span>Units</span><b class="tt-units">${g.length} · ${groupRangeLabel(g)}</b></div>`;
        }
        if (extraCount > 0) html += `<div class="tt-row"><span>Records</span><b>${records.length} entries</b></div>`;
        if (notesText) html += `<div class="tt-row tt-notes-row"><span>Notes</span><span>${notesText}</span></div>`;
        if (!diagnosisText && !notesText) html += `<div class="tt-empty">No diagnosis or notes recorded</div>`;

        return html;
    }

    function positionTooltip(evt) {
        if (!toothTooltipEl || !evt) return;
        const offset = 14;
        let x = evt.clientX + offset;
        let y = evt.clientY + offset;
        const rect = toothTooltipEl.getBoundingClientRect();
        if (x + rect.width > window.innerWidth - 10) x = evt.clientX - rect.width - offset;
        if (y + rect.height > window.innerHeight - 10) y = evt.clientY - rect.height - offset;
        toothTooltipEl.style.left = x + 'px';
        toothTooltipEl.style.top = y + 'px';
    }

    function showToothTooltip(num, evt) {
        if (!toothTooltipEl) return;
        const content = buildTooltipContent(num);
        if (!content) { toothTooltipEl.classList.remove('show'); return; }
        toothTooltipEl.innerHTML = content;
        toothTooltipEl.classList.add('show');
        positionTooltip(evt);
    }

    function hideToothTooltip() {
        if (toothTooltipEl) toothTooltipEl.classList.remove('show');
    }

    if (toothTooltipEl && toothTooltipEl.parentElement !== document.body) {
        document.body.appendChild(toothTooltipEl);
    }

    const chartCanvasEl = document.getElementById('chartCanvas');
    let lastHoveredTooth = null;

    if (chartCanvasEl) {
        chartCanvasEl.addEventListener('mousemove', function(e) {
            const box = e.target.closest('.tooth-box');
            if (!box) {
                if (lastHoveredTooth !== null) { hideToothTooltip(); lastHoveredTooth = null; }
                return;
            }
            lastHoveredTooth = parseInt(box.getAttribute('data-tooth'));
            showToothTooltip(lastHoveredTooth, e);
        });
        chartCanvasEl.addEventListener('mouseleave', function() {
            lastHoveredTooth = null;
            hideToothTooltip();
        });
    }
</script>
