            font-size: .68rem;
        }

        .tooth-tooltip .tt-pending-tag {
            color: #fbbf24;
            font-size: .65rem;
            font-weight: 700;
            background: rgba(251,191,36,0.15);
            padding: 1px 7px;
            border-radius: 999px;
        }

        .tooth-tooltip .tt-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
