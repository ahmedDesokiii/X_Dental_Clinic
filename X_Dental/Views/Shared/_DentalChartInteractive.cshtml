@model Dental.Modules.Clinical.ViewModels.SessionViewModel
@using Dental.Models.Patient
@using System.Linq

@{
    string StatusClass(ToothStatus s) => s.ToString().ToLower();
    ToothStatus GetStatus(int num) => Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == num)?.Status ?? ToothStatus.Healthy;
}

<div class="dental-chart-shell">
    <div class="page" style="max-width:820px;margin:0 auto;">

        <!-- Hero -->
        <div class="hero">
            <div class="hero-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8">
                    <path d="M12 3c-2.4 0-3.6 1.3-4.8 1.3-1.6 0-2.7-1-3.5-.4-.9.7-.7 2.4-.4 3.9.4 2.2 1.1 6.6 2 9.3.5 1.5 1 2.9 2.1 2.9 1.4 0 1.4-3 2.6-3s1.2 3 2.6 3c1.1 0 1.6-1.4 2.1-2.9.9-2.7 1.6-7.1 2-9.3.3-1.5.5-3.2-.4-3.9-.8-.6-1.9.4-3.5.4C15.6 4.3 14.4 3 12 3Z" />
                </svg>
            </div>
            <div>
                <h1>مخطط الأسنان التفاعلي</h1>
                <p>اضغط على أي سن لتسجيل حالته وإجراءاته</p>
            </div>
        </div>

        <div class="chart-card">
            <!-- Toolbar -->
            <div class="toolbar">
                <div class="legend">
                    <span class="legend-item"><span class="dot healthy"></span> سليم</span>
                    <span class="legend-item"><span class="dot decayed"></span> تسوس</span>
                    <span class="legend-item"><span class="dot treated"></span> معالج</span>
                    <span class="legend-item"><span class="dot missing"></span> مفقود</span>
                    <span class="legend-item"><span class="dot extracted"></span> مخلوع</span>
                    <span class="legend-item"><span class="dot rootcanal"></span> عصب</span>
                    <span class="legend-item"><span class="dot crown"></span> تاج</span>
                    <span class="legend-item"><span class="dot implant"></span> زرعة</span>
                </div>
                <button class="btn-save" id="saveBtn" onclick="saveChart()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.4"><path d="M20 6 9 17l-5-5" /></svg>
                    حفظ الرسمة
                </button>
            </div>

            <!-- Stage -->
            <div class="stage" id="stage">
                <svg class="bg-arcs" viewBox="0 0 620 632" preserveAspectRatio="xMidYMid meet">
                    <defs>
                        <linearGradient id="gumUpper" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#f8d3ca" />
                            <stop offset="100%" stop-color="#f2b6a8" />
                        </linearGradient>
                        <linearGradient id="gumLower" x1="0" y1="1" x2="0" y2="0">
                            <stop offset="0%" stop-color="#f8d3ca" />
                            <stop offset="100%" stop-color="#f2b6a8" />
                        </linearGradient>
                    </defs>
                    <path id="upperArchPath" fill="url(#gumUpper)" opacity="0"></path>
                    <path id="lowerArchPath" fill="url(#gumLower)" opacity="0"></path>
                </svg>

                <div class="arch-caption" style="top:2%;">الفك العلوي</div>
                <div class="arch-caption" style="bottom:2%;">الفك السفلي</div>

                <div class="center-mark">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M12 3c-2.4 0-3.6 1.3-4.8 1.3-1.6 0-2.7-1-3.5-.4-.9.7-.7 2.4-.4 3.9.4 2.2 1.1 6.6 2 9.3.5 1.5 1 2.9 2.1 2.9 1.4 0 1.4-3 2.6-3s1.2 3 2.6 3c1.1 0 1.6-1.4 2.1-2.9.9-2.7 1.6-7.1 2-9.3.3-1.5.5-3.2-.4-3.9-.8-.6-1.9.4-3.5.4C15.6 4.3 14.4 3 12 3Z" />
                    </svg>
                </div>

                <!-- Upper Right 11-18 -->
                @for (int i = 0; i < 8; i++)
                {
                    int num = 1 + i;
                    var st = GetStatus(num);
                    <div class="tooth-node" data-tooth="@num" data-status="@StatusClass(st)" data-arch="upper" data-index="@i">
                        <div class="tooth-shape @StatusClass(st)"></div>
                    </div>
                    <div class="badge @StatusClass(st)" data-badge-for="@num" data-arch="upper" data-index="@i">@num</div>
                }
                <!-- Upper Left 21-28 -->
                @for (int i = 0; i < 8; i++)
                {
                    int num = 1 + i;
                    var st = GetStatus(num);
                    <div class="tooth-node" data-tooth="@num" data-status="@StatusClass(st)" data-arch="upper" data-index="@(8 + i)">
                        <div class="tooth-shape @StatusClass(st)"></div>
                    </div>
                    <div class="badge @StatusClass(st)" data-badge-for="@num" data-arch="upper" data-index="@(8 + i)">@num</div>
                }
                <!-- Lower Right 41-48 -->
                @for (int i = 0; i < 8; i++)
                {
                    int num = 1 + i;
                    var st = GetStatus(num);
                    <div class="tooth-node" data-tooth="@num" data-status="@StatusClass(st)" data-arch="lower" data-index="@i">
                        <div class="tooth-shape @StatusClass(st)"></div>
                    </div>
                    <div class="badge @StatusClass(st)" data-badge-for="@num" data-arch="lower" data-index="@i">@num</div>
                }
                <!-- Lower Left 31-38 -->
                @for (int i = 0; i < 8; i++)
                {
                    int num = 31 + i;
                    var st = GetStatus(num);
                    <div class="tooth-node" data-tooth="@num" data-status="@StatusClass(st)" data-arch="lower" data-index="@(8 + i)">
                        <div class="tooth-shape @StatusClass(st)"></div>
                    </div>
                    <div class="badge @StatusClass(st)" data-badge-for="@num" data-arch="lower" data-index="@(8 + i)">@num</div>
                }
            </div>
        </div>

        <div class="footnote" style="text-align:center;font-size:.72rem;color:var(--ink-600);margin-top:14px;opacity:.75;">
            اضغط على السن لتعديل حالته — ثم اضغط حفظ الرسمة
        </div>
    </div>
</div>

<!-- Modal -->
<div class="overlay" id="overlay">
    <div class="modal">
        <div class="modal-head">
            <h3><i class="bi bi-grid-3x3-gap"></i> تفاصيل السن <span id="toothNumLabel"></span></h3>
            <button id="closeModal">✕</button>
        </div>
        <div class="modal-body">
            <div class="field">
                <label>حالة السن</label>
                <select id="toothStatus">
                    <option value="1">سليم</option>
                    <option value="2">تسوس</option>
                    <option value="3">معالج</option>
                    <option value="4">مفقود</option>
                    <option value="5">مخلوع</option>
                    <option value="6">مطمور</option>
                    <option value="7">تاج</option>
                    <option value="8">جسر</option>
                    <option value="9">زرعة</option>
                    <option value="10">مكسور</option>
                    <option value="11">عصب</option>
                    <option value="12">حشوة</option>
                </select>
            </div>
            <div class="field">
                <label>السطوح المتأثرة</label>
                <div class="surface-picker" id="surfacePicker">
                    <div class="surf" data-s="M">M</div>
                    <div class="surf" data-s="D">D</div>
                    <div class="surf" data-s="B">B</div>
                    <div class="surf" data-s="L">L</div>
                    <div class="surf" data-s="O">O</div>
                </div>
            </div>
            <div class="field">
                <label>كود الإجراء</label>
                <input type="text" id="toothProcedure" placeholder="مثال: RCT, CRN, FLL" />
            </div>
            <div class="field">
                <label>ملاحظات</label>
                <textarea id="toothNotes" rows="2" placeholder="اكتب ملاحظة..."></textarea>
            </div>
        </div>
        <div class="modal-foot">
            <button class="btn btn-cancel" id="cancelBtn">إلغاء</button>
            <button class="btn btn-apply" id="applyBtn">تطبيق</button>
        </div>
    </div>
</div>

<style>
    :root {
        --sky-50: #eafbfc;
        --sky-100: #dcf5f7;
        --teal-900: #0a4d4f;
        --teal-700: #0d7377;
        --teal-600: #0f9b8e;
        --teal-500: #14b8a6;
        --teal-400: #4fd8c6;
        --teal-100: #c7f2ea;
        --coral-300: #f6c6bc;
        --coral-500: #eb9483;
        --ink-900: #0b2e30;
        --ink-600: #4b6b6c;
        --white: #ffffff;
        --st-healthy: #ffffff;
        --st-healthy-line: #0f9b8e;
        --st-decayed: #ef4444;
        --st-treated: #3b82f6;
        --st-missing: #cbd5e1;
        --st-extracted: #334155;
        --st-rootcanal: #f59e0b;
        --st-crown: #a855f7;
        --st-implant: #ec4899;
    }

    .dental-chart-shell * {
        box-sizing: border-box;
    }

    .dental-chart-shell {
        font-family: 'Cairo',sans-serif;
        background: radial-gradient(circle at 8% 6%, var(--teal-100) 0%, transparent 42%), radial-gradient(circle at 96% 90%, var(--coral-300) 0%, transparent 30%), var(--sky-50);
        min-height: 100vh;
        padding: 32px 16px;
        color: var(--ink-900);
    }

    .hero {
        display: flex;
        align-items: center;
        gap: 14px;
        background: linear-gradient(135deg,var(--teal-700),var(--teal-500));
        padding: 20px 24px;
        border-radius: 22px;
        color: #fff;
        box-shadow: 0 14px 34px rgba(13,115,119,.28);
        margin-bottom: 18px;
        position: relative;
        overflow: hidden;
    }

        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 90% -20%, rgba(255,255,255,.35), transparent 55%);
        }

    .hero-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        backdrop-filter: blur(6px);
    }

        .hero-icon svg {
            width: 26px;
            height: 26px;
        }

    .hero h1 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .hero p {
        margin: 2px 0 0;
        font-size: .82rem;
        opacity: .9;
        font-weight: 600;
    }

    .chart-card {
        background: rgba(255,255,255,.75);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 26px;
        padding: 22px;
        box-shadow: 0 20px 50px rgba(10,77,79,.1);
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 16px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .76rem;
        font-weight: 700;
        color: var(--ink-600);
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px rgba(0,0,0,.08);
    }

        .dot.healthy {
            background: var(--st-healthy);
            box-shadow: 0 0 0 1px var(--st-healthy-line);
        }

        .dot.decayed {
            background: var(--st-decayed);
        }

        .dot.treated {
            background: var(--st-treated);
        }

        .dot.missing {
            background: var(--st-missing);
        }

        .dot.extracted {
            background: var(--st-extracted);
        }

        .dot.rootcanal {
            background: var(--st-rootcanal);
        }

        .dot.crown {
            background: var(--st-crown);
        }

        .dot.implant {
            background: var(--st-implant);
        }

    .btn-save {
        border: none;
        cursor: pointer;
        background: linear-gradient(135deg,var(--teal-600),var(--teal-700));
        color: #fff;
        font-weight: 800;
        font-size: .82rem;
        padding: 10px 18px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 20px rgba(13,148,136,.32);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(13,148,136,.4);
        }

        .btn-save:active {
            transform: translateY(0);
        }

    .stage {
        position: relative;
        width: 100%;
        max-width: 620px;
        margin: 10px auto 4px;
        aspect-ratio: 1/1.02;
    }

        .stage svg.bg-arcs {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

    .tooth-node {
        position: absolute;
        width: 40px;
        height: 40px;
        transform: translate(-50%,-50%) scale(0);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: popIn .55s cubic-bezier(.2,1.4,.4,1) forwards;
        animation-delay: var(--d);
        cursor: pointer;
    }

    @@keyframes popIn {
        to {
            transform: translate(-50%,-50%) scale(1);
        }
    }

    .tooth-shape {
        width: 100%;
        height: 100%;
        border-radius: 12px 12px 16px 16px;
        background: var(--st-healthy);
        border: 2.5px solid var(--st-healthy-line);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: transform .22s cubic-bezier(.3,1.5,.4,1), box-shadow .22s ease, border-color .22s ease;
        box-shadow: 0 3px 8px rgba(10,77,79,.12);
    }

    .tooth-node:hover .tooth-shape {
        transform: scale(1.22) translateY(-3px);
        box-shadow: 0 10px 22px rgba(10,77,79,.25);
        z-index: 5;
    }

    .tooth-node.selected .tooth-shape {
        transform: scale(1.28) translateY(-4px);
        box-shadow: 0 0 0 4px rgba(15,155,142,.25), 0 12px 24px rgba(10,77,79,.3);
        z-index: 6;
    }

    .tooth-shape.decayed {
        background: #fee2e2;
        border-color: var(--st-decayed);
    }

    .tooth-shape.treated {
        background: #dbeafe;
        border-color: var(--st-treated);
    }

    .tooth-shape.missing {
        background: transparent;
        border: 2.5px dashed var(--st-missing);
        box-shadow: none;
    }

    .tooth-shape.extracted {
        background: var(--st-extracted);
        border-color: var(--st-extracted);
    }

        .tooth-shape.extracted::before, .tooth-shape.extracted::after {
            content: '';
            position: absolute;
            width: 60%;
            height: 2px;
            background: #fca5a5;
            top: 50%;
            left: 20%;
        }

        .tooth-shape.extracted::before {
            transform: rotate(45deg);
        }

        .tooth-shape.extracted::after {
            transform: rotate(-45deg);
        }

    .tooth-shape.rootcanal {
        background: #fef3c7;
        border-color: var(--st-rootcanal);
    }

    .tooth-shape.crown {
        background: #f3e8ff;
        border-color: var(--st-crown);
    }

    .tooth-shape.implant {
        background: #fce7f3;
        border-color: var(--st-implant);
    }

    .tooth-shape.fractured {
        background: #ffedd5;
        border-color: #fdba74;
    }

    .tooth-shape.filling {
        background: #ccfbf1;
        border-color: #5eead4;
    }

    .tooth-shape.impacted {
        background: #e0e7ff;
        border-color: #6366f1;
    }

    .tooth-shape.bridge {
        background: #fef9c3;
        border-color: #eab308;
    }

    .badge {
        position: absolute;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--teal-600);
        color: #fff;
        font-size: .68rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(10,77,79,.25);
        border: 2px solid #fff;
        transform: translate(-50%,-50%) scale(0);
        animation: popIn .5s cubic-bezier(.2,1.4,.4,1) forwards;
        animation-delay: var(--d);
        z-index: 4;
    }

        .badge.decayed {
            background: var(--st-decayed);
        }

        .badge.treated {
            background: var(--st-treated);
        }

        .badge.missing {
            background: #94a3b8;
        }

        .badge.extracted {
            background: var(--st-extracted);
        }

        .badge.rootcanal {
            background: var(--st-rootcanal);
        }

        .badge.crown {
            background: var(--st-crown);
        }

        .badge.implant {
            background: var(--st-implant);
        }

        .badge.fractured {
            background: #fdba74;
        }

        .badge.filling {
            background: #5eead4;
            color: #0f766e;
        }

        .badge.impacted {
            background: #6366f1;
        }

        .badge.bridge {
            background: #eab308;
            color: #713f12;
        }

    .center-mark {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 54px;
        height: 54px;
        transform: translate(-50%,-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle,rgba(255,255,255,.9),rgba(255,255,255,.4));
        box-shadow: 0 0 0 8px rgba(15,155,142,.06);
        animation: breathe 3.2s ease-in-out infinite;
    }

        .center-mark svg {
            width: 26px;
            height: 26px;
            color: var(--teal-600);
        }

    @@keyframes breathe {
        0%, 100% {
            box-shadow: 0 0 0 8px rgba(15,155,142,.06);
        }

        50% {
            box-shadow: 0 0 0 14px rgba(15,155,142,.12);
        }
    }

    .arch-caption {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-size: .7rem;
        font-weight: 800;
        color: var(--teal-700);
        letter-spacing: .5px;
        background: rgba(255,255,255,.7);
        padding: 3px 12px;
        border-radius: 20px;
    }

    .overlay {
        position: fixed;
        inset: 0;
        background: rgba(10,40,42,.45);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: opacity .25s ease, visibility .25s ease;
    }

        .overlay.show {
            opacity: 1;
            visibility: visible;
        }

    .modal {
        width: 100%;
        max-width: 420px;
        margin: 16px;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0,0,0,.3);
        transform: translateY(24px) scale(.96);
        opacity: 0;
        transition: transform .35s cubic-bezier(.2,1.2,.3,1), opacity .35s ease;
    }

    .overlay.show .modal {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    .modal-head {
        padding: 18px 22px;
        color: #fff;
        background: linear-gradient(135deg,var(--teal-600),var(--teal-700));
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-head h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 800;
        }

        .modal-head button {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            border: none;
            background: rgba(255,255,255,.2);
            color: #fff;
            cursor: pointer;
            font-size: 1rem;
        }

    .modal-body {
        padding: 20px 22px;
    }

    .field {
        margin-bottom: 14px;
    }

        .field label {
            display: block;
            font-size: .78rem;
            font-weight: 800;
            color: var(--ink-600);
            margin-bottom: 6px;
        }

        .field select, .field input, .field textarea {
            width: 100%;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1.5px solid var(--sky-100);
            font-family: 'Cairo',sans-serif;
            font-size: .9rem;
            outline: none;
            background: var(--sky-50);
            transition: border-color .2s, box-shadow .2s;
        }

            .field select:focus, .field input:focus, .field textarea:focus {
                border-color: var(--teal-500);
                box-shadow: 0 0 0 3px rgba(15,155,142,.15);
            }

    .surface-picker {
        display: flex;
        gap: 6px;
    }

    .surf {
        flex: 1;
        text-align: center;
        padding: 9px 0;
        border-radius: 10px;
        font-weight: 800;
        font-size: .82rem;
        border: 2px solid var(--sky-100);
        color: var(--ink-600);
        cursor: pointer;
        transition: .2s;
    }

        .surf.on {
            background: linear-gradient(135deg,var(--teal-600),var(--teal-700));
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(15,155,142,.3);
        }

    .modal-foot {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        padding: 14px 22px;
        border-top: 1px solid var(--sky-100);
    }

    .btn {
        border: none;
        padding: 9px 18px;
        border-radius: 10px;
        font-weight: 800;
        font-size: .82rem;
        cursor: pointer;
        font-family: 'Cairo',sans-serif;
    }

    .btn-cancel {
        background: var(--sky-100);
        color: var(--ink-600);
    }

    .btn-apply {
        background: linear-gradient(135deg,var(--teal-600),var(--teal-700));
        color: #fff;
        box-shadow: 0 6px 16px rgba(15,155,142,.3);
    }

    @@media (max-width: 768px) {
        .stage {
            aspect-ratio: 1/1.15;
        }

        .tooth-node {
            width: 34px;
            height: 34px;
        }

        .badge {
            width: 20px;
            height: 20px;
            font-size: .6rem;
        }
    }
</style>

<script>
    /* ---------- geometry ---------- */
    const VB_W = 620, VB_H = 632;
    const cx = 310;
    const upper = { cy: 220, rx: 250, ry: 150 };
    const lower = { cy: 412, rx: 250, ry: 150 };
    const N = 16;
    const spread = 132;

    function archPoint(cfg, angleDeg, radiusScale){
        const rad = angleDeg * Math.PI / 180;
        return {
            x: cx + cfg.rx * radiusScale * Math.cos(rad),
            y: cfg.cy + cfg.ry * radiusScale * Math.sin(rad)
        };
    }

    function buildArchAngles(centerAngle){
        const start = centerAngle + spread/2;
        const end   = centerAngle - spread/2;
        const angles = [];
        for(let i=0;i<N;i++){
            const t = i/(N-1);
            angles.push(start + (end-start)*t);
        }
        return angles;
    }

    const upperAngles = buildArchAngles(270);
    const lowerAngles = buildArchAngles(90);

    function pctFromViewBox(x,y){
        return { left: (x/VB_W*100)+'%', top: (y/VB_H*100)+'%' };
    }

    function makeArchPath(cfg, centerAngle){
        const startA = (centerAngle + spread/2 + 14) * Math.PI/180;
        const endA   = (centerAngle - spread/2 - 14) * Math.PI/180;
        const rxOuter = cfg.rx + 40, ryOuter = cfg.ry + 40;
        const rxInner = cfg.rx - 34, ryInner = cfg.ry - 34;
        const p = (rx,ry,a)=>({x:cx+rx*Math.cos(a), y:cfg.cy+ry*Math.sin(a)});
        const o1 = p(rxOuter,ryOuter,startA);
        const o2 = p(rxOuter,ryOuter,endA);
        const i1 = p(rxInner,ryInner,endA);
        const i2 = p(rxInner,ryInner,startA);
        return `M ${o1.x} ${o1.y} A ${rxOuter} ${ryOuter} 0 0 ${centerAngle===270?1:1} ${o2.x} ${o2.y}
                L ${i1.x} ${i1.y} A ${rxInner} ${ryInner} 0 0 ${centerAngle===270?0:0} ${i2.x} ${i2.y} Z`;
    }

    document.getElementById('upperArchPath').setAttribute('d', makeArchPath(upper,270));
    document.getElementById('lowerArchPath').setAttribute('d', makeArchPath(lower,90));
    document.getElementById('upperArchPath').style.transition = 'opacity .8s ease';
    document.getElementById('lowerArchPath').style.transition = 'opacity .8s ease';
    requestAnimationFrame(()=>{
        setTimeout(()=>{
            document.getElementById('upperArchPath').style.opacity = 1;
            document.getElementById('lowerArchPath').style.opacity = 1;
        }, 80);
    });

    function positionArchElements(archName, cfg, angles){
        const nodes = document.querySelectorAll(`.tooth-node[data-arch="${archName}"]`);
        const badges = document.querySelectorAll(`.badge[data-arch="${archName}"]`);
        nodes.forEach((node, idx)=>{
            const angle = angles[idx];
            const pt = archPoint(cfg, angle, 1);
            const pos = pctFromViewBox(pt.x, pt.y);
            node.style.left = pos.left;
            node.style.top = pos.top;
            node.style.setProperty('--d', (idx*0.045).toFixed(3)+'s');
        });
        badges.forEach((badge, idx)=>{
            const angle = angles[idx];
            const pt = archPoint(cfg, angle, 1.22);
            const pos = pctFromViewBox(pt.x, pt.y);
            badge.style.left = pos.left;
            badge.style.top = pos.top;
            badge.style.setProperty('--d', (idx*0.045+0.08).toFixed(3)+'s');
        });
    }

    positionArchElements('upper', upper, upperAngles);
    positionArchElements('lower', lower, lowerAngles);

    /* ---------- modal / interaction ---------- */
    const overlay = document.getElementById('overlay');
    const toothNumLabel = document.getElementById('toothNumLabel');
    const statusSelect = document.getElementById('toothStatus');
    const toothProcedure = document.getElementById('toothProcedure');
    const toothNotes = document.getElementById('toothNotes');
    let activeNode = null;
    let selectedToothId = null;
    let chartData = [];

    const statusToId = {
        'healthy':1,'decayed':2,'treated':3,'missing':4,'extracted':5,
        'impacted':6,'crown':7,'bridge':8,'implant':9,'fractured':10,'rootcanal':11,'filling':12
    };
    const idToStatus = Object.fromEntries(Object.entries(statusToId).map(([k,v])=>[v,k]));

    function openModal(num, node){
        if(activeNode) activeNode.classList.remove('selected');
        activeNode = node;
        node.classList.add('selected');
        selectedToothId = num;
        toothNumLabel.textContent = '#'+num;

        const shape = node.querySelector('.tooth-shape');
        const currentClass = [...shape.classList].find(c=>c!=='tooth-shape') || 'healthy';
        statusSelect.value = statusToId[currentClass] || 1;

        // Reset surfaces
        document.querySelectorAll('.surf').forEach(s=>s.classList.remove('on'));
        toothProcedure.value = '';
        toothNotes.value = '';

        overlay.classList.add('show');
    }

    function closeModal(){
        overlay.classList.remove('show');
        if(activeNode){ activeNode.classList.remove('selected'); activeNode=null; }
        selectedToothId = null;
    }

    document.getElementById('closeModal').onclick = closeModal;
    document.getElementById('cancelBtn').onclick = closeModal;
    overlay.addEventListener('click', e=>{ if(e.target===overlay) closeModal(); });

    document.querySelectorAll('.surf').forEach(s=>{
        s.addEventListener('click', ()=> s.classList.toggle('on'));
    });

    document.getElementById('applyBtn').onclick = ()=>{
        if(!activeNode || !selectedToothId) return;
        const shape = activeNode.querySelector('.tooth-shape');
        const statusVal = parseInt(statusSelect.value);
        const statusName = idToStatus[statusVal] || 'healthy';

        // Update visual
        shape.className = 'tooth-shape ' + statusName;
        const badge = document.querySelector(`.badge[data-badge-for="${selectedToothId}"]`);
        if(badge){
            badge.className = 'badge ' + statusName;
        }

        // Collect data
        const surfaces = Array.from(document.querySelectorAll('.surf.on')).map(s=>s.dataset.s);
        const proc = toothProcedure.value.trim();
        const notes = toothNotes.value.trim();

        // Remove existing entry for this tooth if any
        chartData = chartData.filter(d => d.Number !== selectedToothId);
        chartData.push({
            Number: selectedToothId,
            Status: statusVal,
            Surfaces: surfaces.map(s => ({ Surface: s, Condition: 'Treated' })),
            ProcedureCode: proc,
            Notes: notes
        });

        closeModal();
    };

    async function saveChart(){
        if(chartData.length === 0){
            if(typeof Swal !== 'undefined'){
                Swal.fire({ title: 'تنبيه', text: 'لم يتم إجراء تغييرات', icon: 'warning', confirmButtonColor: '#0d9488' });
            } else {
                alert('لم يتم إجراء تغييرات');
            }
            return;
        }
        const payload = {
            PatientId: @Model.Patient.Id,
            VisitId: @Model.Visit.Id,
            Teeth: chartData
        };
        const res = await fetch('/Clinical/SaveDentalChart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        if(res.ok){
            if(typeof Swal !== 'undefined'){
                Swal.fire({ title: 'تم', text: 'تم حفظ رسمة الأسنان', icon: 'success', timer: 1500, showConfirmButton: false });
            } else {
                alert('تم حفظ رسمة الأسنان');
            }
            chartData = [];
            const btn = document.getElementById('saveBtn');
            const original = btn.innerHTML;
            btn.innerHTML = 'تم الحفظ ✓';
            btn.style.background = 'linear-gradient(135deg,#14b8a6,#0f9b8e)';
            setTimeout(()=>{ btn.innerHTML = original; btn.style.background = ''; }, 1400);
        }
    }

    // Bind click events to teeth
    document.querySelectorAll('.tooth-node').forEach(node=>{
        node.addEventListener('click', ()=>{
            const num = parseInt(node.dataset.tooth);
            openModal(num, node);
        });
    });
</script>