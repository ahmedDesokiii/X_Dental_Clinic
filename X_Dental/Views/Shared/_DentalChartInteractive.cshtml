@model Dental.Modules.Clinical.ViewModels.SessionViewModel
@await Html.PartialAsync("_DentalArchStyles")

@functions {
    // ⭐ الترقيم الجديد: 28→UR-8, 15→UL-5 (Q1=UL, Q2=UR, Q3=LL, Q4=LR)
    string TLabel(int n) => (n / 10) switch
    {
        1 => $"UL-{n % 10}",
        2 => $"UR-{n % 10}",
        3 => $"LL-{n % 10}",
        4 => $"LR-{n % 10}",
        _ => n.ToString()
    };
}

<style>
    .chart-shell {
        position: relative;
    }

    .quadrant-badge {
        position: absolute;
        font-size: .72rem;
        font-weight: 800;
        color: #0d7377;
        background: #f0fdfa;
        border: 1px solid #ccf3ec;
        border-radius: 8px;
        padding: 3px 8px;
        z-index: 5;
    }

        .quadrant-badge.ur {
            top: 8px;
            left: 8px;
        }

        .quadrant-badge.ul {
            top: 8px;
            right: 8px;
        }

        .quadrant-badge.lr {
            bottom: 8px;
            left: 8px;
        }

        .quadrant-badge.ll {
            bottom: 8px;
            right: 8px;
        }

    .quadrant-divider-v {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 0;
        border-left: 1px dashed rgba(13,115,119,.25);
        z-index: 1;
    }

    .quadrant-divider-h {
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 0;
        border-top: 1px dashed rgba(13,115,119,.25);
        z-index: 1;
    }

    .pending-flag {
        position: absolute;
        top: -5px;
        left: -5px;
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: #fff;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .55rem;
        box-shadow: 0 3px 8px rgba(245,158,11,.4);
        z-index: 30;
        animation: badgePop 0.4s ease;
    }

    /* ⭐ tooth pop-in stagger */
    @@keyframes toothPopIn {
        from {
            opacity: 0;
            transform: scale(.3) translateY(8px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .tooth-box {
        animation: toothPopIn .5s cubic-bezier(.2,1.5,.4,1) backwards;
    }

    /* ⭐ glow on selected */
    @@keyframes selGlow {
        0%, 100% {
            filter: drop-shadow(0 0 6px rgba(13,148,136,.55));
        }

        50% {
            filter: drop-shadow(0 0 16px rgba(13,148,136,.9));
        }
    }

    .tooth-box.selected {
        animation: selGlow 1.2s ease-in-out infinite;
        z-index: 20;
    }

    .tooth-tooltip {
        position: fixed;
        z-index: 3000;
        background: #0b2e30;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: .78rem;
        line-height: 1.6;
        max-width: 250px;
        min-width: 150px;
        box-shadow: 0 14px 34px rgba(0,0,0,0.28);
        pointer-events: none;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity .15s ease, transform .15s ease;
    }

        .tooth-tooltip.show {
            opacity: 1;
            transform: translateY(0);
        }

        .tooth-tooltip .tt-title {
            font-weight: 800;
            font-size: .82rem;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #5eead4;
            border-bottom: 1px solid rgba(255,255,255,0.12);
            padding-bottom: 6px;
        }

        .tooth-tooltip .tt-num {
            color: #94a3b8;
