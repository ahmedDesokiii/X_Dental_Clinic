@model Dental.Modules.Clinical.ViewModels.SessionViewModel
@await Html.PartialAsync("_DentalArchStyles")

<style>
    .chart-shell {
        position: relative;
    }

    .quadrant-badge {
        position: absolute;
        font-size: .72rem;
        font-weight: 800;
        color: #0d7377;
        background: #f0fdfa;
        border: 1px solid #ccf3ec;
        border-radius: 8px;
        padding: 3px 8px;
        z-index: 5;
    }

        .quadrant-badge.ur {
            top: 8px;
            left: 8px;
        }

        .quadrant-badge.ul {
            top: 8px;
            right: 8px;
        }

        .quadrant-badge.lr {
            bottom: 8px;
            left: 8px;
        }

        .quadrant-badge.ll {
            bottom: 8px;
            right: 8px;
        }

    .quadrant-divider-v {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 0;
        border-left: 1px dashed rgba(13,115,119,.25);
        z-index: 1;
    }

    .quadrant-divider-h {
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 0;
        border-top: 1px dashed rgba(13,115,119,.25);
        z-index: 1;
    }

    .pending-flag {
        position: absolute;
        top: -5px;
        left: -5px;
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: #fff;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .55rem;
        box-shadow: 0 3px 8px rgba(245,158,11,.4);
        z-index: 30;
        animation: badgePop 0.4s ease;
    }

    /* ====== Tooth Hover Tooltip ====== */
    .tooth-tooltip {
        position: fixed;
        z-index: 3000;
        background: #0b2e30;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: .78rem;
        line-height: 1.6;
        max-width: 230px;
        min-width: 140px;
        box-shadow: 0 14px 34px rgba(0,0,0,0.28);
        pointer-events: none;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity .15s ease, transform .15s ease;
    }

        .tooth-tooltip.show {
            opacity: 1;
            transform: translateY(0);
        }

        .tooth-tooltip .tt-title {
            font-weight: 800;
            font-size: .82rem;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #5eead4;
            border-bottom: 1px solid rgba(255,255,255,0.12);
            padding-bottom: 6px;
        }

        .tooth-tooltip .tt-pending-tag {
            color: #fbbf24;
            font-size: .65rem;
            font-weight: 700;
            background: rgba(251,191,36,0.15);
            padding: 1px 7px;
            border-radius: 999px;
        }

        .tooth-tooltip .tt-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            padding: 2px 0;
        }

            .tooth-tooltip .tt-row span:first-child {
                color: #94a3b8;
                flex-shrink: 0;
            }

            .tooth-tooltip .tt-row b {
                color: #fff;
                font-weight: 700;
                text-align: left;
            }

        .tooth-tooltip .tt-notes-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
            margin-top: 2px;
        }

            .tooth-tooltip .tt-notes-row span {
                color: #e2e8f0;
                font-weight: 500;
            }

        .tooth-tooltip .tt-empty {
            color: #94a3b8;
            font-style: italic;
            font-size: .74rem;
        }

    .diagnosis-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .diagnosis-row select {
            flex: 1 1 auto;
            min-width: 0;
        }

    .diagnosis-price-badge {
        flex-shrink: 0;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        color: #fff;
        font-weight: 800;
        font-size: .82rem;
        padding: 8px 14px;
        border-radius: 10px;
        white-space: nowrap;
        transition: transform .15s ease;
        min-width: 80px;
        text-align: center;
    }

        .diagnosis-price-badge.updated {
            animation: priceBadgePulse .35s ease;
        }

    @@keyframes priceBadgePulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }

        100% {
            transform: scale(1);
        }
    }

    .xray-upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 14px;
        padding: 16px;
        text-align: center;
        cursor: pointer;
        color: #94a3b8;
        font-size: .82rem;
        background: #fff;
        transition: all .2s ease;
    }

        .xray-upload-zone:hover {
            border-color: #0d9488;
            background: #f0fdfa;
            color: #0d9488;
        }

    .xray-files-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 10px;
        max-height: 200px;
        overflow-y: auto;
    }

    .xray-file-row {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        align-items: center;
        gap: 8px;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        padding: 6px 8px;
        background: #fafcfd;
        animation: fadeInUp 0.3s ease forwards;
    }

    .xray-thumb {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }

    .xray-note-input {
        padding: 7px 10px !important;
        font-size: .78rem !important;
        border: 1px solid #f1f5f9 !important;
        border-radius: 8px !important;
    }

    .xray-remove-btn {
        border: none;
        background: #fee2e2;
        color: #dc2626;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        cursor: pointer;
        flex-shrink: 0;
        transition: all .2s;
    }

        .xray-remove-btn:hover {
            background: #fecaca;
            transform: scale(1.1);
        }

    /* ====== MODAL XL — 3 Columns ====== */
    .tooth-modal {
        position: fixed;
        inset: 0;
        background: rgba(10,40,42,0.45);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1500;
        pointer-events: none;
    }

        .tooth-modal.dc-show {
            display: flex;
            pointer-events: auto;
            animation: fadeInUp 0.25s ease;
        }

    .modal-glass-xl {
        width: 100%;
        max-width: 960px;
        margin: 16px;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0,0,0,0.25);
        transform: translateY(20px) scale(0.96);
        opacity: 0;
        animation: dcModalIn 0.4s cubic-bezier(0.2,1.2,0.3,1) forwards;
        display: flex;
        flex-direction: column;
        max-height: 90vh;
    }

    @@keyframes dcModalIn {
        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    .tooth-modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px;
        background: linear-gradient(135deg, #0d9488, #0d7377);
        color: #fff;
        flex-shrink: 0;
    }

        .tooth-modal-head h5 {
            margin: 0;
            font-weight: 800;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .btn-close-modal {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: none;
        background: rgba(255,255,255,0.2);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .2s;
    }

        .btn-close-modal:hover {
            background: rgba(255,255,255,0.35);
            transform: rotate(90deg);
        }

    .tooth-modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-body-row {
        display: flex;
        gap: 20px;
    }

    .modal-col {
        flex: 1 1 0;
        min-width: 0;
    }

    .modal-col-divider {
        width: 1px;
        background: linear-gradient(180deg, transparent, #e2e8f0, transparent);
        flex-shrink: 0;
    }

    .form-group-v4 label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: #475569;
        margin-bottom: 6px;
    }

    .form-glass-v4 {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #f1f5f9;
        border-radius: 12px;
        background: #f8fafc;
        font-size: .9rem;
        outline: none;
        transition: all .2s;
    }

        .form-glass-v4:focus {
            border-color: #0d9488;
            box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
        }

    .surface-picker-v4 {
        display: flex;
        gap: 8px;
    }

    .surf-check-v4 {
        flex: 1;
        text-align: center;
        padding: 10px 0;
        border-radius: 10px;
        border: 2px solid #f1f5f9;
        background: #fff;
        font-weight: 800;
        color: #475569;
        cursor: pointer;
        transition: all .2s;
        font-size: .85rem;
    }

        .surf-check-v4:has(input:checked) {
            background: linear-gradient(135deg, #0d9488, #0d7377);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 14px rgba(13,115,119,0.25);
        }

        .surf-check-v4 input {
            display: none;
        }

    .tooth-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 24px;
        border-top: 1px solid #f0fdfa;
        background: linear-gradient(180deg, #fafcfd, #fff);
        flex-shrink: 0;
    }

    .btn-glass-v4 {
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: .85rem;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

    .btn-cancel-v4 {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-cancel-v4:hover {
            background: #e2e8f0;
        }

    .btn-save-v4 {
        background: linear-gradient(135deg, #0d9488, #0d7377);
        color: #fff;
        box-shadow: 0 6px 18px rgba(13,115,119,0.25);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-save-v4:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(13,115,119,0.35);
        }

    /* Responsive: stack columns on mobile */
    @@media (max-width: 768px) {
        .modal-body-row {
            flex-direction: column;
            gap: 16px;
        }

        .modal-col-divider {
            display: none;
        }

        .modal-glass-xl {
            margin: 8px;
            max-height: 95vh;
            border-radius: 18px;
        }

        .tooth-modal-body {
            padding: 16px;
        }

        .tooth-modal-head {
            padding: 14px 16px;
        }

        .tooth-modal-foot {
            padding: 12px 16px;
        }
    }
</style>

<div class="chart-shell">
    <div class="tooth-tooltip" id="toothTooltip"></div>

    <div class="chart-canvas" id="chartCanvas">
        <svg class="bg-arcs" viewBox="0 0 620 632" preserveAspectRatio="xMidYMid meet">
            <div class="quadrant-divider-v"></div>
            <div class="quadrant-divider-h"></div>
            <span class="quadrant-badge fs-5 ur">UR</span>
            <span class="quadrant-badge fs-5 ul">UL</span>
            <span class="quadrant-badge fs-5 lr">LR</span>
            <span class="quadrant-badge fs-5 ll">LL</span>
            <defs>
                <linearGradient id="gumUpperInt" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f8d3ca" /><stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
                <linearGradient id="gumLowerInt" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#f8d3ca" /><stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
            </defs>
            <path id="upperArchPath" fill="url(#gumUpperInt)"></path>
            <path id="lowerArchPath" fill="url(#gumLowerInt)"></path>
        </svg>

        <div class="arch-center-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2.4 0-3.6 1.3-4.8 1.3-1.6 0-2.7-1-3.5-.4-.9.7-.7 2.4-.4 3.9.4 2.2 1.1 6.6 2 9.3.5 1.5 1 2.9 2.1 2.9 1.4 0 1.4-3 2.6-3s1.2 3 2.6 3c1.1 0 1.6-1.4 2.1-2.9.9-2.7 1.6-7.1 2-9.3.3-1.5.5-3.2-.4-3.9-.8-.6-1.9.4-3.5.4C15.6 4.3 14.4 3 12 3Z" /></svg>
        </div>

        <!-- Upper Arch -->
        <div class="teeth-row upper">
            @for (int i = 11; i <= 18; i++)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" onclick="openToothModal(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                </div>
            }
            @for (int i = 21; i <= 28; i++)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" onclick="openToothModal(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                </div>
            }
        </div>

        <!-- Lower Arch -->
        <div class="teeth-row lower">
            @for (int i = 41; i <= 48; i++)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" onclick="openToothModal(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                </div>
            }
            @for (int i = 31; i <= 38; i++)
            {
                var entry = Model.DentalHistory.FirstOrDefault(d => d.ToothNumber == i);
                var status = entry?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" onclick="openToothModal(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                    <span class="pending-flag" style="display:none;"><i class="bi bi-clock-history"></i></span>
                </div>
            }
        </div>
    </div>

    <!-- Tooth Detail Modal — XL 3-Column Layout -->
    <div class="tooth-modal" id="toothModal">
        <div class="modal-overlay" onclick="closeToothModal()"></div>
        <div class="modal-glass-xl">
            <div class="tooth-modal-head">
                <h5><i class="bi bi-grid-3x3-gap"></i> تفاصيل السن <span id="selectedToothNum"></span></h5>
                <button type="button" class="btn-close-modal" onclick="closeToothModal()"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="tooth-modal-body">
                <div class="modal-body-row">
                    @* ====== Column 1: Status + Surfaces + Procedure ====== *@
                    <div class="modal-col">
                        <div class="form-group-v4 mb-3">
                            <label>حالة السن</label>
                            <select class="form-glass-v4" id="toothStatus">
                                <option value="1">سليم</option>
                                <option value="2">تسوس</option>
                                <option value="3">معالج</option>
                                <option value="4">مفقود</option>
                                <option value="5">مخلوع</option>
                                <option value="6">مطمور</option>
                                <option value="7">تاج</option>
                                <option value="8">جسر</option>
                                <option value="9">زرعة</option>
                                <option value="10">مكسور</option>
                                <option value="11">عصب</option>
                                <option value="12">حشوة</option>
                            </select>
                        </div>

                        <div class="form-group-v4 mb-3" hidden>
                            <label>السطوح المتأثرة</label>
                            <div class="surface-picker-v4">
                                <label class="surf-check-v4"><input type="checkbox" value="M" /> M</label>
                                <label class="surf-check-v4"><input type="checkbox" value="D" /> D</label>
                                <label class="surf-check-v4"><input type="checkbox" value="B" /> B</label>
                                <label class="surf-check-v4"><input type="checkbox" value="L" /> L</label>
                                <label class="surf-check-v4"><input type="checkbox" value="O" /> O</label>
                            </div>
                        </div>

                        <div class="form-group-v4 mb-0" hidden="">
                            <label>كود الإجراء</label>
                            <input type="text" class="form-glass-v4" id="toothProcedure" placeholder="مثال: RCT, CRN, FLL" />
                        </div>
                            <div class="modal-col">
                            <div class="form-group-v4 mb-3">
                                <label>التشخيص</label>
                                <div class="diagnosis-row">
                                    <select class="form-glass-v4" id="toothDiagnosis" onchange="onDiagnosisChange()">
                                        <option value="">-- اختر التشخيص --</option>
                                        @if (ViewBag.DiagnosisList != null)
                                        {
                                            @foreach (var d in (List<Dental.Models.Clinic.DiagnosisCatalog>)ViewBag.DiagnosisList)
                                            {
                                                <option value="@d.Id" data-price="@d.Price">@d.NameAr</option>
                                            }
                                        }
                                    </select>
                                    <span class="diagnosis-price-badge" id="diagnosisPriceBadge">0 م.ج</span>
                                </div>
                            </div>

                            <div class="form-group-v4 mb-0">
                                <label>ملاحظات الحالة</label>
                                <textarea class="form-glass-v4" id="diagnosisNotes" rows="5" placeholder="ملاحظات عن التشخيص/الحالة..."></textarea>
                            </div>
                        </div>
                    
                    </div>

                    <div class="modal-col-divider"></div>

                    @* ====== Column 2: Diagnosis + Price + Notes ====== *@
                    <div class="modal-col">
                        <div class="form-group-v4 mb-0">
                            <label>أشعة السن (اختياري)</label>
                            <div class="xray-upload-zone p-0" onclick="document.getElementById('toothXrayFiles').click()">
                                <input type="file" id="toothXrayFiles" accept="image/*" multiple hidden onchange="onToothXrayFilesChange(event)" />
                                <i class="bi bi-cloud-arrow-up" style="font-size:1.8rem;display:block;margin-bottom:8px;color:#0d9488;"></i>
                                <span class="mt-0" style="font-weight:700;color:#475569;">اضغط لرفع صورة أو أكثر</span>
                                <small style="display:block;margin-top:4px;color:#94a3b8;">JPG, PNG, DICOM</small>
                            </div>
                            <div id="xrayFilesList" class="xray-files-list"></div>
                        </div>
                    </div>

                    
                </div>
                @* ====== Column 3: X-Rays Upload + List ====== *@
               
            </div>
            <div class="tooth-modal-foot">
                <button type="button" class="btn-glass-v4 btn-cancel-v4" onclick="closeToothModal()">إلغاء</button>
                <button type="button" class="btn-glass-v4 btn-save-v4" onclick="applyToothChanges()">
                    <i class="bi bi-check-lg"></i> إضافة للسيشن
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var canvas = document.getElementById('chartCanvas');
        if (window.initDentalArch) window.initDentalArch(canvas);
    })();

    window.pendingToothRecords = window.pendingToothRecords || {};
    let currentToothNumber = null;
    let currentXrayFiles = [];

    const STATUS_ID_TO_CLASS = {
        1: 'healthy', 2: 'decayed', 3: 'treated', 4: 'missing', 5: 'extracted',
        6: 'impacted', 7: 'crown', 8: 'bridge', 9: 'implant', 10: 'fractured',
        11: 'rootcanal', 12: 'filling'
    };

    const STATUS_ID_TO_LABEL_TT = {
        1: 'سليم', 2: 'تسوس', 3: 'معالج', 4: 'مفقود', 5: 'مخلوع', 6: 'مطمور',
        7: 'تاج', 8: 'جسر', 9: 'زرعة', 10: 'مكسور', 11: 'عصب', 12: 'حشوة'
    };

    // ⭐ خريطة أحدث حالة/تشخيص محفوظ لكل سن (جايه من السيرفر)
    window.toothInfoMap = @Html.Raw(ViewBag.ToothInfoMap ?? "{}");

    function onDiagnosisChange() {
        const select = document.getElementById('toothDiagnosis');
        const badge = document.getElementById('diagnosisPriceBadge');
        const selectedOption = select.options[select.selectedIndex];
        const price = selectedOption ? parseFloat(selectedOption.dataset.price || 0) : 0;
        badge.textContent = price.toLocaleString('en-EG') + ' م.ج';
        badge.classList.remove('updated');
        void badge.offsetWidth;
        badge.classList.add('updated');
    }

    function openToothModal(num, evt) {
        if (evt) { evt.preventDefault(); evt.stopPropagation(); }
        currentToothNumber = num;
        document.getElementById('selectedToothNum').textContent = '#' + num;

        const existing = window.pendingToothRecords[num];
        document.getElementById('toothStatus').value = existing ? existing.Status : 1;
        document.getElementById('toothProcedure').value = existing ? (existing.ProcedureCode || '') : '';
        document.getElementById('toothDiagnosis').value = existing ? (existing.DiagnosisCatalogId || '') : '';
        document.getElementById('diagnosisNotes').value = existing ? (existing.DiagnosisNotes || '') : '';

        document.querySelectorAll('.surf-check-v4 input').forEach(cb => {
            cb.checked = existing ? (existing.Surfaces || []).some(s => s.Surface === cb.value) : false;
        });

        currentXrayFiles = existing && existing.XRays ? existing.XRays.map(x => ({ ...x })) : [];
        renderXrayFilesList();
        onDiagnosisChange();

        document.querySelectorAll('#chartCanvas .tooth-box').forEach(t => t.classList.remove('selected'));
        const target = document.querySelector('#chartCanvas [data-tooth="' + num + '"]');
        if (target) target.classList.add('selected');

        hideToothTooltip();

        const modal = document.getElementById('toothModal');
        modal.classList.add('dc-show');
        modal.style.setProperty('display', 'flex', 'important');
        modal.style.setProperty('visibility', 'visible', 'important');
        modal.style.setProperty('opacity', '1', 'important');
        modal.style.setProperty('pointer-events', 'auto', 'important');
    }

    function closeToothModal() {
        const modal = document.getElementById('toothModal');
        if (modal) {
            modal.classList.remove('dc-show');
            modal.style.setProperty('display', 'none', 'important');
            modal.style.setProperty('visibility', 'hidden', 'important');
            modal.style.setProperty('opacity', '0', 'important');
            modal.style.setProperty('pointer-events', 'none', 'important');
        }
        document.querySelectorAll('#chartCanvas .tooth-box').forEach(t => t.classList.remove('selected'));
        currentToothNumber = null;
    }

    const toothModalEl = document.getElementById('toothModal');
    if (toothModalEl) {
        toothModalEl.addEventListener('click', function (e) {
            if (e.target === toothModalEl) closeToothModal();
        });
    }

    function onToothXrayFilesChange(e) {
        const files = Array.from(e.target.files || []);
        files.forEach(file => {
            const reader = new FileReader();
            reader.onload = (ev) => {
                currentXrayFiles.push({ fileName: file.name, base64: ev.target.result, notes: '' });
                renderXrayFilesList();
            };
            reader.readAsDataURL(file);
        });
        e.target.value = '';
    }

    function renderXrayFilesList() {
        const wrap = document.getElementById('xrayFilesList');
        wrap.innerHTML = '';
        currentXrayFiles.forEach((xr, idx) => {
            const row = document.createElement('div');
            row.className = 'xray-file-row';
            row.innerHTML = `
                <img src="${xr.base64}" class="xray-thumb" />
                <input type="text" class="form-glass-v4 xray-note-input" placeholder="ملاحظة..." value="${xr.notes || ''}" />
                <button type="button" class="xray-remove-btn"><i class="bi bi-x"></i></button>
            `;
            row.querySelector('.xray-note-input').addEventListener('input', function () {
                currentXrayFiles[idx].notes = this.value;
            });
            row.querySelector('.xray-remove-btn').addEventListener('click', function () {
                currentXrayFiles.splice(idx, 1);
                renderXrayFilesList();
            });
            wrap.appendChild(row);
        });
    }

    function applyToothChanges() {
        if (!currentToothNumber) return;

        const statusId = parseInt(document.getElementById('toothStatus').value);
        const surfaces = Array.from(document.querySelectorAll('.surf-check-v4 input:checked'))
            .map(cb => ({ Surface: cb.value, Condition: 'Treated' }));

        const diagSelect = document.getElementById('toothDiagnosis');
        const diagOption = diagSelect.options[diagSelect.selectedIndex];
        const diagId = diagSelect.value;
        const diagPrice = diagOption ? parseFloat(diagOption.dataset.price || 0) : 0;
        const diagName = diagOption ? diagOption.textContent : null;

        window.pendingToothRecords[currentToothNumber] = {
            ToothNumber: currentToothNumber,
            Status: statusId,
            Surfaces: surfaces,
            ProcedureCode: document.getElementById('toothProcedure').value,
            Notes: document.getElementById('diagnosisNotes').value,
            DiagnosisCatalogId: diagId ? parseInt(diagId) : null,
            DiagnosisName: diagName,
            DiagnosisPrice: diagId ? diagPrice : 0,
            DiagnosisSurface: surfaces.map(s => s.Surface).join(','),
            DiagnosisNotes: document.getElementById('diagnosisNotes').value,
            XRays: currentXrayFiles.map(x => ({ FileName: x.fileName, Base64: x.base64, Notes: x.notes })),
            PrescriptionItems: []
        };

        const toothEl = document.querySelector(`#chartCanvas [data-tooth="${currentToothNumber}"]`);
        const newClass = STATUS_ID_TO_CLASS[statusId] || 'healthy';
        toothEl.className = toothEl.className.split(' ').filter(c => !Object.values(STATUS_ID_TO_CLASS).includes(c)).join(' ');
        toothEl.classList.add(newClass);
        if (window.updateToothStatusOverlay) window.updateToothStatusOverlay(toothEl);

        const flag = toothEl.querySelector('.pending-flag');
        if (flag) flag.style.display = 'flex';

        if (window.renderRecordsTable) window.renderRecordsTable();
        closeToothModal();

        Swal.fire({
            toast: true, position: 'top-end', icon: 'success',
            title: 'تمت إضافة السن ' + currentToothNumber, showConfirmButton: false, timer: 1200,
            customClass: { popup: 'rounded-4' }
        });
    }

    function removePendingTooth(num) {
        delete window.pendingToothRecords[num];
        const toothEl = document.querySelector(`#chartCanvas [data-tooth="${num}"]`);
        if (toothEl) {
            const flag = toothEl.querySelector('.pending-flag');
            if (flag) flag.style.display = 'none';
        }
        if (window.renderRecordsTable) window.renderRecordsTable();
    }
    window.removePendingTooth = removePendingTooth;
    window.openToothModal = openToothModal;

    // ============================================================
    // ⭐ Tooth Hover Tooltip — الحالة + التشخيص + الملاحظات
    // ============================================================
    const toothTooltipEl = document.getElementById('toothTooltip');

    function buildTooltipContent(num) {
        const pending = window.pendingToothRecords ? window.pendingToothRecords[num] : null;
        let statusText, diagnosisText, notesText, isPending = false;

        if (pending) {
            isPending = true;
            statusText = STATUS_ID_TO_LABEL_TT[pending.Status] || '-';
            diagnosisText = pending.DiagnosisName || null;
            notesText = pending.DiagnosisNotes || pending.Notes || null;
        } else {
            const info = window.toothInfoMap ? window.toothInfoMap[num] : null;
            if (!info) return null; // سن سليم وملوش أي سجل سابق — من غير تولتيب
            statusText = info.status || '-';
            diagnosisText = info.diagnosis || null;
            notesText = info.notes || null;
        }

        let html = `<div class="tt-title"><i class="bi bi-grid-3x3-gap"></i> سن ${num}`;
        if (isPending) html += `<span class="tt-pending-tag">قيد الحفظ</span>`;
        html += `</div>`;

        html += `<div class="tt-row"><span>الحالة</span><b>${statusText}</b></div>`;

        if (diagnosisText) {
            html += `<div class="tt-row"><span>التشخيص</span><b>${diagnosisText}</b></div>`;
        }

        if (notesText) {
            html += `<div class="tt-row tt-notes-row"><span>ملاحظات</span><span>${notesText}</span></div>`;
        }

        if (!diagnosisText && !notesText) {
            html += `<div class="tt-empty">لا يوجد تشخيص أو ملاحظات مسجلة</div>`;
        }

        return html;
    }

    function positionTooltip(evt) {
        if (!toothTooltipEl || !evt) return;
        const offset = 14;
        let x = evt.clientX + offset;
        let y = evt.clientY + offset;
        const rect = toothTooltipEl.getBoundingClientRect();
        if (x + rect.width > window.innerWidth - 10) x = evt.clientX - rect.width - offset;
        if (y + rect.height > window.innerHeight - 10) y = evt.clientY - rect.height - offset;
        toothTooltipEl.style.left = x + 'px';
        toothTooltipEl.style.top = y + 'px';
    }

    function showToothTooltip(num, evt) {
        if (!toothTooltipEl) return;
        const content = buildTooltipContent(num);
        if (!content) {
            toothTooltipEl.classList.remove('show');
            return;
        }
        toothTooltipEl.innerHTML = content;
        toothTooltipEl.classList.add('show');
        positionTooltip(evt);
    }

    function hideToothTooltip() {
        if (toothTooltipEl) toothTooltipEl.classList.remove('show');
    }

    // ⭐ نقل التولتيب لـ body عشان position:fixed يتحسب بالنسبة للشاشة مش لأي ancestor فيه backdrop-filter
    if (toothTooltipEl && toothTooltipEl.parentElement !== document.body) {
        document.body.appendChild(toothTooltipEl);
    }

    // ⭐ Event Delegation بدل الربط الفردي — يضمن الاشتغال حتى لو DOM اتعاد بناؤه
    const chartCanvasEl = document.getElementById('chartCanvas');
    let lastHoveredTooth = null;

    if (chartCanvasEl) {
        chartCanvasEl.addEventListener('mousemove', function(e) {
            const box = e.target.closest('.tooth-box');
            if (!box) {
                if (lastHoveredTooth !== null) {
                    hideToothTooltip();
                    lastHoveredTooth = null;
                }
                return;
            }
            lastHoveredTooth = parseInt(box.getAttribute('data-tooth'));
            showToothTooltip(lastHoveredTooth, e);
        });
        chartCanvasEl.addEventListener('mouseleave', function() {
            lastHoveredTooth = null;
            hideToothTooltip();
        });
    }
</script>