@{
    var xrayGroups = ViewBag.XRayGroups as List<Dental.Modules.Clinical.DTOs.XRayGroupDto> ?? new();

    string TLbl(int n)
    {
        if (n <= 0) return "عام";
        return (n / 10) switch
        {
            1 => $"UL-{n % 10}",
            2 => $"UR-{n % 10}",
            3 => $"LL-{n % 10}",
            4 => $"LR-{n % 10}",
            _ => n.ToString()
        };
    }

    var totalImages = xrayGroups.Sum(g => g.Items?.Count ?? 0);
}

<div class="xray-section">
    <div class="section-head">
        <h4><i class="bi bi-image"></i> Teeth X-Rays</h4>
        <span class="section-badge">@totalImages image</span>
    </div>

    @if (!xrayGroups.Any() || totalImages == 0)
    {
        <div class="empty-state placeholder-icon-glass">
            <i class="bi bi-image"></i>
        </div>
        <h3 class="text-center">No X-Rays images yet.</h3>
    }
    else
    {
        <div class="xray-groups">
            @foreach (var group in xrayGroups)
            {
                <div class="xray-group">
                    <div class="xray-group-head">
                        <span class="tooth-chip @(group.ToothNumber <= 0 ? "tooth-chip-empty" : "")">@TLbl(group.ToothNumber)</span>
                        <span class="xray-count">@group.Items.Count image</span>
                    </div>
                    <div class="xray-grid">
                        @foreach (var item in group.Items)
                        {
                            <div class="xray-card" onclick="openXrayViewer('@item.FilePath')">
                                <div class="xray-thumb-wrap">
                                    <img src="@item.FilePath" loading="lazy" alt="@(item.FileName ?? "X-Ray")" />
                                    <div class="xray-overlay"><i class="bi bi-zoom-in"></i></div>
                                </div>
                                <div class="xray-meta">
                                    <span class="xray-date">@item.TakenDate.ToString("dd/MM/yyyy")</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <span class="xray-note">@item.Notes</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Lightbox -->
<div class="xray-lightbox" id="xrayViewerModal" style="display:none;" onclick="closeXrayViewer()">
    <img id="xrayViewerImg" src="" alt="X-Ray" />
</div>

<style>
    .xray-groups {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .xray-group {
        background: #fafcfd;
        border: 1px solid #f1f5f9;
        border-radius: 18px;
        padding: 16px;
    }

    .xray-group-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .xray-count {
        font-size: .78rem;
        font-weight: 700;
        color: #94a3b8;
        background: #fff;
        padding: 3px 10px;
        border-radius: 8px;
        border: 1px solid #f1f5f9;
    }

    .xray-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
    }

    .xray-card {
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #f1f5f9;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .xray-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(10,77,79,0.1);
            border-color: #ccf3ec;
        }

    .xray-thumb-wrap {
        position: relative;
        width: 100%;
        height: 120px;
        overflow: hidden;
        background: #f1f5f9;
    }

        .xray-thumb-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .xray-card:hover .xray-thumb-wrap img {
        transform: scale(1.08);
    }

    .xray-overlay {
        position: absolute;
        inset: 0;
        background: rgba(13,115,119,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .xray-overlay i {
            color: #fff;
            font-size: 1.5rem;
        }

    .xray-card:hover .xray-overlay {
        opacity: 1;
    }

    .xray-meta {
        padding: 10px 12px;
    }

    .xray-date {
        font-size: .68rem;
        color: #94a3b8;
        display: block;
    }

    .xray-note {
        font-size: .76rem;
        color: #334155;
        display: block;
        margin-top: 3px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tooth-chip-empty {
        background: linear-gradient(135deg, #f1f5f9, #e2e8f0) !important;
        color: #64748b !important;
        box-shadow: none !important;
        min-width: 42px;
    }

    .xray-lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.88);
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
        backdrop-filter: blur(8px);
        animation: fadeInUp 0.3s ease;
    }

        .xray-lightbox img {
            max-width: 90%;
            max-height: 90%;
            border-radius: 12px;
            box-shadow: 0 30px 80px rgba(0,0,0,.6);
        }
</style>

<script>
    function openXrayViewer(path) {
        document.getElementById('xrayViewerImg').src = path;
        document.getElementById('xrayViewerModal').style.display = 'flex';
    }
    function closeXrayViewer() {
        document.getElementById('xrayViewerModal').style.display = 'none';
    }
</script>