@* Shared / _DentalChartReadOnly.cshtml *@
@model Dental.Modules.Patients.DTOs.DentalChartDto
@await Html.PartialAsync("_DentalArchStyles")

<div class="dental-chart-shell">
    <div class="chart-toolbar">
        <div class="legend-bar">
            <span class="legend-item"><span class="dot healthy"></span> سليم</span>
            <span class="legend-item"><span class="dot decayed"></span> تسوس</span>
            <span class="legend-item"><span class="dot treated"></span> معالج</span>
            <span class="legend-item"><span class="dot missing"></span> مفقود</span>
            <span class="legend-item"><span class="dot extracted"></span> مخلوع</span>
            <span class="legend-item"><span class="dot rootcanal"></span> عصب</span>
            <span class="legend-item"><span class="dot crown"></span> تاج</span>
            <span class="legend-item"><span class="dot implant"></span> زرعة</span>
        </div>
        <a asp-action="NewSession" asp-route-patientId="@Model.PatientId" class="btn-save-chart">
            <i class="bi bi-pencil"></i> فتح سيشن للتعديل
        </a>
    </div>

    <div class="chart-canvas" id="chartCanvasRO">
        <svg class="bg-arcs" viewBox="0 0 620 632" preserveAspectRatio="xMidYMid meet">
            <defs>
                <linearGradient id="gumUpperRO" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f8d3ca" />
                    <stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
                <linearGradient id="gumLowerRO" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#f8d3ca" />
                    <stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
            </defs>
            <path id="upperArchPath" fill="url(#gumUpperRO)"></path>
            <path id="lowerArchPath" fill="url(#gumLowerRO)"></path>
        </svg>

        <div class="arch-label upper">الفك العلوي</div>
        <div class="arch-label lower">الفك السفلي</div>

        <div class="arch-center-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2.4 0-3.6 1.3-4.8 1.3-1.6 0-2.7-1-3.5-.4-.9.7-.7 2.4-.4 3.9.4 2.2 1.1 6.6 2 9.3.5 1.5 1 2.9 2.1 2.9 1.4 0 1.4-3 2.6-3s1.2 3 2.6 3c1.1 0 1.6-1.4 2.1-2.9.9-2.7 1.6-7.1 2-9.3.3-1.5.5-3.2-.4-3.9-.8-.6-1.9.4-3.5.4C15.6 4.3 14.4 3 12 3Z" /></svg>
        </div>

        <div class="teeth-row upper">
            @for (int i = 11; i <= 18; i++)
            {
                var tooth = Model.Teeth.FirstOrDefault(t => t.ToothNumber == i);
                var status = tooth?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                var history = tooth != null ? System.Text.Json.JsonSerializer.Serialize(tooth.Treatments) : "[]";
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-history='@history' onclick="selectToothRO(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body">
                            <div class="surface top"></div>
                            <div class="surface right"></div>
                            <div class="surface bottom"></div>
                            <div class="surface left"></div>
                            <div class="surface center"></div>
                        </div>
                    </div>
                </div>
            }
            @for (int i = 21; i <= 28; i++)
            {
                var tooth = Model.Teeth.FirstOrDefault(t => t.ToothNumber == i);
                var status = tooth?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                var history = tooth != null ? System.Text.Json.JsonSerializer.Serialize(tooth.Treatments) : "[]";
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-history='@history' onclick="selectToothRO(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body">
                            <div class="surface top"></div>
                            <div class="surface right"></div>
                            <div class="surface bottom"></div>
                            <div class="surface left"></div>
                            <div class="surface center"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="teeth-row lower">
            @for (int i = 41; i <= 48; i++)
            {
                var tooth = Model.Teeth.FirstOrDefault(t => t.ToothNumber == i);
                var status = tooth?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                var history = tooth != null ? System.Text.Json.JsonSerializer.Serialize(tooth.Treatments) : "[]";
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-history='@history' onclick="selectToothRO(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body">
                            <div class="surface top"></div>
                            <div class="surface right"></div>
                            <div class="surface bottom"></div>
                            <div class="surface left"></div>
                            <div class="surface center"></div>
                        </div>
                    </div>
                </div>
            }
            @for (int i = 31; i <= 38; i++)
            {
                var tooth = Model.Teeth.FirstOrDefault(t => t.ToothNumber == i);
                var status = tooth?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                var history = tooth != null ? System.Text.Json.JsonSerializer.Serialize(tooth.Treatments) : "[]";
                <div class="tooth-box @status.ToString().ToLower()" data-tooth="@i" data-history='@history' onclick="selectToothRO(@i, event)">
                    <div class="tooth-inner">
                        <span class="tooth-num">@i</span>
                        <div class="tooth-body">
                            <div class="surface top"></div>
                            <div class="surface right"></div>
                            <div class="surface bottom"></div>
                            <div class="surface left"></div>
                            <div class="surface center"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Read-only history modal -->
    <div class="tooth-modal" id="toothModalRO" onclick="if(event.target === this) closeToothModalRO()">
        <div class="modal-glass" style="max-width: 420px;" onclick="event.stopPropagation()">
            <div class="tooth-modal-head">
                <h5><i class="bi bi-grid-3x3-gap"></i> تاريخ السن <span id="selectedToothNumRO"></span></h5>
                <button type="button" class="btn-close-modal" onclick="closeToothModalRO()"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="tooth-modal-body" id="toothHistoryBody">
                <p class="text-muted">لا يوجد تاريخ عالج مسجل لهذا السن.</p>
            </div>
            <div class="tooth-modal-foot">
                <button type="button" class="btn-glass btn-cancel" onclick="closeToothModalRO()">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var canvas = document.getElementById('chartCanvasRO');
        if (window.initDentalArch) window.initDentalArch(canvas);
    })();
        function selectToothRO(num, evt) {
        if (evt) {
            evt.preventDefault();
            evt.stopPropagation();
        }

        document.querySelectorAll('#chartCanvasRO .tooth-box').forEach(t => {
            t.classList.remove('selected');
        });

        const box = document.querySelector(
            `#chartCanvasRO [data-tooth="${num}"]`
        );

        if (!box) {
            return false;
        }

        box.classList.add('selected');

        let history = [];

        try {
            history = JSON.parse(box.dataset.history || '[]');
        } catch (error) {
            console.error('Invalid tooth history:', error);
            history = [];
        }

        document.getElementById('selectedToothNumRO').textContent = '#' + num;

        const body = document.getElementById('toothHistoryBody');

        if (!body) {
            return false;
        }

        if (history.length === 0) {

            body.innerHTML =
                '<p class="text-muted">لا يوجد تاريخ عالج مسجل لهذا السن.</p>';

        } else {

            body.innerHTML = history.map(h => {

                const procedure =
                    h.procedureName ??
                    h.ProcedureName ??
                    '-';

                const dateValue =
                    h.treatmentDate ??
                    h.TreatmentDate;

                const notes =
                    h.notes ??
                    h.Notes;

                let dateText = '-';

                if (dateValue) {
                    const date = new Date(dateValue);

                    if (!isNaN(date.getTime())) {
                        dateText = date.toLocaleDateString('ar-EG');
                    }
                }

                return `
                    <div style="border-bottom:1px solid #e2e8f0; padding:8px 0;">
                        <strong>${procedure}</strong><br/>
                        <small class="text-muted">${dateText}</small>
                        ${notes ? `<p class="mb-0">${notes}</p>` : ''}
                    </div>
                `;

            }).join('');
        }

        const modal = document.getElementById('toothModalRO');

        if (modal) {
            modal.classList.add('dc-show');
        }

        return false;
    }


    function closeToothModalRO() {

        const modal = document.getElementById('toothModalRO');

        if (modal) {
            modal.classList.remove('dc-show');
        }

        document.querySelectorAll('#chartCanvasRO .tooth-box').forEach(t => {
            t.classList.remove('selected');
        });
    }


   
</script>
