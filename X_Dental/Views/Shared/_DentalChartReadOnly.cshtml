@model Dental.Modules.Patients.DTOs.DentalChartDto
@await Html.PartialAsync("_DentalArchStyles")

@functions {
    string TLabelRo(int n) => (n / 10) switch
    {
        1 => $"UL-{n % 10}",
        2 => $"UR-{n % 10}",
        3 => $"LL-{n % 10}",
        4 => $"LR-{n % 10}",
        _ => n.ToString()
    };

    string StatusArLabel(Dental.Models.Patient.ToothStatus s) => s switch
    {
        Dental.Models.Patient.ToothStatus.Healthy => "Healthy",
        Dental.Models.Patient.ToothStatus.Decayed => "Decayed",
        Dental.Models.Patient.ToothStatus.Treated => "Treated",
        Dental.Models.Patient.ToothStatus.Missing => "Missing",
        Dental.Models.Patient.ToothStatus.Extracted => "Extracted",
        Dental.Models.Patient.ToothStatus.RootCanal => "RootCanal",
        Dental.Models.Patient.ToothStatus.Crown => "Crown",
        Dental.Models.Patient.ToothStatus.Filling => "Filling",
        _ => s.ToString()
    };
}


<style>
    .ro-chart-shell {
        position: relative;
    }

    .ro-quadrant-badge {
        position: absolute;
        font-size: .72rem;
        font-weight: 800;
        color: #0d7377;
        background: #f0fdfa;
        border: 1px solid #ccf3ec;
        border-radius: 8px;
        padding: 3px 8px;
        z-index: 5;
    }

        .ro-quadrant-badge.ur {
            top: 8px;
            left: 8px;
        }

        .ro-quadrant-badge.ul {
            top: 8px;
            right: 8px;
        }

        .ro-quadrant-badge.lr {
            bottom: 8px;
            left: 8px;
        }

        .ro-quadrant-badge.ll {
            bottom: 8px;
            right: 8px;
        }

    .ro-tooth-tooltip {
        position: fixed;
        z-index: 3000;
        background: #0b2e30;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: .78rem;
        line-height: 1.6;
        max-width: 250px;
        min-width: 150px;
        box-shadow: 0 14px 34px rgba(0,0,0,0.28);
        pointer-events: none;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity .15s ease, transform .15s ease;
    }

        .ro-tooth-tooltip.show {
            opacity: 1;
            transform: translateY(0);
        }

        .ro-tooth-tooltip .tt-title {
            font-weight: 800;
            font-size: .82rem;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #5eead4;
            border-bottom: 1px solid rgba(255,255,255,0.12);
            padding-bottom: 6px;
        }

        .ro-tooth-tooltip .tt-num {
            color: #94a3b8;
            font-weight: 600;
            font-size: .68rem;
        }

        .ro-tooth-tooltip .tt-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            padding: 2px 0;
        }

            .ro-tooth-tooltip .tt-row span:first-child {
                color: #94a3b8;
                flex-shrink: 0;
            }

            .ro-tooth-tooltip .tt-row b {
                color: #fff;
                font-weight: 700;
                text-align: left;
            }

        .ro-tooth-tooltip .tt-notes-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
            margin-top: 2px;
        }

            .ro-tooth-tooltip .tt-notes-row span {
                color: #e2e8f0;
                font-weight: 500;
            }

        .ro-tooth-tooltip .tt-empty {
            color: #94a3b8;
            font-style: italic;
            font-size: .74rem;
        }

    .tooth-box.ro-mode {
        cursor: default;
    }

    .ro-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(0,0,0,0.04);
    }

    .ro-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .72rem;
        font-weight: 700;
        color: #4b6b6c;
        padding: 3px 8px;
        border-radius: 8px;
        background: rgba(0,0,0,0.02);
    }

    .ro-legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
</style>

<div class="ro-chart-shell">
    <div class="ro-tooth-tooltip" id="roToothTooltip"></div>

    <div class="chart-canvas" id="roChartCanvas">
        <svg class="bg-arcs" viewBox="0 0 620 632" preserveAspectRatio="xMidYMid meet">
            <span class="ro-quadrant-badge fs-4 ur">UR</span>
            <span class="ro-quadrant-badge fs-4 ul">UL</span>
            <span class="ro-quadrant-badge fs-4 lr">LR</span>
            <span class="ro-quadrant-badge fs-4 ll">LL</span>
            <defs>
                <linearGradient id="roGumUpper" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f8d3ca" /><stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
                <linearGradient id="roGumLower" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#f8d3ca" /><stop offset="100%" stop-color="#f2b6a8" />
                </linearGradient>
            </defs>
            <path id="roUpperArchPath" fill="url(#roGumUpper)"></path>
            <path id="roLowerArchPath" fill="url(#roGumLower)"></path>
        </svg>

        <div class="arch-center-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 3c-2.4 0-3.6 1.3-4.8 1.3-1.6 0-2.7-1-3.5-.4-.9.7-.7 2.4-.4 3.9.4 2.2 1.1 6.6 2 9.3.5 1.5 1 2.9 2.1 2.9 1.4 0 1.4-3 2.6-3s1.2 3 2.6 3c1.1 0 1.6-1.4 2.1-2.9.9-2.7 1.6-7.1 2-9.3.3-1.5.5-3.2-.4-3.9-.8-.6-1.9.4-3.5.4C15.6 4.3 14.4 3 12 3Z" />
            </svg>
        </div>

        <div class="teeth-row upper">
            @foreach (var i in Enumerable.Range(11, 8).Reverse().Concat(Enumerable.Range(21, 8)))
            {
                var tooth = Model?.Teeth?.FirstOrDefault(t => t.ToothNumber == i);
                var status = tooth?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box ro-mode @status.ToString().ToLower()" data-tooth="@i">
                    <div class="tooth-inner">
                        <span class="tooth-num">@(i % 10)</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                </div>
            }
        </div>

        <div class="teeth-row lower">
            @foreach (var i in Enumerable.Range(41, 8).Reverse().Concat(Enumerable.Range(31, 8)))
            {
                var tooth = Model?.Teeth?.FirstOrDefault(t => t.ToothNumber == i);
                var status = tooth?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
                <div class="tooth-box ro-mode @status.ToString().ToLower()" data-tooth="@i">
                    <div class="tooth-inner">
                        <span class="tooth-num">@(i % 10)</span>
                        <div class="tooth-body"><div class="surface top"></div><div class="surface right"></div><div class="surface bottom"></div><div class="surface left"></div><div class="surface center"></div></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="ro-legend">

        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#fff;border:2px solid #0f9b8e;"></span> Healthy</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#ef4444;"></span> Decayed</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#3b82f6;"></span> Treated</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#cbd5e1;"></span> Missing</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#cbd5e1;"></span> Extracted</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#f59e0b;"></span> RootCanal</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#a855f7;"></span> Crown</span>
        <span class="ro-legend-item-sm"><span class="ro-legend-dot" style="background:#ec4899;"></span> Impants</span>
    </div>
</div>

<script>
    (function() {
        var canvas = document.getElementById('roChartCanvas');
        // نفس فانكشن رسم القوس المستخدمة في الشارت التفاعلي (من _DentalArchStyles)
        if (window.initDentalArch) window.initDentalArch(canvas, {
            upperPath: 'roUpperArchPath',
            lowerPath: 'roLowerArchPath'
        });

        var toothInfoMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                        (Model?.Teeth ?? new List<Dental.Modules.Patients.DTOs.ToothDto>()).ToDictionary(
                        t => t.ToothNumber.ToString(),
                        t => new
                        {
                                                            status = StatusArLabel(t.Status),
                                                            notes = t.Notes,
                                                            lastTreatment = t.Treatments != null && t.Treatments.Any()
                        ? t.Treatments.OrderByDescending(x => x.TreatmentDate).First().ProcedureName
                        : null,
                                                            lastDate = t.Treatments != null && t.Treatments.Any()
                        ? t.Treatments.OrderByDescending(x => x.TreatmentDate).First().TreatmentDate.ToString("dd/MM/yyyy")
                        : null,
                                                            treatmentsCount = t.Treatments != null ? t.Treatments.Count : 0
                        })
                        ));

        function toothLabel(num) {
            const q = Math.floor(num / 10), p = num % 10;
            return ({ 1: 'UL', 2: 'UR', 3: 'LL', 4: 'LR' })[q] + '-' + p;
        }

        const tooltipEl = document.getElementById('roToothTooltip');
        if (tooltipEl && tooltipEl.parentElement !== document.body) document.body.appendChild(tooltipEl);

        function buildContent(num) {
            const info = toothInfoMap[num];
            let html = `<div class="tt-title"><i class="bi bi-grid-3x3-gap"></i> ${toothLabel(num)} <span class="tt-num">FDI ${num}</span></div>`;
            if (!info) {
                html += `<div class="tt-row"><span>الحالة</span><b>سليم</b></div>`;
                html += `<div class="tt-empty">لا يوجد سجل علاجي</div>`;
                return html;
            }
            html += `<div class="tt-row"><span>الحالة</span><b>${info.status}</b></div>`;
            if (info.lastTreatment) html += `<div class="tt-row"><span>آخر إجراء</span><b>${info.lastTreatment}</b></div>`;
            if (info.lastDate) html += `<div class="tt-row"><span>بتاريخ</span><b>${info.lastDate}</b></div>`;
            if (info.treatmentsCount > 1) html += `<div class="tt-row"><span>عدد السجلات</span><b>${info.treatmentsCount}</b></div>`;
            if (info.notes) html += `<div class="tt-row tt-notes-row"><span>ملاحظات</span><span>${info.notes}</span></div>`;
            return html;
        }

        function position(evt) {
            const offset = 14;
            let x = evt.clientX + offset, y = evt.clientY + offset;
            const rect = tooltipEl.getBoundingClientRect();
            if (x + rect.width > window.innerWidth - 10) x = evt.clientX - rect.width - offset;
            if (y + rect.height > window.innerHeight - 10) y = evt.clientY - rect.height - offset;
            tooltipEl.style.left = x + 'px';
            tooltipEl.style.top = y + 'px';
        }

        let lastTooth = null;
        canvas.addEventListener('mousemove', function(e) {
            const box = e.target.closest('.tooth-box');
            if (!box) {
                if (lastTooth !== null) { tooltipEl.classList.remove('show'); lastTooth = null; }
                return;
            }
            lastTooth = box.getAttribute('data-tooth');
            tooltipEl.innerHTML = buildContent(lastTooth);
            tooltipEl.classList.add('show');
            position(e);
        });
        canvas.addEventListener('mouseleave', function() {
            lastTooth = null;
            tooltipEl.classList.remove('show');
        });
    })();
</script>