@model Dental.Modules.Clinical.ViewModels.SessionViewModel

<div class="followup-wrap">
    <div class="section-head">
        <h4><i class="bi bi-calendar-plus"></i> Reservation Follow Up</h4>
    </div>

    <div class="d-flex">
        <div class="form-group col-5">
            <label>Next Session</label>
            <input type="date" class="dc-input text-center fw-bold" id="followUpDate"
                   value="@(DateTime.Today.ToString("yyyy-MM-dd"))"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   onchange="loadSameDayAppointments()" />

            <label class="mt-3">ملاحظات (اختياري)</label>
            <textarea class="dc-input" id="followUpNotes" rows="1" placeholder="سبب المتابعة..."></textarea>

            <button type="button" class="btn-book-followup mt-3" onclick="bookFollowUp()">
                <i class="bi bi-calendar-check"></i> Book Appointment
            </button>
        </div>
        <div class="modal-col-divider mx-4"></div>
        <div class="form-group col-5">
            <div class="same-day-head">
                <i class="bi bi-people"></i> مرضى لهم مواعيد في نفس اليوم
            </div>
            <div id="sameDayAppointmentsList" class="same-day-list custom-scroll">
                <div class="empty-state" style="padding:20px;">
                    <p style="font-size:.8rem;">اختر تاريخ لعرض المواعيد المحجوزة.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-group label {
        display: block;
        font-size: .78rem;
        font-weight: 800;
        color: #475569;
        margin-bottom: 8px;
    }

    .dc-input {
        width: 100%;
        padding: 12px 14px;
        border: 1.5px solid #f1f5f9;
        border-radius: 14px;
        background: #f8fafc;
        font-size: .9rem;
        outline: none;
        transition: all .2s;
        resize: vertical;
    }

        .dc-input:focus {
            border-color: #0d9488;
            box-shadow: 0 0 0 3px rgba(13,148,136,0.1);
        }

    .btn-book-followup {
        width: 100%;
        background: linear-gradient(135deg, #0d9488, #0891b2);
        color: #fff;
        border: none;
        padding: 12px;
        border-radius: 14px;
        font-weight: 800;
        font-size: .9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(13,148,136,0.25);
        transition: all .2s ease;
    }

        .btn-book-followup:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(13,148,136,0.35);
        }

    .same-day-head {
        font-size: .82rem;
        font-weight: 800;
        color: #475569;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .same-day-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: 300px;
        overflow-y: auto;
    }

    .same-day-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fafcfd;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        padding: 8px 12px;
        font-size: .8rem;
        transition: all .2s ease;
    }

        .same-day-item:hover {
            background: #f0fdfa;
            border-color: #ccf3ec;
            transform: translateX(-2px);
        }

    .same-day-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .same-day-name {
        font-weight: 800;
        color: #0b2e30;
    }

    .same-day-phone {
        font-size: .72rem;
        color: #64748b;
        direction: ltr;
        text-align: right;
    }

    .same-day-status {
        font-weight: 800;
        font-size: .68rem;
        padding: 3px 10px;
        border-radius: 8px;
        white-space: nowrap;
    }

    @@media (max-width: 767.98px) {
        .d-flex {
            flex-direction: column;
        }

        .modal-col-divider {
            display: none;
        }
    }
</style>

<script>
    async function loadSameDayAppointments() {
        const date = document.getElementById('followUpDate').value;
        const listEl = document.getElementById('sameDayAppointmentsList');
        if (!date) return;

        listEl.innerHTML = '<div class="empty-state" style="padding:12px;"><p style="font-size:.8rem;">جاري التحميل...</p></div>';

        const start = date + 'T00:00:00';
        const end = date + 'T23:59:59';

        try {
            const res = await fetch(`/Appointments/GetEvents?start=${start}&end=${end}`);
            const data = await res.json();

            if (!data.success || !data.data.length) {
                listEl.innerHTML = '<div class="empty-state" style="padding:12px;"><p style="font-size:.8rem;">لا توجد مواعيد في هذا اليوم.</p></div>';
                return;
            }

            listEl.innerHTML = '';
            data.data.forEach(function(ap, idx) {
                const row = document.createElement('div');
                row.className = 'same-day-item';
                row.style.animation = `fadeInUp 0.3s ${idx * 0.05}s ease forwards`;
                row.style.opacity = '0';
                row.innerHTML = `
                        <div class="same-day-info">
                            <span class="same-day-name">${ap.patientName}</span>
                            <span class="same-day-phone"><i class="bi bi-telephone-fill"></i> ${ap.patientMobile || '-'}</span>
                        </div>
                        <span class="same-day-status ${ap.statusColorClass}">${ap.statusText}</span>
                    `;
                listEl.appendChild(row);
            });
        } catch (err) {
            listEl.innerHTML = '<div class="empty-state" style="padding:12px;"><p style="font-size:.8rem;">تعذر تحميل المواعيد.</p></div>';
        }
    }

    async function bookFollowUp() {
        const date = document.getElementById('followUpDate').value;
        const notes = document.getElementById('followUpNotes').value;

        if (!date) {
            Swal.fire({ title: 'تنبيه', text: 'اختر تاريخ الموعد أولاً', icon: 'warning', confirmButtonColor: '#0d9488', customClass: { popup: 'rounded-4' } });
            return;
        }

        // مفيش تعارض وقت بقى — كل المرضى بيتسجلوا في نفس اليوم بأي عدد بوقت رمزي ثابت.
        const payload = {
            PatientId: @Model.Patient.Id,
            AppointmentDate: date + 'T12:00:00',
            DurationMinutes: 15,
            Reason: 'متابعة سيشن',
            Notes: notes || null
        };

        try {
            const res = await fetch('/Appointments/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (data.success) {
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'success',
                    title: 'تم حجز الموعد', showConfirmButton: false, timer: 2000,
                    customClass: { popup: 'rounded-4' }
                });
                loadSameDayAppointments();
            } else {
                Swal.fire({ title: 'خطأ', text: data.message || 'تعذر حجز الموعد', icon: 'error', confirmButtonColor: '#dc2626', customClass: { popup: 'rounded-4' } });
            }
        } catch (err) {
            Swal.fire({ title: 'خطأ', text: 'تعذر الاتصال بالسيرفر', icon: 'error', confirmButtonColor: '#dc2626', customClass: { popup: 'rounded-4' } });
        }
    }
</script>