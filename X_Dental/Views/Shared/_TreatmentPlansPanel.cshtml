<script>
    window.TreatmentPlans = (function() {
        const patientId = document.querySelector('.tp-wrap')?.dataset.patientId;
        let plansCache = [];
        let procedureOptions = [];
        let stepEditorCounter = 0;

        function money(v) { return Number(v || 0).toLocaleString('en-US'); }

        function fmtDate(d) { return d ? new Date(d).toLocaleDateString('en-GB') : '—'; }

        const TOOTH_Q = { 1: 'UL', 2: 'UR', 3: 'LL', 4: 'LR' }; // نفس ترقيم الشارت

        function toothOptionsHtml() {
            let h = '<option value="">—</option>';
            [1, 2, 3, 4].forEach(q => {
                h += `<optgroup label="${TOOTH_Q[q]}">`;
                for (let p = 1; p <= 8; p++) {
                    const n = q * 10 + p;
                    h += `<option value="${n}">${TOOTH_Q[q]}-${p}</option>`;
                }
                h += '</optgroup>';
            });
            return h;
        }

        function todayIso() {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        function recalcPlanCost() {
            const total = Array.from(document.querySelectorAll('#tpStepsEditor .tp-f-cost'))
                .reduce((sum, el) => sum + (parseFloat(el.value) || 0), 0);
            document.getElementById('tpPlanCost').value = money(total) + ' EGP';
        }

        function renumberSteps() {
            document.querySelectorAll('#tpStepsEditor .tp-step-editor-row').forEach((row, i) => {
                row.querySelector('.tp-step-badge-num').textContent = `Step ${i + 1}`;
            });
        }

        function removeStepRow(rowId) {
            document.getElementById(rowId)?.remove();
            renumberSteps();
            recalcPlanCost();
        }

        async function loadPlans() {
            const skeleton = document.getElementById('tpSkeleton');
            const list = document.getElementById('tpPlansList');
            const empty = document.getElementById('tpEmptyState');
            skeleton.style.display = 'flex';
            list.style.display = 'none';
            empty.style.display = 'none';

            try {
                const res = await fetch(`/TreatmentPlans/GetPlans?patientId=${patientId}`);
                const result = await res.json();
                plansCache = result.success ? result.data : [];
                renderPlans();
            } catch (e) {
                console.error(e);
                plansCache = [];
                renderPlans();
            } finally {
                skeleton.style.display = 'none';
            }
        }

        function renderPlans() {
            const list = document.getElementById('tpPlansList');
            const empty = document.getElementById('tpEmptyState');

            if (!plansCache.length) {
                list.style.display = 'none';
                empty.style.display = 'block';
                return;
            }

            empty.style.display = 'none';
            list.style.display = 'flex';
            list.innerHTML = plansCache.map(p => planCardHtml(p)).join('');
        }

        function planCardHtml(p) {
            const stepsHtml = p.steps.length
                ? `<div class="tp-steps-timeline">${p.steps.map(s => stepNodeHtml(p, s)).join('')}</div>`
                : `<div class="tp-empty-steps">No steps added yet.</div>`;

            return `
                    <div class="tp-plan-card" id="tpPlan_${p.id}">
                        <div class="tp-plan-head" onclick="TreatmentPlans.toggleExpand(${p.id})">
                            <div>
                                <div class="tp-plan-title-row">
                                    <span class="tp-plan-title">${escapeHtml(p.title)}</span>
                                    <span class="tp-plan-badge ${p.statusColorClass}">${p.statusText}</span>
                                </div>
                                <div class="tp-plan-meta">
                                    <span><i class="bi bi-calendar3"></i> ${fmtDate(p.createdDate)}</span>
                                    <span><i class="bi bi-list-check"></i> ${p.completedSteps}/${p.totalSteps} steps</span>
                                    <span><i class="bi bi-cash-stack"></i> ${money(p.totalEstimatedCost)} EGP</span>
                                </div>
                            </div>
                            <div class="tp-plan-actions">
                                ${p.status === 1 ? `<button class="tp-icon-btn" title="Approve" onclick="event.stopPropagation(); TreatmentPlans.setPlanStatus(${p.id}, 2)"><i class="bi bi-check2"></i></button>` : ''}
                                <button class="tp-icon-btn danger" title="Delete plan" onclick="event.stopPropagation(); TreatmentPlans.deletePlan(${p.id})"><i class="bi bi-trash3"></i></button>
                                <i class="bi bi-chevron-down tp-chevron"></i>
                            </div>
                        </div>
                        <div class="tp-progress-row">
                            <div class="tp-progress-track"><div class="tp-progress-fill" style="width:${p.progressPercent}%;"></div></div>
                            <div class="tp-progress-label"><span>Progress</span><span>${p.progressPercent}%</span></div>
                        </div>
                        <div class="tp-plan-body">
                            ${p.notes ? `<div class="tp-plan-notes"><i class="bi bi-quote"></i> ${escapeHtml(p.notes)}</div>` : ''}
                            ${stepsHtml}
                            <div class="tp-add-step-inline" onclick="TreatmentPlans.openAddStepModal(${p.id})">
                                <i class="bi bi-plus-lg"></i> Add another step
                            </div>
                        </div>
                    </div>`;
        }

        function stepNodeHtml(plan, s) {
            const nodeClass = s.status === 3 ? 'done' : s.status === 2 ? 'progress' : s.status === 4 ? 'skipped' : '';
            const tags = [];
            if (s.toothNumber) tags.push(`Tooth ${s.toothNumber}`);
            if (s.procedureName) tags.push(s.procedureName);
            if (s.targetDate) tags.push(`Start: ${fmtDate(s.targetDate)}`);
            if (s.completedDate) tags.push(`Done: ${fmtDate(s.completedDate)}`);

            return `
                    <div class="tp-step-node ${nodeClass}">
                        <div class="tp-step-card">
                            <div class="tp-step-main">
                                <div class="tp-step-desc">${s.stepOrder}. ${escapeHtml(s.description)}</div>
                                ${tags.length ? `<div class="tp-step-tags">${tags.map(t => `<span class="tp-step-tag">${t}</span>`).join('')}</div>` : ''}
                                ${s.notes ? `<div class="tp-step-notes">${escapeHtml(s.notes)}</div>` : ''}
                            </div>
                            <div class="tp-step-side">
                                <span class="tp-step-cost">${money(s.estimatedCost)} EGP</span>
                                <span class="tp-step-badge ${s.statusColorClass}">${s.statusText}</span>
                                <div class="tp-step-actions">
                                    ${s.status !== 3 ? `<button class="tp-icon-btn" title="Mark Done" onclick="TreatmentPlans.openLinkVisitModal(${s.id})"><i class="bi bi-check2-circle"></i></button>` : ''}
 
                                    <button class="tp-icon-btn danger" title="Delete step" onclick="TreatmentPlans.deleteStep(${s.id})"><i class="bi bi-trash3"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>`;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
        }

        function toggleExpand(id) {
            document.getElementById(`tpPlan_${id}`)?.classList.toggle('expanded');
        }

        // ── Create Plan Modal ──
        async function openCreateModal() {
            document.getElementById('tpPlanTitle').value = '';
            document.getElementById('tpPlanNotes').value = '';
            document.getElementById('tpPlanCost').value = '0 EGP';
            document.getElementById('tpStepsEditor').innerHTML = '';
            stepEditorCounter = 0;
            if (!procedureOptions.length) await loadProcedureOptions();
            addStepRow();
            document.getElementById('tpCreateModal').classList.add('show');
        }
        function closeCreateModal() {
            document.getElementById('tpCreateModal').classList.remove('show');
        }

        async function loadProcedureOptions() {
            try {
                const res = await fetch('/TreatmentPlans/GetProcedureOptions');
                const result = await res.json();
                procedureOptions = result.success ? result.data : [];
            } catch (e) { procedureOptions = []; }
        }

        function procedureOptionsHtml() {
            return `<option value="">— No linked procedure —</option>` +
                procedureOptions.map(p => `<option value="${p.id}" data-price="${p.price}">${p.name}</option>`).join('');
        }

        function addStepRow() {
            stepEditorCounter++;
            const rowId = `tpStepRow_${stepEditorCounter}`;
            const div = document.createElement('div');
            div.className = 'tp-step-editor-row';
            div.id = rowId;
            div.innerHTML = `
            <div class="tp-step-head">
                <span class="tp-step-badge-num"></span>
                <button type="button" class="tp-remove-step" onclick="TreatmentPlans.removeStepRow('${rowId}')"><i class="bi bi-x"></i></button>
            </div>
            <div class="tp-field-grid-4">
                <div>
                    <label class="form-label-custom-new">Step Description <span class="text-danger">*</span></label>
                    <input type="text" class="form-control-custom-new tp-f-desc" placeholder="e.g. Fit upper braces" />
                </div>
                <div>
                    <label class="form-label-custom-new">Tooth #</label>
                    <select class="form-control-custom-new tp-f-tooth">${toothOptionsHtml()}</select>
                </div>
                <div>
                    <label class="form-label-custom-new">Linked Procedure</label>
                    <select class="form-control-custom-new tp-f-proc" onchange="TreatmentPlans.onProcedurePick(this)">
                        ${procedureOptionsHtml()}
                    </select>
                </div>
                <div>
                    <label class="form-label-custom-new">Estimated Cost</label>
                    <input type="number" step="0.01" min="0" class="form-control-custom-new tp-f-cost" value="0" oninput="TreatmentPlans.recalcPlanCost()" />
                </div>
            </div>`;
            document.getElementById('tpStepsEditor').appendChild(div);
            renumberSteps();
            recalcPlanCost();
        }

        function onProcedurePick(selectEl) {
            const opt = selectEl.options[selectEl.selectedIndex];
            const price = opt?.dataset?.price;
            if (!price) return;
            const row = selectEl.closest('.tp-step-editor-row');
            const costEl = row?.querySelector('.tp-f-cost');
            if (costEl) costEl.value = price;
            recalcPlanCost();
        }

        async function savePlan() {
            const title = document.getElementById('tpPlanTitle').value.trim();
            if (!title) {
                Swal.fire({ title: 'Required', text: 'Enter a plan title', icon: 'warning', confirmButtonColor: '#0d9488' });
                return;
            }

            const today = todayIso();
            const steps = Array.from(document.querySelectorAll('#tpStepsEditor .tp-step-editor-row')).map(row => ({
                Description: row.querySelector('.tp-f-desc').value.trim(),
                ProcedureCatalogId: row.querySelector('.tp-f-proc').value ? parseInt(row.querySelector('.tp-f-proc').value) : null,
                ToothNumber: row.querySelector('.tp-f-tooth').value ? parseInt(row.querySelector('.tp-f-tooth').value) : null,
                EstimatedCost: parseFloat(row.querySelector('.tp-f-cost').value || 0),
                TargetDate: today,   // مخفي — تاريخ اليوم
                Notes: ''            // مخفي — فاضي
            })).filter(s => s.Description);

            const btn = document.getElementById('tpBtnSavePlan');
            const btnText = document.getElementById('tpBtnSavePlanText');
            btn.disabled = true;
            btnText.textContent = 'Saving...';

            try {
                const res = await fetch('/TreatmentPlans/CreatePlan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        PatientId: parseInt(patientId),
                        Title: title,
                        Notes: document.getElementById('tpPlanNotes').value.trim(),
                        Steps: steps
                    })
                });
                const result = await res.json();
                if (result.success) {
                    closeCreateModal();
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Plan created', showConfirmButton: false, timer: 1800 });
                    loadPlans();
                } else {
                    Swal.fire({ title: 'Error', text: result.message || 'Could not save plan', icon: 'error' });
                }
            } catch (e) {
                Swal.fire({ title: 'Error', text: 'Server connection failed', icon: 'error' });
            } finally {
                btn.disabled = false;
                btnText.textContent = 'Save Plan';
            }
        }

        // ── Add step to an existing plan ──
        async function openAddStepModal(planId) {
            if (!procedureOptions.length) await loadProcedureOptions();
            document.getElementById('tpAddStepPlanId').value = planId;
            const wrap = document.querySelector('#tpAddStepModal .tp-step-row-fields');
            wrap.innerHTML = `
            <div class="tp-step-editor-row">
                <div class="tp-field-grid-4">
                    <div>
                        <label class="form-label-custom-new">Step Description <span class="text-danger">*</span></label>
                        <input type="text" class="form-control-custom-new" id="tpSoloDesc" placeholder="e.g. Adjust braces wire" />
                    </div>
                    <div>
                        <label class="form-label-custom-new">Tooth #</label>
                        <select class="form-control-custom-new" id="tpSoloTooth">${toothOptionsHtml()}</select>
                    </div>
                    <div>
                        <label class="form-label-custom-new">Linked Procedure</label>
                        <select class="form-control-custom-new" id="tpSoloProc" onchange="TreatmentPlans.onProcedurePick(this)">
                            ${procedureOptionsHtml()}
                        </select>
                    </div>
                    <div>
                        <label class="form-label-custom-new">Estimated Cost</label>
                        <input type="number" step="0.01" min="0" class="form-control-custom-new tp-f-cost" id="tpSoloCost" value="0" />
                    </div>
                </div>
            </div>`;
            document.getElementById('tpAddStepModal').classList.add('show');
        }
        function closeAddStepModal() {
            document.getElementById('tpAddStepModal').classList.remove('show');
        }

        async function saveNewStep() {
            const planId = parseInt(document.getElementById('tpAddStepPlanId').value);
            const desc = document.getElementById('tpSoloDesc').value.trim();
            if (!desc) {
                Swal.fire({ title: 'Required', text: 'Enter a step description', icon: 'warning', confirmButtonColor: '#0d9488' });
                return;
            }
            try {
                const res = await fetch('/TreatmentPlans/AddStep', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        TreatmentPlanId: planId,
                        Description: desc,
                        ProcedureCatalogId: document.getElementById('tpSoloProc').value ? parseInt(document.getElementById('tpSoloProc').value) : null,
                        ToothNumber: document.getElementById('tpSoloTooth').value ? parseInt(document.getElementById('tpSoloTooth').value) : null,
                        EstimatedCost: parseFloat(document.getElementById('tpSoloCost').value || 0),
                        TargetDate: todayIso(),   // مخفي — تاريخ اليوم
                        Notes: ''                 // مخفي — فاضي
                    })
                });
                const result = await res.json();
                if (result.success) {
                    closeAddStepModal();
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Step added', showConfirmButton: false, timer: 1500 });
                    loadPlans();
                } else {
                    Swal.fire({ title: 'Error', text: result.message, icon: 'error' });
                }
            } catch (e) {
                Swal.fire({ title: 'Error', text: 'Server connection failed', icon: 'error' });
            }
        }

        // ── Step status quick actions ──
        async function quickStatus(stepId, status) {
            try {
                const res = await fetch('/TreatmentPlans/UpdateStepStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ StepId: stepId, Status: status })
                });
                const result = await res.json();
                if (result.success) loadPlans();
            } catch (e) { console.error(e); }
        }

        let pendingDoneStepId = null;
        async function openLinkVisitModal(stepId) {
            pendingDoneStepId = stepId;
            document.getElementById('tpDoneStepId').value = stepId;
            const select = document.getElementById('tpDoneVisitId');
            select.innerHTML = '<option value="">— No specific visit —</option>';
            try {
                const res = await fetch(`/TreatmentPlans/GetPatientVisits?patientId=${patientId}`);
                const result = await res.json();
                if (result.success) {
                    result.data.forEach(v => {
                        const opt = document.createElement('option');
                        opt.value = v.id;
                        opt.textContent = `${new Date(v.date).toLocaleDateString('en-GB')} — ${v.status}`;
                        select.appendChild(opt);
                    });
                }
            } catch (e) { /* silent */ }
            document.getElementById('tpLinkVisitModal').classList.add('show');
        }
        function closeLinkVisitModal() {
            document.getElementById('tpLinkVisitModal').classList.remove('show');
            pendingDoneStepId = null;
        }
        async function confirmStepDone() {
            const stepId = parseInt(document.getElementById('tpDoneStepId').value);
            const visitId = document.getElementById('tpDoneVisitId').value;
            try {
                const res = await fetch('/TreatmentPlans/UpdateStepStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ StepId: stepId, Status: 3, CompletedVisitId: visitId ? parseInt(visitId) : null })
                });
                const result = await res.json();
                if (result.success) {
                    closeLinkVisitModal();
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Step marked done', showConfirmButton: false, timer: 1500 });
                    loadPlans();
                } else {
                    Swal.fire({ title: 'Error', text: result.message, icon: 'error' });
                }
            } catch (e) {
                Swal.fire({ title: 'Error', text: 'Server connection failed', icon: 'error' });
            }
        }

        async function deleteStep(stepId) {
            const confirm = await Swal.fire({
                title: 'Delete step?', text: 'This cannot be undone.', icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#dc2626', confirmButtonText: 'Delete', reverseButtons: true
            });
            if (!confirm.isConfirmed) return;
            try {
                const res = await fetch(`/TreatmentPlans/DeleteStep?id=${stepId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) loadPlans();
            } catch (e) { console.error(e); }
        }

        async function deletePlan(planId) {
            const confirm = await Swal.fire({
                title: 'Delete entire plan?', text: 'All steps in this plan will be removed too.', icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#dc2626', confirmButtonText: 'Delete Plan', reverseButtons: true
            });
            if (!confirm.isConfirmed) return;
            try {
                const res = await fetch(`/TreatmentPlans/DeletePlan?id=${planId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Plan deleted', showConfirmButton: false, timer: 1500 });
                    loadPlans();
                }
            } catch (e) { console.error(e); }
        }

        async function setPlanStatus(planId, status) {
            try {
                const res = await fetch('/TreatmentPlans/UpdatePlanStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ PlanId: planId, Status: status })
                });
                const result = await res.json();
                if (result.success) loadPlans();
            } catch (e) { console.error(e); }
        }

        return {
            loadPlans, toggleExpand, openCreateModal, closeCreateModal, addStepRow, onProcedurePick, savePlan,
            openAddStepModal, closeAddStepModal, saveNewStep, quickStatus,
            openLinkVisitModal, closeLinkVisitModal, confirmStepDone,
            deleteStep, deletePlan, setPlanStatus,
            removeStepRow, recalcPlanCost
        };
    })();
</script>