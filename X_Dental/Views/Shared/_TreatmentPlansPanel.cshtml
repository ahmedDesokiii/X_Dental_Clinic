@* _TreatmentPlansPanel.cshtml — لسه صفحة الـ Patients Details هي اللي بتستدعيه في تبويب plans *@

<div class="tp-wrap" data-patient-id="@ViewBag.CurrentPatientId">
    @* <div class="tp-header">
        <div class="tp-header-info">
            <h4><i class="bi bi-clipboard-check"></i> Treatment Plans</h4>
            <span class="tp-header-sub">Proposed and ongoing treatment roadmaps for this patient</span>
        </div>
        <button type="button" class="btn-hero primary" onclick="TreatmentPlans.openCreateModal()">
            <i class="bi bi-plus-lg"></i> New Plan
        </button>
    </div> *@

    <div id="tpSkeleton" class="tp-skeleton">
        <div class="tp-skeleton-card"></div>
        <div class="tp-skeleton-card"></div>
    </div>

    <div id="tpPlansList" class="tp-plans-list " style="display:none;"></div>

    <div id="tpEmptyState" class="placeholder-glass pt-0" style="display:none;">
        <div class="placeholder-icon-glass"><i class="bi bi-clipboard-check"></i></div>
        <h3>No Treatment Plans Yet</h3>
        <p>Create a plan to map out future procedures and track progress step by step.</p>
        <button type="button" class="btn-hero primary" style="display:inline-flex;" onclick="TreatmentPlans.openCreateModal()">
            <i class="bi bi-plus-lg"></i> Create First Plan
        </button>
    </div>
</div>

@* ══════════ Create Plan Modal ══════════ *@
<div class="custom-modal-new" id="tpCreateModal">
    <div class="modal-overlay-new" onclick="TreatmentPlans.closeCreateModal()"></div>
    <div class="modal-box-new tp-modal-lg">
        <div class="modal-head-new">
            <h5><i class="bi bi-clipboard-plus me-2"></i> New Treatment Plan</h5>
            <button type="button" class="btn-close btn-close-white" onclick="TreatmentPlans.closeCreateModal()"></button>
        </div>
        <div class="modal-body-new">

            <!-- ═══ Row 1: Title + Notes + Plan Cost + Add Step ═══ -->
            <div class="tp-header-inline-row">
                <div class="tp-hi-title">
                    <label class="form-label-custom-new">Plan Title <span class="text-danger">*</span></label>
                    <input type="text" class="form-control-custom-new" id="tpPlanTitle" placeholder="e.g. Orthodontic Treatment Plan" />
                </div>
                <div class="tp-hi-notes">
                    <label class="form-label-custom-new">Notes</label>
                    <input type="text" class="form-control-custom-new" id="tpPlanNotes" placeholder="Overview or patient consent notes..." />
                </div>
                <div class="tp-hi-cost">
                    <label class="form-label-custom-new">Plan Cost</label>
                    <input type="text" class="form-control-custom-new tp-readonly" id="tpPlanCost" value="0 EGP" readonly tabindex="-1" />
                </div>
                <div class="tp-hi-btn">
                    <label class="form-label-custom-new tp-invisible-label">Add</label>
                    <button type="button" class="tp-add-step-btn" onclick="TreatmentPlans.addStepRow()">
                        <i class="bi bi-plus-lg"></i> Add Step
                    </button>
                </div>
            </div>

            <div id="tpStepsEditor" class="tp-steps-editor"></div>
        </div>
        <div class="modal-foot-new">
            <button type="button" class="btn-modal-new btn-modal-cancel-new" onclick="TreatmentPlans.closeCreateModal()">Cancel</button>
            <button type="button" class="btn-modal-new btn-modal-save-new" id="tpBtnSavePlan" onclick="TreatmentPlans.savePlan()">
                <i class="bi bi-check-lg"></i> <span id="tpBtnSavePlanText">Save Plan</span>
            </button>
        </div>
    </div>
</div>
@* ══════════ Add Step Modal (for existing plan) ══════════ *@
<div class="custom-modal-new" id="tpAddStepModal">
    <div class="modal-overlay-new" onclick="TreatmentPlans.closeAddStepModal()"></div>
    <div class="modal-box-new tp-modal-lg">
        <div class="modal-head-new">
            <h5><i class="bi bi-plus-circle me-2"></i> Add Step</h5>
            <button type="button" class="btn-close btn-close-white" onclick="TreatmentPlans.closeAddStepModal()"></button>
        </div>
        <div class="modal-body-new">
            <input type="hidden" id="tpAddStepPlanId" />
            <div class="tp-step-row-fields">
@*                 @Html.Partial("_TreatmentStepFields", "solo") *@
            </div>
        </div>
        <div class="modal-foot-new">
            <button type="button" class="btn-modal-new btn-modal-cancel-new" onclick="TreatmentPlans.closeAddStepModal()">Cancel</button>
            <button type="button" class="btn-modal-new btn-modal-save-new" onclick="TreatmentPlans.saveNewStep()">
                <i class="bi bi-check-lg"></i> Add Step
            </button>
        </div>
    </div>
</div>

@* ══════════ Link-to-visit Modal (when marking a step Done) ══════════ *@
<div class="custom-modal-new" id="tpLinkVisitModal">
    <div class="modal-overlay-new" onclick="TreatmentPlans.closeLinkVisitModal()"></div>
    <div class="modal-box-new tp-modal-lg">
        <div class="modal-head-new">
            <h5><i class="bi bi-check2-circle me-2"></i> Mark Step as Done</h5>
            <button type="button" class="btn-close btn-close-white" onclick="TreatmentPlans.closeLinkVisitModal()"></button>
        </div>
        <div class="modal-body-new">
            <input type="hidden" id="tpDoneStepId" />
            <div class="mb-3">
                <label class="form-label-custom-new">Link to a visit (optional)</label>
                <select class="form-control-custom-new" id="tpDoneVisitId">
                    <option value="">— No specific visit —</option>
                </select>
            </div>
            <p class="tp-hint-text"><i class="bi bi-info-circle"></i> Linking helps trace back which session this step was actually performed in.</p>
        </div>
        <div class="modal-foot-new">
            <button type="button" class="btn-modal-new btn-modal-cancel-new" onclick="TreatmentPlans.closeLinkVisitModal()">Cancel</button>
            <button type="button" class="btn-modal-new btn-modal-save-new" onclick="TreatmentPlans.confirmStepDone()">
                <i class="bi bi-check-lg"></i> Confirm Done
            </button>
        </div>
    </div>
</div>

