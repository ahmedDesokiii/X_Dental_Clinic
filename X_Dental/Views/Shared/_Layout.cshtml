@using Microsoft.AspNetCore.Identity
@using Dental.Models.User
@inject IAuthorizationService AuthorizationService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Dental.Core.Settings.IClinicSettingsService ClinicSettingsService
@{
    var clinic = ClinicSettingsService.Get();   // ⚙️ D1
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // 🔒 A3: إظهار روابط القائمة حسب صلاحيات المستخدم
    async Task<bool> Can(string permission) =>
        User?.Identity?.IsAuthenticated == true &&
        (await AuthorizationService.AuthorizeAsync(User, permission)).Succeeded;

    var canPatients = await Can(Permissions.Patients.View_Patients);
    var canAppointments = await Can(Permissions.Appointments.View);
    var canPaymentsReports = await Can(Permissions.Payments.Reports);
    var canPaymentsView = await Can(Permissions.Payments.View);
    var canDiagnosis = await Can(Permissions.Diagnosis.View);
    var canInventory = await Can(Permissions.Inventory.View);
    var canLaboratory = await Can(Permissions.Laboratory.View);
    var canMedications = await Can(Permissions.Medications.View);
    var canAddPatient = await Can(Permissions.Patients.Add_Patient);
    var isAdmin = User?.IsInRole(Roles.Admin.ToString()) == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // ⌨️ D2: الإجراءات السريعة اللي تظهر في البحث (حسب صلاحيات المستخدم)
    var quickActions = new List<object>();
    void Act(bool allowed, string title, string url, string icon, string desc = "", string keywords = "")
    {
        if (allowed) quickActions.Add(new { title, url, icon, desc, keywords });
    }
    Act(canAddPatient, "مريض جديد", "Patients/Create", "bi-person-plus-fill", "تسجيل ملف مريض", "add new patient اضافة");
    Act(canAppointments, "تذكير مواعيد بكرة على واتساب", "Reminders", "bi-whatsapp", "رسائل جاهزة بضغطة", "whatsapp reminder تذكير رسائل");
    Act(canAppointments, "المواعيد", "Appointments", "bi-calendar2-week-fill", "", "calendar appointments كالندر حجز");
    Act(canPatients, "قائمة المرضى", "Patients", "bi-people-fill", "", "patients");
    Act(canPaymentsView, "كشف حساب مريض", "Payments/Search", "bi-receipt", "", "statement payments فلوس حساب");
    Act(canPaymentsReports, "تقرير الإيرادات", "Payments", "bi-graph-up-arrow", "اليوم / الأسبوع / الشهر", "report revenue دخل");
    Act(canDiagnosis, "التشخيصات والأسعار", "Diagnosis", "bi-clipboard2-pulse-fill", "", "diagnosis prices اسعار");
    Act(canLaboratory, "المعمل", "Laboratory", "bi-prescription2", "", "lab");
    Act(canInventory, "المخزن", "Inventory", "bi-box-seam-fill", "", "inventory stock");
    Act(canMedications, "الأدوية", "Medications", "bi-capsule-pill", "", "medications drugs");
    Act(true, "لوحة التحكم", "", "bi-grid-1x2-fill", "", "dashboard home الرئيسية");
    Act(isAdmin, "إعدادات العيادة", "Settings", "bi-gear-fill", "الاسم، اللوجو، رسالة التذكير", "settings");
    Act(isAdmin, "المستخدمين", "Users", "bi-person-badge-fill", "", "users");
}

<!DOCTYPE html>
<html lang="ar" data-theme="light">
<head>
    <meta name="autocomplete" content="off">
    <meta charset="utf-8" />
    <meta name="csrf-token" content="@csrfToken" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- 📱 C1: PWA — تثبيت البرنامج كتطبيق على الموبايل والكمبيوتر -->
    <meta name="theme-color" content="#0d7377" />
    <meta name="application-name" content="Dental Suite" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Dental Suite" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <title>@ViewData["Title"] - @clinic.ClinicName</title>

    <!-- Local Fonts -->
    <style>
            @@font-face {
                font-family: 'Beiruti';
                src: url('/fonts/Beiruti-VariableFont_wght.ttf') format('truetype');
                font-weight: 500 900;
                font-style: normal;
                font-display: swap;
            }
    </style>

    <!-- Bootstrap (local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Premium Design System v2.0 -->
    <link rel="stylesheet" href="~/css/clinic-design-system-v2.css" asp-append-version="true" />

    <!-- Page-specific styles -->
    @await RenderSectionAsync("Styles", required: false)

    <!-- Legacy CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/patient-hero-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CreationStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/executive-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dental.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons (local) -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <link rel="icon" type="image/x-icon" href="~/dental.ico">

    <!-- SweetAlert (local) -->
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <!-- Select2 (local) -->
    <link href="~/lib/select2/select2.min.css" rel="stylesheet" />

    <!-- DataTables (local) -->
    <link rel="stylesheet" href="~/lib/datatables/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/columnControl.dataTables.css" />

    <!-- ✨ D: الشاشات الجديدة + البحث السريع + زرار ➕ -->
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />

    <!-- 📱 C2: تحسينات الموبايل (آخر CSS عشان تكسب) -->
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />

    <!-- SweetAlert (local) -->
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <!-- JS (core first) - Local -->
    <script src="~/lib/jquery/jquery-3.7.1.min.js"></script>
    <script src="~/js/antiforgery.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/dataTables.min.js"></script>
    <script src="~/lib/highcharts/highcharts.js"></script>
    <script src="~/lib/moment/moment.min.js"></script>
</head>

<body>

    <div class="app-shell">

        <!-- Sidebar Overlay (mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- ============ Sidebar ============ -->
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <span class="mark">
                    @if (!string.IsNullOrEmpty(clinic.LogoPath))
                    {
                        <img src="@Url.Content("~" + clinic.LogoPath)" alt="" style="width:100%;height:100%;object-fit:contain;border-radius:inherit;" />
                    }
                    else
                    {
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C9.6 2 8.1 3.2 6.7 3.2c-1.7 0-3.2 1.5-3.2 4 0 2.1.6 3.9 1.1 5.9.5 2 .9 4.3 1.6 5.9.5 1.2 1.1 2 1.9 2 1.1 0 1.3-2.5 1.6-4.2.2-1.2.6-2.1 1.3-2.1s1.1.9 1.3 2.1c.3 1.7.5 4.2 1.6 4.2.8 0 1.4-.8 1.9-2 .7-1.6 1.1-3.9 1.6-5.9.5-2 1.1-3.8 1.1-5.9 0-2.5-1.5-4-3.2-4C15.9 3.2 14.4 2 12 2z" fill="white" />
                    </svg>
                    }
                </span>
                <div class="brand-text">
                    <strong>@clinic.DoctorName</strong>
                    <span>@clinic.ClinicName</span>
                </div>
            </div>
            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="sidebar-link" data-title="Dashboard">
                    <i class="bi bi-grid-1x2-fill fs-5"></i>
                    <span>Dashboard</span>
                </a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="sidebar-section-label">Clinic</div>

                    @if (canPatients)
                    {
                        <a asp-controller="Patients" asp-action="Index" title="Patients" class="sidebar-link " data-title="Patients">
                            <i class="bi bi-people-fill fs-5"></i>
                            <span>Patients</span>
                        </a>
                    }
                    @if (canAppointments)
                    {
                        <a asp-controller="Appointments" asp-action="index" title="Calendar" class="sidebar-link" data-title="Appointments">
                            <i class="bi bi-calendar2-week-fill fs-5"></i>
                            <span>Appointments</span>
                        </a>
                        <a asp-controller="Reminders" asp-action="Index" title="WhatsApp Reminders" class="sidebar-link" data-title="Reminders">
                            <i class="bi bi-whatsapp fs-5"></i>
                            <span>Reminders</span>
                        </a>
                    }

                    @if (canPaymentsReports)
                    {
                        <a asp-controller="Payments" asp-action="index" title="Payments" class="sidebar-link" data-title="Payments & Invoices">
                            <i class="bi bi-cash-coin fs-5"></i>
                            <span>Payments & Invoices</span>
                        </a>
                    }
                    else if (canPaymentsView)
                    {
                        <a asp-controller="Payments" asp-action="Search" title="Payments" class="sidebar-link" data-title="Payments & Invoices">
                            <i class="bi bi-cash-coin fs-5"></i>
                            <span>Payments & Invoices</span>
                        </a>
                    }

                    @if (canDiagnosis)
                    {
                        <a asp-controller="Diagnosis" asp-action="Index" title="Diagnosis" class="sidebar-link" data-title="Diagnoses">
                            <i class="bi bi-clipboard2-pulse-fill fs-5"></i>
                            <span>Diagnoses</span>
                        </a>
                    }

                    @if (canInventory)
                    {
                        <a asp-controller="Inventory" asp-action="Index" title="Inventory" class="sidebar-link" data-title="Inventory">
                            <i class="bi bi-box-seam-fill fs-5"></i>
                            <span>Inventory</span>
                        </a>
                    }
                    @if (canLaboratory)
                    {
                        <a asp-controller="Laboratory" asp-action="Index" title="Laboratory" class="sidebar-link" data-title="Laboratory">
                            <i class="bi bi-prescription2 fs-5"></i>
                            <span>Laboratory</span>
                        </a>
                    }
                    @if (canMedications)
                    {
                        <a asp-controller="Medications" asp-action="Index" title="Medications" class="sidebar-link" data-title="Medications">
                            <i class="bi bi-capsule-pill fs-5"></i>
                            <span>Medications</span>
                        </a>
                    }
                    @if (User.IsInRole(Roles.Admin.ToString()))
                    {
                        <div class="sidebar-section-label">Administration</div>
                        <a asp-controller="Users" asp-action="Index" class="sidebar-link" data-title="Users">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>Users</span>
                        </a>
                        <a asp-controller="Roles" asp-action="Index" class="sidebar-link" data-title="Roles">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Roles</span>
                        </a>
                        <a asp-controller="Settings" asp-action="Index" class="sidebar-link" data-title="Settings">
                            <i class="bi bi-gear-fill"></i>
                            <span>Settings</span>
                        </a>
                    }
                }
            </nav>
            <div class="sidebar-footer py-1">
                @if (!string.IsNullOrWhiteSpace(clinic.FacebookUrl))
                {
                    <a class="sidebar-clinic-link" href="@clinic.FacebookUrl" target="_blank" rel="noopener" data-title="Clinic Page">
                        <i class="bi bi-facebook "></i>
                        <span>Clinic Page</span>
                    </a>
                }
            </div>
        </aside>

        <!-- ============ Main Column ============ -->
        <div class="app-main">
            <!-- Topbar -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Toggle menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topbar-search">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search patient, invoice, appointment..." />
                    </div>
                </div>
                <div class="topbar-actions">
                    <!-- ⌨️ D2: بحث سريع على الموبايل -->
                    <button type="button" class="topbar-btn" id="cpMobileBtn" title="بحث سريع">
                        <i class="bi bi-search"></i>
                    </button>
                    <!-- 📱 C1: تثبيت التطبيق (بيظهر بس لما الجهاز يسمح بالتثبيت) -->
                    <button type="button" class="topbar-btn" id="pwaInstallBtn" title="تثبيت التطبيق" hidden>
                        <i class="bi bi-download"></i>
                    </button>
                    <!-- Theme Toggle -->
                    <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Toggle theme">
                        <i class="bi bi-moon-fill" id="themeIcon"></i>
                    </button>
                    <button class="topbar-btn" title="Notifications" id="notificationBtn">
                        <i class="bi bi-bell-fill"></i>
                        <span class="badge">3</span>
                    </button>
                    <button class="topbar-btn" title="Messages">
                        <i class="bi bi-chat-left-text-fill"></i>
                    </button>
                    <!-- User Menu -->
                    <div class="user-menu" id="userMenu" onclick="toggleUserDropdown()">
                        <div class="user-avatar">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="user-info">
                            <span class="name">@(User.Identity?.Name ?? "User")</span>
                            <span class="role">
                                @{
                                    var myRoles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
                                    var shownRole = myRoles.Contains("Admin") ? "Admin" : myRoles.FirstOrDefault();
                                }
                                @RoleNames.Display(shownRole)
                            </span>
                        </div>
                        <i class="bi bi-chevron-down"></i>

                        <!-- Dropdown -->
                        <div class="user-dropdown" id="userDropdown">
                            <a href="#" class="dropdown-item">
                                <i class="bi bi-person"></i>
                                <span>Profile</span>
                            </a>
                            @if (User.IsInRole(Roles.Admin.ToString()))
                            {
                                <a asp-controller="Settings" asp-action="Index" class="dropdown-item">
                                    <i class="bi bi-gear"></i>
                                    <span>Settings</span>
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="margin:0;">
                                <button type="submit" class="dropdown-item danger">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="app-content" dir="auto">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- ➕ Floating Action Button → قائمة الإجراءات السريعة (مش بيظهر في شاشة الجلسة عشان ما يغطيش أزرارها) -->
    @if (SignInManager.IsSignedIn(User) && currentController != "Clinical")
    {
        <button type="button" class="fab" id="fabBtn" title="إجراء سريع" onclick="showQuickActions()">
            <i class="bi bi-plus-lg"></i>
        </button>
    }

    <!-- ================= Scripts ================= -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>

    <!-- Firebase (local) -->
    <script src="~/lib/firebase/firebase-app-compat.js"></script>
    <script src="~/lib/firebase/firebase-messaging-compat.js"></script>
    <script src="~/sweetalert2/sweetalert2.all.min.js"></script>

    <!-- App Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true" data-base="@Url.Content("~/")"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <script src="~/js/command-palette.js" asp-append-version="true"
                data-base="@Url.Content("~/")"
                data-patients="@(canPatients ? "true" : "false")"
                data-wa-cc="@clinic.WhatsAppCountryCode"
                data-actions="@System.Text.Json.JsonSerializer.Serialize(quickActions)"></script>
    }
    <script src="~/js/login.js"></script>
    <script src="~/js/Users.js"></script>

    <script>
            $(document).ready(function () {
                // Initialize Select2
                $('.searchable').select2({
                    dir: 'rtl',
                    width: '100%'
                });

                // Mark active sidebar link based on current URL
                var path = window.location.pathname.toLowerCase();
                $('.sidebar-link').each(function () {
                    var href = ($(this).attr('href') || '').toLowerCase();
                    if (href && href !== '#' && path.indexOf(href) === 0) {
                        $(this).addClass('active');
                    }
                });

                // Close dropdowns when clicking outside
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('#userMenu').length) {
                        $('#userDropdown').removeClass('show');
                        $('#userMenu').removeClass('active');
                    }
                });

                // Animate stat cards on scroll
                animateOnScroll();
            });

            // Sidebar Toggle
            function toggleSidebar() {
                const sidebar = document.getElementById('appSidebar');
                const overlay = document.getElementById('sidebarOverlay');
                const isMobile = window.innerWidth <= 768;

                if (isMobile) {
                    sidebar.classList.toggle('mobile-open');
                    overlay.classList.toggle('active');
                } else {
                    sidebar.classList.toggle('collapsed');
                    localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                }
            }

            // Restore sidebar state
            (function () {
                const sidebar = document.getElementById('appSidebar');
                const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                if (isCollapsed && window.innerWidth > 768) {
                    sidebar.classList.add('collapsed');
                }
            })();

            // User Dropdown Toggle
            function toggleUserDropdown() {
                const dropdown = document.getElementById('userDropdown');
                const menu = document.getElementById('userMenu');
                dropdown.classList.toggle('show');
                menu.classList.toggle('active');
            }

            // Theme Toggle
            function toggleTheme() {
                const html = document.documentElement;
                const icon = document.getElementById('themeIcon');
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);

                if (newTheme === 'dark') {
                    icon.classList.remove('bi-moon-fill');
                    icon.classList.add('bi-sun-fill');
                } else {
                    icon.classList.remove('bi-sun-fill');
                    icon.classList.add('bi-moon-fill');
                }
            }

            // Restore theme
            (function () {
                const savedTheme = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                const icon = document.getElementById('themeIcon');
                if (savedTheme === 'dark' && icon) {
                    icon.classList.remove('bi-moon-fill');
                    icon.classList.add('bi-sun-fill');
                }
            })();

            // Handle window resize
            window.addEventListener('resize', function () {
                const sidebar = document.getElementById('appSidebar');
                const overlay = document.getElementById('sidebarOverlay');

                if (window.innerWidth > 768) {
                    sidebar.classList.remove('mobile-open');
                    overlay.classList.remove('active');
                }
            });

            // Animate elements on scroll
            function animateOnScroll() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.style.animationPlayState = 'running';
                        }
                    });
                }, { threshold: 0.1 });

                document.querySelectorAll('.stat-card, .card').forEach(el => {
                    observer.observe(el);
                });
            }

            // Quick Actions FAB → معرّفة في command-palette.js (⌨️ D2)
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>