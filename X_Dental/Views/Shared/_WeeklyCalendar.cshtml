<!-- Views/Shared/_WeeklyCalendar.cshtml -->
<div class="weekly-calendar-shell">
    <div class="calendar-header">
        <button class="cal-nav" onclick="shiftWeek(-1)"><i class="bi bi-chevron-right"></i></button>
        <h3 class="cal-title" id="weekRange">الأسبوع الحالي</h3>
        <button class="cal-nav" onclick="shiftWeek(1)"><i class="bi bi-chevron-left"></i></button>
    </div>

    <div class="week-grid" id="weekGrid">
        <!-- Generated by JS -->
    </div>
</div>

<style>
    .weekly-calendar-shell {
        background: rgba(255,255,255,0.8);
        backdrop-filter: blur(16px);
        border-radius: 20px;
        border: 1px solid rgba(226,232,240,0.6);
        padding: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    }

    .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .cal-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
    }

    .cal-nav {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .cal-nav:hover {
            background: #0d9488;
            color: #fff;
            border-color: #0d9488;
            transform: scale(1.1);
        }

    .week-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 12px;
    }

    .day-column {
        background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
        border-radius: 16px;
        border: 1px solid rgba(226,232,240,0.6);
        min-height: 300px;
        overflow: hidden;
        transition: all 0.3s;
    }

        .day-column:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.08);
            border-color: rgba(13,148,136,0.3);
        }

    .day-header {
        padding: 12px;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
        background: linear-gradient(135deg, rgba(13,148,136,0.05), transparent);
    }

    .day-name {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .day-number {
        font-size: 1.4rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
        margin-top: 4px;
    }

    .day-slots {
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .patient-slot {
        background: #fff;
        border-radius: 12px;
        padding: 12px;
        border: 1px solid rgba(226,232,240,0.8);
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
        position: relative;
        overflow: hidden;
    }

        .patient-slot::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #0d9488, #0891b2);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .patient-slot:hover {
            transform: translateX(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            border-color: rgba(13,148,136,0.3);
        }

            .patient-slot:hover::before {
                opacity: 1;
            }

    .slot-time {
        font-size: 0.75rem;
        font-weight: 700;
        color: #0d9488;
        background: rgba(13,148,136,0.08);
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
        margin-bottom: 6px;
    }

    .slot-name {
        font-weight: 700;
        color: #1e293b;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .slot-phone {
        font-size: 0.8rem;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 4px;
        font-family: monospace;
        direction: ltr;
        justify-content: flex-end;
    }

    .slot-type {
        margin-top: 6px;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
    }

    .type-general {
        background: #dbeafe;
        color: #1e40af;
    }

    .type-ortho {
        background: #fef3c7;
        color: #92400e;
    }
</style>

<script>
    // Sample data — replace with AJAX fetch
    const weekData = [
        { day: 'السبت', date: '08', slots: [{time:'10:00', name:'أحمد محمد', phone:'01001234567', type:'general'}, {time:'11:30', name:'سارة علي', phone:'01009876543', type:'ortho'}] },
        { day: 'الأحد', date: '09', slots: [{time:'09:00', name:'محمد سامي', phone:'01005678901', type:'general'}] },
        { day: 'الإثنين', date: '10', slots: [] },
        { day: 'الثلاثاء', date: '11', slots: [{time:'12:00', name:'فاطمة أحمد', phone:'01003334455', type:'ortho'}, {time:'02:00', name:'خالد محمود', phone:'01006667788', type:'general'}] },
        { day: 'الأربعاء', date: '12', slots: [{time:'10:30', name:'نورا سيد', phone:'01001112233', type:'general'}] },
        { day: 'الخميس', date: '13', slots: [] },
        { day: 'الجمعة', date: '14', slots: [{time:'05:00', name:'عمر خالد', phone:'01004445566', type:'ortho'}] }
    ];

    function renderWeek() {
        const grid = document.getElementById('weekGrid');
        grid.innerHTML = weekData.map(d => `
            <div class="day-column">
                <div class="day-header">
                    <div class="day-name">${d.day}</div>
                    <div class="day-number">${d.date}</div>
                </div>
                <div class="day-slots">
                    ${d.slots.length === 0 ? '<div style="text-align:center; color:#94a3b8; padding:20px 0; font-size:0.85rem;">لا توجد مواعيد</div>' : ''}
                    ${d.slots.map(s => `
                        <div class="patient-slot" onclick="window.location.href='/Patients/Details/1'">
                            <div class="slot-time">${s.time}</div>
                            <div class="slot-name">${s.name}</div>
                            <div class="slot-phone"><i class="bi bi-telephone-fill"></i> ${s.phone}</div>
                            <span class="slot-type ${s.type === 'ortho' ? 'type-ortho' : 'type-general'}">
                                ${s.type === 'ortho' ? 'تقويم' : 'عام'}
                            </span>
                        </div>
                    `).join('')}
                </div>
            </div>
        `).join('');
    }
    renderWeek();
</script>