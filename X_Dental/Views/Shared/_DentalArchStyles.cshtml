                    canvas.querySelector(
                        '#upperArchPath'
                    );


                var lowerPath =
                    canvas.querySelector(
                        '#lowerArchPath'
                    );


                if (upperPath) {

                    upperPath.setAttribute(
                        'd',
                        window.__dcArchPathD(
                            cx,
                            upperCfg.cy,
                            upperCfg.rx,
                            upperCfg.ry,
                            upperCfg.centerAngle,
                            spread
                        )
                    );
