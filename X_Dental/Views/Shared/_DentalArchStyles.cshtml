        /* ============================================================
           RENDER ONE TOOTH
           ============================================================ */

        function renderTooth(toothBox) {

            if (!toothBox) {
                return;
            }


            var numberElement =
                toothBox.querySelector(
                    ".tooth-num"
                );


            if (!numberElement) {
                return;
            }


            var number =
                parseInt(
                    numberElement.textContent.trim(),
                    10
                );


            if (isNaN(number)) {
                return;
            }


            var oldBody =
                toothBox.querySelector(
                    ".tooth-body"
                );


            if (!oldBody) {
                return;
            }


            /* Prevent duplicate rendering */

            if (
                oldBody.dataset.realisticRendered ===
                "true"
            ) {

                return;
            }


            oldBody.dataset.realisticRendered =
                "true";


            var type =
                getToothType(
                    number
                );


            var lower =
                isLowerTooth(
                    number
                );


            var svg = "";


            switch (type) {

                case "incisor":

                    svg =
                        incisorSvg(
                            lower
                        );

                    break;


                case "canine":

                    svg =
                        canineSvg(
                            lower
                        );

                    break;


                case "premolar":

                    svg =
                        premolarSvg(
                            lower
                        );

                    break;


                case "molar":

                default:

                    svg =
                        molarSvg(
                            lower
                        );

                    break;
            }


            /* Replace old rectangle */

            oldBody.innerHTML =
                svg;


            /* ========================================================
               STATUS OVERLAY
               ======================================================== */

            var overlay =
                oldBody.querySelector(
                    ".status-overlay"
                );


            if (overlay) {

                var statusClasses = [

                    "decayed",

                    "treated",

                    "crown",

                    "bridge",

                    "implant",

                    "fractured",

                    "rootcanal",

                    "filling"

                ];


                var hasStatus =
                    statusClasses.some(
                        function (cls) {

                            return toothBox.classList.contains(
                                cls
                            );
                        }
                    );


                overlay.setAttribute(
                    "opacity",
                    hasStatus
                        ? "1"
                        : "0"
                );
            }


            /* ========================================================
               EXTRACTED MARK
               ======================================================== */

            if (
                toothBox.classList.contains(
                    "extracted"
                )
            ) {

                var extractedSvg =
                    oldBody.querySelector(
                        ".realistic-tooth"
                    );


                if (extractedSvg) {

                    extractedSvg.insertAdjacentHTML(
                        "beforeend",
                        `

                        <path
                            d="M22 28 L78 100"
                            stroke="#dc2626"
                            stroke-width="3"
                            stroke-linecap="round"
                            opacity=".72"/>

                        <path
                            d="M78 28 L22 100"
                            stroke="#dc2626"
                            stroke-width="3"
                            stroke-linecap="round"
                            opacity=".72"/>

                        `
                    );
                }
            }
        }


        /* ============================================================
           RENDER ALL TEETH
           ============================================================ */

        function renderAllTeeth(root) {

            root =
                root ||
                document;


            var teeth =
                root.querySelectorAll(
                    ".tooth-box"
                );


            teeth.forEach(
                renderTooth
            );
        }


        /* ============================================================
           INITIALIZATION
           ============================================================ */

        function initRealisticTeeth() {

            renderAllTeeth(
                document
            );
        }


        if (
            document.readyState ===
            "loading"
        ) {

            document.addEventListener(
                "DOMContentLoaded",
                initRealisticTeeth
            );

        } else {

            initRealisticTeeth();

        }


        /* ============================================================
           GLOBAL FUNCTION
           ============================================================ */

        window.initRealisticDentalTeeth =
            initRealisticTeeth;


        /* ============================================================
           AJAX / DYNAMIC CONTENT SUPPORT
           ============================================================ */

        if (
            window.MutationObserver
        ) {

            var observer =
                new MutationObserver(
                    function (mutations) {

                        var shouldRender =
                            false;


                        mutations.forEach(
                            function (mutation) {

                                if (
                                    mutation.addedNodes &&
                                    mutation.addedNodes.length
                                ) {

                                    shouldRender =
                                        true;
                                }

                            }
                        );


                        if (
                            shouldRender
                        ) {

                            window.requestAnimationFrame(
                                function () {

                                    renderAllTeeth(
                                        document
                                    );

                                }
                            );
                        }

                    }
                );


            observer.observe(
                document.body,
                {
                    childList: true,
                    subtree: true
                }
            );
        }

    })();

