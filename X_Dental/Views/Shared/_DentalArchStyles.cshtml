                if (lowerPath) {

                    lowerPath.setAttribute(
                        'd',
                        window.__dcArchPathD(
                            cx,
                            lowerCfg.cy,
                            lowerCfg.rx,
                            lowerCfg.ry,
                            lowerCfg.centerAngle,
                            spread
                        )
                    );
                }


                requestAnimationFrame(
                    function () {

                        setTimeout(
                            function () {

                                if (upperPath) {
                                    upperPath.classList.add(
                                        'show'
                                    );
                                }


                                if (lowerPath) {
                                    lowerPath.classList.add(
                                        'show'
                                    );
                                }

                            },
                            60
                        );

                    }
                );
            };

