        /* ============================================================
           TOOTH TYPE
           ============================================================ */

        function getToothType(number) {

            number =
                parseInt(
                    number,
                    10
                );


            if (isNaN(number)) {
                return "molar";
            }


            var tooth =
                number % 10;


            if (
                tooth === 1 ||
                tooth === 2
            ) {

                return "incisor";
            }


            if (tooth === 3) {
                return "canine";
            }


            if (
                tooth === 4 ||
                tooth === 5
            ) {

                return "premolar";
            }


            return "molar";
        }


        /* ============================================================
           LOWER TOOTH
           ============================================================ */

        function isLowerTooth(number) {

            number =
                parseInt(
                    number,
                    10
                );


            if (isNaN(number)) {
                return false;
            }


            return (
                number >= 31 &&
                number <= 48
            );
        }


