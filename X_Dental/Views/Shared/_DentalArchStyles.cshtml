@* ================================================================
   Shared / _DentalArchStyles.cshtml

   Dental Chart:
   - Original curved arch design preserved
   - Realistic anatomical tooth rendering
   - FDI tooth type detection
   - Upper / Lower orientation
   - Status overlays
   - Hover / Selected animations
   - Safe to include more than once
   ================================================================ *@

<style>

    :root {
        --dc-sky-50: #eafbfc;
        --dc-sky-100: #dcf5f7;
        --dc-teal-900: #0a4d4f;
        --dc-teal-700: #0d7377;
        --dc-teal-600: #0f9b8e;
        --dc-teal-500: #14b8a6;
        --dc-teal-100: #c7f2ea;
        --dc-coral-300: #f6c6bc;
        --dc-coral-500: #f2b6a8;
        --dc-ink-900: #0b2e30;
        --dc-ink-600: #4b6b6c;
        --dc-healthy: #ffffff;
        --dc-healthy-line: #0f9b8e;
        --dc-decayed: #fee2e2;
        --dc-decayed-line: #ef4444;
        --dc-treated: #dbeafe;
        --dc-treated-line: #3b82f6;
        --dc-missing-line: #cbd5e1;
        --dc-extracted: #1e293b;
        --dc-extracted-line: #1e293b;
        --dc-impacted: #e0e7ff;
        --dc-impacted-line: #6366f1;
        --dc-crown: #f3e8ff;
        --dc-crown-line: #a855f7;
        --dc-bridge: #cffafe;
        --dc-bridge-line: #06b6d4;
        --dc-implant: #fce7f3;
        --dc-implant-line: #ec4899;
        --dc-fractured: #ffedd5;
        --dc-fractured-line: #f97316;
        --dc-rootcanal: #fef3c7;
        --dc-rootcanal-line: #f59e0b;
        --dc-filling: #ccfbf1;
        --dc-filling-line: #14b8a6;
    }


    /* ============================================================
           MAIN SHELL
           ============================================================ */

    .dental-chart-shell {
        padding: 10px;
    }


    /* ============================================================
           TOOLBAR
           ============================================================ */

    .chart-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 12px;
    }


    .legend-bar {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }


    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .82rem;
        font-weight: 700;
        color: var(--dc-ink-600);
    }


    .dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px var(--dc-sky-100);
    }


        .dot.healthy {
            background: var(--dc-healthy);
            box-shadow: 0 0 0 1px var(--dc-healthy-line);
        }


        .dot.decayed {
            background: var(--dc-decayed-line);
        }


        .dot.treated {
            background: var(--dc-treated-line);
        }


        .dot.missing {
            background: var(--dc-missing-line);
        }


        .dot.extracted {
            background: var(--dc-extracted-line);
        }


        .dot.rootcanal {
            background: var(--dc-rootcanal-line);
        }


        .dot.crown {
            background: var(--dc-crown-line);
        }


        .dot.implant {
            background: var(--dc-implant-line);
        }


    /* ============================================================
           SAVE BUTTON
           ============================================================ */

    .btn-save-chart {
        background: linear-gradient( 135deg, var(--dc-teal-600), var(--dc-teal-700) );
        color: #fff;
        border: none;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 800;
        font-size: .85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 18px rgba(13,115,119,.3);
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .btn-save-chart:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(13,115,119,.38);
            color: #fff;
        }


    /* ============================================================
           CANVAS / STAGE
           ============================================================ */

    .chart-canvas {
        position: relative;
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        aspect-ratio: 1 / 1.02;
        background: radial-gradient( circle at 10% 8%, var(--dc-teal-100) 0%, transparent 40% ), radial-gradient( circle at 92% 92%, var(--dc-coral-300) 0%, transparent 32% ), var(--dc-sky-50);
        border-radius: 26px;
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: 0 16px 40px rgba(10,77,79,.1);
        padding: 0;
        overflow: hidden;
    }


    /* ============================================================
           BACKGROUND ARCHES
           ============================================================ */

    .bg-arcs {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }


        .bg-arcs path {
            opacity: 0;
            transition: opacity .8s ease;
        }


            .bg-arcs path.show {
                opacity: 1;
            }


    /* ============================================================
           ARCH LABELS
           ============================================================ */

    .arch-label {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-size: .72rem;
        font-weight: 800;
        color: var(--dc-teal-700);
        letter-spacing: .5px;
        background: rgba(255,255,255,.75);
        padding: 3px 14px;
        border-radius: 20px;
        z-index: 3;
        white-space: nowrap;
        text-transform: none;
    }


        .arch-label.upper {
            top: 3%;
        }


        .arch-label.lower {
            bottom: 3%;
        }


    /* ============================================================
           CENTER MARK
           ============================================================ */

    .arch-center-mark {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%,-50%);
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: radial-gradient( circle, rgba(255,255,255,.9), rgba(255,255,255,.35) );
        box-shadow: 0 0 0 8px rgba(15,155,142,.06);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: dcBreathe 3.2s ease-in-out infinite;
        z-index: 1;
    }


        .arch-center-mark svg {
            width: 24px;
            height: 24px;
            color: var(--dc-teal-600);
        }


    @@keyframes dcBreathe {

        0%,
        100% {
            box-shadow: 0 0 0 8px rgba(15,155,142,.06);
        }

        50% {
            box-shadow: 0 0 0 14px rgba(15,155,142,.12);
        }
    }


    /* ============================================================
           TEETH ROW
           ============================================================ */

    .teeth-row {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
    }


    /* ============================================================
           TOOTH CONTAINER

           Important:
           This preserves the original arch positioning.
           Only the visual tooth itself is replaced.
           ============================================================ */

    .tooth-box {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 52px !important;
        height: 82px !important;
        cursor: pointer;
        transform: translate(-50%,-50%) rotate(var(--rot,0deg));
        perspective: 900px;
        pointer-events: auto;
        z-index: 2;
    }


    /* ============================================================
           TOOTH INNER
           ============================================================ */

    .tooth-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 0 !important;
        transform-origin: center center;
        transform: scale(0);
        opacity: 0;
        transition: filter .2s ease;
    }


        .tooth-inner.arc-placed {
            animation: dcArcPop .55s cubic-bezier(.2,1.4,.4,1) forwards;
            animation-delay: var(--d,0s);
        }


    @@keyframes dcArcPop {

        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }


    /* ============================================================
           REALISTIC TOOTH
           ============================================================ */

    .realistic-tooth {
        width: 52px;
        height: 64px;
        display: block;
        overflow: visible;
        cursor: pointer;
        filter: drop-shadow( 0 7px 5px rgba(40,35,25,.14) ) drop-shadow( 0 14px 13px rgba(40,35,25,.10) );
        transform: translateZ(0) rotateX(2deg);
        transition: transform .22s cubic-bezier(.2,1.3,.3,1), filter .22s ease;
        transform-origin: center center;
    }


    /* ============================================================
           HOVER
           ============================================================ */

    .tooth-box:hover {
        z-index: 8;
    }


        .tooth-box:hover .realistic-tooth {
            transform: translateY(-3px) scale(1.10) rotateX(3deg);
            filter: drop-shadow( 0 10px 7px rgba(40,35,25,.18) ) drop-shadow( 0 18px 18px rgba(40,35,25,.13) );
        }


    /* ============================================================
           SELECTED
           ============================================================ */

    .tooth-box.selected {
        z-index: 9;
    }


        .tooth-box.selected .realistic-tooth {
            transform: translateY(-4px) scale(1.15) rotateX(4deg);
            filter: drop-shadow( 0 0 3px rgba(20,184,166,.65) ) drop-shadow( 0 0 10px rgba(20,184,166,.40) ) drop-shadow( 0 15px 18px rgba(40,35,25,.18) );
        }


    /* ============================================================
           UPPER / LOWER LIGHTING
           ============================================================ */

    .teeth-row.upper .realistic-tooth {
        transform-origin: center 75%;
    }


    .teeth-row.lower .realistic-tooth {
        transform-origin: center 25%;
    }


    /* ============================================================
           TOOTH NUMBER
           ============================================================ */

    .tooth-num {
        position: relative;
        z-index: 20;
        margin-top: -2px;
        width: 21px !important;
        height: 21px !important;
        border-radius: 50%;
        background: var(--dc-teal-600);
        color: #fff;
        font-size: .60rem !important;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
        box-shadow: 0 2px 5px rgba(10,77,79,.22), 0 0 0 1px rgba(255,255,255,.8);
        transition: transform .2s ease, background .2s ease;
        flex-shrink: 0;
    }


    .tooth-box:hover .tooth-num {
        transform: scale(1.12);
    }


    .tooth-box.selected .tooth-num {
        background: var(--dc-teal-700);
        transform: scale(1.15);
    }


    /* ============================================================
           SVG ENAMEL
           ============================================================ */

    .realistic-tooth .enamel {
        fill: url(#rtEnamel);
        stroke: url(#rtEdge);
        stroke-width: 1.15;
        vector-effect: non-scaling-stroke;
    }


    .realistic-tooth .enamel-shadow {
        fill: url(#rtShadow);
        opacity: .42;
        pointer-events: none;
    }


    .realistic-tooth .enamel-highlight {
        fill: url(#rtHighlight);
        opacity: .82;
        pointer-events: none;
        mix-blend-mode: screen;
    }


    .realistic-tooth .light-reflection {
        fill: url(#rtReflection);
        opacity: .78;
        pointer-events: none;
    }


    .realistic-tooth .surface-line {
        fill: none;
        stroke: rgba(124,105,77,.20);
        stroke-width: .8;
        stroke-linecap: round;
        pointer-events: none;
    }


    .realistic-tooth .cusp {
        fill: url(#rtCusp);
        opacity: .78;
        pointer-events: none;
    }


    .realistic-tooth .fissure {
        fill: none;
        stroke: rgba(100,80,55,.28);
        stroke-width: 1;
        stroke-linecap: round;
        pointer-events: none;
    }


    /* ============================================================
           STATUS COLORS
           ============================================================ */

    .tooth-box.decayed
    .realistic-tooth
    .status-overlay {
        fill: rgba(239,68,68,.30);
        stroke: #ef4444;
        stroke-width: 1.3;
    }


    .tooth-box.treated
    .realistic-tooth
    .status-overlay {
        fill: rgba(59,130,246,.24);
        stroke: #3b82f6;
        stroke-width: 1.3;
    }


    .tooth-box.crown
    .realistic-tooth
    .status-overlay {
        fill: rgba(168,85,247,.23);
        stroke: #a855f7;
        stroke-width: 1.5;
    }


    .tooth-box.bridge
    .realistic-tooth
    .status-overlay {
        fill: rgba(6,182,212,.22);
        stroke: #06b6d4;
        stroke-width: 1.5;
    }


    .tooth-box.implant
    .realistic-tooth
    .status-overlay {
        fill: rgba(236,72,153,.22);
        stroke: #ec4899;
        stroke-width: 1.5;
    }


    .tooth-box.fractured
    .realistic-tooth
    .status-overlay {
        fill: rgba(249,115,22,.22);
        stroke: #f97316;
        stroke-width: 1.5;
    }


    .tooth-box.rootcanal
    .realistic-tooth
    .status-overlay {
        fill: rgba(245,158,11,.20);
        stroke: #f59e0b;
        stroke-width: 1.4;
    }


    .tooth-box.filling
    .realistic-tooth
    .status-overlay {
        fill: rgba(20,184,166,.20);
        stroke: #14b8a6;
        stroke-width: 1.4;
    }


    /* ============================================================
           MISSING
           ============================================================ */

    .tooth-box.missing .realistic-tooth {
        opacity: .28;
        filter: grayscale(.5) drop-shadow( 0 4px 4px rgba(40,35,25,.08) );
    }


    .tooth-box.missing .tooth-num {
        background: #94a3b8;
    }


    /* ============================================================
           EXTRACTED
           ============================================================ */

    .tooth-box.extracted .realistic-tooth {
        opacity: .42;
        filter: grayscale(.7) drop-shadow( 0 4px 4px rgba(40,35,25,.08) );
    }


    .tooth-box.extracted .tooth-num {
        background: var(--dc-extracted-line);
    }


    /* ============================================================
           MODAL
           ============================================================ */

    .tooth-modal {
        position: fixed;
        inset: 0;
        background: rgba(10,40,42,.45);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        pointer-events: none;
    }


        .tooth-modal.dc-show {
            display: flex;
            pointer-events: auto;
            animation: dcFadeIn .25s ease;
        }


    @@keyframes dcFadeIn {

        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }


    .modal-glass {
        width: 100%;
        margin: 16px;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0,0,0,.3);
        transform: translateY(24px) scale(.96);
        opacity: 0;
        animation: dcModalIn .35s cubic-bezier(.2,1.2,.3,1) forwards;
    }


    @@keyframes dcModalIn {

        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }


    .tooth-modal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        margin-bottom: 0;
        color: #fff;
        background: linear-gradient( 135deg, var(--dc-teal-600), var(--dc-teal-700) );
    }


        .tooth-modal-head h5 {
            margin: 0;
            font-weight: 800;
            font-size: 1rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }


    .btn-close-modal {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        border: none;
        background: rgba(255,255,255,.2);
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .tooth-modal-body {
        padding: 20px 22px;
        margin-bottom: 0;
    }


    .tooth-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 22px;
        border-top: 1px solid var(--dc-sky-100);
    }


    .form-group label {
        display: block;
        font-size: .8rem;
        font-weight: 800;
        color: var(--dc-ink-600);
        margin-bottom: 6px;
    }


    .form-glass {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--dc-sky-100);
        border-radius: 10px;
        background: var(--dc-sky-50);
        font-size: .9rem;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }


        .form-glass:focus {
            border-color: var(--dc-teal-500);
            box-shadow: 0 0 0 3px rgba(15,155,142,.15);
        }


    .surface-picker {
        display: flex;
        gap: 8px;
    }


    .surf-check {
        flex: 1;
        text-align: center;
        padding: 9px 0;
        border-radius: 10px;
        border: 2px solid var(--dc-sky-100);
        background: #fff;
        font-weight: 800;
        color: var(--dc-ink-600);
        cursor: pointer;
        transition: .2s;
    }


        .surf-check:has(input:checked) {
            background: linear-gradient( 135deg, var(--dc-teal-600), var(--dc-teal-700) );
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(15,155,142,.3);
        }


        .surf-check input {
            display: none;
        }


    .btn-glass {
        padding: 9px 18px;
        border-radius: 10px;
        font-weight: 800;
        font-size: .85rem;
        border: none;
        cursor: pointer;
        transition: .2s;
    }


    .btn-cancel {
        background: var(--dc-sky-100);
        color: var(--dc-ink-600);
    }


    .btn-save {
        background: linear-gradient( 135deg, var(--dc-teal-600), var(--dc-teal-700) );
        color: #fff;
        box-shadow: 0 6px 16px rgba(15,155,142,.3);
    }


        .btn-save:hover {
            transform: translateY(-1px);
        }


    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 768px) {

        .tooth-box {
            width: 43px !important;
            height: 70px !important;
        }


        .realistic-tooth {
            width: 43px;
            height: 55px;
        }


        .tooth-num {
            width: 18px !important;
            height: 18px !important;
            font-size: .55rem !important;
        }
    }
</style>


<script>

    /* ============================================================
       DENTAL ARCH ENGINE

       Guarded so it can safely be included multiple times.
       ============================================================ */

    if (!window.__dcArchEngine) {

        window.__dcArchEngine = true;


        /* ============================================================
           ARCH POINT
           ============================================================ */

        window.__dcArchPoint =
            function (
                cx,
                cy,
                rx,
                ry,
                angleDeg
            ) {

                var rad =
                    angleDeg *
                    Math.PI /
                    180;

                return {
                    x:
                        cx +
                        rx *
                        Math.cos(rad),

                    y:
                        cy +
                        ry *
                        Math.sin(rad)
                };
            };


        /* ============================================================
           ARCH SVG PATH
           ============================================================ */

        window.__dcArchPathD =
            function (
                cx,
                cy,
                rx,
                ry,
                centerAngle,
                spread
            ) {

                var startA =
                    (
                        centerAngle +
                        spread / 2 +
                        14
                    ) *
                    Math.PI /
                    180;


                var endA =
                    (
                        centerAngle -
                        spread / 2 -
                        14
                    ) *
                    Math.PI /
                    180;


                var rxO =
                    rx + 40;

                var ryO =
                    ry + 40;

                var rxI =
                    rx - 34;

                var ryI =
                    ry - 34;


                var p =
                    function (
                        RX,
                        RY,
                        a
                    ) {

                        return {
                            x:
                                cx +
                                RX *
                                Math.cos(a),

                            y:
                                cy +
                                RY *
                                Math.sin(a)
                        };
                    };


                var o1 =
                    p(
                        rxO,
                        ryO,
                        startA
                    );


                var o2 =
                    p(
                        rxO,
                        ryO,
                        endA
                    );


                var i1 =
                    p(
                        rxI,
                        ryI,
                        endA
                    );


                var i2 =
                    p(
                        rxI,
                        ryI,
                        startA
                    );


                return (
                    'M ' +
                    o1.x +
                    ' ' +
                    o1.y +

                    ' A ' +
                    rxO +
                    ' ' +
                    ryO +
                    ' 0 0 1 ' +
                    o2.x +
                    ' ' +
                    o2.y +

                    ' L ' +
                    i1.x +
                    ' ' +
                    i1.y +

                    ' A ' +
                    rxI +
                    ' ' +
                    ryI +
                    ' 0 0 0 ' +
                    i2.x +
                    ' ' +
                    i2.y +

                    ' Z'
                );
            };


        /* ============================================================
           INIT DENTAL ARCH
           ============================================================ */

        window.initDentalArch =
            function (canvas) {

                if (!canvas) {
                    return;
                }


                var VB_W = 620;
                var VB_H = 632;

                var cx = 310;

                var spread = 132;


                var upperCfg = {

                    cy: 220,

                    rx: 250,

                    ry: 150,

                    centerAngle: 270
                };


                var lowerCfg = {

                    cy: 412,

                    rx: 250,

                    ry: 150,

                    centerAngle: 90
                };


                /* ====================================================
                   LAYOUT ROW
                   ==================================================== */

                function layoutRow(
                    row,
                    cfg
                ) {

                    if (!row) {
                        return;
                    }


                    var items =
                        Array.prototype.filter.call(
                            row.children,
                            function (el) {

                                return el.classList.contains(
                                    'tooth-box'
                                );
                            }
                        );


                    var N =
                        items.length;


                    if (N < 2) {
                        return;
                    }


                    var startA =
                        cfg.centerAngle +
                        spread / 2;


                    var endA =
                        cfg.centerAngle -
                        spread / 2;


                    items.forEach(
                        function (
                            el,
                            idx
                        ) {

                            var t =
                                idx /
                                (N - 1);


                            var angle =
                                startA +
                                (
                                    endA -
                                    startA
                                ) *
                                t;


                            var pt =
                                window.__dcArchPoint(
                                    cx,
                                    cfg.cy,
                                    cfg.rx,
                                    cfg.ry,
                                    angle
                                );


                            el.style.left =
                                (
                                    pt.x /
                                    VB_W *
                                    100
                                ) +
                                '%';


                            el.style.top =
                                (
                                    pt.y /
                                    VB_H *
                                    100
                                ) +
                                '%';


                            var localRot =
                                (
                                    angle -
                                    cfg.centerAngle
                                ) *
                                .55;


                            el.style.setProperty(
                                '--rot',
                                localRot +
                                'deg'
                            );


                            var inner =
                                el.querySelector(
                                    '.tooth-inner'
                                );


                            if (inner) {

                                inner.style.setProperty(
                                    '--d',
                                    (
                                        idx *
                                        .045
                                    ).toFixed(3) +
                                    's'
                                );


                                inner.classList.add(
                                    'arc-placed'
                                );
                            }

                        }
                    );
                }


                layoutRow(
                    canvas.querySelector(
                        '.teeth-row.upper'
                    ),
                    upperCfg
                );


                layoutRow(
                    canvas.querySelector(
                        '.teeth-row.lower'
                    ),
                    lowerCfg
                );


                /* ====================================================
                   ARCH PATHS
                   ==================================================== */

