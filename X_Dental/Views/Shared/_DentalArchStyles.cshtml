@* Shared / _DentalArchStyles.cshtml *@

<style>
    :root {
        --dc-teal-600: #0f9b8e;
    }

    .dental-chart-shell {
        padding: 6px;
    }

    .chart-canvas {
        position: relative;
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        aspect-ratio: 1 / 1.02;
        background: radial-gradient(circle at 10% 8%, var(--dc-teal-100) 0%, transparent 40%), radial-gradient(circle at 92% 92%, var(--dc-coral-300) 0%, transparent 32%), var(--dc-sky-50);
        border-radius: 26px;
        border: 1px solid rgba(255,255,255,0.7);
        box-shadow: 0 16px 40px rgba(10,77,79,0.1);
        padding: 0;
        overflow: hidden;
    }

    .bg-arcs {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

        .bg-arcs path {
            opacity: 0;
            transition: opacity .8s ease;
        }

            .bg-arcs path.show {
                opacity: 1;
            }

    .arch-center-mark {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%,-50%);
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,0.9), rgba(255,255,255,0.35));
        box-shadow: 0 0 0 8px rgba(15,155,142,0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: dcBreathe 3.2s ease-in-out infinite;
        z-index: 1;
    }

        .arch-center-mark svg {
            width: 24px;
            height: 24px;
            color: var(--dc-teal-600);
        }

    @@keyframes dcBreathe {
        0%, 100% {
            box-shadow: 0 0 0 8px rgba(15,155,142,0.06);
        }

        50% {
            box-shadow: 0 0 0 14px rgba(15,155,142,0.12);
        }
    }

    .teeth-row {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
    }

    .tooth-box {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 52px !important;
        height: 82px !important;
        cursor: pointer;
        transform: translate(-50%,-50%) rotate(var(--rot,0deg));
        perspective: 900px;
        pointer-events: auto;
        z-index: 2;
        transition: z-index 0s;
    }

    .tooth-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 0 !important;
        transform-origin: center center;
        transform: scale(0);
        opacity: 0;
        transition: filter .2s ease;
    }

        .tooth-inner.arc-placed {
            animation: dcArcPop .55s cubic-bezier(.2,1.4,.4,1) forwards;
            animation-delay: var(--d,0s);
        }

    @@keyframes dcArcPop {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .realistic-tooth {
        width: 52px;
        height: 64px;
        display: block;
        overflow: visible;
        cursor: pointer;
        filter: drop-shadow(0 7px 5px rgba(40,35,25,.14)) drop-shadow(0 14px 13px rgba(40,35,25,.10));
        transform: translateZ(0) rotateX(2deg);
        transition: transform .22s cubic-bezier(.2,1.3,.3,1), filter .22s ease;
        transform-origin: center center;
    }

    .tooth-box:hover {
        z-index: 8;
    }

        .tooth-box:hover .realistic-tooth {
            transform: translateY(-3px) scale(1.10) rotateX(3deg);
            filter: drop-shadow(0 10px 7px rgba(40,35,25,.18)) drop-shadow(0 18px 18px rgba(40,35,25,.13));
        }

    .tooth-box.selected {
        z-index: 9;
    }

        .tooth-box.selected .realistic-tooth {
            transform: translateY(-4px) scale(1.15) rotateX(4deg);
            filter: drop-shadow(0 0 3px rgba(20,184,166,.65)) drop-shadow(0 0 10px rgba(20,184,166,.40)) drop-shadow(0 15px 18px rgba(40,35,25,.18));
        }

    .teeth-row.upper .realistic-tooth {
        transform-origin: center 75%;
    }

    .teeth-row.lower .realistic-tooth {
        transform-origin: center 25%;
    }

    .tooth-num {
        position: relative;
        z-index: 20;
        margin-top: -2px;
        width: 21px !important;
        height: 21px !important;
        border-radius: 50%;
        background: var(--dc-teal-600);
        color: #fff;
        font-size: .60rem !important;
        font-weight: 800;
        font-family: 'JetBrains Mono', monospace;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
        box-shadow: 0 2px 5px rgba(10,77,79,.22), 0 0 0 1px rgba(255,255,255,.8);
        transition: transform .2s ease, background .2s ease;
        flex-shrink: 0;
    }

    .tooth-box:hover .tooth-num {
        transform: scale(1.12);
    }

    .tooth-box.selected .tooth-num {
        background: var(--dc-teal-700);
        transform: scale(1.15);
    }

    .realistic-tooth .enamel {
        fill: url(#rtEnamel);
        stroke: url(#rtEdge);
        stroke-width: 1.15;
        vector-effect: non-scaling-stroke;
    }

    .realistic-tooth .enamel-shadow {
        fill: url(#rtShadow);
        opacity: .42;
        pointer-events: none;
    }

    .realistic-tooth .enamel-highlight {
        fill: url(#rtHighlight);
        opacity: .82;
        pointer-events: none;
        mix-blend-mode: screen;
    }

    .realistic-tooth .light-reflection {
        fill: url(#rtReflection);
        opacity: .78;
        pointer-events: none;
    }

    .realistic-tooth .surface-line {
        fill: none;
        stroke: rgba(124,105,77,.20);
        stroke-width: .8;
        stroke-linecap: round;
        pointer-events: none;
    }

    .realistic-tooth .cusp {
        fill: url(#rtCusp);
        opacity: .78;
        pointer-events: none;
    }

    .realistic-tooth .fissure {
        fill: none;
        stroke: rgba(100,80,55,.28);
        stroke-width: 1;
        stroke-linecap: round;
        pointer-events: none;
    }

    /* Status overlays */
    .tooth-box.decayed .realistic-tooth .status-overlay {
        fill: rgba(239,68,68,.30);
        stroke: #ef4444;
        stroke-width: 1.3;
    }

    .tooth-box.treated .realistic-tooth .status-overlay {
        fill: rgba(59,130,246,.24);
        stroke: #3b82f6;
        stroke-width: 1.3;
    }

    .tooth-box.crown .realistic-tooth .status-overlay {
        fill: rgba(168,85,247,.23);
        stroke: #a855f7;
        stroke-width: 1.5;
    }

    .tooth-box.bridge .realistic-tooth .status-overlay {
        fill: rgba(6,182,212,.22);
        stroke: #06b6d4;
        stroke-width: 1.5;
    }

    .tooth-box.implant .realistic-tooth .status-overlay {
        fill: rgba(236,72,153,.22);
        stroke: #ec4899;
        stroke-width: 1.5;
    }

    .tooth-box.fractured .realistic-tooth .status-overlay {
        fill: rgba(249,115,22,.22);
        stroke: #f97316;
        stroke-width: 1.5;
    }

    .tooth-box.rootcanal .realistic-tooth .status-overlay {
        fill: rgba(245,158,11,.20);
        stroke: #f59e0b;
        stroke-width: 1.4;
    }

    .tooth-box.filling .realistic-tooth .status-overlay {
        fill: rgba(20,184,166,.20);
        stroke: #14b8a6;
        stroke-width: 1.4;
    }

    .tooth-box.missing .realistic-tooth {
        opacity: .28;
        filter: grayscale(.5) drop-shadow(0 4px 4px rgba(40,35,25,.08));
    }

    .tooth-box.missing .tooth-num {
        background: #94a3b8;
    }

    .tooth-box.extracted .realistic-tooth {
        opacity: .42;
        filter: grayscale(.7) drop-shadow(0 4px 4px rgba(40,35,25,.08));
    }

    .tooth-box.extracted .tooth-num {
        background: var(--dc-extracted-line);
    }

    @@media (max-width: 768px) {
        .tooth-box {
            width: 43px !important;
            height: 70px !important;
        }

        .realistic-tooth {
            width: 43px;
            height: 55px;
        }

        .tooth-num {
            width: 18px !important;
            height: 18px !important;
            font-size: .55rem !important;
        }
    }
</style>

<script>
    if (!window.__dcArchEngine) {
        window.__dcArchEngine = true;

        window.__dcArchPoint = function (cx, cy, rx, ry, angleDeg) {
            var rad = angleDeg * Math.PI / 180;
            return { x: cx + rx * Math.cos(rad), y: cy + ry * Math.sin(rad) };
        };

        window.__dcArchPathD = function (cx, cy, rx, ry, centerAngle, spread) {
            var startA = (centerAngle + spread / 2 + 14) * Math.PI / 180;
            var endA = (centerAngle - spread / 2 - 14) * Math.PI / 180;
            var rxO = rx + 40, ryO = ry + 40;
            var rxI = rx - 34, ryI = ry - 34;
            var p = function (RX, RY, a) { return { x: cx + RX * Math.cos(a), y: cy + RY * Math.sin(a) }; };
            var o1 = p(rxO, ryO, startA), o2 = p(rxO, ryO, endA);
            var i1 = p(rxI, ryI, endA), i2 = p(rxI, ryI, startA);
            return 'M ' + o1.x + ' ' + o1.y + ' A ' + rxO + ' ' + ryO + ' 0 0 1 ' + o2.x + ' ' + o2.y +
                   ' L ' + i1.x + ' ' + i1.y + ' A ' + rxI + ' ' + ryI + ' 0 0 0 ' + i2.x + ' ' + i2.y + ' Z';
        };

        window.initDentalArch = function (canvas) {
            if (!canvas) return;
            var VB_W = 620, VB_H = 632, cx = 310, spread = 132;
            var upperCfg = { cy: 280, rx: 250, ry: 150, centerAngle: 270 };
            var lowerCfg = { cy: 320, rx: 250, ry: 150, centerAngle: 90 };

            function layoutRow(row, cfg) {
                if (!row) return;
                var items = Array.prototype.filter.call(row.children, function (el) { return el.classList.contains('tooth-box'); });
                var N = items.length;
                if (N < 2) return;
                var startA = cfg.centerAngle + spread / 2;
                var endA = cfg.centerAngle - spread / 2;
                items.forEach(function (el, idx) {
                    var t = idx / (N - 1);
                    var angle = startA + (endA - startA) * t;
                    var pt = window.__dcArchPoint(cx, cfg.cy, cfg.rx, cfg.ry, angle);
                    el.style.left = (pt.x / VB_W * 100) + '%';
                    el.style.top = (pt.y / VB_H * 100) + '%';
                    var localRot = (angle - cfg.centerAngle) * .55;
                    el.style.setProperty('--rot', localRot + 'deg');
                    var inner = el.querySelector('.tooth-inner');
                    if (inner) {
                        inner.style.setProperty('--d', (idx * .045).toFixed(3) + 's');
                        inner.classList.add('arc-placed');
                    }
                });
            }

            layoutRow(canvas.querySelector('.teeth-row.upper'), upperCfg);
            layoutRow(canvas.querySelector('.teeth-row.lower'), lowerCfg);

            var upperPath = canvas.querySelector('#upperArchPath');
            var lowerPath = canvas.querySelector('#lowerArchPath');
            if (upperPath) upperPath.setAttribute('d', window.__dcArchPathD(cx, upperCfg.cy, upperCfg.rx, upperCfg.ry, upperCfg.centerAngle, spread));
            if (lowerPath) lowerPath.setAttribute('d', window.__dcArchPathD(cx, lowerCfg.cy, lowerCfg.rx, lowerCfg.ry, lowerCfg.centerAngle, spread));

            requestAnimationFrame(function () {
                setTimeout(function () {
                    if (upperPath) upperPath.classList.add('show');
                    if (lowerPath) lowerPath.classList.add('show');
                }, 60);
            });
        };
    }

    /* Realistic Tooth Engine */
    (function () {
        if (window.__realisticDentalTeeth) return;
        window.__realisticDentalTeeth = true;

        function createDefs() {
            return `
            <defs>
                <linearGradient id="rtEnamel" x1="10%" y1="5%" x2="88%" y2="95%">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="18%" stop-color="#fffef9"/>
                    <stop offset="45%" stop-color="#f8f2df"/>
                    <stop offset="70%" stop-color="#e9dfc6"/>
                    <stop offset="88%" stop-color="#d8c9aa"/>
                    <stop offset="100%" stop-color="#c9b996"/>
                </linearGradient>
                <linearGradient id="rtEdge" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#fffef8"/>
                    <stop offset="45%" stop-color="#d8c9aa"/>
                    <stop offset="100%" stop-color="#a99776"/>
                </linearGradient>
                <linearGradient id="rtShadow" x1="50%" y1="0%" x2="50%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="0"/>
                    <stop offset="48%" stop-color="#b39b72" stop-opacity=".12"/>
                    <stop offset="100%" stop-color="#806b48" stop-opacity=".62"/>
                </linearGradient>
                <linearGradient id="rtHighlight" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity=".95"/>
                    <stop offset="28%" stop-color="#ffffff" stop-opacity=".72"/>
                    <stop offset="55%" stop-color="#ffffff" stop-opacity=".18"/>
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="rtReflection" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity=".95"/>
                    <stop offset="20%" stop-color="#ffffff" stop-opacity=".55"/>
                    <stop offset="45%" stop-color="#ffffff" stop-opacity=".08"/>
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                </linearGradient>
                <radialGradient id="rtCusp" cx="35%" cy="25%" r="75%">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity=".95"/>
                    <stop offset="45%" stop-color="#eee5d2" stop-opacity=".85"/>
                    <stop offset="100%" stop-color="#a99670" stop-opacity=".45"/>
                </radialGradient>
            </defs>`;
        }

        function getToothType(number) {
            number = parseInt(number, 10);
            if (isNaN(number)) return "molar";
            var tooth = number % 10;
            if (tooth === 1 || tooth === 2) return "incisor";
            if (tooth === 3) return "canine";
            if (tooth === 4 || tooth === 5) return "premolar";
            return "molar";
        }
        function isLowerTooth(number) {
            number = parseInt(number, 10);
            if (isNaN(number)) return false;
            return number >= 31 && number <= 48;
        }

        function incisorSvg(lower) {
            var transform = lower ? "rotate(180 50 58)" : "";
            return `<svg class="realistic-tooth tooth-incisor" viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg">${createDefs()}<g transform="${transform}"><path class="enamel" d="M28 18C21 26 18 42 20 61C21 78 24 97 32 108C37 115 63 115 68 108C76 97 79 78 80 61C82 42 79 26 72 18C64 10 36 10 28 18Z"/><path class="enamel-shadow" d="M23 54C24 77 28 99 36 108C43 113 57 113 64 108C72 98 76 77 77 54C66 63 34 63 23 54Z"/><path class="enamel-highlight" d="M29 20C23 30 22 46 24 59C27 45 33 31 43 22C39 17 34 17 29 20Z"/><path class="light-reflection" d="M32 21C27 33 27 46 29 57C31 46 36 33 44 24C40 20 36 19 32 21Z"/><path class="surface-line" d="M31 61C42 66 58 66 69 61"/><path class="surface-line" d="M34 93C43 98 57 98 66 93"/><ellipse cx="50" cy="109" rx="18" ry="4" fill="#9b8868" opacity=".16"/></g><path class="status-overlay" d="M28 18C21 26 18 42 20 61C21 78 24 97 32 108C37 115 63 115 68 108C76 97 79 78 80 61C82 42 79 26 72 18C64 10 36 10 28 18Z" opacity="0"/></svg>`;
        }
        function canineSvg(lower) {
            var transform = lower ? "rotate(180 50 60)" : "";
            return `<svg class="realistic-tooth tooth-canine" viewBox="0 0 100 125" xmlns="http://www.w3.org/2000/svg">${createDefs()}<g transform="${transform}"><path class="enamel" d="M50 9C43 15 37 20 29 25C21 31 18 44 20 62C21 80 26 101 34 112C39 118 61 118 66 112C74 101 79 80 80 62C82 44 79 31 71 25C63 20 57 15 50 9Z"/><path class="enamel-shadow" d="M21 62C23 83 28 103 36 112C43 117 57 117 64 112C72 103 77 83 79 62C67 70 33 70 21 62Z"/><path class="enamel-highlight" d="M48 12C40 21 32 29 28 42C34 34 42 27 50 23C55 20 58 17 61 14C56 11 52 10 48 12Z"/><path class="light-reflection" d="M33 30C27 39 27 52 29 64C31 52 37 39 45 29C41 27 37 28 33 30Z"/><path class="cusp" d="M50 12L43 29L50 23L57 29Z"/><path class="surface-line" d="M29 64C41 71 59 71 71 64"/><ellipse cx="50" cy="113" rx="18" ry="4" fill="#9b8868" opacity=".18"/></g><path class="status-overlay" d="M50 9C43 15 37 20 29 25C21 31 18 44 20 62C21 80 26 101 34 112C39 118 61 118 66 112C74 101 79 80 80 62C82 44 79 31 71 25C63 20 57 15 50 9Z" opacity="0"/></svg>`;
        }
        function premolarSvg(lower) {
            var transform = lower ? "rotate(180 50 60)" : "";
            return `<svg class="realistic-tooth tooth-premolar" viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg">${createDefs()}<g transform="${transform}"><path class="enamel" d="M29 19C21 26 17 38 19 52C20 67 23 89 31 104C37 115 63 115 69 104C77 89 80 67 81 52C83 38 79 26 71 19C63 12 37 12 29 19Z"/><path class="enamel-shadow" d="M20 53C22 72 26 93 34 104C40 112 60 112 66 104C74 93 78 72 80 53C69 64 31 64 20 53Z"/><path class="cusp" d="M29 28C35 18 43 16 50 22L50 47C42 43 35 37 29 28Z"/><path class="cusp" d="M50 22C57 16 65 18 71 28C65 37 58 43 50 47Z"/><path class="fissure" d="M50 44C43 49 37 52 30 53M50 44C57 49 63 52 70 53"/><path class="enamel-highlight" d="M28 23C22 31 22 43 25 51C28 42 34 32 43 25C38 21 33 20 28 23Z"/><path class="light-reflection" d="M27 28C23 37 24 47 27 55C30 45 35 36 42 29C37 26 32 26 27 28Z"/><path class="surface-line" d="M31 72C42 77 58 77 69 72"/><ellipse cx="50" cy="108" rx="20" ry="4" fill="#8f7d5c" opacity=".18"/></g><path class="status-overlay" d="M29 19C21 26 17 38 19 52C20 67 23 89 31 104C37 115 63 115 69 104C77 89 80 67 81 52C83 38 79 26 71 19C63 12 37 12 29 19Z" opacity="0"/></svg>`;
        }
        function molarSvg(lower) {
            var transform = lower ? "rotate(180 50 60)" : "";
            return `<svg class="realistic-tooth tooth-molar" viewBox="0 0 100 125" xmlns="http://www.w3.org/2000/svg">${createDefs()}<g transform="${transform}"><path class="enamel" d="M25 20C16 27 13 40 16 55C18 70 21 91 28 106C32 115 42 118 50 110C58 118 68 115 72 106C79 91 82 70 84 55C87 40 84 27 75 20C65 12 35 12 25 20Z"/><ellipse cx="50" cy="49" rx="28" ry="19" fill="rgba(125,105,72,.18)"/><ellipse class="cusp" cx="35" cy="38" rx="12" ry="10"/><ellipse class="cusp" cx="65" cy="38" rx="12" ry="10"/><ellipse class="cusp" cx="35" cy="60" rx="11" ry="9"/><ellipse class="cusp" cx="65" cy="60" rx="11" ry="9"/><path class="fissure" d="M35 38C42 44 44 48 50 50C56 48 58 44 65 38"/><path class="fissure" d="M35 60C43 55 45 53 50 50C55 53 57 55 65 60"/><path class="fissure" d="M50 50L50 67"/><path class="enamel-highlight" d="M25 22C18 30 18 43 21 53C25 43 32 32 43 24C37 20 31 19 25 22Z"/><path class="light-reflection" d="M23 27C19 36 20 45 23 54C27 43 33 34 41 27C35 24 29 24 23 27Z"/><path class="enamel-shadow" d="M17 59C20 80 24 96 30 106C35 114 42 115 50 108C58 115 65 114 70 106C76 96 80 80 83 59C72 70 28 70 17 59Z"/><path class="surface-line" d="M38 79C39 91 37 101 34 108"/><path class="surface-line" d="M62 79C61 91 63 101 66 108"/><ellipse cx="50" cy="110" rx="22" ry="5" fill="#806b48" opacity=".19"/></g><path class="status-overlay" d="M25 20C16 27 13 40 16 55C18 70 21 91 28 106C32 115 42 118 50 110C58 118 68 115 72 106C79 91 82 70 84 55C87 40 84 27 75 20C65 12 35 12 25 20Z" opacity="0"/></svg>`;
        }

        function renderTooth(toothBox) {
            if (!toothBox) return;
            var numberElement = toothBox.querySelector(".tooth-num");
            if (!numberElement) return;
            var number = parseInt(numberElement.textContent.trim(), 10);
            if (isNaN(number)) return;
            var oldBody = toothBox.querySelector(".tooth-body");
            if (!oldBody) return;
            if (oldBody.dataset.realisticRendered === "true") return;
            oldBody.dataset.realisticRendered = "true";
            var type = getToothType(number);
            var lower = isLowerTooth(number);
            var svg = "";
            switch (type) {
                case "incisor": svg = incisorSvg(lower); break;
                case "canine": svg = canineSvg(lower); break;
                case "premolar": svg = premolarSvg(lower); break;
                case "molar": default: svg = molarSvg(lower); break;
            }
            oldBody.innerHTML = svg;
            var overlay = oldBody.querySelector(".status-overlay");
            if (overlay) {
                var statusClasses = ["decayed","treated","crown","bridge","implant","fractured","rootcanal","filling"];
                var hasStatus = statusClasses.some(function (cls) { return toothBox.classList.contains(cls); });
                overlay.setAttribute("opacity", hasStatus ? "1" : "0");
            }
            if (toothBox.classList.contains("extracted")) {
                var extractedSvg = oldBody.querySelector(".realistic-tooth");
                if (extractedSvg) {
                    extractedSvg.insertAdjacentHTML("beforeend",
                        `<path d="M22 28 L78 100" stroke="#dc2626" stroke-width="3" stroke-linecap="round" opacity=".72"/><path d="M78 28 L22 100" stroke="#dc2626" stroke-width="3" stroke-linecap="round" opacity=".72"/>`);
                }
            }
        }

        function renderAllTeeth(root) {
            root = root || document;
            var teeth = root.querySelectorAll(".tooth-box");
            teeth.forEach(renderTooth);
        }

        function initRealisticTeeth() { renderAllTeeth(document); }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initRealisticTeeth);
        } else {
            initRealisticTeeth();
        }

        window.initRealisticDentalTeeth = initRealisticTeeth;

        if (window.MutationObserver) {
            var observer = new MutationObserver(function (mutations) {
                var shouldRender = false;
                mutations.forEach(function (mutation) {
                    if (mutation.addedNodes && mutation.addedNodes.length) shouldRender = true;
                });
                if (shouldRender) {
                    window.requestAnimationFrame(function () { renderAllTeeth(document); });
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });
        }
    })();
</script>
