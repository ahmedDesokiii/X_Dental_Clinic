@model Dental.Modules.Patients.DTOs.DentalChartDto
@using Dental.Modules.Patients.Enums
@using static Dental.Constants.EnumHelper
@await Html.PartialAsync("_DentalArchStyles")
@{
    var pcPatientId = (int)(ViewBag.CurrentPatientId ?? 0);
    var pcIsBoth = (bool)(ViewBag.PcIsBothType ?? false);
    var pcDiagnoses = ViewBag.DiagnosisList as List<Dental.Models.Clinic.DiagnosisCatalog> ?? new();

    Dental.Models.Patient.ToothStatus StatusOf(int n) =>
        Model?.Teeth?.FirstOrDefault(t => t.ToothNumber == n)?.Status ?? Dental.Models.Patient.ToothStatus.Healthy;
}

