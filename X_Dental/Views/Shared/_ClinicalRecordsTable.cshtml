@model Dental.Modules.Clinical.ViewModels.SessionViewModel

<div class="session-workspace">
    <div class="section-card anim-fade-up anim-d1" style="margin-bottom:0;">
        <div class="section-head">
            <h4><i class="bi bi-grid-3x3-gap"></i> أسنان السيشن الحالي</h4>
            <span class="section-badge" id="recordsCountBadge">0 سن</span>
        </div>
        <div class="table-responsive custom-scroll" style="max-height:520px;">
            <table class="dc-table" id="recordsTable">
                <thead>
                    <tr>
                        <th style="width:50px">السن</th>
                        <th>الحالة</th>
                        <th>التشخيص</th>
                        <th>السعر</th>
                        @* <th>السطوح</th>
                        <th>الإجراء</th> *@
                        <th>الأشعة</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody id="recordsTableBody"></tbody>
            </table>
            <div class="empty-state" id="emptyRecordsMsg">
                <i class="bi bi-grid-3x3"></i>
                <p>لا يوجد أي سن مسجل في هذا السيشن حتى الآن.<br><small>اضغط على أي سن في الشارت لبدء التسجيل</small></p>
            </div>
        </div>
    </div>
</div>

<style>
    .session-workspace {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
</style>

<script>
    const STATUS_ID_TO_LABEL = {
        1: 'سليم', 2: 'تسوس', 3: 'معالج', 4: 'مفقود', 5: 'مخلوع', 6: 'مطمور',
        7: 'تاج', 8: 'جسر', 9: 'زرعة', 10: 'مكسور', 11: 'عصب', 12: 'حشوة'
    };
    const STATUS_ID_TO_COLOR = {
        1: '#0f9b8e', 2: '#ef4444', 3: '#3b82f6', 4: '#94a3b8', 5: '#1e293b',
        6: '#6366f1', 7: '#a855f7', 8: '#06b6d4', 9: '#ec4899', 10: '#f97316',
        11: '#f59e0b', 12: '#14b8a6'
    };

    function renderRecordsTable() {
        const tbody = document.getElementById('recordsTableBody');
        const emptyEl = document.getElementById('emptyRecordsMsg');
        const badgeEl = document.getElementById('recordsCountBadge');
        if (!tbody) return;

        const list = Object.values(window.pendingToothRecords || {}).sort((a, b) => a.ToothNumber - b.ToothNumber);
        tbody.innerHTML = '';

        list.forEach((r, idx) => {
            const tr = document.createElement('tr');
            tr.className = 'row-pending';
            tr.style.animation = `fadeInUp 0.4s ${idx * 0.05}s ease forwards`;
            tr.style.opacity = '0';
            const color = STATUS_ID_TO_COLOR[r.Status] || '#0f9b8e';
            tr.innerHTML = `
                <td><span class="tooth-chip">${r.ToothNumber}</span></td>
                <td><span style="color:${color};font-weight:700;">${STATUS_ID_TO_LABEL[r.Status] || '-'}</span></td>
                <td>${r.DiagnosisName || '-'}</td>
                <td><b>${r.DiagnosisPrice ? r.DiagnosisPrice.toLocaleString('en-EG') + ' م.ج' : '-'}</b></td>

                <td>${r.XRays && r.XRays.length ? '<i class="bi bi-image-fill" style="color:#0d9488;"></i> ' + r.XRays.length : '-'}</td>
                <td class="row-actions">
                    <button class="btn-sm" onclick="openToothModal(${r.ToothNumber})" title="تعديل"><i class="bi bi-pencil-square"></i></button>
                    <button class="btn-sm danger" onclick="removePendingTooth(${r.ToothNumber})" title="حذف"><i class="bi bi-trash3"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
        });

        if (badgeEl) {
            badgeEl.textContent = list.length + ' سن';
            badgeEl.style.animation = 'badgePop 0.4s ease';
            setTimeout(() => badgeEl.style.animation = '', 400);
        }
        if (emptyEl) emptyEl.style.display = list.length === 0 ? 'block' : 'none';

        if (window.renderPendingPaymentsSummary) window.renderPendingPaymentsSummary();
    }
    window.renderRecordsTable = renderRecordsTable;

    async function saveAndEndSession() {
        const teeth = Object.values(window.pendingToothRecords || {});
        const payments = window.pendingPayments || [];

        const confirmResult = await Swal.fire({
            title: 'إنهاء وحفظ السيشن؟',
            text: `سيتم حفظ ${teeth.length} سن و ${payments.length} دفعة، وإنهاء السيشن.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d9488',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'نعم، إنهاء وحفظ',
            cancelButtonText: 'إلغاء',
            reverseButtons: true,
            backdrop: 'rgba(10,40,42,0.4)',
            customClass: { popup: 'rounded-4' }
        });
        if (!confirmResult.isConfirmed) return;

        Swal.fire({
            title: 'جاري الحفظ...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading(),
            backdrop: 'rgba(10,40,42,0.4)',
            customClass: { popup: 'rounded-4' }
        });

        try {
            const payload = {
                PatientId: @Model.Patient.Id,
                VisitId: @Model.Visit.Id,
                ToothRecords: teeth,
                Payments: payments
            };

            const res = await fetch('/Clinical/FinishSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (!data.success) {
                Swal.fire({ title: 'خطأ', text: data.message || 'حدث خطأ أثناء الحفظ', icon: 'error', confirmButtonColor: '#dc2626', customClass: { popup: 'rounded-4' } });
                return;
            }

            Swal.fire({
                title: 'تم بنجاح',
                text: 'تم حفظ السيشن وإنهاؤه',
                icon: 'success',
                timer: 1600,
                showConfirmButton: false,
                backdrop: 'rgba(10,40,42,0.4)',
                customClass: { popup: 'rounded-4' }
            }).then(() => window.location.href = '/Patients/Details/@Model.Patient.Id');

        } catch (err) {
            Swal.fire({ title: 'خطأ', text: 'تعذر الاتصال بالسيرفر', icon: 'error', confirmButtonColor: '#dc2626', customClass: { popup: 'rounded-4' } });
        }
    }
    window.saveAndEndSession = saveAndEndSession;

    document.addEventListener('DOMContentLoaded', renderRecordsTable);
</script>
