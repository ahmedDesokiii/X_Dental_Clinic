@model Dental.Modules.Clinical.ViewModels.SessionViewModel

<div class="session-workspace">
    <div class="section-card anim-fade-up anim-d1" style="margin-bottom:0;">
        <div class="section-head">
            <h4><i class="bi bi-grid-3x3-gap"></i> Current Session Teeth</h4>
            <span class="section-badge" id="recordsCountBadge">0 <small>teeth</small></span>
        </div>
        <div class="table-responsive custom-scroll" style="max-height:520px;">
            <table class="dc-table" id="recordsTable">
                <thead>
                    <tr>
                        <th class="text-start"  style="width:70px">Tooth</th>
                        <th class="text-start" >Status</th>
                        <th class="text-start" >Diagnosis</th>
                        <th class="text-start" >Price</th>
                        <th class="text-start" >X-Rays</th>
                        <th class="text-start"  style="width:80px"></th>
                    </tr>
                </thead>
                <tbody id="recordsTableBody"></tbody>
            </table>
            <div class="empty-state" id="emptyRecordsMsg">
                <i class="bi bi-grid-3x3"></i>
                <p>No teeth recorded in this session yet.<br><small>Click any tooth on the chart to start</small></p>
            </div>
        </div>
    </div>
</div>

<style>
    .session-workspace {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    /* ⭐ Multi-Unit row */
    .row-group {
        background: linear-gradient(90deg, #f5f3ff, #fff) !important;
    }

        .row-group td:first-child {
            border-right: 3px solid #7c3aed;
        }

    .unit-range {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

        .unit-range .tooth-chip {
            width: auto;
            min-width: 34px;
            padding: 0 6px;
        }

        .unit-range i {
            color: #7c3aed;
            font-size: .7rem;
        }

    .units-badge {
        display: inline-block;
        margin-top: 4px;
        font-size: .66rem;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        padding: 2px 9px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .price-calc {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        color: #7c3aed;
    }
</style>

<script>
    const STATUS_ID_TO_LABEL = {
        1: 'Healthy', 2: 'Decayed', 3: 'Treated', 4: 'Missing', 5: 'Extracted', 6: 'Impacted',
        7: 'Crown', 8: 'Bridge', 9: 'Implant', 10: 'Fractured', 11: 'Root Canal', 12: 'Filling'
    };
    const STATUS_ID_TO_COLOR = {
        1: '#0f9b8e', 2: '#ef4444', 3: '#3b82f6', 4: '#94a3b8', 5: '#1e293b', 6: '#6366f1',
        7: '#a855f7', 8: '#06b6d4', 9: '#ec4899', 10: '#f97316', 11: '#f59e0b', 12: '#14b8a6'
    };

    function toothLbl(num) {
        const q = Math.floor(num / 10), p = num % 10;
        return ({ 1: 'UL', 2: 'UR', 3: 'LL', 4: 'LR' })[q] + '-' + p;
    }

    // ⭐ تحويل السجلات لصفوف عرض: السن الواحد صف، والمجموعة (Multi-Unit) صف واحد
    function buildDisplayRows(records) {
        const rows = [];
        const seenGroups = new Set();
        records.forEach(r => {
            if (!r.GroupId) { rows.push({ type: 'single', rec: r, sortKey: r.ToothNumber }); return; }
            if (seenGroups.has(r.GroupId)) return;
            seenGroups.add(r.GroupId);
            const recs = records.filter(x => x.GroupId === r.GroupId);
            const teeth = window.getGroupTeeth ? window.getGroupTeeth(r.GroupId) : recs.map(x => x.ToothNumber).sort((a, b) => a - b);
            rows.push({ type: 'group', recs, teeth, rec: recs[0], sortKey: Math.min(...teeth) });
        });
        return rows.sort((a, b) => a.sortKey - b.sortKey);
    }

    function renderRecordsTable() {
        const tbody = document.getElementById('recordsTableBody');
        const emptyEl = document.getElementById('emptyRecordsMsg');
        const badgeEl = document.getElementById('recordsCountBadge');
        if (!tbody) return;

        const list = window.pendingToothRecords || [];
        const rows = buildDisplayRows(list);
        tbody.innerHTML = '';

        rows.forEach((row, idx) => {
            const r = row.rec;
            const tr = document.createElement('tr');
            tr.style.animation = `fadeInUp 0.4s ${idx * 0.05}s ease forwards`;
            tr.style.opacity = '0';
            const color = STATUS_ID_TO_COLOR[r.Status] || '#0f9b8e';

            if (row.type === 'group') {
                const units = row.teeth.length;
                const total = (r.DiagnosisPrice || 0) * units;
                const xrayCount = row.recs.reduce((s, x) => s + (x.XRays ? x.XRays.length : 0), 0);
                tr.className = 'row-pending row-group';
                tr.innerHTML = `
                    <td>
                        <span class="unit-range">
                            <span class="tooth-chip">${toothLbl(row.teeth[0])}</span>
                            <i class="bi bi-arrow-left-right"></i>
                            <span class="tooth-chip">${toothLbl(row.teeth[units - 1])}</span>
                        </span>
                        <br /><span class="units-badge"><i class="bi bi-diagram-3"></i> ${units} units</span>
                    </td>
                    <td><span style="color:${color};font-weight:700;">${STATUS_ID_TO_LABEL[r.Status] || '-'}</span></td>
                    <td>${r.DiagnosisName || '-'}</td>
                    <td>
                        <b>${total ? total.toLocaleString('en-EG') + ' EGP' : '-'}</b>
                        ${r.DiagnosisPrice ? `<span class="price-calc">${r.DiagnosisPrice.toLocaleString('en-EG')} × ${units}</span>` : ''}
                    </td>
                    <td>${xrayCount ? '<i class="bi bi-image-fill" style="color:#0d9488;"></i> ' + xrayCount : '-'}</td>
                    <td class="row-actions">
                        <button class="btn-sm" onclick="openToothModal(${row.teeth[0]}, null, '${r.uid}')" title="Edit units"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn-sm danger" onclick="removePendingGroup('${r.GroupId}')" title="Delete units"><i class="bi bi-trash3"></i></button>
                    </td>
                `;
            } else {
                tr.className = 'row-pending';
                tr.innerHTML = `
                    <td><span class="tooth-chip">${toothLbl(r.ToothNumber)}</span></td>
                    <td><span style="color:${color};font-weight:700;">${STATUS_ID_TO_LABEL[r.Status] || '-'}</span></td>
                    <td>${r.DiagnosisName || '-'}</td>
                    <td><b>${r.DiagnosisPrice ? r.DiagnosisPrice.toLocaleString('en-EG') + ' EGP' : '-'}</b></td>
                    <td>${r.XRays && r.XRays.length ? '<i class="bi bi-image-fill" style="color:#0d9488;"></i> ' + r.XRays.length : '-'}</td>
                    <td class="row-actions">
                        <button class="btn-sm" onclick="openToothModal(${r.ToothNumber}, null, '${r.uid}')" title="Edit"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn-sm danger" onclick="removePendingRecord('${r.uid}')" title="Delete"><i class="bi bi-trash3"></i></button>
                    </td>
                `;
            }
            tbody.appendChild(tr);
        });

        if (badgeEl) {
            badgeEl.textContent = list.length + (list.length === 1 ? ' tooth' : ' teeth');
            badgeEl.style.animation = 'badgePop 0.4s ease';
            setTimeout(() => badgeEl.style.animation = '', 400);
        }
        if (emptyEl) emptyEl.style.display = list.length === 0 ? 'block' : 'none';

        if (window.renderPendingPaymentsSummary) window.renderPendingPaymentsSummary();
    }
    window.renderRecordsTable = renderRecordsTable;

    async function saveAndEndSession() {
        const teeth = window.pendingToothRecords || [];
        const payments = window.pendingPayments || [];

        const confirmResult = await Swal.fire({
            title: 'Finish & save session?',
            text: `This will save ${teeth.length} record(s) and ${payments.length} payment(s), then complete the session.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d9488',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Yes, finish & save',
            cancelButtonText: 'Cancel',
            reverseButtons: true,
            backdrop: 'rgba(10,40,42,0.4)',
            customClass: { popup: 'rounded-4' }
        });
        if (!confirmResult.isConfirmed) return;

        Swal.fire({
            title: 'Saving...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading(),
            backdrop: 'rgba(10,40,42,0.4)',
            customClass: { popup: 'rounded-4' }
        });

        try {
            const payload = {
                PatientId: @Model.Patient.Id,
                VisitId: @Model.Visit.Id,
                ToothRecords: teeth.map(({ uid, ...rest }) => rest), // ⭐ شيل الـ uid قبل الإرسال (GroupId بيتبعت)
                Payments: payments
            };

            const res = await fetch('/Clinical/FinishSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (!data.success) {
                Swal.fire({ title: 'Error', text: data.message || 'Something went wrong while saving', icon: 'error', confirmButtonColor: '#dc2626', customClass: { popup: 'rounded-4' } });
                return;
            }

            Swal.fire({
                title: 'Done!',
                text: 'Session saved & completed successfully',
                icon: 'success',
                timer: 1600,
                showConfirmButton: false,
                backdrop: 'rgba(10,40,42,0.4)',
                customClass: { popup: 'rounded-4' }
            }).then(() => window.location.href = '/Patients/Details/@Model.Patient.Id');

        } catch (err) {
            Swal.fire({ title: 'Error', text: 'Could not reach the server', icon: 'error', confirmButtonColor: '#dc2626', customClass: { popup: 'rounded-4' } });
        }
    }
    window.saveAndEndSession = saveAndEndSession;

    document.addEventListener('DOMContentLoaded', renderRecordsTable);
</script>
