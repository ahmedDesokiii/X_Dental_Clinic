@* ============================================================
   Views/Shared/_ClinicalRecordsTable.cshtml
   عرض كامل تحت الصف التلاتي (نظرة عامة / الشارت / المدفوعات)
   فيه: جدول سجل السيشن + شريط الإجراء النهائي (حفظ + إنهاء + رجوع + طباعة)
   ============================================================ *@
@model Dental.Modules.Clinical.ViewModels.SessionViewModel

<div class="records-section">
    <div class="records-head">
        <h4><i class="bi bi-table"></i> سجل هذا السيشن</h4>
        <span class="records-count" id="recordsCount">0 سن مسجل</span>
    </div>
    <div class="table-responsive">
        <table class="records-table" id="recordsTable">
            <thead>
                <tr>
                    <th>السن</th>
                    <th>الحالة</th>
                    <th>التشخيص</th>
                    <th>السطوح</th>
                    <th>الإجراء</th>
                    <th>الأشعة</th>
                    <th>الروشتة</th>
                    <th>ملاحظات</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="recordsTableBody">
                @foreach (var d in Model.DentalHistory.OrderByDescending(x => x.Date))
                {
                    <tr class="row-saved">
                        <td><span class="tooth-chip">@d.ToothNumber</span></td>
                        <td>@d.Status</td>
                        <td>-</td>
                        <td>-</td>
                        <td>@d.ProcedureCode</td>
                        <td>-</td>
                        <td>-</td>
                        <td>@d.Notes</td>
                        <td><span class="badge-saved">محفوظ سابقاً</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="empty-records" id="emptyRecordsMsg" style="@(Model.DentalHistory.Any() ? "display:none;" : "")">
            لا يوجد أي سن مسجل في هذا السيشن حتى الآن.
        </div>
    </div>
</div>

<div class="final-save-bar" hidden>
    <div class="final-actions-secondary">
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.Patient.Id" class="btn-hero btn-hero-back-sm">
            <i class="bi bi-arrow-right"></i> رجوع لملف المريض
        </a>
        <button type="button" class="btn-hero btn-hero-print-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> طباعة
        </button>
    </div>
    <button type="button" class="btn-final-save" onclick="saveAndEndSession()">
        <i class="bi bi-check-circle"></i> إنهاء وحفظ السيشن (<span id="finalSaveCount">0</span>)
    </button>
</div>

<style>
    .records-section {
        background: rgba(255,255,255,.9);
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.6);
        box-shadow: 0 10px 34px rgba(10,77,79,.08);
        padding: 18px 20px;
        margin-top: 20px;
    }

    .records-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .records-head h4 {
            margin: 0;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1.05rem;
        }

    .records-count {
        font-size: .8rem;
        font-weight: 700;
        color: #0d9488;
        background: #f0fdfa;
        padding: 4px 12px;
        border-radius: 999px;
    }

    .records-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .records-table th {
            text-align: right;
            padding: 10px 8px;
            color: #64748b;
            font-weight: 700;
            border-bottom: 2px solid #f1f5f9;
            white-space: nowrap;
        }

        .records-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
            vertical-align: middle;
        }

    .row-pending {
        background: #fffbeb;
    }

    .tooth-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg,#ede9fe,#ddd6fe);
        color: #5b21b6;
        font-weight: 800;
    }

    .badge-saved {
        font-size: .72rem;
        font-weight: 700;
        color: #16a34a;
        background: #f0fdf4;
        padding: 3px 8px;
        border-radius: 6px;
    }

    .badge-pending {
        font-size: .72rem;
        font-weight: 700;
        color: #b45309;
        background: #fef3c7;
        padding: 3px 8px;
        border-radius: 6px;
        margin-left: 6px;
    }

    .row-actions button {
        border: none;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        padding: 4px 6px;
    }

        .row-actions button:hover {
            color: #0d9488;
        }

        .row-actions button.danger:hover {
            color: #dc2626;
        }

    .empty-records {
        text-align: center;
        color: #94a3b8;
        padding: 20px;
        font-size: .88rem;
    }

    /* ---- Final Save Bar ---- */
    .final-save-bar {
        position: sticky;
        bottom: 12px;
        z-index: 50;
        background: rgba(255,255,255,.97);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(226,232,240,.9);
        border-radius: 16px;
        padding: 14px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 16px;
        box-shadow: 0 12px 32px rgba(10,77,79,.14);
    }

    .final-actions-secondary {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-hero-back-sm, .btn-hero-print-sm {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 9px 16px;
        border-radius: 10px;
        font-weight: 700;
        font-size: .82rem;
        border: none;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-hero-back-sm {
        background: #f1f5f9;
        color: #334155;
    }

        .btn-hero-back-sm:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    .btn-hero-print-sm {
        background: #f0fdfa;
        color: #0d9488;
    }

        .btn-hero-print-sm:hover {
            background: #ccfbf1;
        }

    .btn-final-save {
        background: linear-gradient(135deg, #0d9488, #059669);
        color: #fff;
        border: none;
        padding: 12px 28px;
        border-radius: 12px;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(13,148,136,.35);
        transition: all .2s;
    }

        .btn-final-save:hover {
            transform: translateY(-2px);
        }
</style>
