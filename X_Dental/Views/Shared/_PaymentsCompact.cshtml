        justify-content: center;
        gap: 6px;
        border: 1.5px solid #f1f5f9;
        border-radius: 10px;
        padding: 9px 6px;
        font-size: .74rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        transition: all .2s ease;
        background: #fff;
    }

        .pay-method-chip input {
            display: none;
        }

        .pay-method-chip i {
            font-size: .95rem;
        }

        .pay-method-chip.selected {
            border-color: #0d9488;
            background: #f0fdfa;
            color: #0d9488;
            box-shadow: 0 3px 10px rgba(13,148,136,0.15);
        }

        .pay-method-chip:hover:not(.selected) {
            border-color: #cbd5e1;
        }

    .dc-input-line {
        width: 100%;
        padding: 9px 12px;
        border: 1.5px solid #f1f5f9;
        border-radius: 10px;
        background: #f8fafc;
        font-size: .8rem;
        outline: none;
        transition: all .2s;
    }

        .dc-input-line:focus {
            border-color: #0d9488;
            box-shadow: 0 0 0 3px rgba(13,148,136,.1);
        }

    .dc-btn {
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        font-size: .85rem;
        border: none;
        cursor: pointer;
        transition: all .2s;
    }

    .dc-btn-primary {
        background: linear-gradient(135deg, #0d9488, #0d7377);
        color: #fff;
        box-shadow: 0 6px 18px rgba(13,115,119,0.25);
    }

        .dc-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(13,115,119,0.35);
        }

    .dc-btn-secondary {
        background: #f1f5f9;
        color: #475569;
    }

        .dc-btn-secondary:hover {
            background: #e2e8f0;
        }
</style>

<script>
    window.pendingPayments = window.pendingPayments || [];

    function openPaymentModal() {
        document.getElementById('paymentModal').style.display = 'flex';
        document.getElementById('payAmount').focus();
    }
    function closePaymentModal() {
        document.getElementById('paymentModal').style.display = 'none';
        document.getElementById('payAmount').value = '';
        document.getElementById('payDiscount').value = '';
        document.getElementById('payDesc').value = '';
    }

    document.querySelectorAll('#payMethodTiles .pay-method-chip').forEach(function(tile) {
        tile.addEventListener('click', function() {
            document.querySelectorAll('#payMethodTiles .pay-method-chip').forEach(t => t.classList.remove('selected'));
            tile.classList.add('selected');
            tile.querySelector('input').checked = true;
        });
    });

    function methodLabel(m) {
        return { Cash: 'نقدي', CreditCard: 'فيزا', BankTransfer: 'تحويل' }[m] || m;
    }

    function submitPayment() {
        const amount = parseFloat(document.getElementById('payAmount').value) || 0;
        const discount = parseFloat(document.getElementById('payDiscount').value) || 0;

        if (amount <= 0 && discount <= 0) {
            Swal.fire({ title: 'تنبيه', text: 'أدخل مبلغ الدفعة أو الخصم', icon: 'warning', confirmButtonColor: '#0d9488', customClass: { popup: 'rounded-4' } });
            return;
        }
        const method = document.querySelector('#payMethodTiles input:checked').value;
        const description = document.getElementById('payDesc').value;

        window.pendingPayments.push({ Amount: amount, Discount: discount, Method: method, Description: description });

        renderPendingPaymentsSummary();
        if (window.renderRecordsTable) window.renderRecordsTable();
        closePaymentModal();

        Swal.fire({
            toast: true, position: 'top-end', icon: 'success',
            title: 'تمت إضافة الدفعة', showConfirmButton: false, timer: 1500,
            customClass: { popup: 'rounded-4' }
        });
    }

    function removePendingPayment(idx) {
        window.pendingPayments.splice(idx, 1);
        renderPendingPaymentsSummary();
        if (window.renderRecordsTable) window.renderRecordsTable();
    }
    window.removePendingPayment = removePendingPayment;

    function renderPendingPaymentsRows() {
        const wrap = document.getElementById('pendingPaymentsRows');
        if (!wrap) return;
        wrap.innerHTML = '';
        (window.pendingPayments || []).forEach((p, idx) => {
            const row = document.createElement('div');
            row.className = 'pay-history-item';
            row.style.background = '#fffbeb';
            row.style.borderColor = '#fde68a';
            row.innerHTML = `
                        <div class="pay-h-left">
                            <b>${p.Amount.toLocaleString('en-EG')} م.ج</b>
                            <span class="pay-h-method">${methodLabel(p.Method)}</span>
                            ${p.Discount > 0 ? `<span class="pay-h-discount">خصم ${p.Discount.toLocaleString('en-EG')}</span>` : ''}
                            <span class="badge-pending-pay">قيد الحفظ</span>
                        </div>
                        <div class="pay-h-right" style="display:flex; align-items:center; gap:8px;">
                            <small style="color:#64748b;">${p.Description || '-'}</small>
                            <button class="btn-sm danger" onclick="removePendingPayment(${idx})" title="حذف"><i class="bi bi-trash3"></i></button>
                        </div>
                    `;
            wrap.appendChild(row);
        });
    }
    window.renderPendingPaymentsRows = renderPendingPaymentsRows;

    function renderPendingPaymentsSummary() {
        const baseTotal = @(Model.Visit.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const basePaid = @(Model.Visit.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const baseDiscount = @(Model.Visit.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture));

        const pendingDiagnosisTotal = window.pendingToothRecords
            ? Object.values(window.pendingToothRecords).reduce((sum, t) => sum + (t.DiagnosisPrice || 0), 0)
            : 0;
        const pendingPaidTotal = window.pendingPayments.reduce((sum, p) => sum + p.Amount, 0);
        const pendingDiscountTotal = window.pendingPayments.reduce((sum, p) => sum + (p.Discount || 0), 0);

        const newTotal = baseTotal + pendingDiagnosisTotal;
        const newDiscount = baseDiscount + pendingDiscountTotal;
        const newPaid = basePaid + pendingPaidTotal;
        const newRemaining = newTotal - newDiscount - newPaid;

        const fmt = n => n.toLocaleString('en-EG');
        const totalEl = document.getElementById('paySummaryTotal');
        const paidEl = document.getElementById('paySummaryPaid');
        const remainingEl = document.getElementById('paySummaryRemaining');
        const discountEl = document.getElementById('paySummaryDiscount');
        if (totalEl) totalEl.innerHTML = fmt(newTotal) + ' <small>م.ج</small>';
        if (paidEl) paidEl.innerHTML = fmt(newPaid) + ' <small>م.ج</small>';
        if (remainingEl) remainingEl.innerHTML = fmt(newRemaining) + ' <small>م.ج</small>';
        if (discountEl) discountEl.innerHTML = fmt(newDiscount) + ' <small>م.ج</small>';

        renderPendingPaymentsRows();
    }
    window.renderPendingPaymentsSummary = renderPendingPaymentsSummary;

    document.addEventListener('DOMContentLoaded', renderPendingPaymentsRows);
</script>