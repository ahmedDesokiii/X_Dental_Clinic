</style>

<script>
    window.pendingPayments = window.pendingPayments || [];

    // ════════════════════════════════════════════════
    // ⭐ مصدر واحد للأرقام — تاب المدفوعات + المودال + الـ Bottom Bar
    // ════════════════════════════════════════════════
    window.SESSION_PAY_BASE = {
        total: @Model.Visit.TotalAmount.ToString(inv),
        paid: @Model.Visit.PaidAmount.ToString(inv),
        discount: @Model.Visit.Discount.ToString(inv),
        prevBalance: @Model.PreviousBalance.ToString(inv),
        isOrtho: @(isOrthoPay ? "true" : "false")
            };

    function payPendingRecords() {
        const r = window.pendingToothRecords;
        if (!r) return [];
        return Array.isArray(r) ? r : Object.values(r);
    }

    window.computeSessionTotals = function () {
        const b = window.SESSION_PAY_BASE;
        const pays = window.pendingPayments || [];

        // كل سن في الـ Multi-Unit سجل لوحده بسعره → المجموع = السعر × عدد الوحدات تلقائيًا
        const pendingDiag = payPendingRecords().reduce((s, t) => s + (t.DiagnosisPrice || 0), 0);
        const pendingPaid = pays.reduce((s, p) => s + (p.Amount || 0), 0);
        const pendingDiscount = pays.reduce((s, p) => s + (p.Discount || 0), 0);

        const todayTotal = b.total + pendingDiag;
        const todayDiscount = b.discount + pendingDiscount;
        const todayPaid = b.paid + pendingPaid;
        const todayNet = todayTotal - todayDiscount - todayPaid;      // ممكن يبقى سالب لو دفع زيادة
        const prevBalance = b.isOrtho ? 0 : b.prevBalance;

        // الزيادة عن مطلوب اليوم بتسدد الزيارات القديمة (FIFO في FinishSession)
        const excess = todayNet < 0 ? -todayNet : 0;
        const settlesOld = Math.min(excess, Math.max(0, prevBalance));

        return {
            todayTotal, todayDiscount, todayPaid,
            todayRemaining: Math.max(0, todayNet),
            todayNet,
            prevBalance,
            settlesOld,
            patientRemaining: prevBalance + todayNet
        };
    };

    const payFmt = n => (Math.round(n * 100) / 100).toLocaleString('en-EG');
    const payEsc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // ⭐ تشخيصات اليوم: المجموعة (GroupId) سطر واحد — التشخيص العادي سطر لكل سجل
    function renderTodayDiagnoses() {
        const wrap = document.getElementById('todayDiagRows');
        if (!wrap) return;

        const lines = [];
        const groups = new Map();
        payPendingRecords().forEach(r => {
            if (!r.DiagnosisCatalogId && !(r.DiagnosisPrice > 0)) return; // سجل حالة بس من غير تشخيص
            if (r.GroupId) {
                if (!groups.has(r.GroupId)) {
                    const g = { name: r.DiagnosisName, price: r.DiagnosisPrice || 0, teeth: [] };
                    groups.set(r.GroupId, g);
                    lines.push(g);
                }
                groups.get(r.GroupId).teeth.push(r.ToothNumber);
            } else {
                lines.push({ name: r.DiagnosisName, price: r.DiagnosisPrice || 0, teeth: [r.ToothNumber] });
            }
        });

        const b = window.SESSION_PAY_BASE;
        let html = '';

        // اللي اتحفظ قبل كده على نفس الزيارة (مثلاً من شاشة المريض)
        if (b.total > 0) {
            html += `<div class="today-diag-row saved">
                                <div><span class="td-name">مسجّل مسبقًا على الزيارة</span></div>
                                <div class="td-amount"><b>${payFmt(b.total)}</b></div>
                             </div>`;
        }

        lines.forEach(l => {
            const units = l.teeth.length;
            const isGroup = units > 1;
            const teethLabel = isGroup && window.groupRangeLabel
                ? window.groupRangeLabel(l.teeth)
                : l.teeth.join(' · ');
            html += `<div class="today-diag-row">
                                <div>
                                    <span class="td-name">${payEsc(l.name || 'تشخيص')}</span>${isGroup ? `<span class="td-mu">${units} units</span>` : ''}
                                    <span class="td-teeth"><i class="bi bi-grid-3x3-gap"></i> ${payEsc(teethLabel)}</span>
                                </div>
                                <div class="td-amount">
                                    <b>${payFmt(l.price * units)}</b>
                                    ${isGroup ? `<small>${payFmt(l.price)} × ${units}</small>` : ''}
                                </div>
                             </div>`;
        });

        if (!html) html = `<div class="today-diag-empty">لسه مفيش تشخيصات في السيشن دي.</div>`;
        wrap.innerHTML = html;

        const countEl = document.getElementById('todayDiagCount');
        if (countEl) countEl.textContent = lines.reduce((s, l) => s + l.teeth.length, 0);
        const totalEl = document.getElementById('todayDiagTotal');
        if (totalEl) totalEl.textContent = payFmt(window.computeSessionTotals().todayTotal);
    }
    window.renderTodayDiagnoses = renderTodayDiagnoses;

    function fillPayAmount(kind) {
        const t = window.computeSessionTotals();
        const v = kind === 'patient' ? Math.max(0, t.patientRemaining) : t.todayRemaining;
        document.getElementById('payAmount').value = v > 0 ? v : '';
        updateExcessHint();
    }
    window.fillPayAmount = fillPayAmount;

    // ⭐ تنبيه لو المبلغ أكبر من متبقي اليوم → الزيادة هتسدد زيارات قديمة
    function updateExcessHint() {
        const hint = document.getElementById('payExcessHint');
        if (!hint) return;
        const t = window.computeSessionTotals();
        const amount = parseFloat(document.getElementById('payAmount').value) || 0;
        const discount = parseFloat(document.getElementById('payDiscount').value) || 0;
        const dueToday = Math.max(0, t.todayRemaining - discount);
        const excess = amount - dueToday;

        if (!t.prevBalance || t.prevBalance <= 0 || excess <= 0 || window.SESSION_PAY_BASE.isOrtho) {
            hint.style.display = 'none';
            return;
        }
        const toOld = Math.min(excess, Math.max(0, t.prevBalance - t.settlesOld));
        hint.innerHTML = `<i class="bi bi-arrow-repeat"></i> ${payFmt(Math.min(amount, dueToday))} لليوم + ${payFmt(toOld)} لسداد زيارات سابقة (الأقدم أولاً)`;
        hint.style.display = '';
    }

    function openPaymentModal() {
        const t = window.computeSessionTotals();
        const qToday = document.getElementById('payQuickToday');
        const qPatient = document.getElementById('payQuickPatient');
        if (qToday) qToday.textContent = payFmt(t.todayRemaining);
        if (qPatient) qPatient.textContent = payFmt(Math.max(0, t.patientRemaining));
        updateExcessHint();

        document.getElementById('paymentModal').style.display = 'flex';
        document.getElementById('payAmount').focus();
    }
    function closePaymentModal() {
        document.getElementById('paymentModal').style.display = 'none';
        document.getElementById('payAmount').value = '';
        document.getElementById('payDiscount').value = '';
        document.getElementById('payDesc').value = '';
        const hint = document.getElementById('payExcessHint');
        if (hint) hint.style.display = 'none';
    }

    document.getElementById('payAmount').addEventListener('input', updateExcessHint);
    document.getElementById('payDiscount').addEventListener('input', updateExcessHint);

    document.querySelectorAll('#payMethodTiles .pay-method-chip').forEach(function (tile) {
        tile.addEventListener('click', function () {
            document.querySelectorAll('#payMethodTiles .pay-method-chip').forEach(t => t.classList.remove('selected'));
            tile.classList.add('selected');
            tile.querySelector('input').checked = true;
        });
    });

    function methodLabel(m) {
        return { Cash: 'نقدي', CreditCard: 'فيزا', BankTransfer: 'تحويل' }[m] || m;
    }

    function submitPayment() {
        const amount = parseFloat(document.getElementById('payAmount').value) || 0;
        const discount = parseFloat(document.getElementById('payDiscount').value) || 0;

        if (amount <= 0 && discount <= 0) {
            Swal.fire({ title: 'تنبيه', text: 'أدخل مبلغ الدفعة أو الخصم', icon: 'warning', confirmButtonColor: '#0d9488', customClass: { popup: 'rounded-4' } });
            return;
        }
        const method = document.querySelector('#payMethodTiles input:checked').value;
        const description = document.getElementById('payDesc').value;

        window.pendingPayments.push({ Amount: amount, Discount: discount, Method: method, Description: description });

        renderPendingPaymentsSummary();
        if (window.renderRecordsTable) window.renderRecordsTable();
        closePaymentModal();

        Swal.fire({
            toast: true, position: 'top-end', icon: 'success',
            title: 'تمت إضافة الدفعة', showConfirmButton: false, timer: 1500,
            customClass: { popup: 'rounded-4' }
        });
    }

    function removePendingPayment(idx) {
        window.pendingPayments.splice(idx, 1);
        renderPendingPaymentsSummary();
        if (window.renderRecordsTable) window.renderRecordsTable();
    }
    window.removePendingPayment = removePendingPayment;

    function renderPendingPaymentsRows() {
        const wrap = document.getElementById('pendingPaymentsRows');
        if (!wrap) return;
        wrap.innerHTML = '';
        (window.pendingPayments || []).forEach((p, idx) => {
            const row = document.createElement('div');
            row.className = 'pay-history-item';
            row.style.background = '#fffbeb';
            row.style.borderColor = '#fde68a';
            row.innerHTML = `
                                <div class="pay-h-left">
                                    <b>${p.Amount.toLocaleString('en-EG')} م.ج</b>
                                    <span class="pay-h-method">${methodLabel(p.Method)}</span>
                                    ${p.Discount > 0 ? `<span class="pay-h-discount">خصم ${p.Discount.toLocaleString('en-EG')}</span>` : ''}
                                    <span class="badge-pending-pay">قيد الحفظ</span>
                                </div>
                                <div class="pay-h-right" style="display:flex; align-items:center; gap:8px;">
                                    <small style="color:#64748b;">${p.Description || '-'}</small>
                                    <button class="btn-sm danger" onclick="removePendingPayment(${idx})" title="حذف"><i class="bi bi-trash3"></i></button>
                                </div>
                            `;
            wrap.appendChild(row);
        });
    }
    window.renderPendingPaymentsRows = renderPendingPaymentsRows;

    function renderPendingPaymentsSummary() {
        const t = window.computeSessionTotals();
        const setHtml = (id, v) => { const el = document.getElementById(id); if (el) el.innerHTML = payFmt(v) + ' <small>م.ج</small>'; };
        const setText = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = payFmt(v); };

        setHtml('paySummaryTotal', t.todayTotal);
        setHtml('paySummaryPaid', t.todayPaid);
        setHtml('paySummaryDiscount', t.todayDiscount);
        setHtml('paySummaryRemaining', t.todayRemaining);

        // رصيد المريض الكلي
        setText('payPrevBalance', t.prevBalance);
        setText('payTodayRemainingStrip', t.todayNet);
        setHtml('payPatientRemaining', t.patientRemaining);

        const note = document.getElementById('payOldSettleNote');
        if (note) {
            if (t.settlesOld > 0) {
                note.innerHTML = `<i class="bi bi-arrow-repeat"></i> ${payFmt(t.settlesOld)} م.ج من مدفوع اليوم هتسدد زيارات سابقة عند حفظ السيشن (الأقدم أولاً)`;
                note.style.display = '';
            } else {
                note.style.display = 'none';
            }
        }

        renderTodayDiagnoses();
        renderPendingPaymentsRows();
    }
    window.renderPendingPaymentsSummary = renderPendingPaymentsSummary;

    document.addEventListener('DOMContentLoaded', () => {
        renderPendingPaymentsRows();
        renderTodayDiagnoses();
    });
</script>