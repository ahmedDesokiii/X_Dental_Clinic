        }

        .pay-stat-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(10,77,79,0.06);
        }

        .pay-stat-box.highlight {
            background: linear-gradient(180deg, #fef2f2, #fee2e2);
            border-color: #fecaca;
        }

            .pay-stat-box.highlight::before {
                background: linear-gradient(90deg, #dc2626, #f87171);
                opacity: .6;
            }

    .pay-stat-icon {
        font-size: 1rem;
        opacity: .55;
        margin-bottom: 4px;
        color: #0d9488;
    }

    .pay-stat-label {
        font-size: .7rem;
        font-weight: 700;
        color: #94a3b8;
        display: block;
        margin-bottom: 4px;
    }

    .pay-stat-value {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

        .pay-stat-value small {
            font-size: .7rem;
            font-weight: 600;
            opacity: .7;
        }

    .pay-history {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .pay-history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fafcfd;
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        padding: 8px 12px;
        transition: all 0.2s ease;
        animation: fadeInUp 0.3s ease forwards;
    }

        .pay-history-item:hover {
            background: #f0fdfa;
            border-color: #ccf3ec;
            transform: translateX(-2px);
        }

    .pay-h-left {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .pay-h-left b {
            color: #0d9488;
            font-size: .85rem;
        }

    .pay-h-icon {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        background: #f0fdfa;
        color: #0d9488;
