@* ============================================================
   Views/Shared/_PaymentsCompact.cshtml
   عمود المدفوعات — ملخص الحساب + سجل المدفوعات القديمة + مدفوعات هذا السيشن (مؤقت)
   ============================================================ *@
@model Dental.Modules.Clinical.ViewModels.SessionViewModel

<div class="side-panel">

    @if (Model.ShowCategoryBreakdown)
    {
        <div class="side-panel-head">
            <i class="bi bi-collection"></i> إجمالي حساب المريض (كل الملفين)
        </div>

        @foreach (var cat in Model.CategoryBreakdown)
        {
            <div class="mini-card pay-summary category-summary">
                <div class="category-summary-title">
                    <i class="bi @cat.Icon"></i> @cat.CategoryName
                </div>
                <div class="pay-summary-row">
                    <span>الإجمالي</span><b>@cat.TotalAmount.ToString("N0") م.ج</b>
                </div>
                <div class="pay-summary-row">
                    <span>الخصم</span><b>@cat.Discount.ToString("N0") م.ج</b>
                </div>
                <div class="pay-summary-row paid">
                    <span>المدفوع</span><b>@cat.PaidAmount.ToString("N0") م.ج</b>
                </div>
                <div class="pay-summary-row remaining">
                    <span>المتبقي</span><b>@cat.Remaining.ToString("N0") م.ج</b>
                </div>
            </div>
        }

        <div class="mini-card pay-summary grand-total">
            <div class="category-summary-title">
                <i class="bi bi-calculator"></i> الإجمالي الكلي (عام + تقويم)
            </div>
            <div class="pay-summary-row">
                <span>الإجمالي</span><b>@Model.CategoryBreakdown.Sum(c => c.TotalAmount).ToString("N0") م.ج</b>
            </div>
            <div class="pay-summary-row">
                <span>الخصم</span><b>@Model.CategoryBreakdown.Sum(c => c.Discount).ToString("N0") م.ج</b>
            </div>
            <div class="pay-summary-row paid">
                <span>المدفوع</span><b>@Model.CategoryBreakdown.Sum(c => c.PaidAmount).ToString("N0") م.ج</b>
            </div>
            <div class="pay-summary-row remaining">
                <span>المتبقي</span><b>@Model.CategoryBreakdown.Sum(c => c.Remaining).ToString("N0") م.ج</b>
            </div>
        </div>
    }

    <div class="side-panel-head">
        <i class="bi bi-credit-card-2-front"></i> مدفوعات هذه الزيارة
    </div>

    <div class="mini-card pay-summary">
        <div class="pay-summary-row">
            <span>الإجمالي</span><b id="paySummaryTotal">@Model.Visit.TotalAmount.ToString("N0") م.ج</b>
        </div>
        <div class="pay-summary-row">
            <span>الخصم</span><b>@Model.Visit.Discount.ToString("N0") م.ج</b>
        </div>
        <div class="pay-summary-row paid">
            <span>المدفوع</span><b id="paySummaryPaid">@Model.Visit.PaidAmount.ToString("N0") م.ج</b>
        </div>
        <div class="pay-summary-row remaining">
            <span>المتبقي</span><b id="paySummaryRemaining">@Model.Visit.Remaining.ToString("N0") م.ج</b>
        </div>
        <button class="btn-add-payment-sm" onclick="openPaymentModal()">
            <i class="bi bi-plus-lg"></i> تسجيل دفعة
        </button>
    </div>

    <div class="mini-card pay-list-card">
        <div class="mini-card-title">
            <i class="bi bi-list-ul"></i> سجل المدفوعات السابق (@Model.Visit.Payments.Count)
        </div>
        <div class="pay-list">
            @foreach (var p in Model.Visit.Payments.OrderByDescending(x => x.PaymentDate))
            {
                <div class="pay-item">
                    <div class="pay-item-top">
                        <b>@p.Amount.ToString("N0") م.ج</b>
                        <span class="pay-method">@p.Method</span>
                    </div>
                    <div class="pay-item-desc">@p.Description</div>
                    <div class="pay-item-date"><i class="bi bi-calendar"></i> @p.PaymentDate.ToString("dd/MM HH:mm")</div>
                </div>
            }
            @if (!Model.Visit.Payments.Any())
            {
                <div class="pay-empty">لا توجد مدفوعات مسجلة بعد.</div>
            }
        </div>
    </div>
</div>

<!-- Payment Modal — فورم أبسط، حفظ مؤقت -->
<div class="payment-modal" id="paymentModal" style="display:none;">
    <div class="modal-overlay" onclick="closePaymentModal()"></div>
    <div class="modal-glass payment-modal-glass">
        <h5><i class="bi bi-cash-stack"></i> تسجيل دفعة جديدة</h5>

        <div class="pay-amount-input-wrap">
            <input type="number" class="pay-amount-input" id="payAmount" placeholder="0" />
            <span class="pay-amount-suffix">م.ج</span>
        </div>

        <div class="pay-method-tiles" id="payMethodTiles">
            <label class="pay-method-tile selected" data-method="Cash">
                <input type="radio" name="payMethod" value="Cash" checked />
                <i class="bi bi-cash-coin"></i> نقدي
            </label>
            <label class="pay-method-tile" data-method="CreditCard">
                <input type="radio" name="payMethod" value="CreditCard" />
                <i class="bi bi-credit-card"></i> فيزا
            </label>
            <label class="pay-method-tile" data-method="BankTransfer">
                <input type="radio" name="payMethod" value="BankTransfer" />
                <i class="bi bi-bank"></i> تحويل
            </label>
        </div>

        <textarea class="form-glass mt-2" id="payDesc" rows="2" placeholder="ملاحظة (اختياري)..."></textarea>

        <div class="modal-actions mt-3">
            <button class="btn-glass btn-cancel" onclick="closePaymentModal()">إلغاء</button>
            <button class="btn-glass btn-save" onclick="submitPayment()">إضافة الدفعة</button>
        </div>
    </div>
</div>

<style>
    .category-summary-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
        font-size: .82rem;
        color: #0b2e30;
        margin-bottom: 6px;
    }

    .category-summary {
        border: 1px solid #f1f5f9;
        margin-bottom: 10px;
    }

    .grand-total {
        background: linear-gradient(160deg, #f0fdfa, #eafbfc);
        border: 1px solid #99f6e4;
    }

    .pay-summary-row {
        display: flex;
        justify-content: space-between;
        font-size: .82rem;
        padding: 6px 0;
        color: #475569;
    }

        .pay-summary-row b {
            color: #0f172a;
        }

        .pay-summary-row.paid b {
            color: #16a34a;
        }

        .pay-summary-row.remaining {
            border-top: 1px dashed #e2e8f0;
            margin-top: 4px;
            padding-top: 8px;
        }

            .pay-summary-row.remaining b {
                color: #dc2626;
                font-size: .95rem;
            }

    .btn-add-payment-sm {
        width: 100%;
        margin-top: 10px;
        background: linear-gradient(135deg, #0d9488, #0891b2);
        color: #fff;
        border: none;
        padding: 9px 12px;
        border-radius: 10px;
        font-weight: 700;
        font-size: .82rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .pay-list-card {
        flex: 1;
        overflow-y: auto;
    }

    .pay-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 260px;
        overflow-y: auto;
    }

    .pay-item {
        border: 1px solid #f1f5f9;
        border-radius: 10px;
        padding: 8px 10px;
        background: #fafcfd;
    }

    .pay-item-top {
        display: flex;
        justify-content: space-between;
        font-size: .82rem;
    }

    .pay-method {
        font-size: .68rem;
        background: #f0fdfa;
        color: #0d9488;
        padding: 1px 8px;
        border-radius: 6px;
        font-weight: 700;
    }

    .pay-item-desc {
        font-size: .74rem;
        color: #64748b;
        margin-top: 3px;
    }

    .pay-item-date {
        font-size: .7rem;
        color: #94a3b8;
        margin-top: 3px;
    }

    .pay-empty {
        text-align: center;
        color: #94a3b8;
        font-size: .8rem;
        padding: 12px;
    }

    .pay-item.pay-item-pending {
        background: #fffbeb;
        border-color: #fde68a;
    }

    /* ---- Payment Modal الجديد ---- */
    .payment-modal-glass {
        max-width: 380px;
    }

    .pay-amount-input-wrap {
        position: relative;
        margin: 14px 0;
    }

    .pay-amount-input {
        width: 100%;
        text-align: center;
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        border: none;
        border-bottom: 2px solid #e2e8f0;
        padding: 10px 0;
        outline: none;
        transition: border-color .15s ease;
    }

        .pay-amount-input:focus {
            border-color: #0d9488;
        }

    .pay-amount-suffix {
        position: absolute;
        left: 0;
        bottom: 14px;
        font-size: .8rem;
        color: #94a3b8;
        font-weight: 700;
    }

    .pay-method-tiles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .pay-method-tile {
        border: 2px solid #f1f5f9;
        border-radius: 12px;
        padding: 10px 6px;
        text-align: center;
        font-size: .78rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        transition: all .15s ease;
    }

        .pay-method-tile input {
            display: none;
        }

        .pay-method-tile i {
            font-size: 1.1rem;
        }

        .pay-method-tile.selected {
            border-color: #0d9488;
            background: #f0fdfa;
            color: #0d9488;
        }
</style>

<script>
    // ============================================================
    // مدفوعات مؤقتة (لحد "إنهاء وحفظ السيشن")
    // ============================================================
    window.pendingPayments = window.pendingPayments || [];

    function openPaymentModal() {
        document.getElementById('paymentModal').style.display = 'flex';
    }

    function closePaymentModal() {
        document.getElementById('paymentModal').style.display = 'none';
        document.getElementById('payAmount').value = '';
        document.getElementById('payDesc').value = '';
    }

    document.querySelectorAll('#payMethodTiles .pay-method-tile').forEach(function (tile) {
        tile.addEventListener('click', function () {
            document.querySelectorAll('#payMethodTiles .pay-method-tile').forEach(t => t.classList.remove('selected'));
            tile.classList.add('selected');
            tile.querySelector('input').checked = true;
        });
    });

    function submitPayment() {
        const amount = parseFloat(document.getElementById('payAmount').value);
        if (!amount || amount <= 0) {
            Swal.fire({ title: 'تنبيه', text: 'من فضلك أدخل مبلغ صحيح', icon: 'warning', confirmButtonColor: '#0d9488' });
            return;
        }
        const method = document.querySelector('#payMethodTiles input:checked').value;
        const description = document.getElementById('payDesc').value;

        window.pendingPayments.push({ Amount: amount, Method: method, Description: description });

        renderPendingPaymentsSummary();
        if (window.renderRecordsTable) window.renderRecordsTable();
        closePaymentModal();
    }

    function removePendingPayment(idx) {
        window.pendingPayments.splice(idx, 1);
        renderPendingPaymentsSummary();
        if (window.renderRecordsTable) window.renderRecordsTable();
    }
    window.removePendingPayment = removePendingPayment;

    function renderPendingPaymentsSummary() {
        const baseTotal = @Model.Visit.TotalAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const basePaid = @Model.Visit.PaidAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const discount = @Model.Visit.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture);

        const pendingDiagnosisTotal = window.pendingToothRecords
            ? Object.values(window.pendingToothRecords).reduce((sum, t) => sum + (t.DiagnosisPrice || 0), 0)
            : 0;
        const pendingPaidTotal = window.pendingPayments.reduce((sum, p) => sum + p.Amount, 0);

        const newTotal = baseTotal + pendingDiagnosisTotal;
        const newPaid = basePaid + pendingPaidTotal;
        const newRemaining = newTotal - discount - newPaid;

        const totalEl = document.getElementById('paySummaryTotal');
        const paidEl = document.getElementById('paySummaryPaid');
        const remainingEl = document.getElementById('paySummaryRemaining');
        if (totalEl) totalEl.textContent = newTotal.toLocaleString('en-EG') + ' م.ج';
        if (paidEl) paidEl.textContent = newPaid.toLocaleString('en-EG') + ' م.ج';
        if (remainingEl) remainingEl.textContent = newRemaining.toLocaleString('en-EG') + ' م.ج';
    }
    window.renderPendingPaymentsSummary = renderPendingPaymentsSummary;
</script>