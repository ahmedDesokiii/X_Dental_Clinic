    }

    .pay-h-discount {
        font-size: .65rem;
        background: #fffbeb;
        color: #b45309;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 700;
    }

    .pay-h-right {
        text-align: left;
    }

    .pay-h-date {
        font-size: .68rem;
        color: #94a3b8;
        display: block;
        margin-top: 2px;
    }

    /* ⭐ تشخيصات اليوم */
    .today-diag-card {
        background: #fafcfd;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 12px 14px;
        margin-bottom: 12px;
    }

    .today-diag-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .8rem;
        font-weight: 800;
        color: #475569;
        margin-bottom: 8px;
    }

        .today-diag-head span:first-child {
            display: flex;
            align-items: center;
