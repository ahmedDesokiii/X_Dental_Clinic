@model Dental.Modules.Clinical.ViewModels.SessionViewModel
@{
    var isOrthoPay = ViewBag.IsOrthoSession as bool? ?? false;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // ⭐ أرقام اليوم الأساسية (المحفوظ فعلاً على الزيارة) — الـ pending بيتضاف عليها في الـ JS
    var todayRemainingServer = Model.Visit.TotalAmount - Model.Visit.Discount - Model.Visit.PaidAmount;
    var patientRemainingServer = Model.PreviousBalance + todayRemainingServer;

    var previousPayments = (ViewBag.PatientPaymentsHistory as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    var previousPaymentsList = previousPayments.ToList();

    // ⭐ Merge: في نفس اليوم، أي حركات ليها نفس الزيارة أو نفس رقم الإيصال → صف واحد
    //    (المرحلة 5: الدفعة اللي اتوزعت على أكتر من زيارة بنفس الإيصال بقت بتظهر كدفعة واحدة)
    var paymentClusters = new List<List<dynamic>>();
    foreach (var dayGroup in previousPaymentsList.GroupBy(x => ((DateTime)x.PaymentDate).Date))
    {
        var dayClusters = new List<(HashSet<int> Visits, HashSet<string> Receipts, List<dynamic> Rows)>();
        foreach (var row in dayGroup)
        {
            int vId = (int)row.VisitId;
            string? rNo = (string?)row.ReceiptNo;
            var hits = dayClusters.Where(c => c.Visits.Contains(vId) || (!string.IsNullOrWhiteSpace(rNo) && c.Receipts.Contains(rNo!))).ToList();
            var merged = (Visits: new HashSet<int> { vId }, Receipts: new HashSet<string>(), Rows: new List<dynamic> { row });
            if (!string.IsNullOrWhiteSpace(rNo)) merged.Receipts.Add(rNo!);
            foreach (var h in hits)
            {
                merged.Visits.UnionWith(h.Visits);
                merged.Receipts.UnionWith(h.Receipts);
                merged.Rows.AddRange(h.Rows);
                dayClusters.Remove(h);
            }
            dayClusters.Add(merged);
        }
        paymentClusters.AddRange(dayClusters.Select(c => c.Rows));
    }

    var mergedPayments = paymentClusters
        .Select(rows => new
        {
            Date = ((DateTime)rows[0].PaymentDate).Date,
            VisitId = (int)rows[0].VisitId,
            VisitsCount = rows.Select(x => (int)x.VisitId).Distinct().Count(),
            Methods = rows.Select(x => (string)x.Method).Distinct().ToList(),
            Amount = rows.Sum(x => (decimal)x.Amount),
            Discount = rows.Sum(x => (decimal)x.Discount),
            // أرقام الزيارة مرة واحدة لكل زيارة (مش لكل حركة)
            VisitTotalAmount = rows.GroupBy(x => (int)x.VisitId).Sum(g => (decimal)g.First().VisitTotalAmount),
            VisitRemaining = rows.GroupBy(x => (int)x.VisitId).Sum(g => (decimal)g.First().VisitRemaining)
        })
        .OrderByDescending(x => x.Date)
        .ToList();

    var totalPaidPrev = previousPaymentsList.Sum(x => (decimal)x.Amount);
    var totalDiscountPrev = previousPaymentsList.Sum(x => (decimal)x.Discount);

    // ⭐ الإجماليات دي بتتحسب مرة واحدة لكل زيارة (مش لكل صف) عشان متتكررش
    var totalVisitAmountPrev = previousPaymentsList
        .GroupBy(x => (int)x.VisitId)
        .Sum(g => (decimal)g.First().VisitTotalAmount);

    var totalRemainingPrev = previousPaymentsList
        .GroupBy(x => (int)x.VisitId)
        .Sum(g => (decimal)g.First().VisitRemaining);

    string MethodLabelAr(string m) => m switch
    {
        "Cash" => "نقدي",
        "CreditCard" => "فيزا",
        "BankTransfer" => "تحويل",
        _ => m
    };
}


<div class="payments-section" style="margin-top:16px;">
    @if (Model.ShowCategoryBreakdown)
    {
        <div class="section-card" style="background: linear-gradient(160deg, #f0fdfa, #eafbfc); border-color: #99f6e4;">
            <div class="section-head">
                <h4><i class="bi bi-collection"></i> ملخص حساب المريض الكلي</h4>
            </div>
            <div class="category-grid">
                @foreach (var cat in Model.CategoryBreakdown)
                {
                    <div class="cat-card">
                        <div class="cat-title"><i class="bi @cat.Icon"></i> @cat.CategoryName</div>
                        <div class="cat-row"><span>الإجمالي</span><b>@cat.TotalAmount.ToString("N0")</b></div>
                        <div class="cat-row"><span>الخصم</span><b>@cat.Discount.ToString("N0")</b></div>
                        <div class="cat-row paid"><span>المدفوع</span><b>@cat.PaidAmount.ToString("N0")</b></div>
                        <div class="cat-row remaining"><span>المتبقي</span><b>@cat.Remaining.ToString("N0")</b></div>
                    </div>
                }
                <div class="cat-card grand">
                    <div class="cat-title"><i class="bi bi-calculator"></i> الإجمالي الكلي</div>
                    <div class="cat-row"><span>الإجمالي</span><b>@Model.CategoryBreakdown.Sum(c => c.TotalAmount).ToString("N0")</b></div>
                    <div class="cat-row"><span>الخصم</span><b>@Model.CategoryBreakdown.Sum(c => c.Discount).ToString("N0")</b></div>
                    <div class="cat-row paid"><span>المدفوع</span><b>@Model.CategoryBreakdown.Sum(c => c.PaidAmount).ToString("N0")</b></div>
                    <div class="cat-row remaining"><span>المتبقي</span><b>@Model.CategoryBreakdown.Sum(c => c.Remaining).ToString("N0")</b></div>
                </div>
            </div>
        </div>
    }

    @* ================= PART 1: مدفوعات السيشن الحالية ================= *@
    <div class="section-card" style="margin-bottom:16px;">
        <div class="section-head">
            <h4><i class="bi bi-credit-card-2-front"></i> مدفوعات السيشن الحالية</h4>
            <button class="btn-add-payment" onclick="openPaymentModal()">
                <i class="bi bi-plus-lg"></i> New Payment
            </button>
        </div>
        @* ⭐ تشخيصات اليوم — الـ Multi-Unit سطر واحد (السعر × الوحدات) *@
        @if (!isOrthoPay)
        {
            <div class="today-diag-card" id="todayDiagCard">
                <div class="today-diag-head">
                    <span><i class="bi bi-clipboard2-pulse"></i> تشخيصات اليوم</span>
                    <span class="today-diag-count" id="todayDiagCount">0</span>
                </div>
                <div id="todayDiagRows"></div>
                <div class="today-diag-foot">
                    <span>مطلوب اليوم</span>
                    <b id="todayDiagTotal">@Model.Visit.TotalAmount.ToString("N0")</b>
                </div>
            </div>
        }

        <div class="pay-summary-grid">
            <div class="pay-stat-box">
                <div class="pay-stat-icon"><i class="bi bi-wallet2"></i></div>
                <span class="pay-stat-label">@(isOrthoPay ? "الإجمالي" : "مطلوب اليوم")</span>
                <span class="pay-stat-value" id="paySummaryTotal">@Model.Visit.TotalAmount.ToString("N0") <small>م.ج</small></span>
            </div>
            <div class="pay-stat-box">
                <div class="pay-stat-icon" style="color:#16a34a;"><i class="bi bi-check-circle"></i></div>
                <span class="pay-stat-label">@(isOrthoPay ? "المدفوع" : "مدفوع اليوم")</span>
                <span class="pay-stat-value" style="color:#16a34a;" id="paySummaryPaid">@Model.Visit.PaidAmount.ToString("N0") <small>م.ج</small></span>
            </div>
            <div class="pay-stat-box">
                <div class="pay-stat-icon" style="color:#f59e0b;"><i class="bi bi-percent"></i></div>
                <span class="pay-stat-label">الخصم</span>
                <span class="pay-stat-value" style="color:#f59e0b;" id="paySummaryDiscount">@Model.Visit.Discount.ToString("N0") <small>م.ج</small></span>
            </div>
            <div class="pay-stat-box @(isOrthoPay ? "highlight" : "")">
                <div class="pay-stat-icon" style="color:#dc2626;"><i class="bi bi-exclamation-circle"></i></div>
                <span class="pay-stat-label">@(isOrthoPay ? "المتبقي" : "متبقي اليوم")</span>
                <span class="pay-stat-value" style="color:#dc2626;" id="paySummaryRemaining">@Math.Max(0, todayRemainingServer).ToString("N0") <small>م.ج</small></span>
            </div>
        </div>

        @* ⭐ رصيد المريض الكلي = رصيد الزيارات السابقة + متبقي اليوم *@
        @if (!isOrthoPay)
        {
            <div class="patient-balance-strip">
                <div class="pb-item">
                    <span class="pb-label">رصيد سابق</span>
                    <b class="pb-value" id="payPrevBalance">@Model.PreviousBalance.ToString("N0")</b>
                </div>
                <span class="pb-op">+</span>
                <div class="pb-item">
                    <span class="pb-label">متبقي اليوم</span>
                    <b class="pb-value" id="payTodayRemainingStrip">@todayRemainingServer.ToString("N0")</b>
                </div>
                <span class="pb-op">=</span>
                <div class="pb-item pb-total">
                    <span class="pb-label">إجمالي المتبقي على المريض</span>
                    <b class="pb-value" id="payPatientRemaining">@patientRemainingServer.ToString("N0") <small>م.ج</small></b>
                </div>
            </div>
            <div class="pb-note" id="payOldSettleNote" style="display:none;"></div>
        }

        <div style="margin-top:16px; padding-top:16px; border-top:1px solid #f1f5f9;">
            <div style="font-size:.8rem; font-weight:800; color:#475569; margin-bottom:10px; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-list-ul"></i> سجل مدفوعات المريض
            </div>
            <div class="pay-history custom-scroll" style="max-height:220px; overflow-y:auto;">
                <div id="pendingPaymentsRows"></div>
                <div id="existingPaymentsRows">
                    @foreach (var p in Model.Visit.Payments.OrderByDescending(x => x.PaymentDate))
                    {
                        <div class="pay-history-item">
                            <div class="pay-h-left">
                                <span class="pay-h-icon"><i class="bi @(p.Method.ToString() == "Cash" ? "bi-cash-coin" : p.Method.ToString() == "CreditCard" ? "bi-credit-card" : "bi-bank")"></i></span>
                                <b>@p.Amount.ToString("N0") م.ج</b>
                                <span class="pay-h-method">@MethodLabelAr(p.Method.ToString())</span>
                                @if (p.Discount > 0)
                                {
                                    <span class="pay-h-discount">خصم @p.Discount.ToString("N0")</span>
                                }
                            </div>
                            <div class="pay-h-right">
                                <small style="color:#64748b;">@(string.IsNullOrWhiteSpace(p.Description) ? "-" : p.Description)</small>
                                <span class="pay-h-date"><i class="bi bi-clock"></i> @p.PaymentDate.ToString("dd/MM HH:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ================= PART 2: مدفوعات سابقة ================= *@
    <div class="section-card" style="margin-bottom:0;">
        <div class="section-head">
            <h4><i class="bi bi-clock-history"></i> مدفوعات سابقة</h4>
            <span class="section-badge">@mergedPayments.Count حركة</span>
        </div>

        @if (mergedPayments.Any())
        {
            <div class="table-responsive custom-scroll" style="max-height:280px;">
                <table class="dc-table">
                    <thead>
                        <tr>
                            <th class="text-start">التاريخ</th>
                            <th class="text-start">طريقة الدفع</th>
                            <th class="text-start">إجمالي السيشن</th>
                            <th class="text-start">المدفوع</th>
                            <th class="text-start">الخصم</th>
                            <th class="text-start">الباقي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in mergedPayments)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@item.Date.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="pay-h-method">
                                        @(item.Methods.Count > 1 ? "متعدد" : MethodLabelAr(item.Methods.First()))
                                    </span>
                                </td>
                                <td style="font-weight:700;color:#0d7377;">@item.VisitTotalAmount.ToString("N0")</td>
                                <td style="color:#16a34a;font-weight:700;">
                                    @item.Amount.ToString("N0")
                                    @if (item.VisitsCount > 1)
                                    {
                                        <span title="دفعة واحدة اتوزعت على أكتر من زيارة" style="font-size:.62rem;font-weight:800;color:#4338ca;background:#eef2ff;border:1px solid #c7d2fe;padding:1px 6px;border-radius:7px;margin-inline-start:4px;white-space:nowrap;"><i class="bi bi-diagram-3"></i> @item.VisitsCount زيارات</span>
                                    }
                                </td>
                                <td style="color:#f59e0b;font-weight:700;">@item.Discount.ToString("N0")</td>
                                <td style="color:#dc2626;font-weight:700;">@item.VisitRemaining.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="background:#f0fdfa;font-weight:800;">
                            <td colspan="2" style="text-align:right;color:#0d7377;">الإجمالي</td>
                            <td style="color:#0d7377;">@totalVisitAmountPrev.ToString("N0")</td>
                            <td style="color:#16a34a;">@totalPaidPrev.ToString("N0")</td>
                            <td style="color:#f59e0b;">@totalDiscountPrev.ToString("N0")</td>
                            <td style="color:#dc2626;">@totalRemainingPrev.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:24px;">
                <i class="bi bi-inbox"></i>
                <p>لا توجد مدفوعات سابقة لهذا المريض.</p>
            </div>
        }
    </div>
</div>

@* Payment Modal *@
<div class="dc-modal" id="paymentModal" style="display:none;">
    <div class="dc-modal-overlay" onclick="closePaymentModal()"></div>
    <div class="dc-modal-box" style="max-width:380px;">
        <div class="dc-modal-head">
            <h5 class="text-light"><i class="bi bi-cash-stack"></i> تسجيل دفعة جديدة</h5>
            <button class="dc-modal-close" onclick="closePaymentModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="dc-modal-body">
            @* ⭐ اختصارات المبلغ: متبقي اليوم / إجمالي المتبقي على المريض *@
            <div class="pay-quick-fill" id="payQuickFill">
                <button type="button" class="pay-quick-btn" onclick="fillPayAmount('today')">
                    <span>@(isOrthoPay ? "المتبقي" : "متبقي اليوم")</span><b id="payQuickToday">0</b>
                </button>
                @if (!isOrthoPay)
                {
                    <button type="button" class="pay-quick-btn total" onclick="fillPayAmount('patient')">
                        <span>إجمالي على المريض</span><b id="payQuickPatient">0</b>
                    </button>
                }
            </div>

            <div class="pay-row-main">
                <div class="pay-field amount-field">
                    <label class="pay-field-label">المبلغ</label>
                    <div class="pay-input-wrap">
                        <input type="number" class="pay-input" id="payAmount" placeholder="0" />
                        <span class="pay-suffix">م.ج</span>
                    </div>
                </div>
                <div class="pay-field discount-field">
                    <label class="pay-field-label">الخصم</label>
                    <input type="number" class="pay-input-sm" id="payDiscount" placeholder="0" />
                </div>
            </div>

            <div class="pay-method-grid-compact" id="payMethodTiles">
                <label class="pay-method-chip selected" data-method="Cash">
                    <input type="radio" name="payMethod" value="Cash" checked />
                    <i class="bi bi-cash-coin"></i><span>نقدي</span>
                </label>
                <label class="pay-method-chip" data-method="CreditCard">
                    <input type="radio" name="payMethod" value="CreditCard" />
                    <i class="bi bi-credit-card"></i><span>فيزا</span>
                </label>
                <label class="pay-method-chip" data-method="BankTransfer">
                    <input type="radio" name="payMethod" value="BankTransfer" />
                    <i class="bi bi-bank"></i><span>تحويل</span>
                </label>
            </div>

            <input type="text" class="dc-input-line" id="payDesc" placeholder="ملاحظة (اختياري)..." />
            <div class="pay-excess-hint" id="payExcessHint" style="display:none;"></div>
        </div>
        <div class="dc-modal-foot">
            <button class="dc-btn dc-btn-secondary" onclick="closePaymentModal()">Cancel</button>
            <button class="dc-btn dc-btn-primary" onclick="submitPayment()">
                <i class="bi bi-check-lg"></i> Add Payment
            </button>
        </div>
    </div>
</div>

<style>
    .payments-section {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
    }

    .cat-card {
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 14px;
        transition: all 0.3s ease;
    }

        .cat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(10,77,79,0.06);
        }

        .cat-card.grand {
            background: linear-gradient(135deg, #f0fdfa, #eafbfc);
            border-color: #99f6e4;
        }

    .cat-title {
        font-size: .78rem;
        font-weight: 800;
        color: #0b2e30;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .cat-row {
        display: flex;
        justify-content: space-between;
        font-size: .78rem;
        padding: 4px 0;
        color: #475569;
    }

        .cat-row b {
            color: #0f172a;
            font-weight: 700;
        }

        .cat-row.paid b {
            color: #16a34a;
        }

        .cat-row.remaining {
            border-top: 1px dashed #e2e8f0;
            margin-top: 4px;
            padding-top: 6px;
        }

            .cat-row.remaining b {
                color: #dc2626;
                font-size: .9rem;
            }

    .btn-add-payment {
        background: linear-gradient(135deg, #0d9488, #0891b2);
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 700;
        font-size: .78rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 4px 14px rgba(13,148,136,0.25);
        transition: all 0.2s ease;
    }

        .btn-add-payment:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(13,148,136,0.35);
        }

    .pay-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .pay-stat-box {
        background: linear-gradient(180deg, #f8fafc, #f1f5f9);
        border-radius: 14px;
        padding: 14px 10px;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.03);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .pay-stat-box::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #0d9488, #14b8a6);
