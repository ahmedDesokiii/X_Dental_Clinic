@{
    var documentTypes = ViewBag.DocumentTypes as List<Dental.Models.Patient.DocumentType> ?? new();
}

<div class="docs-manager-pro" data-patient-id="@ViewBag.CurrentPatientId">
    <div class="docs-layout-grid">

        <!-- ═══ Column 1: Upload ═══ -->
        <aside class="docs-side-panel">

            <div class="docs-upload-zone" id="docsDropzone">
                <div class="docs-upload-icon-wrap">
                    <i class="bi bi-cloud-arrow-up"></i>
                </div>
                <p class="docs-upload-title">اسحب الملفات هنا</p>
                <small class="docs-upload-hint">أو اضغط للاختيار</small>
                <input type="file" id="docFileInput" multiple hidden accept=".pdf,.xls,.xlsx,.doc,.docx,.jpg,.jpeg,.png,.webp" onchange="onDocFilesSelected(event)" />

                <div class="docs-upload-progress-wrap" id="docsProgressWrap">
                    <div class="docs-upload-progress-track">
                        <div class="docs-upload-progress-fill" id="docsProgressFill"></div>
                    </div>
                    <span class="docs-upload-progress-text" id="docsProgressText">0%</span>
                </div>
            </div>

            <div class="docs-side-field" hidden>
                <label class="docs-side-label"><i class="bi bi-tag"></i> نوع المستند</label>
                <select class="form-control-custom-new" id="docTypeSelect">
                    @if (!documentTypes.Any())
                    {
                        <option value="0">عام</option>
                    }
                    @foreach (var dt in documentTypes)
                    {
                        <option value="@dt.Id">@dt.NameAr</option>
                    }
                </select>
            </div>

            <div class="docs-side-field">
                <label class="docs-side-label"><i class="bi bi-pencil"></i> ملاحظة (اختياري)</label>
                <input type="text" class="form-control-custom-new" id="docDescInput" placeholder="اكتب ملاحظة..." />
            </div>

        </aside>

        <!-- ═══ Column 2: Documents Grid ═══ -->
        <main class="docs-main-panel">
            <div class="docs-grid-scroll" id="docsGridScroll">
                <div class="docs-grid" id="docsGrid"></div>

                <div class="empty-state docs-empty-anim" id="docsEmptyState" style="display:none;">
                    <i class="bi bi-folder2-open"></i>
                    <p>لا توجد مستندات مرفوعة بعد</p>
                    <small>ابدأ برفع أول ملف من اللوحة الجانبية</small>
                </div>
            </div>
        </main>

        <!-- ═══ Column 3: Stats + Filters ═══ -->
        <aside class="docs-info-panel">

            <div class="docs-stats-mini">
                <div class="docs-stat-chip">
                    <b id="docsStatCount">0</b>
                    <span>ملف</span>
                </div>
                <div class="docs-stat-chip">
                    <b id="docsStatSize">0 KB</b>
                    <span>الحجم الكلي</span>
                </div>
            </div>

            <div class="docs-filter-chips" id="docsFilterChips">
                <button class="docs-chip active" data-filter="all">الكل <em id="cnt-all">0</em></button>
                <button class="docs-chip" data-filter="image">صور <em id="cnt-image">0</em></button>
                <button class="docs-chip" data-filter="pdf">PDF <em id="cnt-pdf">0</em></button>
                <button class="docs-chip" data-filter="office">مستندات <em id="cnt-office">0</em></button>
                <button class="docs-chip" data-filter="other">أخرى <em id="cnt-other">0</em></button>
            </div>

        </aside>

    </div>
</div>

<!-- Lightbox for image documents -->
<div class="xray-lightbox" id="docImageViewer" style="display:none;" onclick="closeDocImageViewer()">
    <img id="docImageViewerImg" src="" />
</div>

<style>
    @@keyframes docsFadeUp {
        from {
            opacity: 0;
            transform: translateY(14px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes docsPulseBorder {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(13,148,136,0.25);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(13,148,136,0);
        }
    }

    @@keyframes docsIconBounce {
        0% {
            transform: scale(.6);
            opacity: 0;
        }

        60% {
            transform: scale(1.15);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes docsShine {
        0% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes docsChipPop {
        0% {
            transform: scale(.85);
        }

        100% {
            transform: scale(1);
        }
    }

    .docs-layout-grid {
        display: grid;
        grid-template-columns: 220px 1fr 210px;
        gap: 18px;
        align-items: start;
        animation: docsFadeUp .4s ease;
    }

    .docs-info-panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
        position: sticky;
        top: 8px;
    }

    @@media (max-width: 1100px) {
        .docs-layout-grid {
            grid-template-columns: 200px 1fr;
        }

        .docs-info-panel {
            grid-column: 1 / -1;
            position: static;
            flex-direction: row;
            flex-wrap: wrap;
        }

            .docs-info-panel .docs-stats-mini {
                flex: 1;
                min-width: 200px;
            }

            .docs-info-panel .docs-filter-chips {
                flex: 1;
                min-width: 200px;
                flex-direction: row;
                flex-wrap: wrap;
            }

                .docs-info-panel .docs-filter-chips .docs-chip {
                    flex: 1;
                    min-width: 90px;
                    justify-content: center;
                }
    }

    @@media (max-width: 900px) {
        .docs-layout-grid {
            grid-template-columns: 1fr;
        }

        .docs-side-panel {
            position: static;
        }

        .docs-grid-scroll {
            max-height: 340px;
        }
    }

    /* ── Side Panel ── */
    .docs-side-panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
        position: sticky;
        top: 8px;
    }

    .docs-upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 18px;
        padding: 22px 14px;
        text-align: center;
        background: linear-gradient(180deg,#fff,#f8fdfc);
        cursor: pointer;
        transition: all .25s ease;
        position: relative;
        overflow: hidden;
    }

        .docs-upload-zone:hover {
            border-color: #14b8a6;
            transform: translateY(-2px);
        }

        .docs-upload-zone.drag-over {
            border-color: #0d9488;
            background: #f0fdfa;
            animation: docsPulseBorder 1.1s ease-in-out infinite;
        }

        .docs-upload-zone.uploading {
            pointer-events: none;
            opacity: .85;
        }

    .docs-upload-icon-wrap {
        width: 52px;
        height: 52px;
        margin: 0 auto 10px;
        border-radius: 14px;
        background: #f0fdfa;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: docsIconBounce .5s ease;
    }

        .docs-upload-icon-wrap i {
            font-size: 1.5rem;
            color: #0d9488;
        }

    .docs-upload-title {
        margin: 0;
        font-weight: 800;
        font-size: .85rem;
        color: #0b2e30;
    }

    .docs-upload-hint {
        color: #94a3b8;
        font-size: .72rem;
    }

    .docs-upload-progress-wrap {
        display: none;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
    }

        .docs-upload-progress-wrap.show {
            display: flex;
        }

    .docs-upload-progress-track {
        flex: 1;
        height: 8px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .docs-upload-progress-fill {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: linear-gradient(90deg,#0d9488,#14b8a6);
        transition: width .2s ease;
    }

    .docs-upload-progress-text {
        font-size: .68rem;
        font-weight: 800;
        color: #0d9488;
        min-width: 30px;
    }

    .docs-side-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .docs-side-label {
        font-size: .74rem;
        font-weight: 700;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .docs-stats-mini {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .docs-stat-chip {
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        padding: 10px;
        text-align: center;
    }

        .docs-stat-chip b {
            display: block;
            font-size: 1rem;
            font-weight: 800;
            color: #0b2e30;
        }

        .docs-stat-chip span {
            font-size: .64rem;
            color: #94a3b8;
            font-weight: 700;
        }

    .docs-filter-chips {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .docs-chip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #f1f5f9;
        background: #fff;
        border-radius: 10px;
        padding: 8px 12px;
        font-size: .78rem;
        font-weight: 700;
        color: #475569;
        cursor: pointer;
        transition: all .2s ease;
    }

        .docs-chip:hover {
            background: #f0fdfa;
        }

        .docs-chip.active {
            background: linear-gradient(135deg,#0d9488,#14b8a6);
            color: #fff;
            border-color: transparent;
            animation: docsChipPop .2s ease;
        }

        .docs-chip em {
            font-style: normal;
            background: rgba(0,0,0,0.08);
            border-radius: 999px;
            padding: 1px 7px;
            font-size: .68rem;
        }

        .docs-chip.active em {
            background: rgba(255,255,255,0.25);
        }

    /* ── Main Panel ── */
    .docs-main-panel {
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 18px;
        padding: 4px;
    }

    .docs-grid-scroll {
        max-height: 430px;
        overflow-y: auto;
        padding: 14px;
    }

        .docs-grid-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .docs-grid-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .docs-grid-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

            .docs-grid-scroll::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

    .docs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 14px;
    }

    .doc-card {
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        overflow: hidden;
        transition: all .25s ease;
        animation: docsFadeUp .35s ease both;
        position: relative;
    }

        .doc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(10,77,79,0.12);
            border-color: #ccf3ec;
        }

        .doc-card.removing {
            animation: none;
            opacity: 0;
            transform: scale(.9);
            transition: all .25s ease;
        }

    .doc-thumb {
        width: 100%;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        cursor: pointer;
        overflow: hidden;
        position: relative;
    }

        .doc-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .3s ease;
        }

    .doc-card:hover .doc-thumb img {
        transform: scale(1.08);
    }

    .doc-thumb i {
        font-size: 2rem;
    }

    .doc-thumb.pdf i {
        color: #dc2626;
    }

    .doc-thumb.excel i {
        color: #16a34a;
    }

    .doc-thumb.word i {
        color: #2563eb;
    }

    .doc-thumb.generic i {
        color: #94a3b8;
    }

    .doc-type-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(13,148,136,0.9);
        color: #fff;
        font-size: .58rem;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 999px;
    }

    .doc-card-body {
        padding: 9px 11px;
    }

    .doc-card-name {
        font-size: .74rem;
        font-weight: 700;
        color: #0f172a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }

    .doc-card-meta {
        font-size: .64rem;
        color: #94a3b8;
        display: flex;
        justify-content: space-between;
    }

    .doc-card-actions {
        display: flex;
        gap: 4px;
        margin-top: 8px;
    }

    .doc-action-btn {
        flex: 1;
        border: none;
        background: #f1f5f9;
        color: #475569;
        border-radius: 8px;
        padding: 6px 0;
        font-size: .68rem;
        cursor: pointer;
        transition: all .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

        .doc-action-btn:hover {
            background: #e2e8f0;
            transform: translateY(-1px);
        }

        .doc-action-btn.danger:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    .docs-empty-anim {
        animation: docsFadeUp .4s ease;
    }

    @@media (max-width: 900px) {
        .docs-layout-grid {
            grid-template-columns: 1fr;
        }

        .docs-side-panel {
            position: static;
        }

        .docs-grid-scroll {
            max-height: 340px;
        }
    }
</style>

<script>
    (function() {
        let allDocs = [];
        let activeFilter = 'all';
        const patientId = @(ViewBag.CurrentPatientId ?? 0);

        function fmtSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function categoryOf(ext) {
            ext = (ext || '').toLowerCase();
            if (['.jpg', '.jpeg', '.png', '.webp'].includes(ext)) return 'image';
            if (ext === '.pdf') return 'pdf';
            if (['.xls', '.xlsx', '.doc', '.docx'].includes(ext)) return 'office';
            return 'other';
        }

        function iconForExt(ext) {
            ext = (ext || '').toLowerCase();
            const cat = categoryOf(ext);
            if (cat === 'image') return { type: 'image' };
            if (cat === 'pdf') return { type: 'icon', cls: 'pdf', icon: 'bi-file-earmark-pdf' };
            if (['.xls', '.xlsx'].includes(ext)) return { type: 'icon', cls: 'excel', icon: 'bi-file-earmark-excel' };
            if (['.doc', '.docx'].includes(ext)) return { type: 'icon', cls: 'word', icon: 'bi-file-earmark-word' };
            return { type: 'icon', cls: 'generic', icon: 'bi-file-earmark' };
        }

        function updateStatsAndChips() {
            document.getElementById('docsStatCount').textContent = allDocs.length;
            const totalBytes = allDocs.reduce((s, d) => s + (d.fileSize || 0), 0);
            document.getElementById('docsStatSize').textContent = fmtSize(totalBytes);

            const counts = { all: allDocs.length, image: 0, pdf: 0, office: 0, other: 0 };
            allDocs.forEach(d => counts[categoryOf(d.fileExtension)]++);
            Object.keys(counts).forEach(k => {
                const el = document.getElementById('cnt-' + k);
                if (el) el.textContent = counts[k];
            });
        }

        function renderDocsGrid() {
            const grid = document.getElementById('docsGrid');
            const empty = document.getElementById('docsEmptyState');

            const filtered = activeFilter === 'all'
                ? allDocs
                : allDocs.filter(d => categoryOf(d.fileExtension) === activeFilter);

            updateStatsAndChips();

            if (!filtered.length) {
                grid.innerHTML = '';
                empty.style.display = 'block';
                return;
            }
            empty.style.display = 'none';

            grid.innerHTML = filtered.map((doc, idx) => {
                const info = iconForExt(doc.fileExtension);
                const thumbHtml = info.type === 'image'
                    ? `<div class="doc-thumb" onclick="openDocImageViewer('${doc.filePath}')"><img src="${doc.filePath}" /></div>`
                    : `<div class="doc-thumb ${info.cls}" onclick="window.open('${doc.filePath}', '_blank')"><i class="bi ${info.icon}"></i></div>`;

                return `
                        <div class="doc-card" data-id="${doc.id}" style="animation-delay:${Math.min(idx * 0.04, 0.4)}s">
                            ${thumbHtml}
                            ${doc.documentTypeName ? `<span class="doc-type-badge">${doc.documentTypeName}</span>` : ''}
                            <div class="doc-card-body">
                                <div class="doc-card-name" title="${doc.fileName}">${doc.fileName}</div>
                                <div class="doc-card-meta">
                                    <span>${new Date(doc.uploadedDate).toLocaleDateString('en-GB')}</span>
                                    <span>${fmtSize(doc.fileSize)}</span>
                                </div>
                                <div class="doc-card-actions">
                                    <a class="doc-action-btn" href="${doc.filePath}" download><i class="bi bi-download"></i> حفظ</a>
                                    <button class="doc-action-btn danger" onclick="deleteDocument(${doc.id})"><i class="bi bi-trash3"></i> حذف</button>
                                </div>
                            </div>
                        </div>`;
            }).join('');
        }

        async function loadDocuments() {
            try {
                const res = await fetch(`/Patients/GetDocuments?patientId=${patientId}`);
                const result = await res.json();
                if (result.success) {
                    allDocs = result.data;
                    renderDocsGrid();
                }
            } catch (err) {
                console.error('Failed to load documents', err);
            }
        }

        window.deleteDocument = async function(id) {
            const confirmResult = await Swal.fire({
                title: 'حذف هذا الملف؟',
                text: 'لا يمكن التراجع عن هذا الإجراء.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'نعم، احذف',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#dc2626'
            });
            if (!confirmResult.isConfirmed) return;

            const card = document.querySelector(`.doc-card[data-id="${id}"]`);
            if (card) card.classList.add('removing');

            const res = await fetch(`/Patients/DeleteDocument?id=${id}`, { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                setTimeout(() => {
                    allDocs = allDocs.filter(d => d.id !== id);
                    renderDocsGrid();
                }, 200);
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'تم حذف الملف', showConfirmButton: false, timer: 1200 });
            } else {
                if (card) card.classList.remove('removing');
                Swal.fire({ title: 'خطأ', text: result.message || 'فشل الحذف', icon: 'error' });
            }
        };

        function setProgress(pct) {
            document.getElementById('docsProgressFill').style.width = pct + '%';
            document.getElementById('docsProgressText').textContent = pct + '%';
        }

        function uploadFiles(fileList) {
            if (!fileList || !fileList.length) return;

            const docTypeId = document.getElementById('docTypeSelect').value || 0;
            const description = document.getElementById('docDescInput').value || '';

            const formData = new FormData();
            formData.append('patientId', patientId);
            formData.append('documentTypeId', docTypeId);
            formData.append('description', description);
            Array.from(fileList).forEach(f => formData.append('files', f));

            const dropzone = document.getElementById('docsDropzone');
            const progressWrap = document.getElementById('docsProgressWrap');
            dropzone.classList.add('uploading');
            progressWrap.classList.add('show');
            setProgress(0);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/Patients/UploadDocuments');

            xhr.upload.onprogress = function(e) {
                if (e.lengthComputable) {
                    setProgress(Math.round((e.loaded / e.total) * 100));
                }
            };

            xhr.onload = function() {
                dropzone.classList.remove('uploading');
                progressWrap.classList.remove('show');
                setProgress(0);

                let result;
                try { result = JSON.parse(xhr.responseText); } catch { result = { success: false }; }

                if (result.success) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: `تم رفع ${result.count} ملف`, showConfirmButton: false, timer: 1500 });
                    document.getElementById('docDescInput').value = '';
                    document.getElementById('docFileInput').value = '';
                    loadDocuments();
                } else {
                    Swal.fire({ title: 'فشل الرفع', text: result.message || 'حدث خطأ غير متوقع', icon: 'error' });
                }
            };

            xhr.onerror = function() {
                dropzone.classList.remove('uploading');
                progressWrap.classList.remove('show');
                Swal.fire({ title: 'خطأ', text: 'تعذر الاتصال بالسيرفر', icon: 'error' });
            };

            xhr.send(formData);
        }

        window.onDocFilesSelected = function(e) {
            uploadFiles(e.target.files);
        };

        window.openDocImageViewer = function(path) {
            document.getElementById('docImageViewerImg').src = path;
            document.getElementById('docImageViewer').style.display = 'flex';
        };
        window.closeDocImageViewer = function() {
            document.getElementById('docImageViewer').style.display = 'none';
        };

        // Drag & drop
        const dropzone = document.getElementById('docsDropzone');
        if (dropzone) {
            dropzone.addEventListener('click', () => document.getElementById('docFileInput').click());
            ['dragover', 'dragenter'].forEach(evt =>
                dropzone.addEventListener(evt, e => { e.preventDefault(); dropzone.classList.add('drag-over'); }));
            ['dragleave', 'drop'].forEach(evt =>
                dropzone.addEventListener(evt, e => { e.preventDefault(); dropzone.classList.remove('drag-over'); }));
            dropzone.addEventListener('drop', e => uploadFiles(e.dataTransfer.files));
        }

        // Filter chips
        document.getElementById('docsFilterChips').addEventListener('click', e => {
            const chip = e.target.closest('.docs-chip');
            if (!chip) return;
            document.querySelectorAll('.docs-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            activeFilter = chip.dataset.filter;
            renderDocsGrid();
        });

        window.loadDocumentsTab = loadDocuments;
    })();
</script>