@model Dental.Modules.Patients.ViewModels.PatientIndexViewModel
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Auth
@inject Dental.Core.Settings.IClinicSettingsService ClinicSettings

@{
    ViewData["Title"] = "Patients";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // 👥 H2: الأزرار والأعمدة حسب صلاحيات المستخدم
    async Task<bool> Can(string p) => (await Auth.AuthorizeAsync(User, p)).Succeeded;
    var canAdd = await Can(Dental.Constants.Permissions.Patients.Add_Patient);
    var canEdit = await Can(Dental.Constants.Permissions.Patients.Edit_Patient);
    var canDelete = await Can(Dental.Constants.Permissions.Patients.Delete_Patient);
    var canDetails = await Can(Dental.Constants.Permissions.Patients.Details_Patient);
    var canSession = await Can(Dental.Constants.Permissions.Clinical.Manage);
    var canMoney = await Can(Dental.Constants.Permissions.Payments.View);
}

@section Styles {
    <style>
        /* 👥 H2: فلاتر سريعة + خلايا جديدة + كروت الموبايل */
        .pl-quick { display: flex; gap: 8px; flex-wrap: wrap; padding: 0 16px 12px; }
        .pl-q { border: 1px solid rgba(13,115,119,.15); background: #fff; color: #4b6b6c; border-radius: 99px; padding: 6px 14px; font-weight: 700; font-size: .85rem; cursor: pointer; transition: all .15s; }
        .pl-q i { margin-inline-end: 4px; }
        .pl-q:hover { border-color: #14b8a6; color: #0d7377; }
        .pl-q.active { background: #0d7377; border-color: #0d7377; color: #fff; }
        [data-theme="dark"] .pl-q { background: transparent; color: #94a3b8; border-color: rgba(148,163,184,.25); }
        .pl-phone { display: inline-flex; align-items: center; gap: 6px; }
        .pl-ic { width: 26px; height: 26px; border-radius: 8px; display: inline-grid; place-items: center; background: #f0fdfa; color: #0d7377; font-size: .8rem; text-decoration: none; opacity: .0; transition: opacity .15s; }
        tr:hover .pl-ic, .pl-ic:focus { opacity: 1; }
        .pl-wa { color: #128c7e; background: #dcfce7; }
        .pl-last { font-size: .85rem; color: #4b6b6c; font-weight: 600; }
        .pl-last.old { color: #b45309; }
        .pl-due { font-weight: 900; color: #dc2626; background: #fef2f2; padding: 2px 10px; border-radius: 99px; font-size: .85rem; }
        .pl-paid { color: #16a34a; font-weight: 900; }
        tr.pl-clickable { cursor: pointer; }

        @@media (hover: none) { .pl-ic { opacity: 1; } }

        @@media (max-width: 768px) {
            .pl-quick { overflow-x: auto; flex-wrap: nowrap; scrollbar-width: none; }
            .pl-q { flex: 0 0 auto; }
            /* الجدول يتحول لكروت */
            #tablePatients thead { display: none; }
            #tablePatients, #tablePatients tbody { display: block !important; width: 100% !important; }
            #tablePatients tbody tr {
                display: grid !important; grid-template-columns: 1fr auto; gap: 6px 10px; align-items: center;
                background: var(--ft-card, #fff); border: 1px solid rgba(13,115,119,.12); border-radius: 16px;
                padding: 12px 14px; margin-bottom: 10px; box-shadow: 0 6px 18px rgba(10,77,79,.06);
            }
            #tablePatients tbody td { display: block; border: 0 !important; padding: 0 !important; text-align: start !important; white-space: normal; }
            #tablePatients tbody td:nth-child(1) { order: 2; justify-self: end; }                 /* code */
            #tablePatients tbody td:nth-child(2) { order: 1; }                                     /* name */
            #tablePatients tbody td:nth-child(3) { order: 3; grid-column: 1 / -1; }                /* phone */
            #tablePatients tbody td:nth-child(4), #tablePatients tbody td:nth-child(5) { display: none; }  /* gender, age */
            #tablePatients tbody td:nth-child(6) { order: 4; }                                     /* type */
            #tablePatients tbody td:nth-child(7) { order: 5; justify-self: end; }                  /* last visit */
            #tablePatients tbody td:nth-child(8) { order: 6; }                                     /* next */
            #tablePatients tbody td:nth-child(9) { order: 7; justify-self: end; }                  /* balance / actions */
            #tablePatients tbody td:last-child { order: 9; grid-column: 1 / -1; padding-top: 8px !important; border-top: 1px dashed rgba(13,115,119,.15) !important; }
            #tablePatients tbody td:last-child .row-actions-cell { justify-content: space-between; }
            #tablePatients tbody td.dataTables_empty { grid-column: 1 / -1; text-align: center !important; }
        }
    </style>
    <link rel="stylesheet" href="~/lib/datatables-1.13/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-1.13/responsive.dataTables.min.css" />
    <style>
        :root {
            --card-grad: linear-gradient(145deg, rgba(255,255,255,.94), rgba(255,255,255,.68));
            --shadow-card: 0 20px 50px rgba(10,77,79,.08);
            --shadow-hover: 0 22px 50px rgba(10,77,79,.15);
        }

        body {
            background: radial-gradient(circle at 4% 5%, var(--dental-100) 0%, transparent 34%), radial-gradient(circle at 96% 90%, var(--coral-300) 0%, transparent 27%), var(--sky-50);
        }

        .patients-page {
            min-height: 100vh;
            padding-bottom: 30px;
        }

        /* ═══════════ HERO — animated gradient + shine text ═══════════ */
        .patients-hero {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            border-radius: 24px;
            color: #fff;
            padding: 27px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            box-shadow: 0 20px 45px rgba(13,115,119,.27);
            margin-bottom: 22px;
            background: linear-gradient(135deg,#0a5d60 0%,#0d7377 35%,#119e91 68%,#14b8a6 100%);
            background-size: 220% 220%;
            opacity: 0;
            transform: translateY(25px);
            animation: dentalHeroEnter .75s var(--ease-dental) forwards, heroGradShift 9s ease-in-out 1s infinite;
        }

        @@keyframes dentalHeroEnter {
            from {
                opacity: 0;
                transform: translateY(25px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@keyframes heroGradShift {
            0%, 100% {
                background-position: 0% 50%
            }

            50% {
                background-position: 100% 50%
            }
        }

        .patients-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: radial-gradient(circle at 90% -20%, rgba(255,255,255,.34), transparent 46%);
            pointer-events: none;
        }

        /* Floating dental elements */
        .dental-floating-icons {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: -1;
        }

        .dental-floating-icon {
            position: absolute;
            width: 68px;
            height: 68px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.11);
            border: 1px solid rgba(255,255,255,.18);
            backdrop-filter: blur(6px);
            color: rgba(255,255,255,.72);
            font-size: 2rem;
            animation: dentalFloat 7s ease-in-out infinite;
        }

            .dental-floating-icon:nth-child(1) {
                top: 12px;
                right: 27%;
                animation-delay: 0s;
            }

            .dental-floating-icon:nth-child(2) {
                bottom: -18px;
                left: 8%;
                width: 58px;
                height: 58px;
                font-size: 1.55rem;
                animation-delay: 1.7s;
            }

            .dental-floating-icon:nth-child(3) {
                top: -18px;
                left: 35%;
                width: 45px;
                height: 45px;
                border-radius: 14px;
                font-size: 1.1rem;
                animation-delay: 3.2s;
            }

        @@keyframes dentalFloat {
            0%, 100% {
                transform: translateY(0) rotate(0)
            }

            50% {
                transform: translateY(-15px) rotate(7deg)
            }
        }

        .hero-content {
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
            z-index: 2;
        }

        /* ⭐ tooth with pulse ring */
        .hero-tooth {
            width: 58px;
            height: 58px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.2);
            backdrop-filter: blur(8px);
            font-size: 1.65rem;
            flex-shrink: 0;
            animation: toothPulse 4s ease-in-out infinite;
        }

        @@keyframes toothPulse {
            0%, 100% {
                transform: translateY(0) rotate(0);
                box-shadow: 0 0 0 0 rgba(255,255,255,.35);
            }

            50% {
                transform: translateY(-5px) rotate(-3deg);
                box-shadow: 0 0 0 12px rgba(255,255,255,0);
            }
        }

        /* ⭐ shining gradient title */
        .hero-text h1 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -.3px;
            background: linear-gradient(90deg, #fff 20%, var(--dental-200) 50%, #fff 80%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            animation: textShine 5s linear infinite;
        }

        @@keyframes textShine {
            to {
                background-position: -200% center;
            }
        }

        .hero-text p {
            margin: 5px 0 0;
            font-size: .85rem;
            opacity: .9;
            font-weight: 500;
        }

        /* Add patient button + ripple */
        .btn-add-patient {
            position: relative;
            z-index: 3;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 11px 20px;
            border-radius: 13px;
            border: none;
            background: #fff;
            color: var(--dental-700);
            text-decoration: none;
            font-size: .85rem;
            font-weight: 800;
            box-shadow: 0 9px 24px rgba(0,0,0,.13);
            transition: transform .25s var(--ease-dental), box-shadow .25s ease;
        }

            .btn-add-patient:hover {
                color: var(--dental-700);
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(0,0,0,.18);
            }

            .btn-add-patient i {
                font-size: 1rem;
                transition: transform .3s var(--ease-dental);
            }

            .btn-add-patient:hover i {
                transform: rotate(8deg) scale(1.1);
            }

        .ripple {
            position: absolute;
            border-radius: 50%;
            transform: scale(0);
            background: rgba(13,148,136,.25);
            animation: rippleAnim .6s ease-out forwards;
            pointer-events: none;
        }

        @@keyframes rippleAnim {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* ═══════════ STATS — shine sweep on hover ═══════════ */
        .patients-stats {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        .patient-stat {
            position: relative;
            overflow: hidden;
            background: var(--card-grad);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: 20px;
            padding: 19px 21px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: var(--shadow-card);
            opacity: 0;
            transform: translateY(25px) scale(.98);
            animation: statRise .65s var(--ease-dental) forwards;
            transition: transform .3s var(--ease-dental), box-shadow .3s ease;
        }

            .patient-stat:nth-child(1) {
                animation-delay: .12s
            }

            .patient-stat:nth-child(2) {
                animation-delay: .20s
            }

            .patient-stat:nth-child(3) {
                animation-delay: .28s
            }

            .patient-stat:nth-child(4) {
                animation-delay: .36s
            }

        @@keyframes statRise {
            from {
                opacity: 0;
                transform: translateY(25px) scale(.98)
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1)
            }
        }

        .patient-stat:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }

        /* ⭐ shine sweep */
        .patient-stat::before {
            content: "";
            position: absolute;
            top: 0;
            left: -80%;
            width: 50%;
            height: 100%;
            background: linear-gradient(105deg, transparent, rgba(255,255,255,.55), transparent);
            transform: skewX(-20deg);
            transition: left .65s ease;
        }

        .patient-stat:hover::before {
            left: 135%;
        }

        .patient-stat::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            right: -35px;
            top: -45px;
            background: rgba(20,184,166,.055);
            transition: transform .4s ease;
        }

        .patient-stat:hover::after {
            transform: scale(1.35);
        }

        .patient-stat-icon {
            width: 55px;
            height: 55px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.45rem;
            flex-shrink: 0;
            transition: transform .3s var(--ease-dental);
        }

        .patient-stat:hover .patient-stat-icon {
            transform: scale(1.08) rotate(-4deg);
        }

        .stat-total .patient-stat-icon {
            background: #f0fdfa;
            color: #0f766e;
        }

        .stat-general .patient-stat-icon {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .stat-ortho .patient-stat-icon {
            background: #fffbeb;
            color: #b45309;
        }

        .stat-both .patient-stat-icon {
            background: #f5f3ff;
            color: #6d28d9;
        }

        .patient-stat-value {
            display: block;
            font-size: 1.65rem;
            line-height: 1;
            font-weight: 800;
            color: var(--ink-900);
        }

        .patient-stat-label {
            display: block;
            margin-top: 5px;
            font-size: .76rem;
            color: var(--ink-600);
            font-weight: 700;
        }

        /* ═══════════ TABLE CARD ═══════════ */
        .patients-card {
            position: relative;
            overflow: hidden;
            background: var(--card-grad);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.65);
            border-radius: 24px;
            box-shadow: var(--shadow-card);
            opacity: 0;
            transform: translateY(30px);
            animation: cardEnter .75s var(--ease-dental) .42s forwards;
        }

        @@keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(30px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--sky-100);
            flex-wrap: wrap;
        }

        .pill-toggle {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 4px;
            background: var(--sky-100);
            border-radius: 999px;
        }

        .pill-btn {
            position: relative;
            overflow: hidden;
            border: none;
            background: transparent;
            padding: 8px 16px;
            border-radius: 999px;
            color: var(--ink-600);
            font-size: .8rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all .25s ease;
        }

            .pill-btn i {
                transition: transform .25s var(--ease-dental);
            }

            .pill-btn:hover i {
                transform: scale(1.1) rotate(-4deg);
            }

            .pill-btn.active {
                background: linear-gradient(135deg,var(--dental-600),var(--dental-700));
                color: #fff;
                box-shadow: 0 5px 13px rgba(13,148,136,.25);
            }

            .pill-btn:hover:not(.active) {
                background: #fff;
                color: var(--dental-700);
            }

        .filter-bar-end {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        #tablePatients_filter {
            margin: 0;
        }

            #tablePatients_filter label {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0;
                background: rgba(255,255,255,.9);
                border: 1.5px solid var(--sky-100);
                border-radius: 999px;
                padding: 7px 15px;
                transition: border-color .2s, box-shadow .2s;
            }

                #tablePatients_filter label:focus-within {
                    border-color: var(--dental-500);
                    box-shadow: 0 0 0 3px rgba(15,155,142,.12);
                }

                #tablePatients_filter label i {
                    color: var(--dental-600);
                    font-size: .9rem;
                }

            #tablePatients_filter input {
                border: none !important;
                outline: none !important;
                box-shadow: none !important;
                background: transparent !important;
                padding: 0 !important;
                width: 210px;
                font-size: .82rem;
                color: var(--ink-900);
            }

        #tablePatients_length {
            margin: 0;
        }

            #tablePatients_length label {
                display: flex;
                align-items: center;
                gap: 7px;
                margin: 0;
                font-size: .76rem;
                color: var(--ink-600);
                font-weight: 700;
                white-space: nowrap;
            }

            #tablePatients_length select {
                border: 1.5px solid var(--sky-100);
                border-radius: 10px;
                background: #fff;
                padding: 6px 9px;
                outline: none;
                font-size: .8rem;
            }

        #tablePatients {
            border-collapse: separate;
            border-spacing: 0;
        }

            #tablePatients thead {
                opacity: 0;
                transform: translateY(10px);
                animation: tableHeaderEnter .5s ease .8s forwards;
            }

        @@keyframes tableHeaderEnter {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        #tablePatients thead th {
            background: rgba(234,251,252,.72) !important;
            color: var(--ink-600) !important;
            border: none !important;
            border-bottom: 2px solid var(--sky-100) !important;
            padding: 14px 10px;
            font-size: .75rem;
            font-weight: 800;
            white-space: nowrap;
        }

        #tablePatients tbody td {
            padding: 12px 10px;
            vertical-align: middle;
            border-color: var(--sky-100);
            font-size: .84rem;
        }

        #tablePatients tbody tr {
            opacity: 0;
            transform: translateY(10px);
            animation: patientRowEnter .45s var(--ease-dental) forwards;
            transition: background-color .2s, box-shadow .2s, transform .2s;
        }

        @@keyframes patientRowEnter {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }
        /* ⭐ row lift on hover */
        #tablePatients tbody tr:hover {
            background: var(--sky-50) !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(10,77,79,.07);
        }

        .patient-name-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .patient-avatar {
            width: 39px;
            height: 39px;
            border-radius: 12px;
            background: linear-gradient(135deg,var(--dental-500),var(--dental-700));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .78rem;
            font-weight: 800;
            box-shadow: 0 5px 12px rgba(13,148,136,.16);
            transition: transform .3s var(--ease-dental), box-shadow .3s ease;
        }

        #tablePatients tbody tr:hover .patient-avatar {
            transform: scale(1.08) rotate(-3deg);
            box-shadow: 0 8px 18px rgba(13,148,136,.25);
        }

        .btn-row-session {
            position: relative;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg,var(--dental-600),var(--dental-700));
            color: #fff;
            font-size: .74rem;
            font-weight: 800;
            text-decoration: none;
            box-shadow: 0 5px 12px rgba(13,148,136,.22);
            transition: transform .25s var(--ease-dental), box-shadow .25s ease;
        }

            .btn-row-session:hover {
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 8px 18px rgba(13,148,136,.3);
            }

            .btn-row-session::before {
                content: "";
                position: absolute;
                top: 0;
                left: -120%;
                width: 70%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
                transform: skewX(-20deg);
                transition: left .6s ease;
            }

            .btn-row-session:hover::before {
                left: 130%;
            }

        .row-actions-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            flex-wrap: nowrap;
        }

        .action-icon-btn {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: var(--ink-600);
            transition: transform .25s var(--ease-dental), background .2s, color .2s;
        }

            .action-icon-btn:hover {
                background: #f0fdfa;
                color: var(--dental-700);
                transform: translateY(-2px) scale(1.05);
            }

            .action-icon-btn.danger:hover {
                background: #fee2e2;
                color: #dc2626;
            }

        .table-loading-overlay {
            position: absolute;
            inset: 0;
            z-index: 10;
            background: rgba(255,255,255,.72);
            backdrop-filter: blur(3px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity .25s;
        }

            .table-loading-overlay.show {
                opacity: 1;
                pointer-events: all;
            }

        .loading-pulse {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--dental-700);
            font-weight: 800;
            font-size: .85rem;
            animation: loadingFloat 1.5s ease-in-out infinite;
        }

            .loading-pulse i {
                font-size: 1.25rem;
                animation: spin .9s linear infinite;
            }

        @@keyframes loadingFloat {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-5px)
            }
        }

        @@keyframes spin {
            from {
                transform: rotate(0)
            }

            to {
                transform: rotate(360deg)
            }
        }

        .table-footer-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            padding: 13px 20px 17px;
            border-top: 1px solid var(--sky-100);
            opacity: 0;
            animation: footerEnter .5s ease 1s forwards;
        }

        @@keyframes footerEnter {
            from {
                opacity: 0
            }

            to {
                opacity: 1
            }
        }

        #tablePatients_info {
            margin: 0;
            color: var(--ink-600);
            font-size: .76rem;
            font-weight: 600;
        }

        #tablePatients_paginate {
            margin: 0;
            display: flex;
            align-items: center;
        }

            #tablePatients_paginate .paginate_button {
                padding: 5px 11px;
                margin: 0 2px;
                border: 1px solid transparent !important;
                border-radius: 9px;
                background: transparent !important;
                color: var(--ink-600) !important;
                transition: all .2s ease;
            }

                #tablePatients_paginate .paginate_button.current {
                    background: var(--dental-500) !important;
                    color: #fff !important;
                    border-color: var(--dental-500) !important;
                }

                #tablePatients_paginate .paginate_button:hover:not(.current):not(.disabled) {
                    background: #f0fdfa !important;
                    border-color: var(--dental-200) !important;
                }

                #tablePatients_paginate .paginate_button.disabled {
                    opacity: .4;
                }

        @@media (max-width:1100px) {
            .patients-stats {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:760px) {
            .patients-hero {
                padding: 22px;
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .hero-content {
                width: 100%;
            }

            .btn-add-patient {
                width: 100%;
                justify-content: center;
            }

            .pill-toggle {
                width: 100%;
                justify-content: center;
            }

            .filter-bar-end {
                width: 100%;
                justify-content: space-between;
            }
        }

        @@media (max-width:640px) {
            .patients-stats {
                grid-template-columns: 1fr;
            }

            .patients-hero {
                border-radius: 18px;
            }

            .hero-text h1 {
                font-size: 1.15rem;
            }

            .hero-text p {
                font-size: .76rem;
            }

            .hero-tooth {
                width: 50px;
                height: 50px;
                font-size: 1.35rem;
            }

            #tablePatients_filter input {
                width: 150px;
            }

            .table-footer-bar {
                justify-content: center;
            }
        }

        @@media (prefers-reduced-motion:reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }

        .swal2-container {
            z-index: 2000 !important;
        }
    </style>
}

<section class="patients-page mt-0">
    <div class="row">
        <div class="col-12">

            <!-- ═══════ HERO ═══════ -->
            <div class="patients-hero">
                <div class="dental-floating-icons">
                    <div class="dental-floating-icon"><i class="bi bi-tooth"></i></div>
                    <div class="dental-floating-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                    <div class="dental-floating-icon"><i class="bi bi-clipboard2-pulse"></i></div>
                </div>
                <div class="hero-content">
                    <div class="hero-tooth"><i class="bi bi-tooth-fill"></i></div>
                    <div class="hero-text">
                        <h1>Patients</h1>
                        <p>Manage patient files, visits &amp; treatments in one place</p>
                    </div>
                </div>
                @if (canAdd)
                {
                    <button type="button" class="btn-add-patient" onclick="openPatientModal()">
                        <i class="bi bi-person-plus-fill"></i> Add New Patient
                    </button>
                }
            </div>

            <!-- ═══════ STATS ═══════ -->
            <div class="patients-stats" id="statsRow">
                <div class="patient-stat">
                    <div class="patient-stat-icon stat-total"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <span class="patient-stat-value" id="statTotal">0</span>
                        <span class="patient-stat-label">Total Patients</span>
                    </div>
                </div>
                <div class="patient-stat">
                    <div class="patient-stat-icon stat-general"><i class="bi bi-sign-intersection-side-fill"></i></div>
                    <div>
                        <span class="patient-stat-value" id="statGeneral">0</span>
                        <span class="patient-stat-label">General Files</span>
                    </div>
                </div>
                <div class="patient-stat">
                    <div class="patient-stat-icon stat-ortho"><i class="bi bi-braces"></i></div>
                    <div>
                        <span class="patient-stat-value" id="statOrtho">0</span>
                        <span class="patient-stat-label">Orthodontics Files</span>
                    </div>
                </div>
                <div class="patient-stat">
                    <div class="patient-stat-icon stat-both"><i class="bi bi-person-hearts"></i></div>
                    <div>
                        <span class="patient-stat-value" id="statBoth">0</span>
                        <span class="patient-stat-label">Both Files</span>
                    </div>
                </div>
            </div>

            <!-- ═══════ TABLE CARD ═══════ -->
            <div class="card patients-card p-0">
                <div class="filter-bar">
                    <div class="pill-toggle" id="categoryFilterGroup">
                        <button type="button" class="pill-btn active" data-category="">
                            <i class="bi bi-grid-fill"></i> All
                        </button>
                        <button type="button" class="pill-btn" data-category="General">
                            <i class="bi bi-sign-intersection-side-fill"></i> General
                        </button>
                        <button type="button" class="pill-btn" data-category="Orthodontics">
                            <i class="bi bi-braces"></i> Orthodontics
                        </button>
                    </div>
                    <div class="filter-bar-end" id="filterBarEnd"></div>
                </div>

                <!-- 👥 H2: فلاتر سريعة -->
                <div class="pl-quick" id="quickFilters">
                    <button type="button" class="pl-q active" data-q=""><i class="bi bi-people"></i> All patients</button>
                    <button type="button" class="pl-q" data-q="upcoming"><i class="bi bi-calendar2-check"></i> Has upcoming appointment</button>
                    @if (canMoney)
                    {
                        <button type="button" class="pl-q" data-q="balance"><i class="bi bi-cash-coin"></i> Has balance due</button>
                    }
                    <button type="button" class="pl-q" data-q="inactive"><i class="bi bi-moon-stars"></i> No visit in 6 months</button>
                </div>

                <div class="card-body p-0 position-relative">
                    <div class="table-loading-overlay" id="tableLoadingOverlay">
                        <div class="loading-pulse">
                            <i class="bi bi-arrow-repeat"></i> Loading patients...
                        </div>
                    </div>

                    <div class="table-responsive px-3 pb-3">
                        <table class="table table-hover align-middle display nowrap" id="tablePatients" style="width:100%">
                            <thead>
                                <tr class="text-center">
                                    <th class="text-center fs-6">Code</th>
                                    <th class="fs-6">Patient</th>
                                    <th class="text-center fs-6">Phone</th>
                                    <th class="text-center fs-6">Gender</th>
                                    <th class="text-center fs-6">Age</th>
                                    <th class="text-center fs-6">File Type</th>
                                    <th class="text-center fs-6">Last Visit</th>
                                    <th class="text-center fs-6">Next Session</th>
                                    @if (canMoney) { <th class="text-center fs-6">Balance</th> }
                                    <th class="text-center fs-6">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="table-footer-bar" id="tableFooterBar"></div>
                </div>
            </div>

        </div>
    </div>
</section>

<div id="patientModalContainer"></div>

@section Scripts {
    <script src="~/lib/datatables-1.13/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-1.13/dataTables.responsive.min.js"></script>

    <script>
        $(document).ready(function() {

            var currentCategoryFilter = '';
            var currentQuickFilter = '';
            const PL = {
                canEdit: @(canEdit ? "true" : "false"), canDelete: @(canDelete ? "true" : "false"),
                canDetails: @(canDetails ? "true" : "false"), canSession: @(canSession ? "true" : "false"),
                canMoney: @(canMoney ? "true" : "false"), cc: '@ClinicSettings.Get().WhatsAppCountryCode'
            };
            const waLink = m => {
                let d = String(m || '').replace(/\D/g, '');
                if (d.length < 8) return null;
                if (d.startsWith('00')) d = d.slice(2);
                else if (!(d.startsWith(PL.cc) && d.length > 10)) d = PL.cc + d.replace(/^0/, '');
                return 'https://wa.me/' + d;
            };
            const relDate = iso => {
                if (!iso) return null;
                const d = new Date(iso), t = new Date(); t.setHours(0, 0, 0, 0);
                const x = new Date(d); x.setHours(0, 0, 0, 0);
                const days = Math.round((t - x) / 864e5);
                if (days <= 0) return 'Today';
                if (days === 1) return 'Yesterday';
                if (days < 30) return days + ' days ago';
                if (days < 365) return Math.round(days / 30) + ' mo ago';
                return (days / 365).toFixed(1) + ' yr ago';
            };

            /* Animated counter */
            function animateCount(el, target) {
                target = parseInt(target || 0);
                const duration = 900, startTime = performance.now();
                function step(now) {
                    const progress = Math.min((now - startTime) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.text(Math.floor(target * eased).toLocaleString('en-EG'));
                    if (progress < 1) requestAnimationFrame(step);
                    else el.text(target.toLocaleString('en-EG'));
                }
                requestAnimationFrame(step);
            }

            function loadStats() {
                $.get('/Patients/GetPatientsStats', function(res) {
                    animateCount($('#statTotal'), res.total || 0);
                    animateCount($('#statGeneral'), res.general || 0);
                    animateCount($('#statOrtho'), res.ortho || 0);
                    animateCount($('#statBoth'), res.both || 0);
                });
            }
            loadStats();

            /* DataTable */
            var table = $('#tablePatients').DataTable({
                processing: true,
                serverSide: true,
                responsive: window.innerWidth > 768,   // 👥 H2: على الموبايل بنعرض كروت بدل إخفاء الأعمدة
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100, 200, 400, 1000],
                ordering: true,

                ajax: {
                    url: '/Patients/GetPatientsData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function(d) {
                        d.categoryFilter = currentCategoryFilter;
                        d.quickFilter = currentQuickFilter;
                        return JSON.stringify(d);
                    },
                    error: function(xhr, error, thrown) {
                        console.error('DataTables error:', error, thrown);
                        Swal.fire({
                            title: 'Error', text: 'Failed to load patients from the server',
                            icon: 'error', confirmButtonColor: '#0d9488'
                        });
                    }
                },

                columns: [
                    {
                        data: 'patientCode', name: 'patientCode', className: 'text-center fs-6',
                        render: function(data) {
                            return `<span class="badge bg-secondary" style="font-family:Candara;">${data || '-'}</span>`;
                        }
                    },
                    {
                        data: null, name: 'fullNameAr', className: 'fs-6',
                        render: function(data) {
                            var name = data.fullNameAr || '-';
                            var initials = name.split(' ').filter(Boolean).slice(0, 2)
                                .map(function(p) { return p[0]; }).join('');
                            return `<div class="patient-name-cell">
                                                <div class="patient-avatar">${initials || '?'}</div>
                                                <span class="link-dark fw-semibold">${name}</span>
                                            </div>`;
                        }
                    },
                    {
                        data: 'phone', name: 'phone', className: 'fs-6 text-center',
                        render: function(data) {
                            if (!data) return '-';
                            const wa = waLink(data);
                            return `<div class="pl-phone">
                                        <span style="font-family:Candara;direction:ltr;">${data}</span>
                                        <a class="pl-ic" href="tel:${data}" title="Call" onclick="event.stopPropagation()"><i class="bi bi-telephone"></i></a>
                                        ${wa ? `<a class="pl-ic pl-wa" href="${wa}" target="_blank" rel="noopener" title="WhatsApp" onclick="event.stopPropagation()"><i class="bi bi-whatsapp"></i></a>` : ''}
                                    </div>`;
                        }
                    },
                    { data: 'genderBadge', name: 'genderName', className: 'text-center', searchable: false },
                    {
                        data: 'age', name: 'age', className: 'text-center fs-6',
                        render: function(data) { return data || '<span class="text-muted">-</span>'; }
                    },
                    { data: 'categoryBadge', name: 'category', className: 'text-center', orderable: false, searchable: false },
                    {
                        data: 'lastVisit', name: 'lastVisit', className: 'text-center',
                        render: function(data) {
                            const r = relDate(data);
                            if (!r) return '<span class="text-muted">—</span>';
                            const old = (Date.now() - new Date(data)) / 864e5 > 180;
                            return `<span class="pl-last ${old ? 'old' : ''}" title="${new Date(data).toLocaleDateString('en-GB')}">${r}</span>`;
                        }
                    },
                    {
                        data: 'nextSession', name: 'nextSession', className: 'text-center',
                        render: function(data) {
                            if (!data) return '<span class="text-muted">—</span>';
                            var d = new Date(data);
                            var today = new Date(); today.setHours(0, 0, 0, 0);
                            var t = new Date(d); t.setHours(0, 0, 0, 0);
                            var diff = Math.round((t - today) / 86400000);
                            var label = diff === 0 ? 'Today' : diff === 1 ? 'Tomorrow'
                                : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                            var cls = diff === 0 ? 'bg-danger' : diff === 1 ? 'bg-warning text-dark' : 'bg-light text-dark border';
                            return `<span class="badge ${cls}">${label}</span>`;
                        }
                    },
                    ...(PL.canMoney ? [{
                        data: 'balance', name: 'balance', className: 'text-center',
                        render: function(data) {
                            const n = Number(data || 0);
                            return n > 0 ? `<span class="pl-due">${n.toLocaleString('en-US')}</span>` : '<span class="pl-paid"><i class="bi bi-check2"></i></span>';
                        }
                    }] : []),
                    {
                        data: null, orderable: false, searchable: false, className: 'text-center',
                        render: function(data) {
                            return `<div class="row-actions-cell" onclick="event.stopPropagation()">
                                        ${PL.canSession ? `<a class="btn-row-session" title="Start a new session"
                                           href="/Patients/NewSession?patientId=${data.id}">
                                            <i class="bi bi-clipboard2-pulse"></i> New Session
                                        </a>` : ''}
                                        ${PL.canDetails ? `<a class="action-icon-btn fs-5" title="View details"
                                           href="/Patients/Details/${data.id}">
                                            <i class="bi bi-eye"></i>
                                        </a>` : ''}
                                        ${PL.canEdit ? `<a class="action-icon-btn fs-5" title="Edit"
                                           href="javascript:void(0)" onclick="openPatientModal(${data.id})">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>` : ''}
                                        ${PL.canDelete ? `<button type="button" class="action-icon-btn danger fs-5" title="Delete"
                                                onclick="deletePatient(${data.id})">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>` : ''}
                                    </div>`;
                        }
                    }
                ],

                language: {
                    search: '<i class="bi bi-search"></i>',
                    searchPlaceholder: 'Search by name, code or phone...',
                    lengthMenu: '_MENU_',
                    info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                    zeroRecords: 'No patients found',
                    emptyTable: 'No patient data available',
                    paginate: { first: 'First', previous: 'Previous', next: 'Next', last: 'Last' },
                    processing: ''
                },

                deferRender: true,

                createdRow: function(row, data) {
                    row.dataset.id = data.id;
                    if (PL.canDetails) row.classList.add('pl-clickable');
                },

                drawCallback: function() {
                    $('#tablePatients tbody tr').each(function(index) {
                        const row = this;
                        row.style.animation = 'none';
                        void row.offsetWidth;
                        row.style.animation = 'patientRowEnter .45s var(--ease-dental) forwards';
                        row.style.animationDelay = Math.min(index * .045, .35) + 's';
                    });
                },

                initComplete: function() {
                    $('#tablePatients_filter').appendTo('#filterBarEnd');
                    $('#tablePatients_length').appendTo('#filterBarEnd');
                    $('#tablePatients_info').appendTo('#tableFooterBar');
                    $('#tablePatients_paginate').appendTo('#tableFooterBar');
                }
            });

            $('#tablePatients').on('processing.dt', function(e, settings, processing) {
                $('#tableLoadingOverlay').toggleClass('show', processing);
            });

            // 👥 H2: الضغط على الصف يفتح ملف المريض
            $('#tablePatients tbody').on('click', 'tr.pl-clickable', function(e) {
                if (e.target.closest('a,button,input')) return;
                const id = this.dataset.id;
                if (!id) return;
                if (e.ctrlKey || e.metaKey) window.open('/Patients/Details/' + id, '_blank');
                else location.href = '/Patients/Details/' + id;
            });

            $('#quickFilters').on('click', '.pl-q', function() {
                $('#quickFilters .pl-q').removeClass('active');
                $(this).addClass('active');
                currentQuickFilter = $(this).data('q') || '';
                table.ajax.reload();
            });

            $('.pill-btn').on('click', function() {
                $('.pill-btn').removeClass('active');
                $(this).addClass('active');
                currentCategoryFilter = $(this).data('category');
                table.ajax.reload();
            });

            /* ⭐ ripple effect on hero button */
            $('.btn-add-patient').on('click', function(e) {
                const btn = this, rect = btn.getBoundingClientRect();
                const ripple = document.createElement('span');
                const size = Math.max(rect.width, rect.height);
                ripple.className = 'ripple';
                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
                btn.appendChild(ripple);
                setTimeout(() => ripple.remove(), 650);
            });
        });

        /* ══════════ Delete ══════════ */
        function deletePatient(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: 'The patient will be deactivated from the system',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(function(result) {
                if (!result.isConfirmed) return;
                $.ajax({
                    url: '/Patients/Delete',
                    type: 'POST',
                    data: { id: id },
                    headers: {
                        RequestVerificationToken: window.getCsrfToken ? window.getCsrfToken() : 
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#tablePatients').DataTable().ajax.reload(null, false);
                            Swal.fire({
                                title: 'Deleted!',
                                text: response.message || 'Patient deactivated successfully.',
                                icon: 'success',
                                confirmButtonColor: '#0d9488',
                                confirmButtonText: 'OK',
                                timer: 2000,
                                timerProgressBar: true
                            });
                            setTimeout(function() {
                                $.get('/Patients/GetPatientsStats', function(res) {
                                    animatePatientStat('#statTotal', res.total || 0);
                                    animatePatientStat('#statGeneral', res.general || 0);
                                    animatePatientStat('#statOrtho', res.ortho || 0);
                                    animatePatientStat('#statBoth', res.both || 0);
                                });
                            }, 250);
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: response.message || 'Something went wrong while deleting',
                                icon: 'error',
                                confirmButtonColor: '#0d9488',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            title: 'Error', text: 'Failed to connect to the server',
                            icon: 'error', confirmButtonColor: '#0d9488', confirmButtonText: 'OK'
                        });
                    }
                });
            });
        }

        function animatePatientStat(selector, target) {
            const el = $(selector);
            const startValue = parseInt(el.text().replace(/,/g, '')) || 0;
            const duration = 600, startTime = performance.now();
            function step(now) {
                const progress = Math.min((now - startTime) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const value = Math.round(startValue + (target - startValue) * eased);
                el.text(value.toLocaleString('en-EG'));
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

        /* ══════════ Patient Modal — open / save / dd-mm-yyyy ══════════ */
        let pmBackdropEl = null;

        function openPatientModal(id) {
            const url = id ? '/Patients/Modal?id=' + id : '/Patients/Modal';
            const box = document.getElementById('patientModalContainer');

            box.innerHTML = `<div class="pmodal-backdrop show">
                        <div class="pmodal" style="min-height:220px;display:flex;align-items:center;justify-content:center;">
                            <div class="spinner-border" style="color:#0d9488"></div>
                        </div></div>`;

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => {
                    if (!r.ok) throw new Error(r.status);
                    return r.text();
                })
                .then(html => {
                    box.innerHTML = html;
                    pmBackdropEl = document.getElementById('pmodalBackdrop');
                    requestAnimationFrame(() => pmBackdropEl.classList.add('show'));
                    initPatientModal();
                })
                .catch(() => {
                    box.innerHTML = '';
                    Swal.fire({
                        title: 'Error', text: 'Failed to load the form',
                        icon: 'error', confirmButtonColor: '#0d9488'
                    });
                });
        }

        function closePatientModal() {
            if (!pmBackdropEl) return;
            pmBackdropEl.classList.add('hide-out');
            setTimeout(() => {
                document.getElementById('patientModalContainer').innerHTML = '';
                pmBackdropEl = null;
            }, 300);
        }

        function initPatientModal() {
            const form = document.getElementById('patientModalForm');
            const nameInput = document.getElementById('pmFullName');
            const avatar = document.getElementById('pmAvatar');
            const title = document.getElementById('pmTitle');
            const isEdit = form.action.indexOf('/Edit') > -1;

            /* Live age calculation */
            const dobInput = document.getElementById('pmDateOfBirth');
            const ageBadge = document.getElementById('pmAgeBadge');
            function updateAge() {
                if (!dobInput.value) { ageBadge.textContent = ''; return; }
                const dob = new Date(dobInput.value);
                const now = new Date();
                let age = now.getFullYear() - dob.getFullYear();
                const m = now.getMonth() - dob.getMonth();
                if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
                ageBadge.textContent = age >= 0 ? age + ' years' : '';
            }
            dobInput.addEventListener('change', updateAge);
            updateAge();


            /* Live avatar + title */
            nameInput.addEventListener('input', function() {
                const n = this.value.trim();
                avatar.textContent = n.split(' ').filter(Boolean).slice(0, 2).map(p => p[0]).join('') || '?';
                title.textContent = n || (isEdit ? 'Edit Patient' : 'New Patient');
            });

            /* Gender segmented */
            const seg = document.getElementById('pmGenderSeg');
            seg.querySelectorAll('input[type=radio]').forEach((radio, idx) => {
                radio.addEventListener('change', () => {
                    seg.querySelectorAll('label').forEach(l => l.classList.remove('active'));
                    radio.closest('label').classList.add('active');
                    seg.classList.toggle('pos-1', idx === 0);
                    seg.classList.toggle('pos-2', idx === 1);
                });
            });

            /* Type tiles */
            document.querySelectorAll('#pmTypeTiles input[type=radio]').forEach(radio => {
                radio.addEventListener('change', () => {
                    document.querySelectorAll('#pmTypeTiles .pm-tile').forEach(t => t.classList.remove('selected'));
                    radio.closest('.pm-tile').classList.add('selected');
                });
            });

            /* Close handlers */
            pmBackdropEl.querySelectorAll('[data-pm-close]').forEach(b =>
                b.addEventListener('click', closePatientModal));
            pmBackdropEl.addEventListener('mousedown', e => {
                if (e.target === pmBackdropEl) closePatientModal();
            });
            document.addEventListener('keydown', function esc(e) {
                if (e.key === 'Escape' && pmBackdropEl) {
                    closePatientModal();
                    document.removeEventListener('keydown', esc);
                }
            });

            /* AJAX submit */
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('pmSaveBtn');
                const originalHtml = btn.innerHTML;
                const resetBtn = () => { btn.disabled = false; btn.innerHTML = originalHtml; };

                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
                pmBackdropEl.querySelectorAll('.invalid-msg').forEach(s => s.style.display = 'none');

                try {
                    const r = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    const raw = await r.text();
                    let res = null;
                    try { res = JSON.parse(raw); } catch { /* مش JSON */ }
                    console.log('Patient save response:', r.status, raw);

                    if (res && res.success) {
                        closePatientModal();
                        Swal.fire({
                            title: 'Success', text: res.message, icon: 'success',
                            confirmButtonColor: '#0d9488',
                            timer: 1600, timerProgressBar: true, showConfirmButton: false
                        }).then(() => {
                            if (res.redirectUrl) window.location.href = res.redirectUrl;
                            else $('#tablePatients').DataTable().ajax.reload(null, false);
                        });
                        return;
                    }

                    resetBtn();

                    if (res && res.errors) {
                        const unmatched = [];
                        Object.entries(res.errors).forEach(([field, msgs]) => {
                            const key = field.split('.').pop();
                            const slot = pmBackdropEl.querySelector(`.invalid-msg[data-for="${key}"]`);
                            if (slot) { slot.textContent = msgs[0]; slot.style.display = 'block'; }
                            else unmatched.push(`${key}: ${msgs[0]}`);
                        });
                        if (unmatched.length) {
                            Swal.fire({
                                title: 'Validation', text: unmatched.join(' | '),
                                icon: 'error', confirmButtonColor: '#0d9488'
                            });
                        }
                        return;
                    }

                    Swal.fire({
                        title: 'Error',
                        text: (res && res.message) || `Server returned ${r.status}: ${raw.slice(0, 150)}`,
                        icon: 'error', confirmButtonColor: '#0d9488'
                    });
                } catch (err) {
                    console.error(err);
                    resetBtn();
                    Swal.fire({
                        title: 'Error', text: 'Failed to connect to the server',
                        icon: 'error', confirmButtonColor: '#0d9488'
                    });
                }
            });

            nameInput.focus();
        }
    </script>

    @if (TempData[Helper.MsgType] != null)
    {
        <script>
            Swal.fire({
                title: '@TempData[Helper.Title]',
                text: '@Html.Raw(TempData[Helper.Msg])',
                confirmButtonText: 'OK',
                icon: '@(TempData[Helper.MsgType]?.ToString() == Helper.Success ? "success" : "error")',
                confirmButtonColor: '#0d9488'
            });
        </script>
    }
}