@using Dental.Models.Patient
@using Dental.Modules.Patients.DTOs
@model Dental.Modules.Patients.DTOs.UpdatePatientDto
@{
    ViewData["Title"] = "تعديل بيانات المريض";
    var genderList = ViewBag.Genders as SelectList ?? new SelectList(new List<SelectListItem>());
    var bloodGroupList = ViewBag.BloodGroups as SelectList ?? new SelectList(new List<SelectListItem>());
}
@section Styles {
    <link rel="stylesheet" href="~/css/patients-theme.css" />
}
<section class="container-fluid mt-4" dir="rtl">
    <div class="row">
        <div class="col-md-1"></div>
        <div class="col-md-10">
            <div class="erp-hero">
                <div class="hero-title">
                    <div class="hero-icon"><i class="bi bi-pencil-square"></i></div>
                    <div>
                        <h1>تعديل بيانات المريض</h1>
                        <p>تحديث بيانات المريض والتاريخ الطبي</p>
                    </div>
                </div>
                <div class="hero-actions">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-hero btn-hero-ghost">
                        <i class="bi bi-x-lg"></i> إلغاء
                    </a>
                    <button type="submit" form="editForm" class="btn-hero btn-hero-light">
                        <i class="bi bi-check-lg"></i> حفظ التعديلات
                    </button>
                </div>
            </div>
            <form id="editForm" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <!-- Patient Identity -->
                    <div class="col-12 col-lg-3">
                        <div class="erp-card">
                            <div class="erp-card-header tone-identity">
                                <i class="bi bi-person-fill"></i> هوية المريض
                            </div>
                            <div class="erp-card-body">
                                <div class="erp-field">
                                    <label>الاسم الكامل <span class="required">*</span></label>
                                    <input asp-for="FullNameAr" class="form-control" placeholder="أدخل اسم المريض" autocomplete="off" />
                                    <span asp-validation-for="FullNameAr" class="text-danger"></span>
                                </div>
                                <div class="erp-field">
                                    <label>الاسم بالإنجليزية</label>
                                    <input asp-for="FullNameEn" class="form-control" placeholder="Optional" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Personal Information -->
                    <div class="col-12 col-lg-3">
                        <div class="erp-card">
                            <div class="erp-card-header tone-personal">
                                <i class="bi bi-card-checklist"></i> البيانات الشخصية
                            </div>
                            <div class="erp-card-body">
                                <div class="erp-field">
                                    <label>نوع الملف <span class="required">*</span></label>
                                    <div class="type-chip-group">
                                        <label class="type-chip general">
                                            <input type="radio" name="PatientType" value="1" @(Model.PatientType == PatientType.General ? "checked" : "") />
                                            <i class="bi bi-tooth"></i> عام
                                        </label>
                                        <label class="type-chip ortho">
                                            <input type="radio" name="PatientType" value="2" @(Model.PatientType == PatientType.Orthodontics ? "checked" : "") />
                                            <i class="bi bi-braces"></i> تقويم
                                        </label>
                                        <label class="type-chip both">
                                            <input type="radio" name="PatientType" value="3" @(Model.PatientType == PatientType.Both ? "checked" : "") />
                                            <i class="bi bi-heart-pulse"></i> كلهما
                                        </label>
                                    </div>
                                </div>
                                <div class="erp-field">
                                    <label>النوع</label>
                                    <select asp-for="GenderId" asp-items="@genderList" class="form-select">
                                        <option value="">-- اختر --</option>
                                    </select>
                                </div>
                                <div class="erp-field">
                                    <label>تاريخ الميلاد</label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                </div>
                                <div class="erp-field">
                                    <label>فصيلة الدم</label>
                                    <select asp-for="BloodGroupId" asp-items="@bloodGroupList" class="form-select">
                                        <option value="">-- اختر --</option>
                                    </select>
                                </div>
                                <div class="erp-field">
                                    <label>الرقم القومي</label>
                                    <input asp-for="NationalId" class="form-control" placeholder="14 رقم" maxlength="14" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Contact Information -->
                    <div class="col-12 col-lg-3">
                        <div class="erp-card">
                            <div class="erp-card-header tone-contact">
                                <i class="bi bi-telephone-fill"></i> بيانات التواصل
                            </div>
                            <div class="erp-card-body">
                                <div class="erp-field">
                                    <label>الموبايل <span class="required">*</span></label>
                                    <input asp-for="Mobile" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" />
                                    <span asp-validation-for="Mobile" class="text-danger"></span>
                                </div>
                                <div class="erp-field">
                                    <label>تليفون</label>
                                    <input asp-for="Phone" class="form-control" placeholder="اختياري" dir="ltr" />
                                </div>
                                <div class="erp-field">
                                    <label>البريد الإلكتروني</label>
                                    <input asp-for="Email" class="form-control" placeholder="patient@email.com" dir="ltr" />
                                </div>
                                <div class="erp-field">
                                    <label>العنوان</label>
                                    <input asp-for="Address" class="form-control" placeholder="أدخل العنوان" />
                                </div>
                                <div class="erp-field">
                                    <label>المهنة</label>
                                    <input asp-for="Occupation" class="form-control" placeholder="اختياري" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Medical History -->
                    <div class="col-12 col-lg-3">
                        <div class="erp-card">
                            <div class="erp-card-header tone-medical">
                                <i class="bi bi-heart-pulse-fill"></i> التاريخ الطبي
                            </div>
                            <div class="erp-card-body">
                                <div class="erp-field">
                                    <label>الحساسية</label>
                                    <input asp-for="Allergies" class="form-control" placeholder="مثال: بنسلين، ليدوكايين..." />
                                </div>
                                <div class="erp-field">
                                    <label>أمراض مزمنة</label>
                                    <input asp-for="ChronicDiseases" class="form-control" placeholder="سكري، ضغط..." />
                                </div>
                                <div class="erp-field">
                                    <label>الأدوية الحالية</label>
                                    <input asp-for="CurrentMedications" class="form-control" />
                                </div>
                                <div class="erp-field">
                                    <label>حالة التدخين</label>
                                    <select asp-for="SmokingStatus" class="form-select">
                                        <option value="">-- اختر --</option>
                                        <option value="NonSmoker">لا يدخن</option>
                                        <option value="FormerSmoker">مدخن سابق</option>
                                        <option value="LightSmoker">مدخن خفيف</option>
                                        <option value="HeavySmoker">مدخن شره</option>
                                    </select>
                                </div>
                                <div class="erp-field">
                                    <label class="check-label">
                                        <input type="checkbox" asp-for="IsPregnant" />
                                        <span>حامل</span>
                                    </label>
                                </div>
                                <div class="erp-field">
                                    <label>ملاحظات طبية عاجلة</label>
                                    <textarea asp-for="EmergencyNotes" class="form-control erp-textarea" style="min-height:60px;" placeholder="تحذيرات للدكتور..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Notes -->
                    <div class="col-12">
                        <div class="erp-card">
                            <div class="erp-card-header tone-notes">
                                <i class="bi bi-journal-text"></i> ملاحظات إضافية
                            </div>
                            <div class="erp-card-body">
                                <textarea asp-for="Notes" class="form-control erp-textarea" placeholder="أي ملاحظات أو تعليمات خاصة بالمريض..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-1"></div>
    </div>
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}