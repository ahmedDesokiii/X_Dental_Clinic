@using Dental.Models.Patient
@using Dental.Modules.Patients.DTOs
@using System.Linq
@model Dental.Modules.Patients.DTOs.UpdatePatientDto
@{
    ViewData["Title"] = "تعديل بيانات المريض";
    var genderList = ViewBag.Genders as SelectList ?? new SelectList(new List<SelectListItem>());
    var bloodGroupList = ViewBag.BloodGroups as SelectList ?? new SelectList(new List<SelectListItem>());

    var initialName = string.IsNullOrWhiteSpace(Model.FullNameAr) ? "مريض" : Model.FullNameAr;
    var initialInitials = string.IsNullOrWhiteSpace(Model.FullNameAr)
        ? "؟"
        : string.Join("", Model.FullNameAr.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}
@section Styles {
    <link rel="stylesheet" href="~/css/patient-hero-shared.css" asp-append-version="true" />


    <style>
        /* ── Profile panel (right col) ── */
        .profile-panel-inline {
            background: rgba(255,255,255,.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: var(--sc-radius-lg);
            padding: 22px 18px;
            box-shadow: 0 20px 50px rgba(10,77,79,.08);
        }

        .avatar-preview {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 800;
            margin: 0 auto 12px;
            box-shadow: 0 10px 24px rgba(13,115,119,.28);
        }

        #namePreview {
            font-size: 1rem;
            font-weight: 800;
            color: var(--sc-ink-900);
            min-height: 1.3em;
            margin-bottom: 16px;
        }

        .code-chip {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            background: var(--sc-sky-100);
            color: var(--sc-teal-700);
            padding: 4px 12px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .profile-summary {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px dashed var(--sc-sky-100);
            display: flex;
            flex-direction: column;
            gap: 10px;
            text-align: right;
        }

        .summary-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
        }

            .summary-row span.label {
                color: var(--sc-ink-600);
                font-weight: 600;
            }

            .summary-row span.value {
                font-weight: 800;
                color: var(--sc-ink-900);
                display: flex;
                align-items: center;
                gap: 5px;
            }

        /* ── Document card ── */
        .form-doc {
            background: rgba(255,255,255,.82);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: var(--sc-radius-lg);
            box-shadow: 0 20px 50px rgba(10,77,79,.08);
            overflow: hidden;
            
        }

        .form-section {
            padding: 20px 22px;
            opacity: 0;
            transform: translateY(8px);
            animation: sectionFadeIn .45s ease forwards;
        }

            .form-section:not(:last-child) {
                border-bottom: 1px solid var(--sc-sky-100);
            }

            .form-section:nth-of-type(1) {
                animation-delay: .03s;
            }

            .form-section:nth-of-type(2) {
                animation-delay: .08s;
            }

            .form-section:nth-of-type(3) {
                animation-delay: .13s;
            }

        @@keyframes sectionFadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section-head {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

            .section-head .section-icon {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--sc-sky-100);
                color: var(--sc-teal-700);
                font-size: 1rem;
                flex-shrink: 0;
            }

            .section-head h2 {
                font-size: 0.95rem;
                font-weight: 800;
                color: var(--sc-ink-900);
                margin: 0;
            }

            .section-head p {
                font-size: 0.76rem;
                color: var(--sc-ink-600);
                margin: 1px 0 0;
                font-weight: 600;
            }

        .fields-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 16px;
        }

        @@media (max-width: 640px) {
            .fields-grid {
                grid-template-columns: 1fr;
            }
        }

        .fields-grid .span-2 {
            grid-column: 1 / -1;
        }

        /* ⭐ الليبل جنب الـ Input بدل ما يكون فوقه (زي كل حقول الفورم) */
        .sc-field {
            display: flex;
            align-items: center;
            
        }

            .sc-field label {
                flex: 0 0 auto;
                min-width: 92px;
                font-size: 0.76rem;
                font-weight: 700;
                color: var(--sc-ink-600);
                margin-bottom: 0;
                text-align: right;
            }

                .sc-field label .required {
                    color: #dc2626;
                }

            .sc-field .form-control,
            .sc-field .form-select {
                flex: 1 1 auto;
                min-width: 0;
                width: auto;
                border: 1.5px solid var(--sc-sky-100);
                border-radius: 10px;
                padding: 10px 12px;
                font-size: 0.9rem;
                background: #fff;
                transition: border-color .2s, box-shadow .2s;
            }

                .sc-field .form-control:focus,
                .sc-field .form-select:focus {
                    border-color: var(--sc-teal-500);
                    box-shadow: 0 0 0 3px rgba(15,155,142,.12);
                    outline: none;
                }

            .sc-field textarea.form-control {
                min-height: 90px;
                resize: vertical;
            }

            /* الحقول اللي فيها textarea نخلي الـ label ملزّق فوق مش في النص رأسيًا */
            .sc-field.align-start {
                align-items: flex-start;
            }

                .sc-field.align-start label {
                    margin-top: 10px;
                }

            .sc-field .text-danger {
                font-size: 0.76rem;
                margin-top: 4px;
                display: block;
            }

        .sc-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            font-size: .85rem;
            font-weight: 700;
            color: var(--sc-ink-900);
            padding-top: 6px;
        }

            .sc-checkbox input {
                width: 18px;
                height: 18px;
                accent-color: var(--sc-teal-600);
                cursor: pointer;
            }

        /* ── Patient type — selectable tiles ── */
        .type-tiles {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        @@media (max-width: 640px) {
            .type-tiles {
                grid-template-columns: 1fr;
            }
        }

        .type-tile {
            position: relative;
            border: 2px solid var(--sc-sky-100);
            border-radius: 14px;
            padding: 16px 14px;
            text-align: center;
            cursor: pointer;
            transition: all .22s ease;
            background: #fff;
        }

            .type-tile input {
                display: none;
            }

            .type-tile .tile-icon {
                width: 42px;
                height: 42px;
                margin: 0 auto 10px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
                background: var(--sc-sky-100);
                color: var(--sc-teal-700);
                transition: all .22s ease;
            }

            .type-tile .tile-title {
                font-weight: 800;
                font-size: 0.88rem;
                color: var(--sc-ink-900);
            }

            .type-tile .tile-desc {
                font-size: 0.72rem;
                color: var(--sc-ink-600);
                margin-top: 3px;
                line-height: 1.4;
            }

            .type-tile .tile-check {
                position: absolute;
                top: 10px;
                left: 10px;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: var(--sc-teal-600);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .68rem;
                opacity: 0;
                transform: scale(.5);
                transition: all .2s ease;
            }

            .type-tile:hover {
                border-color: var(--sc-teal-100);
                transform: translateY(-2px);
            }

            .type-tile.selected {
                border-color: var(--sc-teal-600);
                background: linear-gradient(160deg, #fff, var(--sc-sky-50));
                box-shadow: 0 8px 20px rgba(15,155,142,.18);
                transform: translateY(-2px);
            }

                .type-tile.selected .tile-icon {
                    background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
                    color: #fff;
                }

                .type-tile.selected .tile-check {
                    opacity: 1;
                    transform: scale(1);
                }

        /* ── Gender — segmented control ── */
        .segmented {
            position: relative;
            display: flex;
            background: var(--sc-sky-100);
            border-radius: 999px;
            padding: 4px;
        }

            .segmented .seg-thumb {
                position: absolute;
                top: 4px;
                bottom: 4px;
                width: calc(50% - 4px);
                background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
                border-radius: 999px;
                box-shadow: 0 4px 10px rgba(13,148,136,.28);
                transition: transform .28s cubic-bezier(.3,1.2,.4,1);
                z-index: 0;
            }

            .segmented.pos-1 .seg-thumb {
                transform: translateX(0);
            }

            .segmented.pos-2 .seg-thumb {
                transform: translateX(-100%);
            }

            .segmented label {
                position: relative;
                z-index: 1;
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                padding: 9px 0;
                font-size: 0.85rem;
                font-weight: 700;
                color: var(--sc-ink-600);
                cursor: pointer;
                transition: color .2s ease;
                border-radius: 999px;
            }

                .segmented label input {
                    display: none;
                }

                .segmented label.active {
                    color: #fff;
                }
    </style>
}
<section class="patients-page-anim" dir="rtl">
    <div class="row">
        <form id="editForm" asp-action="Edit" method="post">
            <div class="col-md-12">

                @{
                    var editGenderIcon = Model.GenderId == 2 ? "bi-gender-female" : "bi-gender-male";
                    var editGenderText = Model.GenderId == 2 ? "أنثى" : "ذكر";
                    var editTypeIcon = Model.PatientType == PatientType.Orthodontics ? "bi-braces"
                        : Model.PatientType == PatientType.Both ? "bi-heart-pulse" : "bi-app-indicator";
                    var editTypeText = Model.PatientType == PatientType.Orthodontics ? "تقويم"
                        : Model.PatientType == PatientType.Both ? "كلا الملفين" : "عام";
                    var editBloodText = bloodGroupList.FirstOrDefault(i => i.Value == Model.BloodGroupId?.ToString())?.Text;
                    var editPatientCode = ViewBag.PatientCode as string;
                    int? editAge = null;
                    if (Model.DateOfBirth.HasValue)
                    {
                        var today = DateOnly.FromDateTime(DateTime.Today);
                        var dob = Model.DateOfBirth.Value;
                        var a = today.Year - dob.Year;
                        if (dob > today.AddYears(-a)) a--;
                        editAge = a;
                    }
                }
                <div class="patient-hero">
                    <div class="hero-content">
                        <div class="hero-avatar" id="avatarPreview">@initialInitials</div>
                        <div>
                            <h1 id="heroNamePreview">@initialName</h1>
                            <div class="hero-meta">
                                @if (!string.IsNullOrWhiteSpace(editPatientCode))
                                {
                                    <span class="hero-meta-tag"><i class="bi bi-hash"></i> @editPatientCode</span>
                                }
                                <span class="hero-meta-tag" id="heroMobileTag"><i class="bi bi-telephone"></i> @Model.Mobile</span>
                                <span class="hero-meta-tag" id="heroGenderTag"><i class="bi @editGenderIcon"></i> @editGenderText</span>
                                <span class="hero-meta-tag" id="heroAgeTag" style="@(editAge == null ? "display:none;" : "")">
                                    <i class="bi bi-calendar"></i> @editAge سنة
                                </span>
                                <span class="hero-meta-tag" id="heroTypeTag"><i class="bi @editTypeIcon"></i> @editTypeText</span>
                                <span class="hero-meta-tag hero-tag-optional @(string.IsNullOrWhiteSpace(editBloodText) ? "" : "has-value")" id="heroBloodTag">
                                    <i class="bi bi-droplet"></i> @editBloodText
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="hero-actions">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-hero btn-hero-ghost">
                            <i class="bi bi-x-lg"></i> إلغاء
                        </a>
                        <button type="submit" form="editForm" class="btn-hero btn-hero-light">
                            <i class="bi bi-check-lg"></i> حفظ التعديلات
                        </button>
                    </div>
                </div>

            
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <!-- Identity + basic fields -->
                    <div class="col-12 col-lg-4">
                        <div class="form-section">
                        <div class="section-head">
                                <div class="section-icon"><i class="bi bi-person-fill"></i></div>
                                <div>
                                    <h2>المعلومات الأساسية</h2>
                                    <p>اسم المريض كما سيظهر في الملف</p>
                                </div>
                            </div>
                        <div class="fields-grid">
                            <div class="sc-field span-2">
                                <label>الاسم الكامل <span class="required">*</span></label>
                                <input asp-for="FullNameAr" id="fullNameInput" class="form-control text-center" placeholder="أدخل اسم المريض" autocomplete="off" />
                            <span asp-validation-for="FullNameAr" class="text-danger"></span>
                            </div>
                            <div class="sc-field span-2" hidden>
                                <label>الاسم بالإنجليزية</label>
                                <input asp-for="FullNameEn" class="form-control" placeholder="Optional" autocomplete="off" dir="ltr" />
                            </div>
                            <div class="sc-field span-2">
                                <label>الموبايل <span class="required">*</span></label>
                                <input asp-for="Mobile" class="form-control text-center" placeholder="01xxxxxxxxx" dir="ltr" />
                            <span asp-validation-for="Mobile" class="text-danger"></span>
                            </div>
                            <div class="sc-field span-2">
                                <label>تاريخ الميلاد</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control text-center" />
                            </div>
                            <div class="sc-field span-2">
                                <label>فصيلة الدم</label>
                                <select asp-for="BloodGroupId" asp-items="@bloodGroupList" class="form-select text-center">
                                    <option value="">-- اختر --</option>
                                </select>
                            </div>
                            <!-- ⭐ العنوان بقى هنا تحت فصيلة الدم -->
                            <div class="sc-field span-2">
                                <label>العنوان</label>                               
                                <textarea asp-for="Address" class="form-control" placeholder="ادخل العنوان"></textarea>
                            </div>
                           


                            <div class="sc-field span-2" hidden>
                                <label>الرقم القومي</label>
                                <input asp-for="NationalId" class="form-control" placeholder="14 رقم" maxlength="14" dir="ltr" />
                            </div>

                        </div>
                        </div>
                    </div>

                    <!-- Patient type + gender -->
                    <div class="col-12 col-lg-4 form-doc mt-4">
                        <div class="form-section">
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-card-checklist"></i></div>
                                <div>
                                    <h2>نوع الملف </h2>
                                    <p>حدد نوع العلاج المطلوب وبيانات المريض الأساسية</p>
                                </div>
                            </div>

                            <div class="sc-field span-2" style="margin-bottom:16px;">
                                <div class="type-tiles" id="typeTiles">
                                    <label class="type-tile @(Model.PatientType == PatientType.General ? "selected" : "")" data-type="general">
                                        <input type="radio" name="PatientType" value="1" @(Model.PatientType == PatientType.General ? "checked" : "") />
                                        <span class="tile-check"><i class="bi bi-check-lg"></i></span>
                                        <div class="tile-icon"><i class="bi bi-app-indicator"></i></div>
                                        <div class="tile-title">عام</div>
                                        <div class="tile-desc">علاج الأسنان العام والوقائي</div>
                                    </label>
                                    <label class="type-tile @(Model.PatientType == PatientType.Orthodontics ? "selected" : "")" data-type="ortho">
                                        <input type="radio" name="PatientType" value="2" @(Model.PatientType == PatientType.Orthodontics ? "checked" : "") />
                                        <span class="tile-check"><i class="bi bi-check-lg"></i></span>
                                        <div class="tile-icon"><i class="bi bi-braces"></i></div>
                                        <div class="tile-title">تقويم</div>
                                        <div class="tile-desc">متابعة دورية لتقويم الأسنان</div>
                                    </label>
                                    <label class="type-tile @(Model.PatientType == PatientType.Both ? "selected" : "")" data-type="both">
                                        <input type="radio" name="PatientType" value="3" @(Model.PatientType == PatientType.Both ? "checked" : "") />
                                        <span class="tile-check"><i class="bi bi-check-lg"></i></span>
                                        <div class="tile-icon"><i class="bi bi-heart-pulse"></i></div>
                                        <div class="tile-title">كلا الملفين</div>
                                        <div class="tile-desc">علاج عام ومتابعة تقويم معًا</div>
                                    </label>
                                </div>
                            </div>

                            <div class="fields-grid mt-3">
                                @{
                                    var genderItems = genderList.ToList();
                                    var selectedGenderIndex = genderItems.FindIndex(g =>
                                        Model.GenderId.HasValue && Model.GenderId.Value.ToString() == g.Value);
                                }
                                <div class="segmented @(selectedGenderIndex == 1 ? "pos-2" : "pos-1")" id="genderSegmented">
                                    <div class="seg-thumb"></div>
                                    @for (int i = 0; i < genderItems.Count; i++)
                                    {
                                        var g = genderItems[i];
                                        var isMale = g.Text.Contains("ذكر");
                                        var isSelected = Model.GenderId.HasValue && Model.GenderId.Value.ToString() == g.Value;
                                        <label data-gender="@(isMale ? "male" : "female")" class="@(isSelected ? "active" : "")">
                                            <input type="radio" name="GenderId" value="@g.Value" @(isSelected ? "checked" : "") />
                                            <i class="bi bi-gender-@(isMale ? "male" : "female")"></i> @g.Text
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-section" hidden>
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-telephone-fill"></i></div>
                                <div>
                                    <h2>بيانات التواصل</h2>
                                    <p>وسائل التواصل مع المريض</p>
                                </div>
                            </div>
                            <div class="fields-grid">
                                <div class="sc-field">
                                    <label>تليفون</label>
                                    <input asp-for="Phone" class="form-control" placeholder="اختياري" dir="ltr" />
                                </div>
                                <div class="sc-field">
                                    <label>البريد الإلكتروني</label>
                                    <input asp-for="Email" class="form-control" placeholder="patient@email.com" dir="ltr" />
                                </div>
                                <div class="sc-field span-2">
                                    <label>المهنة</label>
                                    <input asp-for="Occupation" class="form-control" placeholder="اختياري" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Medical history -->
                    <div class="col-12 col-lg-4">
                        <div class="form-section">
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                                <div>
                                    <h2>التاريخ الطبي</h2>
                                    <p>معلومات مهمة قبل بدء أي علاج</p>
                                </div>
                            </div>
                            <div class="fields-grid">
                                <div class="sc-field span-2">
                                    <label>الحساسية</label>
                                    <input asp-for="Allergies" class="form-control" placeholder="مثال: بنسلين، ليدوكايين..." />
                                </div>
                                <div class="sc-field span-2">
                                    <label>أمراض مزمنة</label>
                                    <input asp-for="ChronicDiseases" class="form-control" placeholder="سكري، ضغط..." />
                                </div>
                                <div class="sc-field span-2">
                                    <label>الأدوية الحالية</label>
                                    <input asp-for="CurrentMedications" class="form-control" />
                                </div>
                                <div class="sc-field span-2">
                                    <label>حالة التدخين</label>
                                    <select asp-for="SmokingStatus" class="form-select">
                                        <option value="NonSmoker">لا يدخن</option>
                                        <option value="FormerSmoker">مدخن سابق</option>
                                        <option value="LightSmoker">مدخن خفيف</option>
                                        <option value="HeavySmoker">مدخن شره</option>
                                    </select>
                                </div>
                                <div class="sc-field span-2" hidden>
                                    <label class="sc-checkbox">
                                        <input type="checkbox" asp-for="IsPregnant" />
                                        <span>حامل</span>
                                    </label>
                                </div>
                                <div class="sc-field span-2 align-start">
                                    <label>ملاحظات طبية عاجلة</label>
                                    <textarea asp-for="EmergencyNotes" class="form-control" placeholder="تحذيرات للدكتور..."></textarea>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- General notes (full width) -->
                    <div class="col-12" hidden>
                        <div class="form-doc">
                            <div class="form-section">
                                <div class="section-head">
                                    <div class="section-icon"><i class="bi bi-journal-text"></i></div>
                                    <div>
                                        <h2>ملاحظات إضافية</h2>
                                        <p>أي ملاحظات أو تعليمات خاصة بالمريض</p>
                                    </div>
                                </div>
                                <div class="fields-grid">
                                    <div class="sc-field span-2">
                                        <textarea asp-for="MedicalNotes" class="form-control" placeholder="أي ملاحظات أو تعليمات خاصة بالمريض..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Live avatar + name preview while typing (initial values are already
        // rendered server-side above, this just keeps them in sync on edit)
        const nameInput = document.getElementById('fullNameInput');
        const namePreview = document.getElementById('namePreview');
        const avatarPreview = document.getElementById('avatarPreview');
        nameInput.addEventListener('input', function () {
            const name = this.value.trim();
            namePreview.textContent = name || 'مريض';
            const initials = name.split(' ').filter(Boolean).slice(0, 2).map(p => p[0]).join('');
            avatarPreview.textContent = initials || '؟';
        });

        // Blood group tag in hero (بيظهر بس على الشاشات الواسعة - CSS بيتحكم في ده)
        const bloodGroupSelect = document.getElementById('BloodGroupId');
        const heroBloodTag = document.getElementById('heroBloodTag');
        if (bloodGroupSelect && heroBloodTag) {
            bloodGroupSelect.addEventListener('change', function () {
                const text = this.options[this.selectedIndex]?.text?.trim();
                if (text && this.value) {
                    heroBloodTag.classList.add('has-value');
                    heroBloodTag.innerHTML = `<i class="bi bi-droplet"></i> ${text}`;
                } else {
                    heroBloodTag.classList.remove('has-value');
                }
            });
        }

        // Mobile tag in hero
        const mobileInput = document.getElementById('Mobile');
        const heroMobileTag = document.getElementById('heroMobileTag');
        if (mobileInput && heroMobileTag) {
            mobileInput.addEventListener('input', function () {
                const val = this.value.trim();
                if (val) {
                    heroMobileTag.style.display = 'inline-flex';
                    heroMobileTag.innerHTML = `<i class="bi bi-telephone"></i> ${val}`;
                } else {
                    heroMobileTag.style.display = 'none';
                }
            });
        }

        // Age tag in hero (يتحسب لايف لو غيّرت تاريخ الميلاد)
        const dobInput = document.getElementById('DateOfBirth');
        const heroAgeTag = document.getElementById('heroAgeTag');
        if (dobInput && heroAgeTag) {
            dobInput.addEventListener('change', function () {
                if (!this.value) { heroAgeTag.style.display = 'none'; return; }
                const dob = new Date(this.value);
                const today = new Date();
                let age = today.getFullYear() - dob.getFullYear();
                const m = today.getMonth() - dob.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
                if (age >= 0 && age < 130) {
                    heroAgeTag.style.display = 'inline-flex';
                    heroAgeTag.innerHTML = `<i class="bi bi-calendar"></i> ${age} سنة`;
                } else {
                    heroAgeTag.style.display = 'none';
                }
            });
        }

        // Patient type tiles
        const typeLabels = {
            general: { icon: 'bi-app-indicator', text: 'عام' },
            ortho: { icon: 'bi-braces', text: 'تقويم' },
            both: { icon: 'bi-heart-pulse', text: 'كلا الملفين' }
        };
        document.querySelectorAll('#typeTiles input[type=radio]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.type-tile').forEach(t => t.classList.remove('selected'));
                const tile = this.closest('.type-tile');
                tile.classList.add('selected');
                const info = typeLabels[tile.dataset.type];
                const heroTypeTag = document.getElementById('heroTypeTag');
                if (info && heroTypeTag) heroTypeTag.innerHTML = `<i class="bi ${info.icon}"></i> ${info.text}`;
            });
        });

        // Gender segmented control
        const genderSegmented = document.getElementById('genderSegmented');
        const genderLabels = { male: { icon: 'bi-gender-male', text: 'ذكر' }, female: { icon: 'bi-gender-female', text: 'أنثى' } };
        genderSegmented.querySelectorAll('input[type=radio]').forEach(function (radio, idx) {
            radio.addEventListener('change', function () {
                genderSegmented.querySelectorAll('label[data-gender]').forEach(l => l.classList.remove('active'));
                const lbl = this.closest('label');
                lbl.classList.add('active');
                genderSegmented.classList.toggle('pos-1', idx === 0);
                genderSegmented.classList.toggle('pos-2', idx === 1);
                const info = genderLabels[lbl.dataset.gender];
                const heroGenderTag = document.getElementById('heroGenderTag');
                if (info && heroGenderTag) heroGenderTag.innerHTML = `<i class="bi ${info.icon}"></i> ${info.text}`;
            });
        });
    </script>
}
