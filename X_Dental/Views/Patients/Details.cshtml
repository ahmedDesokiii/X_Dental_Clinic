<!-- 🔷 Add Payment Modal (Tab) -->
<div class="custom-modal" id="tabPayModal">
    <div class="modal-overlay" onclick="closeTabPaymentModal()"></div>
    <div class="modal-box">
        <div class="modal-head">
            <h5><i class="bi bi-cash-coin me-2"></i> تسجيل دفعة جديدة</h5>
            <button type="button" class="btn-close btn-close-white" onclick="closeTabPaymentModal()"></button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label-custom">الزيارة <span class="text-danger">*</span></label>
                <select class="form-control-custom" id="tabPayVisitId"></select>
            </div>
            <div class="mb-3">
                <label class="form-label-custom">المبلغ <span class="text-danger">*</span></label>
                <input type="number" step="0.01" class="form-control-custom" id="tabPayAmount" />
            </div>
            <div class="mb-3">
                <label class="form-label-custom">طريقة الدفع</label>
                <select class="form-control-custom" id="tabPayMethod">
                    <option value="0">نقدي</option>
                    <option value="1">بطاقة ائتمان</option>
                    <option value="2">بطاقة خصم</option>
                    <option value="3">تحويل بنكي</option>
                    <option value="4">تأمين</option>
                    <option value="5">تقسيط</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label-custom">ملاحظات</label>
                <textarea class="form-control-custom" id="tabPayDesc" rows="2"></textarea>
            </div>
