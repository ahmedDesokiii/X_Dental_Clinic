                            <div class="info-row-flex"><span class="info-label-sm">أمراض مزمنة</span><span class="info-value-sm">@(patient.ChronicDiseases ?? "لا يوجد")</span></div>
                            <div class="info-row-flex"><span class="info-label-sm">الأدوية الحالية</span><span class="info-value-sm">@(patient.CurrentMedications ?? "لا يوجد")</span></div>
                            <div class="info-row-flex"><span class="info-label-sm">التدخين</span><span class="info-value-sm">@(patient.SmokingStatus ?? "-")</span></div>
                            *@ 
                            <p class="notes-text-new">@(patient.Notes ?? "لا توجد ملاحظات.")</p>

                        </div>
                    </div>
                    <div class="info-card-glass"hidden>
                        <div class="card-header-glass"><i class="bi bi-journal-text"></i> ملاحظات</div>
                        <div class="card-body-glass">
                        </div>
                    </div>
                    <div class="info-card-glass">
                        <div class="card-header-glass"><i class="bi bi-activity"></i> آخر النشاطات</div>
                        <div class="card-body-glass">
                            <div class="timeline-container">
                                <div class="timeline-node">
                                    <div class="timeline-date">@DateTime.Now.ToString("dd MMM yyyy")</div>
                                    <div class="timeline-title">فتح ملف المريض</div>
                                    <div class="timeline-desc">تم فتح الملف من لوحة التحكم</div>
                                </div>
                                @if (patient.LastVisit.HasValue)
                                {
                                    <div class="timeline-node">
                                        <div class="timeline-date">@patient.LastVisit.Value.ToString("dd MMM yyyy")</div>
                                        <div class="timeline-title">آخر زيارة</div>
                                        <div class="timeline-desc">زيارة علاجية</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
            <!-- 🔷 Tab: Previous Sessions -->
            <div class="tab-panel" id="prevSessions">
                @if (ViewBag.PreviousSessions is List<Dental.Modules.Clinical.DTOs.PreviousSessionRecordDto> prevSessions && prevSessions.Any())
                {
                    @await Html.PartialAsync("_PreviousSessionsTable", new Dental.Modules.Clinical.ViewModels.SessionViewModel())
                }
                else
                {
                    <div class="placeholder-glass">
                        <div class="placeholder-icon-glass"><i class="bi bi-archive"></i></div>
                        <h3>لا توجد سجلات أسنان سابقة</h3>
                        <p>هتظهر هنا كل حالات الأسنان المسجلة من السيشنات السابقة</p>
                    </div>
                }
            </div>

            <!-- 🔷 Tab: Dental Chart -->
            <div class="tab-panel" id="teeth">
                @if (Model.DentalChart != null && Model.DentalChart.Teeth.Any())
                {
                    @await Html.PartialAsync("_DentalChartReadOnly", Model.DentalChart)
                }
                else
                {
                    <div class="placeholder-glass">
                        <div class="placeholder-icon-glass"><i class="bi bi-grid-3x3-gap"></i></div>
                        <h3>لا يوجد رسم أسنان مسجل بعد</h3>
                        <a asp-action="NewSession" asp-route-patientId="@patient.Id" class="btn-hero btn-hero-session" style="display:inline-flex;">
                            <i class="bi bi-clipboard-pulse"></i> بدء سيشن لتسجيل الرسم
                        </a>
                    </div>
                }
            </div>

            <!-- 🔷 Tab: Treatment Plans -->
            <div class="tab-panel" id="plans">
                <div class="placeholder-glass">
                    <div class="placeholder-icon-glass"><i class="bi bi-clipboard-check"></i></div>
                    <h3>خطط العلاج</h3>
                    <p>الخطط العلاجية المستقبلية والمكتملة</p>
                </div>
            </div>

            <!-- 🔷 Tab: X-Rays -->
            <div class="tab-panel" id="xrays">
                @await Html.PartialAsync("_XRaysTable")
            </div>

            <!-- 🔷 Tab: Prescriptions -->
            <div class="tab-panel" id="prescriptions">
                <div class="placeholder-glass">
                    <div class="placeholder-icon-glass"><i class="bi bi-file-medical"></i></div>
                    <h3>الروشتات</h3>
                    <p>جميع الروشتات والأدوية المكتوبة</p>
                </div>
            </div>

            <!-- 🔷 Tab: Payments -->
            <div class="tab-panel" id="payments">
                <div class="pmt-summary-grid-new">
                    <div class="pmt-summary-card-new">
                        <div class="pmt-label">إجمالي المطلوب</div>
                        <div class="pmt-value" id="pmtSumTotal">—</div>
                    </div>
                    <div class="pmt-summary-card-new">
                        <div class="pmt-label">إجمالي الخصم</div>
                        <div class="pmt-value" id="pmtSumDiscount">—</div>
                    </div>
                    <div class="pmt-summary-card-new is-paid">
                        <div class="pmt-label">إجمالي المدفوع</div>
                        <div class="pmt-value" id="pmtSumPaid">—</div>
                    </div>
                    <div class="pmt-summary-card-new is-due">
                        <div class="pmt-label">المتبقي</div>
                        <div class="pmt-value" id="pmtSumRemaining">—</div>
                    </div>
                </div>
                <div class="info-card-glass full-width">
                    <div class="card-header-glass" style="display:flex; justify-content:space-between; align-items:center;">
                        <span><i class="bi bi-cash-stack"></i> سجل الدفعات</span>
                        <button class="btn-hero btn-hero-session" style="display:inline-flex; padding:8px 16px; font-size:0.8rem;" onclick="openTabPaymentModal()">
                            <i class="bi bi-plus-lg"></i> دفعة جديدة
                        </button>
                    </div>
                    <div class="card-body-glass">
                        <table class="pmt-table-new">
                            <thead>
                                <tr><th>التاريخ</th><th>الزيارة</th><th>المبلغ</th><th>الطريقة</th><th>رقم الإيصال</th><th>ملاحظات</th><th></th></tr>
                            </thead>
                            <tbody id="pmtPaymentsBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="info-card-glass full-width mb-3">
                    <div class="card-header-glass"><i class="bi bi-clipboard2-data"></i> الزيارات</div>
                    <div class="card-body-glass">
                        <table class="pmt-table-new">
                            <thead>
                                <tr><th>التاريخ</th><th>النوع</th><th>الإجمالي</th><th>الخصم</th><th>المدفوع</th><th>المتبقي</th><th>الحالة</th></tr>
                            </thead>
                            <tbody id="pmtVisitsBody"></tbody>
                        </table>
                    </div>
                </div>

              
            </div>

            <!-- 🔷 Tab: Documents -->
            <div class="tab-panel" id="docs">
                @if (Model.Documents.Any())
                {
                    <div class="doc-table-container">
                        <table class="pmt-table-new">
                            <thead><tr><th>النوع</th><th>الملف</th><th>تاريخ الرفع</th><th>ملاحظات</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>@doc.DocumentTypeName</td>
                                        <td>@doc.FileName</td>
                                        <td>@doc.UploadedDate.ToString("dd/MM/yyyy")</td>
                                        <td>@doc.Description</td>
                                        <td><a href="@doc.FilePath" target="_blank" class="btn-hero btn-hero-session" style="display:inline-flex;padding:6px 12px; font-size:0.8rem;"><i class="bi bi-download"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="placeholder-glass">
                        <div class="placeholder-icon-glass"><i class="bi bi-folder"></i></div>
                        <h3>لا توجد مستندات مرفوعة بعد</h3>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- 🔷 Add Payment Modal -->
<div class="custom-modal-new" id="tabPayModal">
    <div class="modal-overlay-new" onclick="closeTabPaymentModal()"></div>
    <div class="modal-box-new">
        <div class="modal-head-new">
            <h5><i class="bi bi-cash-coin me-2"></i> تسجيل دفعة جديدة</h5>
            <button type="button" class="btn-close btn-close-white" onclick="closeTabPaymentModal()"></button>
        </div>
        <div class="modal-body-new">
            <div class="mb-3">
                <label class="form-label-custom-new">الزيارة <span class="text-danger">*</span></label>
                <select class="form-control-custom-new" id="tabPayVisitId"></select>
            </div>
            <div class="mb-3">
                <label class="form-label-custom-new">المبلغ <span class="text-danger">*</span></label>
                <input type="number" step="0.01" class="form-control-custom-new" id="tabPayAmount" />
            </div>
            <div class="mb-3">
                <label class="form-label-custom-new">طريقة الدفع</label>
                <select class="form-control-custom-new" id="tabPayMethod">
                    <option value="0">نقدي</option>
                    <option value="1">بطاقة ائتمان</option>
                    <option value="2">بطاقة خصم</option>
                    <option value="3">تحويل بنكي</option>
                    <option value="4">تأمين</option>
                    <option value="5">تقسيط</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label-custom-new">ملاحظات</label>
                <textarea class="form-control-custom-new" id="tabPayDesc" rows="2"></textarea>
            </div>
        </div>
        <div class="modal-foot-new">
            <button type="button" class="btn-modal-new btn-modal-cancel-new" onclick="closeTabPaymentModal()">إلغاء</button>
            <button type="button" class="btn-modal-new btn-modal-save-new" onclick="submitTabPayment()">حفظ الدفعة</button>
        </div>
    </div>
</div>

<!-- 🔷 Appointment Modal -->
<div class="custom-modal-new" id="apptModal">
    <div class="modal-overlay-new" onclick="closeApptModal()"></div>
    <div class="modal-box-new">
        <div class="modal-head-new">
            <h5><i class="bi bi-calendar-plus me-2"></i> موعد جديد</h5>
            <button type="button" class="btn-close btn-close-white" onclick="closeApptModal()"></button>
        </div>
        <div class="modal-body-new">
            <input type="hidden" id="apptPatientId" value="@patient.Id" />
            <div class="mb-3">
                <label class="form-label-custom-new">المريض</label>
                <input type="text" class="form-control-custom-new" value="@patient.FullNameAr" disabled />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label-custom-new">التاريخ <span class="text-danger">*</span></label>
                    <input type="date" class="form-control-custom-new" id="apptDate" />
                </div>
                <div class="col-6">
                    <label class="form-label-custom-new">الوقت <span class="text-danger">*</span></label>
                    <input type="time" class="form-control-custom-new" id="apptTime" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label-custom-new">السبب / الملاحظات</label>
                <textarea class="form-control-custom-new" id="apptReason" rows="2" placeholder="مثال: تركيب تاج، متابعة..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label-custom-new">المدة</label>
                <select class="form-control-custom-new" id="apptDuration">
                    <option value="15">15 دقيقة</option>
                    <option value="30" selected>30 دقيقة</option>
                    <option value="45">45 دقيقة</option>
                    <option value="60">ساعة</option>
                    <option value="90">ساعة ونص</option>
                </select>
            </div>
        </div>
        <div class="modal-foot-new">
            <button type="button" class="btn-modal-new btn-modal-cancel-new" onclick="closeApptModal()">إلغاء</button>
            <button type="button" class="btn-modal-new btn-modal-save-new" onclick="saveAppt()">
                <i class="bi bi-check-lg"></i> حفظ الموعد
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        // ── Payments Tab Logic ──
        let pmtLoaded = false;
        let pmtVisits = [];

        function money(v) {
            return Number(v).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        async function loadPaymentsTab() {
            try {
                const res = await fetch(`/Payments/GetStatement?patientId=@patient.Id`);
                const result = await res.json();
                if (!result.success) return;
                renderPaymentsTab(result.data);
                pmtLoaded = true;
            } catch (err) {
                console.error('Failed to load payments tab', err);
            }
        }

        function renderPaymentsTab(data) {
            pmtVisits = data.visits;

            document.getElementById('pmtSumTotal').textContent = money(data.totalAmount);
            document.getElementById('pmtSumDiscount').textContent = money(data.totalDiscount);
            document.getElementById('pmtSumPaid').textContent = money(data.totalPaid);
            document.getElementById('pmtSumRemaining').textContent = money(data.totalRemaining);

            document.getElementById('pmtVisitsBody').innerHTML = data.visits.length ? data.visits.map(v => `
                <tr>
                    <td>${new Date(v.visitDate).toLocaleDateString('ar-EG')}</td>
                    <td>${v.category === 1 ? 'تقويم' : 'عام'}</td>
                    <td>${money(v.totalAmount)}</td>
                    <td>${money(v.discount)}</td>
                    <td>${money(v.paidAmount)}</td>
                    <td>${money(v.remaining)}</td>
                    <td>${v.isFullyPaid ? '<span class="pmt-badge-paid-new">مسدد</span>' : '<span class="pmt-badge-due-new">متبقي</span>'}</td>
                </tr>`).join('') : '<tr><td colspan="7" style="text-align:center; color:#94a3b8; padding:16px;">لا توجد زيارات</td></tr>';

            document.getElementById('pmtPaymentsBody').innerHTML = data.payments.length ? data.payments.map(p => `
                <tr>
                    <td>${new Date(p.paymentDate).toLocaleDateString('ar-EG')}</td>
                    <td>${new Date(p.visitDate).toLocaleDateString('ar-EG')}</td>
                    <td>${money(p.amount)}</td>
                    <td>${p.methodText}</td>
                    <td style="direction:ltr; text-align:right;">${p.receiptNo || '—'}</td>
                    <td>${p.description || ''}</td>
                    <td><button class="btn-pmt-void-new" onclick="voidTabPayment(${p.id})"><i class="bi bi-x-circle"></i> إلغاء</button></td>
                </tr>`).join('') : '<tr><td colspan="7" style="text-align:center; color:#94a3b8; padding:16px;">لا توجد دفعات</td></tr>';

            const dueVisits = data.visits.filter(v => v.remaining > 0);
            document.getElementById('tabPayVisitId').innerHTML = dueVisits.length
                ? dueVisits.map(v => `<option value="${v.visitId}">${new Date(v.visitDate).toLocaleDateString('ar-EG')} — متبقي ${money(v.remaining)}</option>`).join('')
                : '<option value="">لا توجد زيارات عليها مبلغ متبقي</option>';
        }

        function openTabPaymentModal() {
            document.getElementById('tabPayAmount').value = '';
            document.getElementById('tabPayDesc').value = '';
            document.getElementById('tabPayModal').classList.add('show');
        }
        function closeTabPaymentModal() {
            document.getElementById('tabPayModal').classList.remove('show');
        }

        async function submitTabPayment() {
            const visitId = parseInt(document.getElementById('tabPayVisitId').value);
            const amount = parseFloat(document.getElementById('tabPayAmount').value);
            const method = parseInt(document.getElementById('tabPayMethod').value);
            const description = document.getElementById('tabPayDesc').value;

            if (!visitId || !amount || amount <= 0) {
                Swal.fire({ title: 'مطلوب', text: 'اختر الزيارة وادخل مبلغ صحيح', icon: 'warning', confirmButtonColor: '#14b8a6' });
                return;
            }

            try {
                const res = await fetch('/Payments/AddPayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ VisitId: visitId, Amount: amount, Method: method, Description: description })
                });
                const result = await res.json();
                if (result.success) {
                    closeTabPaymentModal();
                    Swal.fire({ title: 'تم!', text: result.message, icon: 'success', confirmButtonColor: '#14b8a6', timer: 1500, showConfirmButton: false });
                    loadPaymentsTab();
                } else {
                    Swal.fire({ title: 'تعذر الحفظ', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'خطأ', text: 'مشكلة في الاتصال بالسيرفر', icon: 'error' });
            }
        }

        async function voidTabPayment(paymentId) {
            const confirmResult = await Swal.fire({
                title: 'تأكيد الإلغاء',
                text: 'هيتم إلغاء الدفعة دي وتصحيح رصيد الزيارة تلقائيًا. متأكد؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'أيوه، إلغاء',
                cancelButtonText: 'رجوع',
                confirmButtonColor: '#b91c1c'
            });
            if (!confirmResult.isConfirmed) return;

            const res = await fetch(`/Payments/VoidPayment?paymentId=${paymentId}`, { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                Swal.fire({ title: 'تم', text: result.message, icon: 'success', timer: 1500, showConfirmButton: false });
                loadPaymentsTab();
            } else {
                Swal.fire({ title: 'تعذر التنفيذ', text: result.message, icon: 'error' });
            }
        }

        document.addEventListener('DOMContentLoaded', loadPaymentsTab);

        // ── Appointment Modal ──
        function openApptModal() {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('apptDate').value = tomorrow.toISOString().split('T')[0];
            document.getElementById('apptTime').value = '09:00';
            document.getElementById('apptModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeApptModal() {
            document.getElementById('apptModal').classList.remove('show');
            document.body.style.overflow = '';
        }

        async function saveAppt() {
            const patientId = parseInt(document.getElementById('apptPatientId').value);
            const date = document.getElementById('apptDate').value;
            const time = document.getElementById('apptTime').value;
            const reason = document.getElementById('apptReason').value;
            const duration = parseInt(document.getElementById('apptDuration').value);

            if (!date || !time) {
                Swal.fire({ title: 'مطلوب', text: 'اختر التاريخ والوقت', icon: 'warning', confirmButtonColor: '#14b8a6' });
                return;
            }

            const appointmentDate = new Date(`${date}T${time}`);

            try {
                const res = await fetch('/Appointments/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        PatientId: patientId,
                        AppointmentDate: appointmentDate.toISOString(),
                        DurationMinutes: duration,
                        Reason: reason
                    })
                });
                const result = await res.json();
                if (result.success) {
                    closeApptModal();
                    Swal.fire({ title: 'تم!', text: 'تم إنشاء الموعد بنجاح', icon: 'success', confirmButtonColor: '#14b8a6', timer: 2000, showConfirmButton: false });
                    setTimeout(() => location.reload(), 1500);
                } else {
                    Swal.fire({ title: 'خطأ', text: result.message || 'فشل الحفظ', icon: 'error', confirmButtonColor: '#14b8a6' });
                }
            } catch (err) {
                Swal.fire({ title: 'خطأ', text: 'مشكلة في الاتصال', icon: 'error', confirmButtonColor: '#14b8a6' });
            }
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeApptModal(); closeTabPaymentModal(); }});
    </script>
}