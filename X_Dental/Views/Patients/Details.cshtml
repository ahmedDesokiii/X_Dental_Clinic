                <button type="button" class="btn-modal-new btn-modal-save-new" id="btnSubmitTabPay" onclick="submitTabPayment()">
                    <i class="bi bi-check-lg"></i> <span id="btnSubmitTabPayText">Save Payment</span>
                </button>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AppointmentModal")
</div>

@section Scripts {
    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');

            // Lazy load per-tab data only when first opened
            if (tabId === 'payments') loadPaymentsTab();
            if (tabId === 'docs' && window.loadDocumentsTab) window.loadDocumentsTab();
            if (tabId === 'prescriptions' && window.loadPatientPrescriptions) window.loadPatientPrescriptions();
            if (tabId === 'plans' && window.TreatmentPlans) window.TreatmentPlans.loadPlans();
        }

        // ── Payments Tab Logic ──
        let pmtVisits = [];

        function money(v) {
            return Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function methodBadgeClass(methodText) {
            if (!methodText) return '';
            const t = methodText.toLowerCase();
            if (t.includes('cash') || t.includes('نقد')) return 'cash';
            if (t.includes('card') || t.includes('بطاقة')) return 'card';
            if (t.includes('transfer') || t.includes('تحويل')) return 'transfer';
            if (t.includes('insurance') || t.includes('تأمين')) return 'insurance';
            if (t.includes('install') || t.includes('تقسيط')) return 'installment';
            return '';
        }

        async function loadPaymentsTab() {
            const skeleton = document.getElementById('pmtSkeleton');
            const table = document.getElementById('pmtPaymentsTable');
            skeleton.style.display = 'flex';
            table.style.display = 'none';

            try {
                const res = await fetch(`/Payments/GetStatement?patientId=@patient.Id`);
                const result = await res.json();
                if (!result.success) {
                    renderPaymentsError();
                    return;
                }
                renderPaymentsTab(result.data);
            } catch (err) {
                console.error('Failed to load payments tab', err);
                renderPaymentsError();
            } finally {
                skeleton.style.display = 'none';
                table.style.display = '';
            }
        }

        function renderPaymentsError() {
            document.getElementById('pmtPaymentsBody').innerHTML =
                '<tr><td colspan="7" class="pmt-empty-inline"><i class="bi bi-wifi-off"></i>Could not load payment data.</td></tr>';
        }

        function renderPaymentsTab(data) {
            pmtVisits = data.visits;

            document.getElementById('pmtSumTotal').textContent = money(data.totalAmount);
            document.getElementById('pmtSumDiscount').textContent = money(data.totalDiscount);
            document.getElementById('pmtSumPaid').textContent = money(data.totalPaid);
            document.getElementById('pmtSumRemaining').textContent = money(data.totalRemaining);

            document.getElementById('pmtVisitsBody').innerHTML = data.visits.length ? data.visits.map(v => `
                        <tr>
                            <td>${new Date(v.visitDate).toLocaleDateString('en-GB')}</td>
                            <td>${v.category === 1 ? 'Ortho' : 'General'}</td>
                            <td>${money(v.totalAmount)}</td>
                            <td>${money(v.discount)}</td>
                            <td>${money(v.paidAmount)}</td>
                            <td>${money(v.remaining)}</td>
                            <td>${v.isFullyPaid ? '<span class="pmt-badge-paid-new">Paid</span>' : '<span class="pmt-badge-due-new">Due</span>'}</td>
                        </tr>`).join('') : '<tr><td colspan="7" class="pmt-empty-inline"><i class="bi bi-clipboard-x"></i>No visits recorded</td></tr>';

            document.getElementById('pmtPaymentsBody').innerHTML = data.payments.length ? data.payments.map(p => `
                        <tr>
                            <td>${new Date(p.paymentDate).toLocaleDateString('en-GB')}</td>
                            <td>${new Date(p.visitDate).toLocaleDateString('en-GB')}</td>
                            <td><b>${money(p.amount)}</b></td>
                            <td><span class="pmt-method-badge ${methodBadgeClass(p.methodText)}">${p.methodText}</span></td>
                            <td style="direction:ltr; text-align:left;">${p.receiptNo || '—'}</td>
                            <td>${p.description || '—'}</td>
                            <td><button class="btn-pmt-void-new" onclick="voidTabPayment(${p.id})"><i class="bi bi-x-circle"></i> Void</button></td>
                        </tr>`).join('') : '<tr><td colspan="7" class="pmt-empty-inline"><i class="bi bi-cash"></i>No payments recorded yet</td></tr>';

            const dueVisits = data.visits.filter(v => v.remaining > 0);
            document.getElementById('tabPayVisitId').innerHTML = dueVisits.length
                ? dueVisits.map(v => `<option value="${v.visitId}">${new Date(v.visitDate).toLocaleDateString('en-GB')} — due ${money(v.remaining)}</option>`).join('')
                : '<option value="">No visits with a remaining balance</option>';
        }

        function openTabPaymentModal() {
            document.getElementById('tabPayAmount').value = '';
            document.getElementById('tabPayDesc').value = '';
            document.getElementById('tabPayModal').classList.add('show');
        }
        function closeTabPaymentModal() {
            document.getElementById('tabPayModal').classList.remove('show');
        }

        async function submitTabPayment() {
            const visitId = parseInt(document.getElementById('tabPayVisitId').value);
            const amount = parseFloat(document.getElementById('tabPayAmount').value);
            const method = parseInt(document.getElementById('tabPayMethod').value);
            const description = document.getElementById('tabPayDesc').value;

            if (!visitId || !amount || amount <= 0) {
                Swal.fire({ title: 'Required', text: 'Select a visit and enter a valid amount', icon: 'warning', confirmButtonColor: '#14b8a6' });
                return;
            }

            const btn = document.getElementById('btnSubmitTabPay');
            const btnText = document.getElementById('btnSubmitTabPayText');
            btn.disabled = true;
            btnText.textContent = 'Saving...';

            try {
                const res = await fetch('/Payments/AddPayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ VisitId: visitId, Amount: amount, Method: method, Description: description })
                });
                const result = await res.json();
                if (result.success) {
                    closeTabPaymentModal();
                    Swal.fire({ title: 'Done!', text: result.message, icon: 'success', confirmButtonColor: '#14b8a6', timer: 1500, showConfirmButton: false });
                    loadPaymentsTab();
                } else {
                    Swal.fire({ title: 'Could not save', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'Error', text: 'Could not reach the server', icon: 'error' });
            } finally {
                btn.disabled = false;
                btnText.textContent = 'Save Payment';
            }
        }

        async function voidTabPayment(paymentId) {
            const confirmResult = await Swal.fire({
                title: 'Confirm Void',
                text: 'This payment will be voided and the visit balance corrected automatically. Are you sure?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, void it',
                cancelButtonText: 'Back',
                confirmButtonColor: '#b91c1c',
                reverseButtons: true
            });
            if (!confirmResult.isConfirmed) return;

            try {
                const res = await fetch(`/Payments/VoidPayment?paymentId=${paymentId}`, { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    Swal.fire({ title: 'Done', text: result.message, icon: 'success', timer: 1500, showConfirmButton: false });
                    loadPaymentsTab();
                } else {
                    Swal.fire({ title: 'Could not void', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'Error', text: 'Could not reach the server', icon: 'error' });
            }
        }

        // Refresh KPIs/next appointment card after booking from the shared modal
        window.onAppointmentCreated = function() {
            setTimeout(() => location.reload(), 1200);
        };

        document.addEventListener('DOMContentLoaded', loadPaymentsTab);
    </script>
}