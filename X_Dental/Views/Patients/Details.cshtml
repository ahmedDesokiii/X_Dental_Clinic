        </div>
    </div>
</div>


<!-- 🔷 Custom Appointment Modal -->
<div class="custom-modal" id="apptModal">
    <div class="modal-overlay" onclick="closeApptModal()"></div>
    <div class="modal-box">
        <div class="modal-head">
            <h5><i class="bi bi-calendar-plus me-2"></i> موعد جديد</h5>
            <button type="button" class="btn-close btn-close-white" onclick="closeApptModal()"></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="apptPatientId" value="@patient.Id" />
            <div class="mb-3">
                <label class="form-label-custom">المريض</label>
                <input type="text" class="form-control-custom" value="@patient.FullNameAr" disabled />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label-custom">التاريخ <span class="text-danger">*</span></label>
                    <input type="date" class="form-control-custom" id="apptDate" />
                </div>
                <div class="col-6">
                    <label class="form-label-custom">الوقت <span class="text-danger">*</span></label>
                    <input type="time" class="form-control-custom" id="apptTime" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label-custom">السبب / الملاحظات</label>
                <textarea class="form-control-custom" id="apptReason" rows="2" placeholder="مثال: تركيب تاج، متابعة..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label-custom">المدة</label>
                <select class="form-control-custom" id="apptDuration">
                    <option value="15">15 دقيقة</option>
                    <option value="30" selected>30 دقيقة</option>
                    <option value="45">45 دقيقة</option>
                    <option value="60">ساعة</option>
                    <option value="90">ساعة ونص</option>
                </select>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn-modal btn-modal-cancel" onclick="closeApptModal()">إلغاء</button>
            <button type="button" class="btn-modal btn-modal-save" onclick="saveAppt()">
                <i class="bi bi-check-lg"></i> حفظ الموعد
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        // ── تاب المدفوعات: تحميل كشف الحساب ──
        let pmtLoaded = false;
        let pmtVisits = [];

        function money(v) {
            return Number(v).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        async function loadPaymentsTab() {
            try {
                const res = await fetch(`/Payments/GetStatement?patientId=@patient.Id`);
                const result = await res.json();
                if (!result.success) return;
                renderPaymentsTab(result.data);
                pmtLoaded = true;
            } catch (err) {
                console.error('Failed to load payments tab', err);
            }
        }

        function renderPaymentsTab(data) {
            pmtVisits = data.visits;

            document.getElementById('pmtSumTotal').textContent = money(data.totalAmount);
            document.getElementById('pmtSumDiscount').textContent = money(data.totalDiscount);
            document.getElementById('pmtSumPaid').textContent = money(data.totalPaid);
            document.getElementById('pmtSumRemaining').textContent = money(data.totalRemaining);

            document.getElementById('pmtVisitsBody').innerHTML = data.visits.length ? data.visits.map(v => `
                <tr>
                    <td>${new Date(v.visitDate).toLocaleDateString('ar-EG')}</td>
                    <td>${v.category === 2 ? 'تقويم' : 'عام'}</td>
                    <td>${money(v.totalAmount)}</td>
                    <td>${money(v.discount)}</td>
                    <td>${money(v.paidAmount)}</td>
                    <td>${money(v.remaining)}</td>
                    <td>${v.isFullyPaid ? '<span class="pmt-badge-paid">مسدد</span>' : '<span class="pmt-badge-due">متبقي</span>'}</td>
                </tr>`).join('') : '<tr><td colspan="7" style="text-align:center; color:#94a3b8; padding:16px;">لا توجد زيارات</td></tr>';

            document.getElementById('pmtPaymentsBody').innerHTML = data.payments.length ? data.payments.map(p => `
                <tr>
                    <td>${new Date(p.paymentDate).toLocaleDateString('ar-EG')}</td>
                    <td>${new Date(p.visitDate).toLocaleDateString('ar-EG')}</td>
                    <td>${money(p.amount)}</td>
                    <td>${p.methodText}</td>
                    <td style="direction:ltr; text-align:right;">${p.receiptNo || '—'}</td>
                    <td>${p.description || ''}</td>
                    <td><button class="btn-pmt-void" onclick="voidTabPayment(${p.id})"><i class="bi bi-x-circle"></i> إلغاء</button></td>
                </tr>`).join('') : '<tr><td colspan="7" style="text-align:center; color:#94a3b8; padding:16px;">لا توجد دفعات</td></tr>';

            const dueVisits = data.visits.filter(v => v.remaining > 0);
            document.getElementById('tabPayVisitId').innerHTML = dueVisits.length
                ? dueVisits.map(v => `<option value="${v.visitId}">${new Date(v.visitDate).toLocaleDateString('ar-EG')} — متبقي ${money(v.remaining)}</option>`).join('')
                : '<option value="">لا توجد زيارات عليها مبلغ متبقي</option>';
        }

        function openTabPaymentModal() {
            document.getElementById('tabPayAmount').value = '';
            document.getElementById('tabPayDesc').value = '';
            document.getElementById('tabPayModal').classList.add('show');
        }
        function closeTabPaymentModal() {
            document.getElementById('tabPayModal').classList.remove('show');
        }

        async function submitTabPayment() {
            const visitId = parseInt(document.getElementById('tabPayVisitId').value);
            const amount = parseFloat(document.getElementById('tabPayAmount').value);
            const method = parseInt(document.getElementById('tabPayMethod').value);
            const description = document.getElementById('tabPayDesc').value;

            if (!visitId || !amount || amount <= 0) {
                Swal.fire({ title: 'مطلوب', text: 'اختر الزيارة وادخل مبلغ صحيح', icon: 'warning', confirmButtonColor: '#14b8a6' });
                return;
            }

            try {
                const res = await fetch('/Payments/AddPayment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ VisitId: visitId, Amount: amount, Method: method, Description: description })
                });
                const result = await res.json();
                if (result.success) {
                    closeTabPaymentModal();
                    Swal.fire({ title: 'تم!', text: result.message, icon: 'success', confirmButtonColor: '#14b8a6', timer: 1500, showConfirmButton: false });
                    loadPaymentsTab();
                } else {
                    Swal.fire({ title: 'تعذر الحفظ', text: result.message, icon: 'error' });
                }
            } catch (err) {
                Swal.fire({ title: 'خطأ', text: 'مشكلة في الاتصال بالسيرفر', icon: 'error' });
            }
        }

        async function voidTabPayment(paymentId) {
            const confirmResult = await Swal.fire({
                title: 'تأكيد الإلغاء',
                text: 'هيتم إلغاء الدفعة دي وتصحيح رصيد الزيارة تلقائيًا. متأكد؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'أيوه، إلغاء',
                cancelButtonText: 'رجوع',
                confirmButtonColor: '#b91c1c'
            });
            if (!confirmResult.isConfirmed) return;

            const res = await fetch(`/Payments/VoidPayment?paymentId=${paymentId}`, { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                Swal.fire({ title: 'تم', text: result.message, icon: 'success', timer: 1500, showConfirmButton: false });
                loadPaymentsTab();
            } else {
                Swal.fire({ title: 'تعذر التنفيذ', text: result.message, icon: 'error' });
            }
        }

        // تحميل بيانات المدفوعات أول ما الصفحة تفتح (البيانات خفيفة، مفيش داعي نستنى لحد ما يدوس على التاب)
        document.addEventListener('DOMContentLoaded', loadPaymentsTab);



        // ── Modal ──
        function openApptModal() {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('apptDate').value = tomorrow.toISOString().split('T')[0];
            document.getElementById('apptTime').value = '09:00';
            document.getElementById('apptModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeApptModal() {
            document.getElementById('apptModal').classList.remove('show');
            document.body.style.overflow = '';
        }

        async function saveAppt() {
            const patientId = parseInt(document.getElementById('apptPatientId').value);
            const date = document.getElementById('apptDate').value;
            const time = document.getElementById('apptTime').value;
            const reason = document.getElementById('apptReason').value;
            const duration = parseInt(document.getElementById('apptDuration').value);

            if (!date || !time) {
                Swal.fire({ title: 'مطلوب', text: 'اختر التاريخ والوقت', icon: 'warning', confirmButtonColor: '#14b8a6' });
                return;
            }

            const appointmentDate = new Date(`${date}T${time}`);

            const data = {
                PatientId: patientId,
                AppointmentDate: appointmentDate.toISOString(),
                Duration: duration,
                Reason: reason,
                Status: 1
            };

            try {
                       const res = await fetch('/Appointments/Create', {  
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                PatientId: patientId,
                AppointmentDate: appointmentDate.toISOString(),
                DurationMinutes: duration,   
                Reason: reason
            })
        });
                const result = await res.json();
                if (result.success) {
                    closeApptModal();
                    Swal.fire({ title: 'تم!', text: 'تم إنشاء الموعد بنجاح', icon: 'success', confirmButtonColor: '#14b8a6', timer: 2000, showConfirmButton: false });
                    setTimeout(() => location.reload(), 1500);
                } else {
                    Swal.fire({ title: 'خطأ', text: result.message || 'فشل الحفظ', icon: 'error', confirmButtonColor: '#14b8a6' });
                }
            } catch (err) {
                Swal.fire({ title: 'خطأ', text: 'مشكلة في الاتصال', icon: 'error', confirmButtonColor: '#14b8a6' });
            }
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeApptModal(); });
    </script>
}