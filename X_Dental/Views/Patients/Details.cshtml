                        <option value="2">Debit Card</option>
                        <option value="3">Bank Transfer</option>
                        <option value="4">Insurance</option>
                        <option value="5">Installment</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label-custom-new">Notes</label>
                    <textarea class="form-control-custom-new" id="tabPayDesc" rows="2"></textarea>
