@using Dental.Models.Patient
@{
    var isEdit = ViewBag.IsEdit == true;
    var genderList = ViewBag.Genders as SelectList ?? new SelectList(new List<SelectListItem>());
    var genderItems = genderList.ToList();

    var formAction = isEdit ? Url.Action("Edit", "Patients") : Url.Action("Create", "Patients");
    var dob = isEdit ? ViewBag.DateOfBirth as DateOnly? : null;
    var genderId = isEdit ? (int)ViewBag.GenderId : 0;
    var patientType = isEdit ? (int)ViewBag.PatientType : 1;
    var fullName = isEdit ? (string)ViewBag.FullName : "";
    var mobile = isEdit ? (string)ViewBag.Mobile : "";
    var address = isEdit ? (string)ViewBag.Address : "";
    var medNotes = isEdit ? (string)ViewBag.MedNotes : "";

    // ⭐ Single source of truth: which item in the list is selected —
    // used for BOTH which radio gets checked/active AND which visual
    // position (pos-1/pos-2) the thumb takes. No more guessing by Id value.
    var selectedGenderIndex = 0;
    if (isEdit)
    {
        var idx = genderItems.FindIndex(g => g.Value == genderId.ToString());
        selectedGenderIndex = idx >= 0 ? idx : 0;
    }
}

<style>
    /* ═════════ Patient Modal — XL · glass · spring animations ═════════ */
    .pmodal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1080;
        background: rgba(11,46,48,.38);
        backdrop-filter: blur(7px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        opacity: 0;
        transition: opacity .3s ease;
    }

        .pmodal-backdrop.show {
            opacity: 1;
        }

    /* ⭐ XL — no scroll on desktop */
    .pmodal {
        width: 100%;
        max-width: 940px;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 24px;
        box-shadow: 0 30px 80px rgba(10,77,79,.3);
        transform: translateY(45px) scale(.93);
        opacity: 0;
        transition: transform .5s cubic-bezier(.2,1.35,.35,1), opacity .35s ease;
    }

    .pmodal-backdrop.show .pmodal {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    .pm-age-badge {
        flex-basis: 100%;
        margin-left: 100px;
        font-size: .74rem;
        font-weight: 800;
        color: #0f766e;
    }

    .pmodal.hide-out {
        transform: translateY(30px) scale(.95) !important;
        opacity: 0 !important;
    }

    /* Header */
    .pmodal-head {
        position: relative;
        overflow: hidden;
        border-radius: 24px 24px 0 0;
        padding: 18px 24px;
        color: #fff;
        background: linear-gradient(135deg,#0a5d60 0%,#0d7377 40%,#119e91 100%);
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .pmodal-head::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 85% -30%, rgba(255,255,255,.35), transparent 50%);
            pointer-events: none;
        }

    .pmodal-avatar {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        flex-shrink: 0;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        font-weight: 800;
        animation: pmodalFloat 4s ease-in-out infinite;
    }

    @@keyframes pmodalFloat {
        0%, 100% {
            transform: translateY(0) rotate(0)
        }

        50% {
            transform: translateY(-4px) rotate(-3deg)
        }
    }

    .pmodal-head h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
    }

    .pmodal-head p {
        margin: 2px 0 0;
        font-size: .72rem;
        opacity: .9;
        font-weight: 600;
    }

    .pmodal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 2;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 10px;
        background: rgba(255,255,255,.15);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s;
    }

        .pmodal-close:hover {
            background: rgba(255,255,255,.32);
            transform: rotate(90deg);
        }

    /* Body — ⭐ 2 columns: basic info beside medical history */
    .pmodal-body {
        padding: 18px 24px 6px;
    }

    .pmodal-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 26px;
    }

    @@media (max-width: 768px) {
        .pmodal {
            max-height: 92vh;
            overflow-y: auto;
        }

        .pmodal-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Staggered entrance */
    .pmodal-sec {
        margin-bottom: 16px;
        opacity: 0;
        transform: translateY(14px);
        animation: pmodalSecIn .5s ease forwards;
    }

        .pmodal-sec.d1 {
            animation-delay: .1s;
        }

        .pmodal-sec.d2 {
            animation-delay: .2s;
        }

        .pmodal-sec.d3 {
            animation-delay: .3s;
        }

    @@keyframes pmodalSecIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .pmodal-sec-head {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
    }

    .pmodal-sec-ico {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: #dcf5f7;
        color: #0f766e;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pmodal-sec-head h3 {
        font-size: .85rem;
        font-weight: 800;
        color: #0b2e30;
        margin: 0;
    }

    .pmodal-sec-head span {
        font-size: .68rem;
        color: #4b6b6c;
        font-weight: 600;
    }

    /* Fields */
    .pmf {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 11px;
        flex-wrap: wrap;
    }

        .pmf > label {
            flex: 0 0 90px;
            font-size: .74rem;
            font-weight: 700;
            color: #4b6b6c;
            margin: 0;
            text-align: right;
        }

            .pmf > label .required {
                color: #dc2626;
            }

        .pmf .form-control, .pmf .form-select {
            flex: 1;
            min-width: 0;
            border: 1.5px solid #dcf5f7;
            border-radius: 10px;
            padding: 8px 12px;
            font-size: .86rem;
            background: #fff;
            transition: border-color .2s, box-shadow .2s;
        }

            .pmf .form-control:focus, .pmf .form-select:focus {
                border-color: #14b8a6;
                box-shadow: 0 0 0 3px rgba(15,155,142,.12);
                outline: none;
            }

        .pmf textarea.form-control {
            min-height: 96px;
            resize: vertical;
            line-height: 1.6;
        }

        .pmf.align-start {
            align-items: flex-start;
        }

            .pmf.align-start > label {
                margin-top: 9px;
            }

        .pmf .invalid-msg {
            flex-basis: 100%;
            margin-left: 100px;
            font-size: .72rem;
            color: #dc2626;
            display: none;
            animation: pmodalSecIn .3s ease;
        }

    /* Gender segmented */
    .pm-seg {
        position: relative;
        display: flex;
        background: #dcf5f7;
        border-radius: 999px;
        padding: 4px;
        flex: 1;
    }

    .pm-seg-thumb {
        position: absolute;
        top: 4px;
        left: 4px;
        bottom: 4px;
        width: calc(50% - 4px);
        border-radius: 999px;
        background: linear-gradient(135deg,#0d9488,#0f766e);
        box-shadow: 0 4px 10px rgba(13,148,136,.28);
        transition: transform .3s cubic-bezier(.3,1.3,.4,1);
        z-index: 0;
    }

    .pm-seg.pos-2 .pm-seg-thumb {
        transform: translateX(100%);
    }

    .pm-seg label {
        position: relative;
        z-index: 1;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 0;
        margin: 0;
        font-size: .82rem;
        font-weight: 700;
        color: #4b6b6c;
        cursor: pointer;
        border-radius: 999px;
        transition: color .2s;
    }

        .pm-seg label input {
            display: none;
        }

        .pm-seg label.active {
            color: #fff;
        }

    /* Type tiles — full width under the two columns */
    .pm-tiles {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 10px;
    }

    @@media (max-width: 560px) {
        .pm-tiles {
            grid-template-columns: 1fr;
        }
    }

    .pm-tile {
        position: relative;
        border: 2px solid #dcf5f7;
        border-radius: 14px;
        padding: 12px 10px;
        text-align: center;
        cursor: pointer;
        transition: all .22s ease;
        background: #fff;
    }

        .pm-tile input {
            display: none;
        }

        .pm-tile .ti {
            width: 36px;
            height: 36px;
            margin: 0 auto 7px;
            border-radius: 11px;
            background: #dcf5f7;
            color: #0f766e;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: .22s;
        }

        .pm-tile .tt {
            font-weight: 800;
            font-size: .8rem;
            color: #0b2e30;
        }

        .pm-tile .td {
            font-size: .66rem;
            color: #4b6b6c;
            margin-top: 2px;
            line-height: 1.35;
        }

        .pm-tile .tc {
            position: absolute;
            top: 8px;
            left: 8px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #0d9488;
            color: #fff;
            font-size: .6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: scale(.5);
            transition: .2s;
        }

        .pm-tile:hover {
            border-color: #99f6e4;
            transform: translateY(-2px);
        }

        .pm-tile.selected {
            border-color: #0d9488;
            background: linear-gradient(160deg,#fff,#eafbfc);
            box-shadow: 0 8px 18px rgba(15,155,142,.16);
            transform: translateY(-2px);
        }

            .pm-tile.selected .ti {
                background: linear-gradient(135deg,#14b8a6,#0f766e);
                color: #fff;
            }

            .pm-tile.selected .tc {
                opacity: 1;
                transform: scale(1);
            }

    /* Footer */
    .pmodal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 24px;
        background: #eafbfc;
        border-radius: 0 0 24px 24px;
        opacity: 0;
        animation: pmodalSecIn .5s ease .38s forwards;
    }

        .pmodal-foot .btn {
            border: none;
            border-radius: 12px;
            padding: 10px 22px;
            font-size: .83rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: .22s;
        }

    .pm-btn-ghost {
        background: #dcf5f7;
        color: #4b6b6c;
    }

        .pm-btn-ghost:hover {
            background: #fff;
        }

    .pm-btn-save {
        background: linear-gradient(135deg,#0d9488,#0f766e);
        color: #fff;
        box-shadow: 0 8px 20px rgba(13,148,136,.3);
    }

        .pm-btn-save:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(13,148,136,.4);
        }

        .pm-btn-save:disabled {
            opacity: .75;
        }

    @@media (prefers-reduced-motion: reduce) {
        .pmodal-sec, .pmodal-foot, .pmodal-avatar {
            animation-duration: .01ms !important;
            animation-delay: 0s !important;
        }

        .pmodal, .pmodal-backdrop {
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="pmodal-backdrop" id="pmodalBackdrop">
    <div class="pmodal" id="pmodalBox" role="dialog" aria-modal="true">
        <form id="patientModalForm" action="@formAction" method="post" novalidate>
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input type="hidden" name="Id" value="@ViewBag.PatientId" />
            }

            <div class="pmodal-head">
                <div class="pmodal-avatar" id="pmAvatar">
                    @(string.IsNullOrWhiteSpace(fullName) ? "?" :
                    string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])))
                </div>
                <div>
                    <h2 class="fs-5 text-light" id="pmTitle">@(isEdit ? fullName : "New Patient")</h2>
                    <p>@(isEdit ? "Update the patient's basic information" : "Enter basic info & start the session right away")</p>
                </div>
                <button type="button" class="pmodal-close" data-pm-close title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="pmodal-body">
                <div class="pmodal-grid">

                    <!-- ═══ Basic Information ═══ -->
                    <div class="pmodal-sec d1">
                        <div class="pmodal-sec-head">
                            <div class="pmodal-sec-ico"><i class="bi bi-person-fill"></i></div>
                            <div><h3>Basic Information</h3><span>Name, mobile & address</span></div>
                        </div>

                        <div class="pmf">
                            <label>Full Name <span class="required">*</span></label>
                            <input name="FullNameAr" id="pmFullName" class="form-control text-center"
                                   value="@fullName" placeholder="Patient full name" autocomplete="off" />
                            <span class="invalid-msg" data-for="FullNameAr"></span>
                        </div>

                        <div class="pmf">
                            <label>Mobile <span class="required">*</span></label>
                            <input name="Mobile" class="form-control text-center" value="@mobile"
                                   placeholder="01xxxxxxxxx" dir="ltr" />
                            <span class="invalid-msg" data-for="Mobile"></span>
                        </div>

                        <div class="pmf">
                            <label>Date of Birth</label>
                            <input type="date" name="DateOfBirth" id="pmDateOfBirth" class="form-control text-center"
                                   value="@((dob?.ToString("yyyy-MM-dd")) ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span class="pm-age-badge" id="pmAgeBadge"></span>
                        </div>

                        <div class="pmf">
                            <label>Address</label>
                            <input name="Address" class="form-control" value="@address" placeholder="Patient address" />
                        </div>

                        <div class="pmf">
                            <label>Gender</label>
                            <div class="pm-seg @(selectedGenderIndex == 1 ? "pos-2" : "pos-1")" id="pmGenderSeg">
                                <div class="pm-seg-thumb"></div>
                                @for (int i = 0; i < genderItems.Count; i++)
                                {
                                    var g = genderItems[i];
                                    var isMale = g.Text.Contains("ذكر");
                                    var isSel = i == selectedGenderIndex;
                                    <label class="@(isSel ? "active" : "")">
                                        <input type="radio" name="GenderId" value="@g.Value" @(isSel ? "checked" : "") />
                                        <i class="bi bi-gender-@(isMale ? "male" : "female")"></i> @g.Text
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ═══ Medical History ═══ -->
                    <div class="pmodal-sec d2">
                        <div class="pmodal-sec-head">
                            <div class="pmodal-sec-ico"><i class="bi bi-heart-pulse-fill"></i></div>
                            <div><h3>Medical History</h3><span>Important before any treatment</span></div>
                        </div>
                        <div class="pmf align-start" >
                            <label style="margin-top:9px">Medical Notes</label>
                            <textarea name="MedicalNotes" class="form-control"
                                      placeholder="Allergies, chronic diseases, current medications...">@medNotes</textarea>
                        </div>


                        <div class="pmodal-sec-head">
                            <div class="pmodal-sec-ico"><i class="bi bi-card-checklist"></i></div>
                            <div><h3>File Type</h3><span>Select the required treatment type</span></div>
                        </div>
                        <div class="pm-tiles" id="pmTypeTiles">
                            <label class="pm-tile @(patientType == 1 ? "selected" : "")" data-type="general">
                                <input type="radio" name="PatientType" value="1" @(patientType == 1 ? "checked" : "") />
                                <span class="tc"><i class="bi bi-check-lg"></i></span>
                                <div class="ti"><i class="bi bi-app-indicator"></i></div>
                                <div class="tt">General</div>
                                <div class="td">General & preventive dentistry</div>
                            </label>
                            <label class="pm-tile @(patientType == 2 ? "selected" : "")" data-type="ortho">
                                <input type="radio" name="PatientType" value="2" @(patientType == 2 ? "checked" : "") />
                                <span class="tc"><i class="bi bi-check-lg"></i></span>
                                <div class="ti"><i class="bi bi-braces"></i></div>
                                <div class="tt">Orthodontics</div>
                                <div class="td">Regular braces follow-up</div>
                            </label>
                            <label class="pm-tile @(patientType == 3 ? "selected" : "")" data-type="both">
                                <input type="radio" name="PatientType" value="3" @(patientType == 3 ? "checked" : "") />
                                <span class="tc"><i class="bi bi-check-lg"></i></span>
                                <div class="ti"><i class="bi bi-heart-pulse"></i></div>
                                <div class="tt">Both Files</div>
                                <div class="td">General treatment & ortho follow-up</div>
                            </label>
                        </div>
                    </div>
                </div>


            </div>

            <div class="pmodal-foot">
                <button type="button" class="btn pm-btn-ghost" data-pm-close>
                    <i class="bi bi-x-lg"></i> Cancel
                </button>
                <button type="submit" class="btn pm-btn-save" id="pmSaveBtn">
                    <i class="bi bi-check-lg"></i> @(isEdit ? "Save Changes" : "Save & Start Session")
                </button>
            </div>
        </form>
    </div>
</div>