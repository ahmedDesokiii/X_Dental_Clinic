</style>

<script>
    (function () {
        const patientId = @rxPatientId;
        const fixedVisitId = @(rxVisitId?.ToString() ?? "null");          // السيشن: الزيارة الحالية
        const modalOnly = @(rxModalOnly ? "true" : "false");
        let ppVisits = [];
        let ppPrescriptions = [];
        let ppMedications = [];
        let ppDrugOptionsHtml = '<option value="">Select medication...</option>';
        let ppMedicationsLoaded = false;
        let ppDrugIndex = 1;
        let ppTargetVisitId = null;

        async function loadPatientPrescriptions() {
            document.getElementById('ppSkeleton').style.display = 'flex';
            document.getElementById('ppEmptyState').style.display = 'none';
            document.getElementById('ppList').innerHTML = '';
            try {
                const res = await fetch(`/Patients/GetPrescriptionsData?patientId=${patientId}`);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const result = await res.json();
                if (result.success) {
                    ppVisits = result.visits;
                    ppPrescriptions = result.prescriptions;
                    renderPpList();
                } else {
                    showPpError(result.message || 'Could not load prescriptions.');
                }
            } catch (err) {
                console.error('Failed to load prescriptions', err);
                showPpError('Could not load prescriptions — check that /Patients/GetPrescriptionsData exists.');
            } finally {
                document.getElementById('ppSkeleton').style.display = 'none';
            }
        }

        function showPpError(msg) {
            document.getElementById('ppList').innerHTML = '';
            const empty = document.getElementById('ppEmptyState');
            empty.innerHTML = `<i class="bi bi-exclamation-triangle"></i><p>${msg}</p>`;
            empty.style.display = 'block';
        }

        function statusLabel(s) {
            if (s === 'Active') return 'نشطة';
            if (s === 'Completed') return 'مكتملة';
            if (s === 'Cancelled') return 'ملغاة';
            return s;
        }

        function renderPpList() {
            document.getElementById('ppCount').textContent = `الروشتات (${ppPrescriptions.length})`;
            const list = document.getElementById('ppList');
            const empty = document.getElementById('ppEmptyState');

            if (!ppPrescriptions.length) {
                list.innerHTML = '';
                empty.innerHTML = '<i class="bi bi-file-medical"></i><p>لا توجد روشتات مسجلة لهذا المريض</p>';
                empty.style.display = 'block';
                return;
            }
            empty.style.display = 'none';

            list.innerHTML = ppPrescriptions.map(rx => `
                        <div class="pp-card">
                            <div class="pp-card-head">
                                <div class="pp-date"><i class="bi bi-calendar3"></i> ${new Date(rx.prescriptionDate).toLocaleDateString('en-GB')}</div>
                                <span class="pp-visit-badge">${rx.visitCategory} — ${new Date(rx.visitDate).toLocaleDateString('en-GB')}</span>
                                <div class="pp-status ${rx.status.toLowerCase()}">${statusLabel(rx.status)}</div>
                            </div>
                            ${rx.diagnosis ? `<div class="pp-diagnosis"><strong>التشخيص:</strong> ${rx.diagnosis}</div>` : ''}
                            <div class="pp-items">
                                ${rx.items.map(item => `
                                    <div class="pp-item">
                                        <div class="pp-drug-name"><i class="bi bi-capsule"></i> ${item.medicationName} <span class="pp-dosage">${item.dosage || ''}</span></div>
                                        <div class="pp-instructions">
                                            ${item.frequency ? `<span class="pp-chip"><i class="bi bi-clock"></i> ${item.frequency}</span>` : ''}
                                            ${item.duration ? `<span class="pp-chip"><i class="bi bi-calendar-week"></i> ${item.duration}</span>` : ''}
                                            ${item.instructions ? `<span class="pp-chip info"><i class="bi bi-info-circle"></i> ${item.instructions}</span>` : ''}
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            ${rx.notes ? `<div class="pp-footer">${rx.notes}</div>` : ''}
                            <div class="pp-actions-bar">
                                <span class="pp-by"><i class="bi bi-person-badge"></i> د. ${rx.prescribedBy || ''}</span>
                                <button class="pp-btn-print" onclick="printPp(${rx.id})"><i class="bi bi-printer"></i> طباعة</button>
                            </div>
                        </div>
                    `).join('');
        }

        async function loadPpMedications() {
            try {
                const res = await fetch('/Medications/GetActiveMedications');
                const result = await res.json();
                if (result.success) {
                    ppMedications = result.data;
                    ppDrugOptionsHtml = buildPpOptionsHtml(ppMedications);
                } else {
                    ppDrugOptionsHtml = '<option value="">Could not load medications</option>';
                }
            } catch (err) {
                console.error('Failed to load medications', err);
                ppDrugOptionsHtml = '<option value="">Could not load medications</option>';
            } finally {
                ppMedicationsLoaded = true;
                document.querySelectorAll('.pp-drug-select').forEach(sel => {
                    sel.innerHTML = ppDrugOptionsHtml;
                });
            }
        }

        function buildPpOptionsHtml(meds) {
            if (!meds.length) return '<option value="">No medications registered — upload the medications file from the catalog screen</option>';

            const groups = {};
            meds.forEach(m => {
                if (!groups[m.categoryName]) groups[m.categoryName] = [];
                groups[m.categoryName].push(m);
            });

            let html = '<option value="">Select medication...</option>';
            Object.keys(groups).forEach(cat => {
                html += `<optgroup label="${cat}">`;
                groups[cat].forEach(m => {
                    html += `<option value="${m.id}" data-name="${m.name}" data-dosage="${m.defaultDosage || ''}" data-freq="${m.defaultFrequency || ''}" data-duration="${m.defaultDuration || ''}">${m.name}</option>`;
                });
                html += '</optgroup>';
            });
            return html;
        }

        window.onPpDrugSelected = function (selectEl) {
            const opt = selectEl.selectedOptions[0];
            const row = selectEl.closest('.pp-item-row');
            if (!row || !opt || !opt.value) return;

            row.querySelector('.pp-drug-dosage').value = opt.dataset.dosage || '';
            row.querySelector('.pp-drug-freq').value = opt.dataset.freq || '';
            row.querySelector('.pp-drug-duration').value = opt.dataset.duration || '';
        };

        function renumberPpRows() {
            document.querySelectorAll('#ppItemsEditor .pp-item-row').forEach((row, i) => {
                const badge = row.querySelector('.pp-item-count');
                if (badge) badge.textContent = i + 1;
            });
        }

        function getPpDrugRowHtml(idx) {
            return `
                    <div class="pp-item-row" data-index="${idx}">
                        <span class="pp-item-count">${idx + 1}</span>
                        <div class="pp-row-5">
                            <div class="form-group">
                                <label>Medication <span class="text-danger">*</span></label>
                                <select class="pp-input pp-drug-select" onchange="onPpDrugSelected(this)">${ppDrugOptionsHtml}</select>
                            </div>
                            <div class="form-group">
                                <label>Dosage</label>
                                <input type="text" class="pp-input pp-drug-dosage" placeholder="500mg" />
                            </div>
                            <div class="form-group">
                                <label>Frequency</label>
                                <input type="text" class="pp-input pp-drug-freq" placeholder="3 times daily" />
                            </div>
                            <div class="form-group">
                                <label>Duration</label>
                                <input type="text" class="pp-input pp-drug-duration" placeholder="7 days" />
                            </div>
                            <div class="form-group">
                                <label>Instructions</label>
                                <input type="text" class="pp-input pp-drug-instr" placeholder="After meals..." />
                            </div>
                        </div>
                        <button type="button" class="pp-item-remove" onclick="removePpDrugRow(this)" title="Remove">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>`;
        }

        window.addPpDrugRow = function () {
            const container = document.getElementById('ppItemsEditor');
            const div = document.createElement('div');
            div.innerHTML = getPpDrugRowHtml(ppDrugIndex++);
            container.appendChild(div.firstElementChild);
            renumberPpRows();
        };

        window.removePpDrugRow = function (btn) {
            const rows = document.querySelectorAll('#ppItemsEditor .pp-item-row');
            const row = btn.closest('.pp-item-row');
            if (rows.length <= 1) {
                row.querySelector('.pp-drug-select').value = '';
                row.querySelectorAll('input').forEach(inp => inp.value = '');
                return;
            }
            row.remove();
            renumberPpRows();
        };

        window.openPpModal = function () {
            // ⭐ في السيشن: الروشتة على الزيارة الحالية مباشرة
            if (fixedVisitId) {
                ppTargetVisitId = fixedVisitId;
                document.getElementById('ppVisitInfo').textContent = `Current session — ${new Date().toLocaleDateString('en-GB')}`;
                document.getElementById('ppModal').style.display = 'flex';
                if (!ppMedicationsLoaded) loadPpMedications();
                return;
            }
            if (!ppVisits.length) {
                Swal.fire({ title: 'No Visits', text: 'This patient has no recorded visits yet — a visit is required before adding a prescription.', icon: 'warning' });
                return;
            }

            const target = ppVisits.find(v => v.isOpen) || ppVisits[0]; // latest visit (ppVisits is date-desc)
            ppTargetVisitId = target.id;
            document.getElementById('ppVisitInfo').textContent =
                `Visit: ${new Date(target.date).toLocaleDateString('en-GB')} — ${target.category}${target.isOpen ? ' (open)' : ''}`;

            document.getElementById('ppModal').style.display = 'flex';
            if (!ppMedicationsLoaded) loadPpMedications();
        };

        window.closePpModal = function () {
            document.getElementById('ppModal').style.display = 'none';
            document.getElementById('ppItemsEditor').innerHTML = getPpDrugRowHtml(0);
            ppDrugIndex = 1;
            document.getElementById('ppDiagnosis').value = '';
            document.getElementById('ppNotes').value = '';
            renumberPpRows();
        };

        window.submitPpPrescription = async function (andPrint) {
            if (!ppTargetVisitId) {
                Swal.fire({ title: 'Error', text: 'No target visit determined.', icon: 'error' });
                return;
            }

            const items = [];
            document.querySelectorAll('.pp-item-row').forEach(row => {
                const select = row.querySelector('.pp-drug-select');
                const opt = select.selectedOptions[0];
                if (!opt || !opt.value) return;

                items.push({
                    MedicationName: opt.dataset.name,
                    Dosage: row.querySelector('.pp-drug-dosage').value,
                    Frequency: row.querySelector('.pp-drug-freq').value,
                    Duration: row.querySelector('.pp-drug-duration').value,
                    Instructions: row.querySelector('.pp-drug-instr').value
                });
            });

            if (!items.length) {
                Swal.fire({ title: 'Required', text: 'Please select at least one medication.', icon: 'warning' });
                return;
            }

            const data = {
                VisitId: ppTargetVisitId,
                Diagnosis: document.getElementById('ppDiagnosis').value,
                Notes: document.getElementById('ppNotes').value,
                Items: items,
                PrescribedBy: '@(User.Identity?.Name ?? "System")'
            };

            const btnSave = document.getElementById('btnSavePp');
            const btnPrint = document.getElementById('btnSavePrintPp');
            const activeBtn = andPrint ? btnPrint : btnSave;
            const activeLabel = activeBtn.querySelector('span');
            const originalLabel = activeLabel.textContent;
            btnSave.disabled = btnPrint.disabled = true;
            activeLabel.textContent = 'Saving...';

            // ⭐ نفتح نافذة الطباعة فورًا مع الضغطة (قبل الـ await) عشان المتصفح ميعتبرهاش popup ويمنعها
            let printWin = null;
            if (andPrint) {
                printWin = window.open('', '_blank');
                if (printWin) printWin.document.write('<p style="font-family:Tahoma;text-align:center;margin-top:40px;color:#64748b">جاري تجهيز الروشتة للطباعة...</p>');
            }

            try {
                const res = await fetch('/Clinical/AddPrescription', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    const rxId = result.data;
                    if (andPrint) {
                        const url = `/Clinical/PrintPrescription?id=${rxId}&autoprint=1`;
                        if (printWin && !printWin.closed) printWin.location.href = url;
                        else window.open(url, '_blank');
                    }
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'success',
                        title: andPrint ? 'Prescription saved — opening print' : 'Prescription saved',
                        showConfirmButton: false, timer: 1800
                    });
                    closePpModal();
                    if (!modalOnly) loadPatientPrescriptions();
                    if (typeof window.onPrescriptionSaved === 'function') window.onPrescriptionSaved(rxId);
                } else {
                    if (printWin) printWin.close();
                    Swal.fire({ title: 'Could not save', text: result.message || 'An unexpected error occurred', icon: 'error' });
                }
            } catch (err) {
                if (printWin) printWin.close();
                Swal.fire({ title: 'Error', text: 'Could not connect to the server', icon: 'error' });
            } finally {
                btnSave.disabled = btnPrint.disabled = false;
                activeLabel.textContent = originalLabel;
            }
        };

        window.printPp = function (id) { window.open(`/Clinical/PrintPrescription?id=${id}`, '_blank'); };

        window.loadPatientPrescriptions = loadPatientPrescriptions;
        if (!modalOnly) document.addEventListener('DOMContentLoaded', loadPatientPrescriptions);

        // Esc يقفل المودال
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && document.getElementById('ppModal').style.display === 'flex') closePpModal();
        });
    })();
</script>
