@{
    // ⭐ المرحلة 3 — نفس المودال بيشتغل في Details وفي السيشن:
    //   RxPatientId : رقم المريض (الافتراضي ViewBag.CurrentPatientId بتاع Details)
    //   RxVisitId   : لو متحدد → الروشتة بتتسجل على الزيارة دي مباشرة (السيشن الحالي)
    //   RxModalOnly : true → المودال بس من غير قائمة الروشتات (السيشن)
    var rxPatientId = ViewData["RxPatientId"] as int? ?? (int)(ViewBag.CurrentPatientId ?? 0);
    var rxVisitId = ViewData["RxVisitId"] as int?;
    var rxModalOnly = ViewData["RxModalOnly"] as bool? ?? false;
}
<div class="pp-shell" data-patient-id="@rxPatientId" @(rxModalOnly ? "hidden" : "")>
    <div class="pp-toolbar">
        <div class="pp-title"><i class="bi bi-file-medical"></i> <span id="ppCount">Prescriptions</span></div>
        <button class="pp-btn-add" onclick="openPpModal()">
            <i class="bi bi-plus-lg"></i> Add Prescription
        </button>
    </div>

    <div class="pp-skeleton" id="ppSkeleton">
        <div class="pp-skeleton-row"></div>
        <div class="pp-skeleton-row"></div>
        <div class="pp-skeleton-row"></div>
    </div>

    <div class="pp-list" id="ppList"></div>

    <div class="pp-empty" id="ppEmptyState" style="display:none;">
        <i class="bi bi-file-medical"></i>
        <p>There are no registered prescriptions for this patient.</p>
    </div>
</div>

<!-- Add Prescription Modal -->
<div class="pp-modal" id="ppModal" style="display:none;">
    <div class="pp-modal-glass">
        <div class="pp-modal-head">
            <div>
                <h5><i class="bi bi-file-earmark-medical"></i> New Prescription</h5>
                <div class="pp-modal-subtitle" id="ppVisitInfo"></div>
            </div>
            <button class="pp-btn-close" onclick="closePpModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="pp-modal-body">
            <div class="pp-top-row">
                <div class="form-group">
                    <label>Diagnosis</label>
                    <input type="text" class="pp-input" id="ppDiagnosis" placeholder="Diagnosis..." />
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <input type="text" class="pp-input" id="ppNotes" placeholder="Prescription notes..." />
                </div>
            </div>

            <div class="pp-items-editor" id="ppItemsEditor">
                <div class="pp-item-row" data-index="0">
                    <span class="pp-item-count">1</span>
                    <div class="pp-row-5">
                        <div class="form-group">
                            <label>Medication <span class="text-danger">*</span></label>
                            <select class="pp-input pp-drug-select" onchange="onPpDrugSelected(this)">
                                <option value="">Loading medications...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Dosage</label>
                            <input type="text" class="pp-input pp-drug-dosage" placeholder="500mg" />
                        </div>
                        <div class="form-group">
                            <label>Frequency</label>
                            <input type="text" class="pp-input pp-drug-freq" placeholder="3 times daily" />
                        </div>
                        <div class="form-group">
                            <label>Duration</label>
                            <input type="text" class="pp-input pp-drug-duration" placeholder="7 days" />
                        </div>
                        <div class="form-group">
                            <label>Instructions</label>
                            <input type="text" class="pp-input pp-drug-instr" placeholder="After meals..." />
                        </div>
                    </div>
                    <button type="button" class="pp-item-remove" onclick="removePpDrugRow(this)" title="Remove">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </div>

            <button class="pp-btn-add-drug" onclick="addPpDrugRow()">
                <i class="bi bi-plus-circle"></i> Add Medication
            </button>
        </div>
        <div class="pp-modal-foot">
            <button class="pp-btn pp-btn-cancel" onclick="closePpModal()">Cancel</button>
            <button class="pp-btn pp-btn-save-only" id="btnSavePp" onclick="submitPpPrescription(false)">
                <i class="bi bi-check2"></i> <span>Save</span>
            </button>
            <button class="pp-btn pp-btn-save" id="btnSavePrintPp" onclick="submitPpPrescription(true)">
                <i class="bi bi-printer"></i> <span>Save &amp; Print</span>
            </button>
        </div>
    </div>
</div>

<style>
