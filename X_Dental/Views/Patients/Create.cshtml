@using Dental.Modules.Patients.DTOs
@model Dental.Modules.Patients.DTOs.CreatePatientDto
@{
    ViewData["Title"] = "إضافة مريض جديد";
    var genderList = ViewBag.Genders as SelectList ?? new SelectList(new List<SelectListItem>());
    var bloodGroupList = ViewBag.BloodGroups as SelectList ?? new SelectList(new List<SelectListItem>());
}
@section Styles {
    <link rel="stylesheet" href="~/css/patient-hero-shared.css" asp-append-version="true" />
    <style>
        /* ── Layout: sticky profile panel + single flowing document card ──
                                   (deliberately NOT a grid of separate equal cards) */
        .create-layout {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
            align-items: start;
        }

        @@media (max-width: 992px) {
            .create-layout {
                grid-template-columns: 1fr;
            }
        }

        /* ── Profile panel (left, sticky) ── */
        .profile-panel {
            position: sticky;
            top: 20px;
            background: rgba(255,255,255,.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: var(--sc-radius-lg);
            padding: 26px 22px;
            box-shadow: 0 20px 50px rgba(10,77,79,.08);
            text-align: center;
        }

        .avatar-preview {
            width: 76px;
            height: 76px;
            border-radius: 22px;
            background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            font-weight: 800;
            margin: 0 auto 14px;
            box-shadow: 0 10px 24px rgba(13,115,119,.28);
            transition: transform .2s ease;
        }

        #namePreview {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--sc-ink-900);
            min-height: 1.3em;
        }

        .code-chip {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            background: var(--sc-sky-100);
            color: var(--sc-teal-700);
            padding: 4px 12px;
            border-radius: 999px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 8px;
        }

        .profile-summary {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px dashed var(--sc-sky-100);
            display: flex;
            flex-direction: column;
            gap: 10px;
            text-align: right;
        }

        .summary-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
        }

            .summary-row span.label {
                color: var(--sc-ink-600);
                font-weight: 600;
            }

            .summary-row span.value {
                font-weight: 800;
                color: var(--sc-ink-900);
                display: flex;
                align-items: center;
                gap: 5px;
            }

        /* ── Document card (right) ── */
        .form-doc {
            background: rgba(255,255,255,.82);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: var(--sc-radius-lg);
            box-shadow: 0 20px 50px rgba(10,77,79,.08);
            overflow: hidden;

        }

        .form-section {
            padding: 8px 10px;
            opacity: 0;
            transform: translateY(8px);
            animation: sectionFadeIn .45s ease forwards;
        }

            .form-section:not(:last-child) {
                border-bottom: 1px solid var(--sc-sky-100);
            }

            .form-section:nth-of-type(1) {
                animation-delay: .03s;
            }

            .form-section:nth-of-type(2) {
                animation-delay: .08s;
            }

            .form-section:nth-of-type(3) {
                animation-delay: .13s;
            }

            .form-section:nth-of-type(4) {
                animation-delay: .18s;
            }

        @@keyframes sectionFadeIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section-head {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

            .section-head .section-icon {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--sc-sky-100);
                color: var(--sc-teal-700);
                font-size: 1rem;
                flex-shrink: 0;
            }

            .section-head h2 {
                font-size: 0.95rem;
                font-weight: 800;
                color: var(--sc-ink-900);
                margin: 0;
            }

            .section-head p {
                font-size: 0.76rem;
                color: var(--sc-ink-600);
                margin: 1px 0 0;
                font-weight: 600;
            }

        .fields-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 16px;
        }

        @@media (max-width: 640px) {
            .fields-grid {
                grid-template-columns: 1fr;
            }
        }

        .fields-grid .span-2 {
            grid-column: 1 / -1;
        }

        /* ⭐ الاسم الكامل جنب الـ input بدل ما يكون فوقه (زي كل الحقول التانية) */
        .sc-field {
            display: flex;
            align-items: center;
           
        }

            .sc-field label {
                flex: 0 0 auto;
                min-width: 92px;
                font-size: 0.76rem;
                font-weight: 700;
                color: var(--sc-ink-600);
                margin-bottom: 0;
                text-align: right;
            }

                .sc-field label .required {
                    color: #dc2626;
                }

            .sc-field .form-control,
            .sc-field .form-select {
                flex: 1 1 auto;
                min-width: 0;
                border: 1.5px solid var(--sc-sky-100);
                border-radius: 10px;
                padding: 10px 12px;
                font-size: 0.9rem;
                background: #fff;
                transition: border-color .2s, box-shadow .2s;
            }

                .sc-field .form-control:focus,
                .sc-field .form-select:focus {
                    border-color: var(--sc-teal-500);
                    box-shadow: 0 0 0 3px rgba(15,155,142,.12);
                    outline: none;
                }

            .sc-field textarea.form-control {
                min-height: 90px;
                resize: vertical;
            }

            /* للحقول اللي فيها textarea نخلي الـ label ملزّق فوق مش في النص رأسيًا */
            .sc-field.align-start {
                align-items: flex-start;
            }

                .sc-field.align-start label {
                    margin-top: 10px;
                }

            .sc-field .text-danger {
                font-size: 0.76rem;
                margin-top: 4px;
                display: block;
            }

        /* ── Patient type — selectable tiles (replaces the old vertical
                                   radio chip list entirely) ── */
        .type-tiles {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        @@media (max-width: 640px) {
            .type-tiles {
                grid-template-columns: 1fr;
            }
        }

        .type-tile {
            position: relative;
            border: 2px solid var(--sc-sky-100);
            border-radius: 14px;
            padding: 16px 14px;
            text-align: center;
            cursor: pointer;
            transition: all .22s ease;
            background: #fff;
        }

            .type-tile input {
                display: none;
            }

            .type-tile .tile-icon {
                width: 42px;
                height: 42px;
                margin: 0 auto 10px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
                background: var(--sc-sky-100);
                color: var(--sc-teal-700);
                transition: all .22s ease;
            }

            .type-tile .tile-title {
                font-weight: 800;
                font-size: 0.88rem;
                color: var(--sc-ink-900);
            }

            .type-tile .tile-desc {
                font-size: 0.72rem;
                color: var(--sc-ink-600);
                margin-top: 3px;
                line-height: 1.4;
            }

            .type-tile .tile-check {
                position: absolute;
                top: 10px;
                left: 10px;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: var(--sc-teal-600);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .68rem;
                opacity: 0;
                transform: scale(.5);
                transition: all .2s ease;
            }

            .type-tile:hover {
                border-color: var(--sc-teal-100);
                transform: translateY(-2px);
            }

            .type-tile.selected {
                border-color: var(--sc-teal-600);
                background: linear-gradient(160deg, #fff, var(--sc-sky-50));
                box-shadow: 0 8px 20px rgba(15,155,142,.18);
                transform: translateY(-2px);
            }

                .type-tile.selected .tile-icon {
                    background: linear-gradient(135deg, var(--sc-teal-500), var(--sc-teal-700));
                    color: #fff;
                }

                .type-tile.selected .tile-check {
                    opacity: 1;
                    transform: scale(1);
                }

        /* ── Gender — segmented control (replaces the two bordered boxes) ── */
        .segmented {
            position: relative;
            display: flex;
            background: var(--sc-sky-100);
            border-radius: 999px;
            padding: 4px;
        }

            .segmented .seg-thumb {
                position: absolute;
                top: 4px;
                bottom: 4px;
                width: calc(50% - 4px);
                background: linear-gradient(135deg, var(--sc-teal-600), var(--sc-teal-700));
                border-radius: 999px;
                box-shadow: 0 4px 10px rgba(13,148,136,.28);
                transition: transform .28s cubic-bezier(.3,1.2,.4,1);
                z-index: 0;
            }

            .segmented.pos-1 .seg-thumb {
                transform: translateX(0);
            }

            .segmented.pos-2 .seg-thumb {
                transform: translateX(-100%);
            }

            .segmented label {
                position: relative;
                z-index: 1;
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                padding: 9px 0;
                font-size: 0.85rem;
                font-weight: 700;
                color: var(--sc-ink-600);
                cursor: pointer;
                transition: color .2s ease;
                border-radius: 999px;
                min-width: 0;
            }

                .segmented label input {
                    display: none;
                }

                .segmented label.active {
                    color: #fff;
                }

        /* ── Save row ── */
        .form-save-row {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 18px 28px;
            background: var(--sc-sky-50);
        }
    </style>
}
<section class="patients-page-anim" dir="rtl">
    <div class="row">
        <div class="col-md-12">
            <div class="patient-hero">
                <div class="hero-content">
                    <div class="hero-avatar" id="heroAvatar">؟</div>
                    <div>
                        <h1 id="heroNamePreview">مريض جديد</h1>
                        <div class="hero-meta">
                            <span class="hero-meta-tag"><i class="bi bi-magic"></i> كود تلقائي عند الحفظ</span>
                            <span class="hero-meta-tag" id="heroMobileTag" style="display:none;"><i class="bi bi-telephone"></i></span>
                            <span class="hero-meta-tag" id="heroGenderTag"><i class="bi bi-gender-male"></i> ذكر</span>
                            <span class="hero-meta-tag" id="heroAgeTag" style="display:none;"><i class="bi bi-calendar"></i></span>
                            <span class="hero-meta-tag" id="heroTypeTag"><i class="bi bi-app-indicator"></i> عام</span>
                            <span class="hero-meta-tag hero-tag-optional" id="heroBloodTag"><i class="bi bi-droplet"></i></span>
                        </div>
                    </div>
                </div>
                <div class="hero-actions">
                    <a asp-action="Index" class="btn-hero btn-hero-ghost">
                        <i class="bi bi-x-lg"></i> إلغاء
                    </a>
                    <button type="submit" form="patientForm" class="btn-hero btn-hero-light">
                        <i class="bi bi-check-lg"></i> حفظ المريض
                    </button>
                </div>
            </div>

            <form id="patientForm" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Sticky profile preview -->
                    <div class=" col-12 col-lg-4">
                        <div class="form-section">
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-person-fill"></i></div>
                                <div>
                                    <h2>المعلومات الأساسية</h2>
                                    <p>اسم المريض كما سيظهر في الملف</p>
                                </div>
                            </div>
                            <div class="fields-grid px-1">
                                <div class="text-end sc-field span-2 mx-0">
                                    <label>الاسم الكامل <span class="required">*</span></label>
                                    <input asp-for="FullNameAr" id="fullNameInput" class="form-control text-center" placeholder="ادخل اسم المريض" autocomplete="off" />
                                    <span asp-validation-for="FullNameAr" class="text-danger"></span>
                                </div>
                                <div class="text-end sc-field span-2 mx-0">
                                    <label>الموبايل <span class="required">*</span></label>
                                    <input asp-for="Mobile" class="form-control text-center" placeholder="01xxxxxxxxx" dir="ltr" />
                                    <span asp-validation-for="Mobile" class="text-danger"></span>
                                </div>
                                <div class="text-end sc-field span-2 mx-0">
                                    <label>تاريخ الميلاد</label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control text-center" />
                                </div>
                                <div class="text-end sc-field span-2 mx-0">
                                    <label>فصيلة الدم</label>
                                    <select asp-for="BloodGroupId" asp-items="@bloodGroupList" class="form-select text-center">
                                        <option value="">-- اختر --</option>
                                    </select>
                                </div>
                                <!-- ⭐ العنوان بقى هنا تحت فصيلة الدم -->
                                <div class="text-end sc-field span-2 mx-0">
                                    <label>العنوان</label>
                                    <textarea asp-for="Address" class="form-control" placeholder="ادخل العنوان"></textarea>
                                </div>


                                <div class="sc-field span-2 " hidden>
                                    <label>الاسم بالإنجليزية</label>
                                    <input asp-for="FullNameEn" class="form-control" placeholder="Optional" autocomplete="off" dir="ltr" />
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- Single flowing document with clear sections -->
                    <div class="form-doc col-12 col-lg-4">
                        <div class="form-section">
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-card-checklist"></i></div>
                                <div>
                                    <h2>نوع الملف </h2>
                                    <p>حدد نوع العلاج المطلوب وبيانات المريض الأساسية</p>
                                </div>
                            </div>

                            <div class="sc-field span-2" style="margin-bottom:16px;">

                                <div class="type-tiles" id="typeTiles">
                                <label class="type-tile selected" data-type="general">
                                    <input type="radio" name="PatientType" value="1" checked />
                                    <span class="tile-check"><i class="bi bi-check-lg"></i></span>
                                    <div class="tile-icon"><i class="bi bi-app-indicator"></i></div>
                                    <div class="tile-title">عام</div>
                                    <div class="tile-desc">علاج الأسنان العام والوقائي</div>
                                </label>
                                <label class="type-tile" data-type="ortho">
                                    <input type="radio" name="PatientType" value="2" />
                                    <span class="tile-check"><i class="bi bi-check-lg"></i></span>
                                    <div class="tile-icon"><i class="bi bi-braces"></i></div>
                                    <div class="tile-title">تقويم</div>
                                    <div class="tile-desc">متابعة دورية لتقويم الأسنان</div>
                                </label>
                                <label class="type-tile" data-type="both">
                                    <input type="radio" name="PatientType" value="3" />
                                    <span class="tile-check"><i class="bi bi-check-lg"></i></span>
                                    <div class="tile-icon"><i class="bi bi-heart-pulse"></i></div>
                                    <div class="tile-title">كلا الملفين</div>
                                    <div class="tile-desc">علاج عام ومتابعة تقويم معًا</div>
                                </label>
                            </div>
                            </div>
                            <div class="fields-grid mt-3">
                                <div class="segmented pos-1" id="genderSegmented">
                                    <div class="seg-thumb"></div>
                                    <label data-gender="male" class="active">
                                        <input type="radio" name="GenderId" value="1" checked />
                                        <i class="bi bi-gender-male"></i> ذكر
                                    </label>
                                    <label data-gender="female">
                                        <input type="radio" name="GenderId" value="2" />
                                        <i class="bi bi-gender-female"></i> أنثى
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-section" hidden>
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-telephone-fill"></i></div>
                                <div>
                                    <h2>بيانات التواصل</h2>
                                    <p>وسائل التواصل مع المريض</p>
                                </div>
                            </div>
                            <div class="fields-grid">
                                <div class="sc-field">
                                    <label>الرقم القومي</label>
                                    <input asp-for="NationalId" class="form-control" placeholder="14 رقم" maxlength="14" dir="ltr" />
                                </div>

                                <div class="sc-field">
                                    <label>تليفون</label>
                                    <input asp-for="Phone" class="form-control" placeholder="اختياري" dir="ltr" />
                                </div>
                                <div class="sc-field">
                                    <label>البريد الإلكتروني</label>
                                    <input asp-for="Email" class="form-control" placeholder="patient@email.com" dir="ltr" />
                                </div>
                            </div>
                        </div>

                        <div class="form-save-row" hidden>
                            <a asp-action="Index" class="btn-hero" style="background:var(--sc-sky-100);color:var(--sc-ink-600);">
                                <i class="bi bi-x-lg"></i> إلغاء
                            </a>
                            <button type="submit" class="btn-hero" style="background:linear-gradient(135deg,var(--sc-teal-600),var(--sc-teal-700));color:#fff;">
                                <i class="bi bi-check-lg"></i> حفظ المريض
                            </button>
                        </div>

                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-section">
                            <div class="section-head">
                                <div class="section-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                                <div>
                                    <h2>التاريخ الطبي</h2>
                                    <p>معلومات مهمة قبل بدء أي علاج</p>
                                </div>
                            </div>
                            <div class="fields-grid">
                                <div class="sc-field span-2">
                                    <label>الحساسية</label>
                                    <input name="MedicalInfo.Allergies" class="form-control" placeholder="مثال: بنسلين، ليدوكايين..." />
                                </div>
                                <div class="sc-field span-2">
                                    <label>أمراض مزمنة</label>
                                    <input name="MedicalInfo.ChronicDiseases" class="form-control" placeholder="سكري، ضغط..." />
                                </div>
                                <div class="sc-field span-2">
                                    <label>الأدوية الحالية</label>
                                    <input name="MedicalInfo.CurrentMedications" class="form-control" placeholder="الأدوية المستخدمة لدي المريض ..." />
                                </div>
                                <div class="sc-field span-2">
                                    <label>حالة التدخين</label>
                                    <select asp-for="SmokingStatus" class="form-select">
                                        <option value="">-- اختر --</option>
                                        <option value="NonSmoker">لا يدخن</option>
                                        <option value="FormerSmoker">مدخن سابق</option>
                                        <option value="LightSmoker">مدخن خفيف</option>
                                        <option value="HeavySmoker">مدخن شره</option>
                                    </select>
                                </div>
                                <div class="sc-field span-2 align-start">
                                    <label>ملاحظات طبية عاجلة</label>
                                    <textarea name="MedicalInfo.EmergencyNotes" class="form-control" placeholder="أي تحذيرات للدكتور..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Live avatar + name preview while typing
        const nameInput = document.getElementById('fullNameInput');
        const namePreview = document.getElementById('namePreview');
        const avatarPreview = document.getElementById('avatarPreview');
        const heroAvatar = document.getElementById('heroAvatar');
        const heroNamePreview = document.getElementById('heroNamePreview');
        nameInput.addEventListener('input', function () {
            const name = this.value.trim();
            namePreview.textContent = name || 'مريض جديد';
            heroNamePreview.textContent = name || 'مريض جديد';
            const initials = name.split(' ').filter(Boolean).slice(0, 2).map(p => p[0]).join('');
            avatarPreview.textContent = initials || '؟';
            heroAvatar.textContent = initials || '؟';
        });

        // Blood group tag in hero (بيظهر بس على الشاشات الواسعة - CSS بيتحكم في ده)
        const bloodGroupSelect = document.getElementById('BloodGroupId');
        const heroBloodTag = document.getElementById('heroBloodTag');
        if (bloodGroupSelect && heroBloodTag) {
            bloodGroupSelect.addEventListener('change', function () {
                const text = this.options[this.selectedIndex]?.text?.trim();
                if (text && this.value) {
                    heroBloodTag.classList.add('has-value');
                    heroBloodTag.innerHTML = `<i class="bi bi-droplet"></i> ${text}`;
                } else {
                    heroBloodTag.classList.remove('has-value');
                }
            });
        }

        // Mobile tag in hero
        const mobileInput = document.getElementById('Mobile');
        const heroMobileTag = document.getElementById('heroMobileTag');
        if (mobileInput && heroMobileTag) {
            mobileInput.addEventListener('input', function () {
                const val = this.value.trim();
                if (val) {
                    heroMobileTag.style.display = 'inline-flex';
                    heroMobileTag.innerHTML = `<i class="bi bi-telephone"></i> ${val}`;
                } else {
                    heroMobileTag.style.display = 'none';
                }
            });
        }

        // Age tag in hero (يتحسب لايف من تاريخ الميلاد)
        const dobInput = document.getElementById('DateOfBirth');
        const heroAgeTag = document.getElementById('heroAgeTag');
        if (dobInput && heroAgeTag) {
            dobInput.addEventListener('change', function () {
                if (!this.value) { heroAgeTag.style.display = 'none'; return; }
                const dob = new Date(this.value);
                const today = new Date();
                let age = today.getFullYear() - dob.getFullYear();
                const m = today.getMonth() - dob.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
                if (age >= 0 && age < 130) {
                    heroAgeTag.style.display = 'inline-flex';
                    heroAgeTag.innerHTML = `<i class="bi bi-calendar"></i> ${age} سنة`;
                } else {
                    heroAgeTag.style.display = 'none';
                }
            });
        }

        // Patient type tiles
        const typeLabels = {
            general: { icon: 'bi-app-indicator', text: 'عام' },
            ortho: { icon: 'bi-braces', text: 'تقويم' },
            both: { icon: 'bi-heart-pulse', text: 'كلا الملفين' }
        };
        document.querySelectorAll('#typeTiles input[type=radio]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.type-tile').forEach(t => t.classList.remove('selected'));
                const tile = this.closest('.type-tile');
                tile.classList.add('selected');
                const info = typeLabels[tile.dataset.type];
                document.getElementById('summaryType').innerHTML = `<i class="bi ${info.icon}"></i> ${info.text}`;
                const heroTypeTag = document.getElementById('heroTypeTag');
                if (heroTypeTag) heroTypeTag.innerHTML = `<i class="bi ${info.icon}"></i> ${info.text}`;
            });
        });

        // Gender segmented control
        const genderSegmented = document.getElementById('genderSegmented');
        const genderLabels = { male: { icon: 'bi-gender-male', text: 'ذكر' }, female: { icon: 'bi-gender-female', text: 'أنثى' } };
        genderSegmented.querySelectorAll('input[type=radio]').forEach(function (radio, idx) {
            radio.addEventListener('change', function () {
                genderSegmented.querySelectorAll('label[data-gender]').forEach(l => l.classList.remove('active'));
                const lbl = this.closest('label');
                lbl.classList.add('active');
                genderSegmented.classList.toggle('pos-1', idx === 0);
                genderSegmented.classList.toggle('pos-2', idx === 1);
                const info = genderLabels[lbl.dataset.gender];
                document.getElementById('summaryGender').innerHTML = `<i class="bi ${info.icon}"></i> ${info.text}`;
                const heroGenderTag = document.getElementById('heroGenderTag');
                if (heroGenderTag) heroGenderTag.innerHTML = `<i class="bi ${info.icon}"></i> ${info.text}`;
            });
        });
    </script>
}
